<apex:page sidebar="false"
           title="Post Sale Refunds: {! Approval__c.Name }"
           standardController="Approval__c"
           extensions="PostSaleRefundsController"
           tabStyle="Approval__c" >
    <apex:slds />
    <c:HerokuScripts />

    <style type="text/css">
        .zen .zen-headerBottom {
            border-bottom-right-radius: 5px;
            border-bottom-left-radius: 5px;
        }
        .zen .zen-moreTabs ul {
            z-index: 20;
        }
        .bodyDiv.brdPalette.brandPrimaryBrd {
            border: none;
            -webkit-box-shadow: inset 0px 6px 5px 0px rgba(123,187,207,1);
            -moz-box-shadow: inset 0px 6px 5px 0px rgba(123,187,207,1);
            box-shadow: inset 0px 6px 5px 0px rgba(123,187,207,1);
            background: #b0c4df url("/_slds/images/themes/lightning_blue/lightning_blue_background.png") repeat-x !important;
            font-family: "Salesforce Sans", Arial, sans-serif;
            height: inherit;
            min-height: calc(100vh - 170px);
            border-radius: 0;
            margin: 0 -10px;
            width: calc(100% + 20px);
        }
        .noSidebarCell, .bodyDiv .outerNoSidebar {
            padding: 0;
        }

        .noTableFooter {
            margin-left: 0;
        }
        .cdk-overlay-container {
            pointer-events: none;
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            z-index: 1000;
        }
        .cdk-overlay-pane {
            position: absolute;
            pointer-events: auto;
            box-sizing: border-box;
            z-index: 1000;
            display: flex;
            max-width: 100%;
            max-height: 100%;
        }
        .details__table th:first-child, .details__table td:first-child{
            min-width: 500px;
            width: 500px;
        }
    </style>

    <div id="psrContainer" class="slds-scope"></div>

    <script type="text/javascript">
        const herokuEndpoint = '{!billingWizardURL}';
        const sessionId      = '{!sId}';
        const origin         = '{!JSENCODE(origin)}';
        const approvalParams = '{! JSENCODE(dataJSON) }';

        const angular = document.createElement('app-root');
        angular.routeParams = {
            name: 'post-sales-refunds',
            data: {
                billingParams: {
                    herokuEndpoint,
                    sessionId,
                    origin
                },
                approvalParams
            }
        };
        document.getElementById('psrContainer').appendChild(angular);
    </script>

</apex:page>