<apex:page standardController="Case" tabStyle="Case" lightningStylesheets="true">
    <apex:slds /> 
    <style>
        * {padding:0;margin:0;}
    </style>
    <div class="slds-grid slds-size_1-of-1 label-inline">
        <div style="padding-left:0" class="slds-form-element slds-hint-parent test-id__output-root slds-form-element_edit slds-form-element_readonly slds-form-element_horizontal">
            <div class="test-id__field-label-container slds-form-element__label no-utility-icon">
                <span class="test-id__field-label">RC Porting Order ID</span>
            </div>
            <div style="display: inline-flex; padding-left:13%">
                <span class="test-id__field-value slds-form-element__static slds-grow word-break-ie11">
                    <apex:outputText value="{0, Number, #}">
                        <apex:param value="{!case.RC_Porting_Order_ID__c}" />
                    </apex:outputText>
                </span>
            </div>
        </div>
    </div>
</apex:page>