<apex:page standardController="Account_Hierarchy__c" 
            extensions="CompanyRelatedListsExt" 
            showHeader="false" 
            sidebar="false">
    <style>
        .links{
            padding: 0.4em;
        }
        .spacing{
            padding: 0.3em;
        }
    </style>
    <script>
        function deleteItem(value, sobject) {
            event.preventDefault();
            var text = 'Are you sure?';
            if(confirm(text)) {
                deleteRecord(value, sobject);
                window.opener.location.reload();
            }
            return false;
        }
        function openLink(value) {
            window.open('/' + value, '_parent');
        }
    </script>
    <apex:form >
        <apex:outputPanel id="errorMessage">
            <apex:pageMessages />
        </apex:outputPanel>
        <apex:actionFunction name="deleteRecord"
                                immediate="true" 
                                action="{!deleteItem}" 
                                rerender="redirectScript,errorMessage">
            <apex:param name="cId" value="" />
            <apex:param name="sobj" value="" />
        </apex:actionFunction>
        <apex:pageBlock title="Activities" mode="detail" id="actBlock">
            <apex:outputPanel id="redirectScript" >
                <apex:outputText rendered="{!redirect}">
                    <script type="text/javascript">
                        window.top.location.href = '{!redirectUrl}';
                    </script>
                </apex:outputText>
            </apex:outputPanel>
            <apex:pageBlockTable value="{!Activities}" 
                                    var="act" 
                                    rendered="{!showFullTable}">
                <apex:column styleClass="actionColumn">
                    <apex:facet name="header">
                        Action
                    </apex:facet>
                    <apex:commandLink action="{!editItem}" 
                                        value="Edit" 
                                        styleClass="actionLink" 
                                        rerender="redirectScript">
                        <apex:param name="cId" value="{!act.Id}"/>
                    </apex:commandLink>&nbsp;|&nbsp;
                    <apex:commandLink value="Del" 
                                        onclick="deleteItem('{!act.Id}', 'Task');" 
                                        styleClass="actionLink" 
                                        reRender="false" />
                </apex:column>
                <apex:column headerValue="Subject">
                    <apex:outputLink value="{!URLFOR($Action.Task.View,act.Id)}" target="_parent">
                        {!act.Subject}
                    </apex:outputLink>
                </apex:column>
                <apex:column value="{!act.WhoId}" onclick="openLink('{!act.WhoId}');"/>
                <apex:column value="{!act.WhatId}" onclick="openLink('{!act.WhatId}');"/>
                <apex:column value="{!act.ActivityDate}"/>
                <apex:column value="{!act.OwnerId}" onclick="openLink('{!act.OwnerId}');"/>
                <apex:column value="{!act.LastModifiedDate}"/>
            </apex:pageBlockTable>
            <apex:pageBlockTable value="{!Activities}" 
                                    var="act" 
                                    rows="5"
                                    rendered="{!IF(AND(Activities.size > 0, !showFullTable), true, false)}">
                <apex:column styleClass="actionColumn">
                    <apex:facet name="header">
                        Action
                    </apex:facet>
                    <apex:commandLink action="{!editItem}" 
                                        value="Edit" 
                                        styleClass="actionLink" 
                                        rerender="redirectScript">
                        <apex:param name="cId" value="{!act.Id}"/>
                    </apex:commandLink>&nbsp;|&nbsp;
                    <apex:commandLink value="Del" 
                                        onclick="deleteItem('{!act.Id}', 'Task');" 
                                        styleClass="actionLink" 
                                        reRender="false" />
                </apex:column>
                <apex:column headerValue="Subject">
                    <apex:outputLink value="{!URLFOR($Action.Task.View,act.Id)}" target="_parent">
                        {!act.Subject}
                    </apex:outputLink>
                </apex:column>
                <apex:column value="{!act.WhoId}" onclick="openLink('{!act.WhoId}');"/>
                <apex:column value="{!act.WhatId}" onclick="openLink('{!act.WhatId}');"/>
                <apex:column value="{!act.ActivityDate}"/>
                <apex:column value="{!act.OwnerId}" onclick="openLink('{!act.OwnerId}');"/>
                <apex:column value="{!act.LastModifiedDate}"/>
            </apex:pageBlockTable>
            <apex:outputPanel layout="block" styleClass="spacing"/>
            <apex:commandLink action="{!showAllRecords}" 
                                value="Show all ({!Activities.size}) records »" 
                                rendered="{!IF(AND(Activities.size > 5, !showFullTable), true, false)}" 
                                reRender="actBlock"
                                styleClass="links"/>
            <apex:outputLabel value="No records to display" rendered="{!Activities.size == 0}"/>
        </apex:pageBlock>
    </apex:form>
</apex:page>