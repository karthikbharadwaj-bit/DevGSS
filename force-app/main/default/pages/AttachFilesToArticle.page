<apex:page controller="SupportCommunityKnowledgeController" lightningstylesheets="true" showheader="true" standardstylesheets="false" sidebar="true" applyhtmltag="true" applybodytag="false" doctype="html-5.0">
    <apex:slds />
    <html xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta http-equiv="x-ua-compatible" content="ie=edge"/>
        <title>Knowledge files attachment</title>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <apex:includescript value="{! $Resource.jquery172 }"></apex:includescript>
        <script src="//cdnjs.cloudflare.com/ajax/libs/jsforce/1.9.1/jsforce.min.js"></script>
        <style>
            * {
                box-sizing: border-box;
            }
            .slds-scope {
                background-color: #b0c4df!important;
                padding: 0 !important;
            }
            .slds-scope_my {
                background-image: url("/_slds/images/themes/lightning_blue/lightning_blue_background.png") !important;
                background-color: #b0c4df !important;
                background-repeat: repeat-x !important;
                font-family: "Salesforce Sans", Arial, sans-serif;
                height: inherit;
            }
            .wrapper {
                width: 100%;
                min-height: 500px;
                max-width: 1200px;
                position: relative;
                margin: 0 auto;
                padding:50px 10px;
            }
            .wrapper .slds-card {
                max-width: 600px;
                width: 80%;
                position: absolute;
                left: 50%;
                top: 50%;
                transform: translate(-50%, -50%);
            }
            .slds-card__footer {
                display: flex !important;
                justify-content: space-between;
            }
            .file_list {
                flex-direction: column;
                background-color: #fff;
                border: 1px solid #dddbda;
                border-radius: .25rem;
                overflow-y: auto;
                width: 100%;
                min-height: 32px;
                max-height: 210px;
                position: relative;
            }
            .file_list:empty:before {
                content: 'No attached files';
                position: absolute;
                left: 50%;
                transform: translate(-50%, -50%);
                top: 50%;
                color: #dddbda;
                font-size: 18px;
                font-weight: 500;
            }
            .file_list .file {
                position: relative;
                height: 32px;
                width: 100%;
                display: flex;
                align-items: center;
                padding: 10px 10px 10px 30px;
                font-style: italic;
                overflow: hidden;
            }
            .file_list .file .shared {
                display: none;
                position: absolute;
                left: 5px;
                width: 20px;
                height: 20px;
                top: 50%;
                transform: translateY(-50%);
                color: #006dcc;
            }
            .file_list .file.published {
                background-color: rgba(0, 109, 204,.05);
                font-style: normal;
            }

            .file_list .file.published .shared {
                display: block;
            }

            .file_list .file.error {
                color: #dddbda;
                background-color: rgba(229, 57, 53,.3);
                font-style: italic;
                text-decoration: line-through;
                cursor: pointer;
            }
            .file_list .file.error .remove{
                display: none;
            }

            .file_list .file:not(:last-child) {
                border-bottom: 1px solid #dddbda;
            }
            .file_list .file > span {
                line-height: 1.25;
                font-weight: 700;
                color: #16325c;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .file_list .file a {
                white-space: nowrap;
                text-overflow: ellipsis;
                overflow: hidden;
                padding-right: 125px;
            }
            .file_list .file .file_langs {
                display: flex;
                position: absolute;
                right: 30px;
                top: 50%;
                transform: translateY(-50%);
            }
            .file_list .file .file_langs span {
                border-radius: 4px;
                border: solid 1px #DDDBDA;
                line-height: 19px;
                padding: 0 4px;
                color: #16325c;
                display: block;
                margin: 0 2px;
                font-size: 11px;
                cursor: pointer;
                transition: border-color 0.3s ease-out;
            }
            .file_list .file .file_langs span:hover {
                border-color: #006DCC;
            }
            .file_list .file .file_langs span.active {
                border-radius: 4px;
                background: #006DCC;
                border: solid 1px #006DCC;
                color: #fff;
            }
            .file_list .file .file_langs span.active:hover {
                border: solid 1px #fff;
            }
            .file_list .file .file_remove {
                display: none;
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
            }
            .file_list .file:hover .file_remove {
                display: block;
            }
            .slds-form-element__control {
                height: 100%;
            }
            .slds-scope .slds-file-selector {
                height: inherit;
            }
            #Selected {
                padding-left: 5px;
            }
            .loading {
                display: flex;
                position: absolute;
                left: 0;
                top:0;
                border: none;
                width: 100%;
                height: 100%;
                color: #16325c;
                line-height: 1.25;
                font-weight: 700;
                background-color: #fff;
                justify-content: center;
                align-items: center;
                cursor: wait;
            }
            .loading.multi .slds-progress-bar {
                display: block;
            }
            .loading.hide {
                display: none;
            }
            .loading .slds-progress-bar {
                display: none;
                position: absolute;
                top: 40px;
                left: 10px;
                width: calc(100% - 20px);
            }
            .loading .slds-progress-bar .slds-progress-bar__value {
                transition: 1s width ease-out;
            }
            .spinner {
                top: 0;
                left: 0;
                position: absolute;
                height: 100%;
                width: 100%;
                z-index: 20;
                background-color: rgba(255,255,255,.5);
            }
        </style>
        <script type="text/javascript">
            const langs = [
                { title: "En", val: "en_US", help: "English" },
                { title: "Fr", val: "fr", help: "French" },
                { title: "De", val: "de", help: "German" },
                { title: "Es", val: "es", help: "Spanish" }
            ];
            var conn = new jsforce.Connection({ accessToken: "{!$Api.Session_Id}" });
            const MAX_FILE_SIZE = 52; //Mb
            jQuery.noConflict();
            var articleId = null;
            var files = [];
            function initArticle() {
                var d = jQuery.Deferred();
                Visualforce.remoting.Manager.invokeAction(
                    "{!$RemoteAction.SupportCommunityKnowledgeController.getKnowledgeInfoByArticleNumber}",
                    articleId,
                    function(result, event) {
                        if (event.status) {
                            d.resolve(result);
                        } else {
                            d.reject();
                            console.error(event.message);
                        }
                    },
                    { escape: true }
                );
                return d;
            }
            function Publish() {
                jQuery(".file_list .file.error").remove();
                var d = jQuery.Deferred();
                Visualforce.remoting.Manager.invokeAction(
                    "{!$RemoteAction.SupportCommunityKnowledgeController.publishFiles}",
                    articleId,
                    function(result, event) {
                        if (event.status) {
                            d.resolve(result);
                        } else {
                            d.reject();
                            console.error(event.message);
                        }
                    },
                    { escape: true }
                );
                return d;
            }
            function changeFileLang(docId, languages) {
                var d = jQuery.Deferred();
                Visualforce.remoting.Manager.invokeAction(
                    "{!$RemoteAction.SupportCommunityKnowledgeController.changeFileLang}",
                    JSON.stringify({ docId, languages }),
                    function(result, event) {
                        if (event.status) {
                            d.resolve(result);
                        } else {
                            d.reject();
                            console.error(event.message);
                        }
                    },
                    { escape: true }
                );
                return d;
            }
            function getRemove(docid) {
                var d = jQuery.Deferred();
                SupportCommunityKnowledgeController.removeFileFromArticle(
                    articleId,
                    docid,
                    function(result, event) {
                        if (event.status) {
                            d.resolve(result);
                        } else {
                            d.reject();
                            console.error(event.message);
                        }
                    },
                    { escape: true }
                );
                return d;
            }
            function getBase64(file) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.readAsDataURL(file);
                    reader.onload = function() {
                        resolve(this.result);
                        reader.onerror = error => reject(error);
                    };
                });
            }
            function removeFile(id) {
                if (confirm("Are you sure you want to delete this file?")) {
                    getRemove(id)
                        .done(function(e) {
                            jQuery('.file[data-id="' + id + '"]').remove();
                            checkToPublish();
                        })
                        .fail(function(e) {
                            console.error(e);
                            checkToPublish();
                            alert("Remove error!");
                        });
                }
            }
            function clickLang(langs, docId) {
                jQuery(".loading").removeClass("hide");
                changeFileLang(docId, langs).then(function(data) {
                    if (data === false) {
                        console.error("change file lang failed!");
                        alert("Change language error!");
                    }
                    jQuery(".loading").addClass("hide");
                });
            }
            function FileEl(file) {
                var el = jQuery("<div>").addClass("file");
                if (file.IsPublished__c) el.addClass("published");
                var sharedIcon = jQuery(
                    '<svg aria-hidden="true" title="Published" data-prefix="fas" data-icon="users" class="shared" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><path fill="currentColor" d="M96 224c35.3 0 64-28.7 64-64s-28.7-64-64-64-64 28.7-64 64 28.7 64 64 64zm448 0c35.3 0 64-28.7 64-64s-28.7-64-64-64-64 28.7-64 64 28.7 64 64 64zm32 32h-64c-17.6 0-33.5 7.1-45.1 18.6 40.3 22.1 68.9 62 75.1 109.4h66c17.7 0 32-14.3 32-32v-32c0-35.3-28.7-64-64-64zm-256 0c61.9 0 112-50.1 112-112S381.9 32 320 32 208 82.1 208 144s50.1 112 112 112zm76.8 32h-8.3c-20.8 10-43.9 16-68.5 16s-47.6-6-68.5-16h-8.3C179.6 288 128 339.6 128 403.2V432c0 26.5 21.5 48 48 48h288c26.5 0 48-21.5 48-48v-28.8c0-63.6-51.6-115.2-115.2-115.2zm-223.7-13.4C161.5 263.1 145.6 256 128 256H64c-35.3 0-64 28.7-64 64v32c0 17.7 14.3 32 32 32h65.9c6.3-47.4 34.9-87.3 75.2-109.4z"></path></svg>'
                );
                var title;
                var remove;
                var langsEl;
                if (file.IsError) {
                    el.addClass("error");
                    title = jQuery("<span>").text(file.FileTitle__c || "Unnamed file");
                    el.click(function() {
                        jQuery(this).remove();
                    });
                } else {
                    title = jQuery("<a>")
                        .text(file.FileTitle__c || "Unnamed file")
                        .attr("href", file.DistributionUrl__c || "#")
                        .attr("target", "blank_");
                }
                langsEl = jQuery('<div class="file_langs"></div>');
                var fileLangs = file.Language__c;
                if (!fileLangs) {
                    fileLangs = langs.map(function(item) {
                        return item.val;
                    });
                } else {
                    fileLangs = fileLangs.split(";");
                }
                for (var i = 0; i < langs.length; i++) {
                    const active =
                        fileLangs.filter(function(item) {
                            return item === langs[i].val;
                        }).length > 0
                            ? "active"
                            : "";
                    var langEl = jQuery(
                        '<span class="' + active + '" title="' + langs[i].help + '">' + langs[i].title + "</span>"
                    );
                    langEl.data("val", langs[i].val);
                    langEl.data("docId", file.DocumentId__c);
                    langEl.click(function() {
                        jQuery(this).toggleClass("active");
                        const langs = jQuery
                            .makeArray(
                                jQuery(this)
                                    .parent()
                                    .children("span.active")
                                    .map(function() {
                                        return jQuery(this).data("val");
                                    })
                            )
                            .join(";");
                        if(langs.length > 0) {
                            clickLang(langs, jQuery(this).data("docId"));
                        } else {
                            jQuery(this).addClass("active");
                            alert("At least one language must be selected.");
                        }
                    });
                    langsEl.append(langEl);
                }
                remove = jQuery(
                    '<div class="file_remove"><button class="slds-button slds-button_icon" title="Remove file"><svg aria-hidden="true" class="slds-button__icon"><use xlink:href="/_slds/icons/utility-sprite/svg/symbols.svg#close"></use></svg><span class="slds-assistive-text">Remove</span></button></div>'
                );
                remove.data("docId", file.DocumentId__c);
                el.attr("data-id", file.DocumentId__c);
                remove.click(function() {
                    removeFile(jQuery(this).data("docId"));
                });
                el.append(sharedIcon)
                    .append(title)
                    .append(langsEl)
                    .append(remove);
                return el;
            }
            function loadFileList(Files) {
                var list = jQuery(".file_list");
                list.empty();
                for (var i = 0; i < Files.length; i++) {
                    list.append(FileEl(Files[i]));
                }
                checkToPublish();
            }
            function checkToPublish() {
                if (jQuery(".file_list .file:not(.published)").filter(":not(.error)").length > 0)
                    jQuery("#publish").removeProp("disabled");
                else jQuery("#publish").prop("disabled", "disabled");
            }
            function updatePrgogress(num) {
                const len = files.length;
                if (len === 0) return null;
                jQuery(".slds-assistive-text").text("Progress: " + num + "/" + len);
                var proc = Math.round((num * 100) / len);
                if (proc > 100) proc = 100;
                if (proc > 0) proc = proc + "%";
                jQuery(".slds-progress-bar__value").width(proc);
            }
            var fileId = 0;
            jQuery(document).ready(function() {
                const hash = document.location.hash;
                if (hash.length > 1) {
                    articleId = hash.slice(1);
                }
                if (articleId.length === 0) {
                    jQuery(".slds-notify_alert").show();
                    jQuery(".wrapper > .slds-card").hide();
                } else {
                    initArticle().then(function(data) {
                        jQuery(".spinner").hide();
                        jQuery("#articleTitle")
                            .text(data.Article.Title)
                            .attr("href", "/" + data.Article.Id);
                        loadFileList(data.Docs || []);
                        jQuery(".wrapper > .slds-card").show();
                        var fileInput = jQuery('.chooseFileContainer input[type="file"]');
                        jQuery("#send").click(function() {
                            let filesProp = fileInput.prop("files");
                            files = [];
                            for (var i = 0; i < filesProp.length; i++) {
                                var file = filesProp[i];
                                if (file.size > MAX_FILE_SIZE * 1024 * 1024) {
                                    fileInput.val(null);
                                    files = [];
                                    jQuery("#send").prop("disabled", "disabled");
                                    alert("Error. Max file size must be " + MAX_FILE_SIZE + " Mb");
                                    break;
                                } else {
                                    jQuery(".loading").removeClass("hide");
                                    files.push(file);
                                }
                            }
                            if (files.length > 0) {
                                if (files.length > 1) jQuery(".loading").addClass("multi");
                                else jQuery(".loading").removeClass("multi");
                                uploadFile(true);
                            }
                        });
                        jQuery("#publish").click(function() {
                            Publish().then(function(data) {
                                if (data.success) {
                                    jQuery(".file_list .file").addClass("published");
                                } else {
                                    alert("Publish error!\nPlease try again later.");
                                }
                                checkToPublish();
                            });
                        });
                        fileInput.change(function(e) {
                            var fileLen = jQuery('.chooseFileContainer input[type="file"]').prop("files").length;
                            if (fileLen) jQuery("#Selected").text("Selected " + fileLen + " file(s)");
                            else jQuery("#Selected").text("");
                            jQuery("#send").removeProp("disabled");
                        });
                    });
                }
            });
            function uploadFile(clear) {
                if (clear) fileId = 0;
                updatePrgogress(fileId);
                const filename = files[fileId].name;
                getBase64(files[fileId]).then(function(result) {
                    result = result.split(",")[1];
                    saveFile(filename, result);
                });
            }

            function saveFile(fileName, base64content) {
                var path = "/services/data/v44.0";
                return conn
                    .requestPost(path + "/composite/", {
                        allOrNone: true,
                        compositeRequest: [
                            {
                                method: "POST",
                                url: path + "/sobjects/ContentVersion",
                                referenceId: "newFile",
                                body: {
                                    Title: fileName,
                                    PathOnClient: fileName,
                                    VersionData: base64content
                                }
                            }
                        ]
                    })
                    .then(function(response) {
                        var contentVersionId = null;
                        for (var i = 0; i < response.compositeResponse.length; i++) {
                            if (response.compositeResponse[i].referenceId === "newFile") {
                                contentVersionId = response.compositeResponse[i].body.id;
                                break;
                            }
                        }
                        if (contentVersionId) {
                            SupportCommunityKnowledgeController.addFileToArticle(articleId, contentVersionId, function(
                                result,
                                event
                            ) {
                                if (result && result.success === true) {
                                    jQuery(".file_list").append(FileEl(result.doc));
                                    jQuery('.chooseFileContainer input[type="file"]').val(null);
                                    jQuery("#send").prop("disabled", "disabled");
                                    if (files.length > fileId + 1) {
                                        fileId++;
                                        uploadFile(false);
                                    } else {
                                        checkToPublish();
                                        jQuery('.chooseFileContainer input[type="file"]').val(null);
                                        jQuery(".loading").addClass("hide");
                                    }
                                } else {
                                    jQuery(".file_list").append(
                                        FileEl({ Id: 0, DocumentId__c: 0, FileTitle__c: fileName, IsError: true })
                                    );
                                    jQuery(".loading").addClass("hide");
                                }
                            });
                        }
                    })
                    .catch(function(err) {
                        console.error(err);
                        jQuery(".file_list").append(
                            FileEl({ Id: 0, DocumentId__c: 0, FileTitle__c: fileName, IsError: true })
                        );
                        jQuery(".loading").addClass("hide");
                    });
            }
        </script>
    </head>
    <body style="height: 100vh;">
        <div class="slds-scope slds-scope_my">
            <div class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_error" role="alert" style="display: none;">
                <span class="slds-assistive-text">error</span>
                <span class="slds-icon_container slds-icon-utility-error slds-m-right_x-small" title="Error">
                    <svg class="slds-icon slds-icon_x-small" aria-hidden="true">
                      <use xlink:href="/_slds/icons/utility-sprite/svg/symbols.svg#error"></use>
                    </svg>
                </span>
                <h2>Article not found!</h2>
                <div class="slds-notify__close">
                    <button class="slds-button slds-button_icon slds-button_icon-small slds-button_icon-inverse" title="Close">
                        <svg class="slds-button__icon" aria-hidden="true">
                            <use xlink:href="/_slds/icons/utility-sprite/svg/symbols.svg#close"></use>
                        </svg>

                    </button>
                </div>
            </div>
            <div class="spinner">
                <div role="status" class="slds-spinner slds-spinner_large">
                    <span class="slds-assistive-text">Loading</span>
                    <div class="slds-spinner__dot-a"></div>
                    <div class="slds-spinner__dot-b"></div>
                </div>
            </div>
            <div class="wrapper">

                <article class="slds-card" style="display: none;">
                    <div class="slds-card__header slds-grid">
                        <header class="slds-media slds-media_center slds-has-flexi-truncate">
                            <div class="slds-media__figure">
                                <span class="slds-icon_container slds-icon-standard-account" title="file">
                                  <svg class="slds-icon slds-icon_small" aria-hidden="true">
                                    <use xlink:href="/_slds/icons/standard-sprite/svg/symbols.svg#file"></use>
                                  </svg>
                                  <span class="slds-assistive-text">files</span>
                                </span>
                            </div>
                            <div class="slds-media__body">
                                <h2 class="slds-card__header-title">
                                    <a id="articleTitle" href="">Article Title files</a>
                                    <div class="language"></div>
                                </h2>
                            </div>
                        </header>
                    </div>
                    <div class="slds-card__body slds-card__body_inner">
                        <span class="">Files list:</span>
                        <div class="file_list">
                        </div>
                    </div>
                    <footer class="slds-card__footer">
                        <div class="chooseFileContainer">
                            <div class="slds-form-element__control">
                                <div class="slds-file-selector slds-file-selector_files">
                                    <input class="slds-file-selector__input slds-assistive-text" type="file" id="file-upload-input-01" multiple="true" aria-labelledby="file-selector-primary-label file-selector-secondary-label" />
                                    <label class="slds-file-selector__body" for="file-upload-input-01" id="file-selector-secondary-label">
                                              <span class="slds-file-selector__button slds-button slds-button_neutral">
                                                <svg class="slds-button__icon slds-button__icon_left" aria-hidden="true">
                                                  <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="/_slds/icons/utility-sprite/svg/symbols.svg#upload" />
                                                </svg>Upload Files</span>
                                    </label>
                                </div>
                                <span id="Selected"></span>
                            </div>
                        </div>
                        <div class="send">
                            <button class="slds-button slds-button_brand" disabled="disabled" id="send">Upload</button>
                            <button class="slds-button slds-button_brand" disabled="disabled" id="publish">Publish</button>
                        </div>
                        <div class="loading hide">
                            <div class="slds-progress-bar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="25" role="progressbar">
                              <span class="slds-progress-bar__value" style="width: 0;">
                                <span class="slds-assistive-text">Progress: 0/1</span>
                              </span>
                            </div>
                            <div role="status" class="slds-spinner slds-spinner_medium">
                                <span class="slds-assistive-text">Loading</span>
                                <div class="slds-spinner__dot-a"></div>
                                <div class="slds-spinner__dot-b"></div>
                            </div>
                        </div>
                    </footer>
                </article>
            </div>
        </div>
    </body>
    </html>
</apex:page>