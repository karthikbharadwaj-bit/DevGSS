    <script>
        function getCookie (name) {
            var matches = document.cookie.match(new RegExp(
                "(?:^|; )" + name.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g, '\\$1') + "=([^;]*)"
            ));
            return matches ? decodeURIComponent(matches[1]) : undefined;
        }
        function linksHandler (link) {
            if (link.indexOf('/lc') >= 0) {
                var token = getCookie('apex__userToken');
                if (token) {
                    link.href = link.href + '/LMSSSOautorization?token=' + token;
                }
            }
            return true;
        }
    </script>

