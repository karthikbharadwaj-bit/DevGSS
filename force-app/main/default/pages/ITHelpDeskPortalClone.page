                    <!-- Articles -->
                    <apex:outputPanel id="articlepanel">
                        <div class="panel panel-default" id="HDarticlepanel">
                            <div class="panel-heading">
                                <div class="panel-title">
                                    <div class="row">
                                        <div class="col-xs-6">
                                            <a data-toggle="collapse" data-target="#collapseThree" href="#collapseThree"  id="HDpaneltext">Knowledge Articles</a>
                                        </div>
                                        <div class="col-xs-6 HDpager">
                                            <apex:outputText rendered="{!IF(articlePages > 1, true, false)}">
                                                <ul class="pagination pagination-sm">
                                                    <li class="{!IF(hasPrevArticles, '', 'disabled')}"><apex:commandLink action="{! getPrevArticles }" value="Prev" reRender="articlepanel"/></li>
