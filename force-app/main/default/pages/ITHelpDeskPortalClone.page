    <script type="text/javascript">
  
        $('#HDoutageslarge').readmore({
            speed: 75,
            collapsedHeight: 73,
            moreLink: '<a href="#" class="morelink">Show More</a>',
            lessLink: '<a href="#" class="morelink">Show Less</a>',
            embedCSS: true,
            blockCSS: 'display: block; width: 100%;',
            startOpen: false
        });

        $('#HDoutagessmall').readmore({
            speed: 75,
            collapsedHeight: 70,
            moreLink: '<a href="#" class="morelink">Show More</a>',
            lessLink: '<a href="#" class="morelink">Show Less</a>',
            embedCSS: true,
            blockCSS: 'display: block; width: 100%;',
            startOpen: false
        });

        function noenter(ev)  {
            var val = $('j_id0:j_id6:HDinputbox').val();
            keycode = window.event.keyCode;
            if (window.event && ((keycode > 47 && keycode < 91) || keycode == 8)) {
                setTimeout(function(){
                    if ($('j_id0:j_id6:HDinputbox').val() == val) {
                        gosearch();
                        return false;
                    };
                }, 500)
            } else if (keycode == 13){
                gosearch();
                return false;
            } else {
                return true;
            }
        }
        
        document.getElementById("purchaseticket").onclick = function () {
            location.href = "{!$Site.BaseUrl}/../helpdesk/apex/purchasecase";
        };
        
    </script>
</apex:page>