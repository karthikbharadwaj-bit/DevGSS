                    size: A4 potrait;
                    margin-bottom: 4cm;
                    @top-left {
                    content : element(header);
                    }
                    @bottom-left {
                    content: element(footer);
                    }
                    }
                </style>
            </apex:variable>
            <apex:variable var="test2" value="test2" rendered="{!and(objPartnerQuotePDF.quoteRec.Opportunity__r.Brand_Name__c == 'Avaya Cloud Office',
