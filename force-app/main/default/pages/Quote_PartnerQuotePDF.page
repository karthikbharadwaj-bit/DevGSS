                                url="{!If(objPartnerQuotePDF.quoteRec.Opportunity__r.Brand_Name__c == 'Avaya Cloud Office',$Resource.Avaya_RC_Logo,If(objPartnerQuotePDF.quoteRec.Opportunity__r.Brand_Name__c == 'Unify Office',$Resource.Atos_Logo_v2,If(objPartnerQuotePDF.quoteRec.Opportunity__r.Brand_Name__c == 'RingCentral',$Resource.InternalRC_Logo,If(objPartnerQuotePDF.quoteRec.Opportunity__r.Brand_Name__c == 'RingCentral Canada',$Resource.InternalRC_Logo,If(objPartnerQuotePDF.quoteRec.Opportunity__r.Brand_Name__c == 'RingCentral UK',$Resource.InternalRC_Logo,If(objPartnerQuotePDF.quoteRec.Opportunity__r.Brand_Name__c == 'RingCentral EU',$Resource.InternalRC_Logo,If(objPartnerQuotePDF.quoteRec.Opportunity__r.Brand_Name__c == 'RingCentral AU',$Resource.InternalRC_Logo,'')))))))}"
                                />
                </apex:variable>
            
                <apex:variable var="test4" value="test4" rendered="{!objPartnerQuotePDF.quoteRec.Opportunity__r.Brand_Name__c == 'Rainbow Office'}">
