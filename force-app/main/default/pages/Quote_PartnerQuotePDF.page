        <style>
            .watermark {
                    background-repeat: repeat;
                    background-image: url("{!URLFOR($Resource.BudgetaryWaterMark)}");
                    background-size: 300px 100px;
            }
            
            div.footer {
                display: block;
                padding: 5px;
                position: running(footer);
            }
            
            div.subfooter {
                display: inline-block;
            }
            
            div.right {
                float: right;
            }
            
            #quoteTb {
              border-collapse: collapse;
              width: 100%;
            }
            
            #quoteTb td, #quoteTb th {
              border: 1px solid #ddd;
              padding: 8px;
            }
            
            body { 
            font-family: 'SansSerif'; 
            font-size:9pt;
            }
            .smallText{
            font-size:12pt;
            }
            .page-break {
            display:block;
            page-break-after:always;
            }
            .header{
            font-weight:bold;
            /*background-color:#B8B8B8;*/
            }
            .subHeader{
            font-weight:bold;
            background-color:#E6E6E6;
            }
            .fontCourier{
            font-family: 'Courier';
            }
            
            div.footer {
                display: block;
                padding: 5px;
                position: running(footer);
            }
            div.footerpageCount {
                display: block;
                padding: 5px;
                position: running(footerpageCount);
            }
            
            .pagenumber:before {
                content: counter(page);
            }
            .pagecount:before {
                content: counter(pages);
            }
            
            .avaya {
                color:red;
            }
            .atos {
                color:rgb(0, 102, 161);
            }
            .rainbowoffice {
                color:#573393;
            }
            /* Longform quotes chages - starts */
            .longformbody { 
