<apex:page standardController="Account"
           extensions="NdaPdfPreviewControllerExtension"
           showHeader="false"
           sidebar="false"
           applyBodyTag="false"
           title="NDA PDF Page">
    <title>NDA PDF Page</title>
    <head>
        <apex:slds />
        <apex:includeLightning />
        <c:HerokuScripts />
    </head>

    <body class="slds-scope">
        <div id="nda-pdf">
        <apex:outputPanel rendered="{!showError}">
            <div style="height:24rem">
                <section role="alertdialog" tabindex="0" aria-labelledby="prompt-heading-id" aria-describedby="prompt-message-wrapper" class="slds-modal slds-fade-in-open slds-modal_prompt" aria-modal="true">
                    <div class="slds-modal__container">
                        <header class="slds-modal__header slds-theme_error slds-theme_alert-texture">
                            <h2 class="slds-text-heading_medium" id="prompt-heading-id">Error</h2>
                        </header>
                        <div class="slds-modal__content slds-p-around_medium" id="prompt-message-wrapper">
                            <p>
                                {!errorMessage}
                            </p>
                        </div>
                        <footer class="slds-modal__footer slds-theme_default">
                            <button class="slds-button slds-button_neutral" onclick="goBack()">Go back</button>
                        </footer>
                    </div>
                </section>
                <div class="slds-backdrop slds-backdrop_open"></div>
            </div>
        </apex:outputPanel>

        <!-- Application container -->
        <apex:outputPanel rendered="{!!showError}">
            <div id="angular" class="slds-scope"></div>
        </apex:outputPanel>

        <!-- Hidden fields to get values without query -->
        <apex:outputText value="{!account.RC_Brand__c} {!account.BillingCountry}" rendered="false"/>
        </div>
    </body>

    <style>
        #nda-pdf {
            height: 100%;
        }
    </style>

    <!-- Scripts -->
    <script type="text/javascript">
        const errors = '{!showError}';

        if (errors === 'false') {
            const herokuEndpoint = '{!JSENCODE(billingWizardURL)}';
            const sessionId = '{!sId}';
            const origin = '{!JSENCODE(origin)}';
            const accountId = '{!account.Id}';
            const vfOrigin = window.location.origin;
            const billingCountry = '{!account.BillingCountry}';
            const brand = '{!account.RC_Brand__c}';

            const angular = document.createElement('app-root');
            angular.routeParams = {
                name: 'nda-pdf',
                data: {
                    billingParams: {
                        herokuEndpoint,
                        sessionId,
                        origin,
                        accountId,
                        vfOrigin
                    },
                    billingCountry,
                    brand
                }
            };
            document.getElementById('nda-pdf').appendChild(angular);
        }
        function goBack() {
            window.history.back();
        }
    </script>
</apex:page>