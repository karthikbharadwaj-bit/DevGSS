<apex:page controller="USCareerDashboardPopupController" sidebar="false" showheader="false">
  <apex:form id="form" >  
        
     <div style="width 100%">
        <apex:pageBlock >
        <apex:pageBlockTable value="{!CLogs}" var="CLog">
                  <apex:column value="{!CLog.Coaching_Date__c}"/>
                  <apex:column value="{!CLog.ASP1__c}"/>
                  <apex:column >
                  <apex:facet name="header">CLOSE RATE %</apex:facet>
                        {!CLog.CLOSE_RATE__c}%
                  </apex:column> 
                  <apex:column value="{!CLog.UPSELL__c}"/>
                  <apex:column >
                  <apex:facet name="header">BOOKINGS QUALITY %</apex:facet>
                        {!CLog.BOOKINGS_QUALITY_TARGET__c}%
                  </apex:column> 
                  <apex:column >
                  <apex:facet name="header">NET BOOKINGS %</apex:facet>
                        {!CLog.NETBOOKINGS_MTD_TARGET__c}%
                  </apex:column> 
        </apex:pageBlockTable>
        </apex:pageBlock>
          
       
        
    
     </div>
   </apex:form>
</apex:page>