    <script>
        //-------------------------------------------Implementation details Javascript starts------------------------------------

        //-----------------------getting all Call flow models and features dependency json from controller-------------
        var controllerList  = jQuery.parseJSON( '{!getDependencyList}');
        var objName = '{!objName}';
        //------------------------------function to create dependency and binding event on page level--------------------
        function createDependency(modelValue){
            $('.jsDependentClass').find('select,input,textarea').prop('disabled',false);
            var jsonObj = [];
            var itemObj = {};
            $('.jsDependentClass input:checkbox').each(function() {
                var id = $(this).attr("id");
                var value = $(this).val();
                itemObj = {};
                itemObj['key'] = value;
                itemObj['id'] = id;
                jsonObj.push(itemObj);
            });
            var childArray =  (controllerList[modelValue]).childList;
            for(j in jsonObj){
                $( document.getElementById(jsonObj[j].id) ).prop( "checked", false );
                for(var i in childArray){
                    if(jsonObj[j].key == childArray[i]){
                        $( document.getElementById(jsonObj[j].id) ).prop( "checked", true );
                     }
                }
            }
        }
        //-------------------------------------------Implementation details Javascript ends------------------------------------

        //-------------------------------------------Discovery guide related javascript starts---------------------------------
        //--------------------------------------Function to initiate tab nature-------------------------------------------
        function initiateTabs(tabWrapper,options){
            var optionsJson = jQuery.parseJSON(options);
            if(optionsJson.activeTab != null){
                $(tabWrapper).children('.tabdiv').hide().eq(optionsJson.activeTab).show();
            }
            else{
                $(tabWrapper).children('.tabdiv').hide().eq(0).show();
            }
        };
        //-------------------------------------Function to check and show errors in discovery tab-------------------------
        function CheckErrorTabs(){

            $.each($(".box-wrap").children(".tabdiv"),function(){
                 var parent = $(this);
                $(this).find(".errorMsg").filter(function(){

                        $(".box-wrap").siblings("ul").find("li[id*="+parent.attr('id')+"]").each(function(){
                             $(this).addClass("errorTab");
                        //     alert($(this).attr("id"));

                        });
                    });
            });
            $.each($(".box-wrapEdit").children(".tabdiv"),function(){
                 var parent = $(this);
                $(this).find(".errorMsg").filter(function(){

                        $(".box-wrapEdit").siblings("ul").find("li[id*="+parent.attr('id')+"]").each(function(){
                             $(this).addClass("errorTab");
                        //     alert($(this).attr("id"));

                        });
                    });
            });
        };
        //sets given value to the given element. Needed to dynamically change text from current situation inputTextarea on Sum page to current situation inputTextarea on current situation page.
        function setValToElement(value, field) {
          $(field).val(value);
        }
        //-------------------------------------Function to check and show errors in discovery tab-------------------------
        //-------------------------------------Function to check length of field on page level----------------------------
        function TextAreaLengthCheck(areaId,FieldName,validlength){
            $(areaId).keyup(function () {
                var maxLength = validlength;
                var text = $(this).val();
                var textLength = text.length;
                if (textLength > maxLength) {
                    $(this).val(text.substring(0, (maxLength)));
                    alert("Sorry, you are only " + maxLength + " characters allowed for "+FieldName);
                }
                else {
                    //alert("Required Min. 500 characters");
                }
            });
        };
        //-------------------------------------------Discovery guide related javascript ends----------------------------------

        <!-- ---------------------As/Simplion/6/20/2014/start--------------- -->
        function ImplementationView(){

                  if(objName == 'Implementation__c'){

                    $("#CustomerProile,#NewLeadQualificationSection, .NewDiscoverySection, #CustomerPro, #CustomerPro2, #SDRInfoView, #SDRInfo, #LeadQualPanel1, #LeadQualPanel2").hide();

                  }
        }
        <!-- ---------------------As/Simplion/6/20/2014/ends--------------- -->

        function showOverlay() {
            var o = document.getElementById('overlay');
            o.style.visibility = 'visible';
        }
        function hideOverlay() {
            var o = document.getElementById('overlay');
            o.style.visibility = 'hidden';
        }
    </script>
    <script type="text/javascript">

        window.captureEvents(Event.KEYPRESS);
        window.onkeypress = Ausgabe;

        function Ausgabe(Ereignis) {
        if(Ereignis.which == 13 && document.activeElement.tagName!='TEXTAREA'){
                SonE();
            }
        }

        function checkLength(control, maximum, e) {
            var keycode;
            if (window.event) keycode = window.event.keyCode;
            else if (e) keycode = e.which;
            if(keycode != 8) {
                var length = control.value.length;
                if (e.keyCode == 32 && (length >= maximum)) {
                    e.preventDefault();
                } else {
                    if (length >= maximum) {
                        alert('Please limit your value to '+ maximum + ' characters. There are currently ' + length + ' characters.');
                        return false;
                    }
                    return true;
                }
            }
        }
        function showDecMaker(maincls,hiddenpanel) {
            var display = 'none';
            if($('select.'+maincls+' option:selected').val() == 'No') {
                display = 'block';
            }
            $('.'+hiddenpanel).each(function() {
                $(this).css('display',display);
            });
        }
    </script>

