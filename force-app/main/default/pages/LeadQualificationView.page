  <script>
        var toshowViewMode = 'true';
        var prevselected;
        $(document).ready(function() {
            $("table tr td input[name=LQSelection]:radio").click(function(srcc) {
                try {
                    if(toshowViewMode == 'false') {

                    } else {
                        $(".inputselect").closest('tr').css('background-color', 'transparent');
                        $(this).closest('tr').css('background-color', '#F0F0F0');
                    }
                } catch(e) {alert(e);}
            });
        });
        function selectRow() {
            var selectedVal = '{!selectedLeadQual}';
            $("table tr td input[name=LQSelection]:radio").each(function() {
                if(selectedVal != "" && $(this).val() != "") {
                    if(selectedVal == $(this).val()) {
                        prevselected = $(this).val();
                        $(this).attr("checked",true);
                        $(this).closest('tr').css('background', '#F0F0F0');
                    }
                }
            });
        }
        selectRow();

        function loadLeadQualDet(id) {
            if(toshowViewMode == 'false') {

                var isConfirm = confirm('Do you really want to continue without saving changes?');
                if(isConfirm) {
                    toshowViewMode = 'true';
                    prevselected = $("table tr td input[name=LQSelection]:radio:checked").val();
                    loadLeadQualDet1(id);
                } else {
                   document.getElementById(prevselected).checked = true;
                }
            } else {
                prevselected = $("table tr td input[name=LQSelection]:radio:checked").val();
                toshowViewMode = 'true';
                loadLeadQualDet1(id);
            }
        }

        function backClorRowIE() {
            //alert(1);
            $(".inputselect").closest('tr').css('background-color', 'transparent');
            var selRow = 'tr'+ prevselected;
            document.getElementById(selRow).style.background = '#F0F0F0';
        }

        function EditMode() {
            toshowViewMode = 'false';
            EditMode1();
        }

        function SaveLeadQ() {
            if ('{!isInsideSalesProfile}' === 'true') {
                const requiredFields = document.getElementsByClassName('required');
                let isChecked = true;

                if (requiredFields && requiredFields.length) {
                    for (let field of requiredFields) {
                        let fieldValue = field.value.replace(/\s+/g, '');
                        if (!fieldValue) {
                            const height = field.style.height;
                            field.style.cssText = `border: 3px solid red !important; height: ${height};`;
                            isChecked = false;
                        } else {
                            const height = field.style.height;
                            field.style.cssText = `border: 1px solid lightgray !important; height: ${height};`;
                        }
                    }
                }
                if (!isChecked) {
                    alert('Please populate all required fields.');
                    return false;
                }
            }
            toshowViewMode = 'true';
            SaveLeadQ1();
        }

        function CancelLeadQual() {
            if(toshowViewMode == 'false') {
                var isConfirm = confirm('Do you really want to continue without saving changes?');
                if(isConfirm) {
                    toshowViewMode = 'true';
                    CancelLeadQual1();
                }
            } else {
                toshowViewMode = 'true';
                CancelLeadQual1();
            }
        }

        const addFieldClass = () => {
            if ('{!isInsideSalesProfile}' === 'true') {
                const requiredFields = document.getElementsByClassName('required');
                if (requiredFields && requiredFields.length) {
                    for (let field of requiredFields) {
                        field.classList.add('requiredField');
                    }
                }
            }
        }
        addFieldClass();

        function sellingThroughCur(){
          initiateTabs('.box-wrap','{"activeTab" : 0}');
          $("#tabsItems").find("li").on('click',function(){
              var targetId = $(this).attr('id');
              $(".box-wrap").children('.tabdiv').hide();
              $(targetId).show();
              $(this).siblings().removeClass('tabActiveHeader');
              $(this).addClass('tabActiveHeader');
          });
          initiateTabs('.box-wrapEdit','{"activeTab" : 0}');
          $("#tabsItems").find("li").on('click',function(){
              var targetId = $(this).attr('id');
              $(".box-wrapEdit").children('.tabdiv').hide();
              $(targetId).show();
              $(this).siblings().removeClass('tabActiveHeader');
              $(this).addClass('tabActiveHeader');
          });

          CheckErrorTabs();
          <!-- ---------------------------------------------As/Simplion/7/3/2014-------------------- -->
          TextAreaLengthCheck('.discoveryNotes','Discovery Notes',32000);
          TextAreaLengthCheck('.discoveryNextStep','Next Step',32000);
          TextAreaLengthCheck('.notes','Manger Notes',32000);
          addFieldClass();
        }
        sellingThroughCur();

