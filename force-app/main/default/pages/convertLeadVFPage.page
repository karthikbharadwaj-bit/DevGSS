<apex:page id="page" controller="ConvertLeadOptimize" tabStyle="Lead" title="Convert Lead" action="{!validateLeadBeforeConversion}">
    <apex:includeScript value="{!URLFOR($Resource.jquery, 'js/jquery-1.4.2.min.js')}" />
    <apex:includeScript value="{!URLFOR($Resource.rcnotify, 'rcnotify.js')}" />
    <apex:includeScript value="{!$Resource.ConvertLeadVFPageDependencies + '/CLPage.js'}" />
    <script>
        function doSearchonChk(btnId)
        {
            var getFrmBtn = document.getElementById('page:j_id17:j_id18:j_id36:btnSearch');
            getFrmBtn.click();
        }

        function convertCallback(){
            convertBusy(true);
            createQuote();
        }

        function createQuoteCallback(){
            convertBusy(true);
            createAdditionalQuoteLineItems();
        }

        function convertBusy(isBusy){
            var buttons = document.getElementsByClassName('convertButton');
            for (var i = 0; i < buttons.length; i++) {
                if (isBusy) {
                    buttons[i].value = "Converting...";
                    buttons[i].disabled = true;

                    rcnotify.showSpinner();
                } else {
                    buttons[i].value = "Convert";
                    buttons[i].disabled = false;

                    rcnotify.hideSpinner();
                }
            }
        }
    </script>
    <style>
        #body .pbBody table.list tr.headerRow td, body .pbBody table.list tr.headerRow th {
            text-align: center !important;
        }
        .header {
            background: #E3F3FF !important;
            height:25px;
            text-align:center;
            border: none !important;
            border-bottom:1px solid #DBDBDB !important;
        }
        .rowData {
            height:25px;
            text-align:center;
            border: none !important;
        }
        .selectedRow {
            background:#F0F0F0;
        }

        /* Modified the code for case # 04534122 */
        .formLabel {
            font: Bold 16px arial;
            text-align: left;
            /*border: 2px solid steelblue;*/
            float: left;
            width: 38%;
            margin-left: 25%;
            margin-right: -10%;
        }

        .upperdiv {
            width: 100%;
            height: 60px;
            background-color: white;
            height: 60px;
            /*border: 1px solid black;*/
            padding-left: 20px;
            padding-right: 20px;
            /* margin-left: 21%; */
            box-shadow: 0px 0px 35px 5px lightgray inset;
            /*border-radius: 10px;*/
        }

        .lowerdiv {
            box-shadow: 0px -71px 101px -19px #C7D6E9 inset;
            background: #f8f8f8;
            outline: none;
            width: 100%;
            padding: 20px;
        }

        .menuOption {
            border: 1px solid steelblue;
            width: 60%;
            height: 30px;
            font: Bold 16px arial;
            padding-top: 10px;
            border-radius: 10px;
            box-shadow: 0px -4px 50px -2px lightblue inset;
            cursor: pointer;
            background-color: white;
        }

        .menuOption:hover {
            background-color: white;
            text-decoration: underline;
            box-shadow: 0px -4px 50px -2px #dbfdab inset;
            cursor: pointer;
        }

        .fancybox-close {
            position: absolute;
            top: 8px;
            right: -55px;
            width: 36px;
            height: 36px;
            cursor: pointer;
            z-index: 8040;
        }

        .requiredfield {
            width: 3px;
            height: 21px;
            background: #F00;
            /* padding-top: 0px; */
            float: left;
            margin-top: 2px;
            margin-right: 2px;
        }

        .msgPanelCls {
            height: 30px;
            width: auto;
            border: 1px solid #3399FF;
            padding: 2px;
            background: #FFFFCC;
            font-weight: bolder !important;
            border-radius: 5px;
        }
        .datePicker {
            z-index: 99999 !important;
            position:fixed !important;
        }
        .message .messageText h4 {
            display: none !important;
        }
        .message.errorM3 {
            text-align:left !important;
        }
        .internal {
            width: 100%;
            border: 1px solid lightblue;
            height: 290px;
            vertical-align: middle;
            background: black;
            opacity: 0.6;
            /* Generic for Major browsers */
            -ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=60)";
            /* IE 5-7 */
            filter: alpha(opacity=60);
            /* Netscape */
            -moz-opacity: 0.6;
            /* Safari 1.x */
            -khtml-opacity: 0.6;
            border-radius: 4px;
            -webkit-border-radius: 4px;
            -moz-border-radius: 4px;
            position: absolute;
            top: 85px;
            color: white;
        }
        .internalmsg {
            margin-top: 18%;
            font-weight: bolder;
            font-size: 20px;
        }
        .helpText {
            z-index: 999999;
        }
        .shadow {
            top:25px;
            background-color: #c6c0c0;
            height: 335px;
            opacity:0.65;
            width: 100%;
            padding: 20px;
        }
        .waitingHolder {
            right: 30px;
        }
        .backgroundShadow {
            background: lightslategray;
            opacity: 0.75;
            position: absolute;
            top: 0;
            width: 100%;
            z-index: 9999;
            height:100%;
        }
        .textAlignLeft {
            text-align: left;
        }
    </style>
    <apex:sectionHeader title="Convert Lead"/>
    <apex:pageMessage severity="error" strength="3" title="Error" rendered="{!multipleSelected}">
        You can only select ONE account to merge into.
    </apex:pageMessage>

    <div style="display: none;">
        <apex:form id="fakeInput">
            <!-- Fake input to get picklist values from SF -->
            <apex:inputField value="{!leadObj.Lead_Brand_Name__c}" id="LeadBrandField"/>
            <apex:inputField value="{!leadObj.Lead_Tier_Name__c}" id="LeadProductField"/>
            <apex:inputField value="{!leadObj.RC_Edition__c}" id="LeadEditionField"/>
            <apex:inputField value="{!leadObj.RC_Term__c}" id="LeadTermField"/>
        </apex:form>
    </div>
    <!-- get all picklist values by record type -->
    <script>
        var LeadBrandOptions = CLPage.getPicklistOptions('{!$Component.fakeInput.LeadBrandField}').values;
        var LeadProductOptions = CLPage.getPicklistOptions('{!$Component.fakeInput.LeadProductField}').values;
        var LeadEditionOptions = CLPage.getPicklistOptions('{!$Component.fakeInput.LeadEditionField}').values;
        var LeadTermOptions = CLPage.getPicklistOptions('{!$Component.fakeInput.LeadTermField}').values;
        window.setTimeout(function() { setParams(JSON.stringify(LeadBrandOptions),JSON.stringify(LeadProductOptions),JSON.stringify(LeadEditionOptions),JSON.stringify(LeadTermOptions)); }, 1);
    </script>
    <!--set values for controller variables -->
    <apex:form >
        <apex:actionRegion >
            <apex:actionFunction action="{!setParams}" name="setParams" rerender="popuppanel">
                <apex:param name="brandValues" assignTo="{!brandValues}" value="" />
                <apex:param name="productValues" assignTo="{!productValues}" value="" />
                <apex:param name="editionValues" assignTo="{!editionValues}" value="" />
                <apex:param name="termValues" assignTo="{!termValues}" value="" />
            </apex:actionFunction>
        </apex:actionRegion>
    </apex:form>
    <apex:form id="popuppanel">
        <apex:actionFunction action="{!createQuote}" name="createQuote" oncomplete="convertBusy(false);createQuoteCallback();" status="convertStatus" />
        <apex:actionFunction action="{!createAdditionalQuoteLineItems}" oncomplete="convertBusy(false)" name="createAdditionalQuoteLineItems" status="convertStatus" />
        <apex:outputpanel id="convertBlock" rendered="{!showMandatoryFieldPanel}">
            <div class="backgroundShadow"></div>
            <apex:outputPanel rendered="true" style="position: fixed;z-index: 99999;top: 15%;left: 20%;width: 70%;" id="main">
                <div class="upperdiv" align="center">
                    <p style="font:Bold 25px arial; padding-top:12px;">Convert Lead</p>
                </div>
                <div class="lowerdiv" align="center" id="menu">
                    <div style="width:100%;">
                        <div class="msgPanelCls">
                            <div style="float:left;">
                                <apex:image style="vertical-align:middle; width:27px; height:26px;margin-top: 2px;" url="/s.gif"/>
                            </div>
                            <div style="float:left;margin-top:6px;">
                                <apex:outputpanel style="vertical-align:middle; color: red; font: 12px arial; padding:2px;" id="errorForm" >{!impErrorMsg}</apex:outputpanel>
                            </div>
                        </div>
                    </div>
                    <p/>
                    <div class="formLabel textAlignLeft">Forecasted Users</div>
                    <div class="textAlignLeft">
                        <div class="requiredfield"/>
                        <apex:inputField value="{!leadObj.Number_of_Users__c}" id="forecastedUser"
                                         required="{!IF((brand == "BT Business"), 'false', 'true')}" style="width:21%;"/>
                    </div>
                    <p/>
                    <!-- Added the code for case # 04534122 -->
                    <div class="formLabel textAlignLeft">Forecasted Contact Center Users</div>
                    <div class="textAlignLeft">
                        <div class="requiredfield"/>
                        <apex:inputField value="{!leadObj.Forecasted_Contact_Center_Users__c}" id="forecastedCCUser" required="true" style="width:21%;"/>
                    </div>
                    <p/>
                    <div class="formLabel">RC Brand</div>
                    <div class="textAlignLeft">
                        <div class="requiredfield"/>
                        <apex:actionRegion >
                            <apex:selectList value="{!brand}" multiselect="false" size="1">
                                <apex:actionSupport event="onchange" reRender="cterm, edition, product, test, testBrand, forecastedUser" status="actStatusBrand"/>
                                <apex:actionStatus id="actStatusBrand" >
                                    <apex:facet name="start" >
                                        <div class="waitingSearchDiv shadow">
                                            <div class="waitingHolder" >
                                                <img class="waitingImage" src="/img/loading.gif" />
                                                <span class="waitingDescription">Please wait...</span>
                                            </div>
                                        </div>
                                    </apex:facet>
                                </apex:actionStatus>
                                <apex:selectOptions value="{!BrandNames}">
                                </apex:selectOptions>
                            </apex:selectList>
                        </apex:actionRegion>
                    </div>
                    <p/>
                    <div class="formLabel">RC Product</div>
                    <div class="textAlignLeft">
                        <div class="requiredfield"/>
                        <apex:actionRegion >
                            <apex:selectList value="{!product}" multiselect="false" id="product" size="1" disabled="{!isProductDisabled}">
                                <apex:actionSupport event="onchange" reRender="edition, cterm" status="actStatusProduct"/>
                                <apex:actionStatus id="actStatusProduct" >
                                    <apex:facet name="start" >
                                        <div class="waitingSearchDiv shadow">
                                            <div class="waitingHolder" >
                                                <img class="waitingImage" src="/img/loading.gif" />
                                                <span class="waitingDescription">Please wait...</span>
                                            </div>
                                        </div>
                                    </apex:facet>
                                </apex:actionStatus>
                                <apex:selectOptions value="{!ProductNames}">
                                </apex:selectOptions>
                            </apex:selectList>
                        </apex:actionRegion>
                    </div>
                    <p/>
                    <div class="formLabel">RC Edition</div>
                    <div class="textAlignLeft">
                        <div class="requiredfield"/>
                        <apex:actionRegion >
                            <apex:selectList value="{!edition}" multiselect="false" id="edition" size="1" disabled="{!isEditionDisabled}">
                                <apex:selectOptions value="{!EditionNames}">
                                </apex:selectOptions>
                            </apex:selectList>
                        </apex:actionRegion>
                    </div>
                    <p/>
                    <div class="formLabel">RC Term</div>
                    <div class="textAlignLeft">
                        <div class="requiredfield"/>
                        <apex:selectList value="{!term}" multiselect="false" id="cterm" size="1" disabled="{!isTermDisabled}">
                            <apex:selectOptions value="{!TermNames}">
                            </apex:selectOptions>
                        </apex:selectList>
                    </div>
                    <p/>

                    <div class="internal backgroundShadow" id="internal" style="display:{!IF(showMandatoryFieldPanel,'none', 'block')}">
                        <div class="internalmsg">Please wait...</div>
                    </div>
                    <div style="height: 1%;">&nbsp;</div>
                    <div>
                        <apex:commandButton styleclass="btn" value="Continue" action="{!saveLeadBeforeConversion}" rerender="page" >
                            <apex:actionStatus id="counterStatus" onStart="rcnotify.showSpinner();" onstop="rcnotify.hideSpinner();"/>
                        </apex:commandButton>
                        <apex:commandButton styleclass="btn" value="Cancel" status="counterStatusNew" onclick="window.open('/{!leadObj.Id}','_self');return false;"/>
                    </div>
                </div>
                <a class="fancybox-item fancybox-close" href="/{!leadObj.Id}" title="Close"></a>

            </apex:outputPanel>
        </apex:outputpanel>

        <apex:pageBlock title="Initial Category is Blank" rendered="{!Initial_CategoryFlag}">
            <apex:pageMessage severity="info" strength="1">
                You are not allowed to convert this Lead because Initial Category is blank. Please select a Initial Category
            </apex:pageMessage>
            <apex:selectRadio value="{!initialCategory}" layout="pagedirection"
                              onclick="doSearchonChk('{!$Component.btnSearch}')">
                <apex:selectOptions value="{!listInitialCategoryItems}" />
            </apex:selectRadio>
            <apex:pageblockButtons >
                <apex:commandButton id="btnSearch" value="Search" action="{!updateLeadCategory}" style="display:none;"/>
            </apex:pageblockButtons>

        </apex:pageBlock>

        <apex:pageBlock title="Matching Accounts" >

            <apex:pageMessages id="pageMessages" escape="false"></apex:pageMessages>

            <apex:pageblockButtons >
                <apex:commandButton action="{!convertAndMerge}"
                                    value="Convert"
                                    rendered="{! !newModel }"
                                    status="convertStatus"
                                    styleClass="convertButton"
                                    rerender="pageMessages"
                                    onclick="convertBusy(true);"
                                    oncomplete="convertBusy(false);"/>
                <apex:commandButton action="{!convertAndMerge}"
                                    value="Convert"
                                    rendered="{! newModel }"
                                    status="convertStatus"
                                    styleClass="convertButton"
                                    rerender="pageMessages"
                                    onclick="convertBusy(true);"
                                    oncomplete="convertBusy(false);convertCallback();"/>
                <apex:commandButton action="{!URLFOR($Action.Lead.view, l.id)}"
                                    value="Cancel"
                                    immediate="true"/>
            </apex:pageblockButtons>
            <apex:pageMessage severity="info" strength="1" rendered="{!matchFound}">
                There are matching Accounts. Please select one below to merge your new Opportunity into.
            </apex:pageMessage>
            <apex:pageMessage severity="info" strength="1" rendered="{!matchNotFound}">
                There are no Accounts with matching contact phone or email data. Please select Create New.
            </apex:pageMessage>
            <apex:pageMessage severity="error" strength="1" rendered="{!notAnswered}">
                You must select a Account.
            </apex:pageMessage>




            <apex:pageBlockTable value="{!accounts}" var="a" id="table">
                <apex:column >
                    <!-- This is the selected Boolean property in the Wrapper class -->
                    <apex:inputCheckbox value="{!a.selected}"/>
                </apex:column>
                <apex:column >
                    <apex:facet name="header"><b>Account Name (Click to view in new tab)</b></apex:facet>
                    <apex:outputLink rendered="{!a.acc.Name != 'Create New'}" value="{!urlFor($Action.Account.View, a.acc.Id)}" target="_blank">
                        {!a.acc.Name}
                    </apex:outputLink>
                    <apex:outputText rendered="{!a.acc.Name == 'Create New'}" value="{!a.acc.Name}"/>
                </apex:column>
                <apex:column >
                    <apex:facet name="header"><b>Enterprise Account ID</b></apex:facet>
                    <apex:outputLink rendered="{!a.acc.Name != 'Create New'}" value="{!urlFor($Action.Account.View, a.acc.Id)}" target="_blank">
                        {!a.acc.RC_User_ID__c}
                    </apex:outputLink>
                </apex:column>
                <apex:column >
                    <apex:facet name="header"><b>RC Account Number</b></apex:facet>
                    <apex:outputLink rendered="{!a.acc.Name != 'Create New'}" value="{!urlFor($Action.Account.View, a.acc.Id)}" target="_blank">
                        {!a.acc.RC_Account_Number__c}
                    </apex:outputLink>
                </apex:column>
                <apex:column >
                    <apex:facet name="header"><b>RC Account Status</b></apex:facet>
                    <apex:outputLink rendered="{!a.acc.Name != 'Create New'}" value="{!urlFor($Action.Account.View, a.acc.Id)}" target="_blank">
                        {!a.acc.RC_Account_Status__c}
                    </apex:outputLink>
                </apex:column>
            </apex:pageBlockTable>             <BR/>
            <apex:outputLabel value="Select a known Account: " for="accountSelector"/>
            <apex:inputField id="accountSelector" value="{!l.Account__c}"/>
            <!--  <apex:inputField value="{!acct.Id}"/> -->
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<apex:outputLabel value="Create a new Account: " for="createNew"/>
            <apex:inputCheckbox id="createNew" value="{!createNew}"/>

            <br/><br/>
            <div style="width:100%;border-top: 1px solid #DBDBDB;height:15px;padding-bottom: 10px;padding-top: 10px;">
                <div class="pbTitle" style="padding: 0px">
                    <h2 class="mainTitle">Available Qualifications</h2>
                </div>
            </div>

            <div  id="listDiv">
                <apex:outputPanel rendered="{!if(wrLeadQualList.size>0,true,false)}">
                    <table cellspacing="0" cellpadding="0" style="width:100%;border:1px solid #DBDBDB !important;">
                        <thead>
                        <tr>
                            <th class="header" style="border-right:1px solid #DBDBDB !important;">Select</th>
                            <th class="header" style="border-right:1px solid #DBDBDB !important;">Lead Qualification</th>
                            <th class="header" style="border-right:1px solid #DBDBDB !important;">Lead</th>
                            <th class="header" style="border-right:1px solid #DBDBDB !important;">Account</th>
                            <th class="header" style="border-right:1px solid #DBDBDB !important;">Opportunity</th>
                            <th class="header" >Last Modified Date</th>
                        </tr>
                        </thead>
                        <tbody>
                        <apex:variable var="Index" value="1" />
                        <apex:variable var="bottomcss" value="border-bottom: 1px solid #DBDBDB !important;"/>
                        <apex:variable var="lastRow" value="border:1px solid #DBDBDB"/>
                        <apex:repeat var="o" value="{!wrLeadQualList}">
                            <tr class="{!IF(VALUE(Index) == 1, 'selectedRow', '')}">
                                <td class="rowData" style="border-right:1px solid #DBDBDB !important;{!IF(VALUE(Index) != wrLeadQualList.size, bottomcss, '')}">
                                    <input type="radio" Name="LQSelection" onchange="loadLeadQualDet('{!o.leadQualObj.Id}');" id="{!o.leadQualObj.Id}" class="inputselect" value="{!o.leadQualObj.Id}" /></td>
                                <td class="rowData" style="border-right:1px solid #DBDBDB !important;{!IF(VALUE(Index) != wrLeadQualList.size, bottomcss, '')}">
                                    <apex:outputLink value="/{!o.leadQualObj.Id}"  target="_blank">
                                        <apex:outputText value="{!o.leadQualObj.Name}"/>
                                    </apex:outputLink>&nbsp;
                                </td>
                                <td class="rowData" style="border-right:1px solid #DBDBDB !important;{!IF(VALUE(Index) != wrLeadQualList.size, bottomcss, '')}">
                                    <apex:outputLink value="{!if(Isblank(o.leadQualObj.Lead__c),o.leadQualObj.Lead__c,urlFor($Action.Lead.View, o.leadQualObj.Lead__c))}"  target="_blank">
                                        <apex:outputText value="{!o.leadQualObj.Lead__r.Name}"/>
                                    </apex:outputLink>&nbsp;
                                </td>
                                <td class="rowData" style="border-right:1px solid #DBDBDB !important;{!IF(VALUE(Index) != wrLeadQualList.size, bottomcss, '')}">
                                    <apex:outputLink value="{!if(Isblank(o.leadQualObj.Account__c),o.leadQualObj.Account__c,urlFor($Action.Account.View, o.leadQualObj.Account__c))}" target="_blank">
                                        <apex:outputText value="{!o.leadQualObj.Account__r.Name}"/>
                                    </apex:outputLink>&nbsp;
                                </td>
                                <td class="rowData" style="border-right:1px solid #DBDBDB !important;{!IF(VALUE(Index) != wrLeadQualList.size, bottomcss, '')}">
                                    <apex:outputLink value="{!if(Isblank(o.leadQualObj.Opportunity__c),o.leadQualObj.Opportunity__c,urlFor($Action.Opportunity.View, o.leadQualObj.Opportunity__c))}"  target="_blank">
                                        <apex:outputText value="{!o.leadQualObj.Opportunity__r.Name}"/>
                                    </apex:outputLink>&nbsp;
                                </td>
                                <td class="rowData" style="border-right:1px solid #DBDBDB !important;{!IF(VALUE(Index) != wrLeadQualList.size, bottomcss, '')}">
                                    <apex:outputText value="{!o.strformatDT}"/>
                                </td>
                            </tr>
                            <apex:variable var="Index" value="{!VALUE(Index)+1}" />
                        </apex:repeat>
                        </tbody>
                    </table>
                </apex:outputPanel>
                <apex:pageMessage summary="No Lead Qualifications." severity="info" strength="1"  rendered="{!if(wrLeadQualList.size>0,false,true)}"/>
            </div>
        </apex:pageBlock>
        <apex:actionSupport action="{!convert}"/>
        <br/>
        <apex:pageBlock title="Protected ActivePipe Opportunities">
            <apex:pageBlockTable value="{!Opportunities}" var="o" id="table1">
                <apex:column >
                    <apex:facet name="header"><b>Opportunity</b></apex:facet>
                    <apex:outputLink value="{!urlFor($Action.Opportunity.View, o.opportunity.Id)}" target="_blank">
                        {!o.oppName }
                    </apex:outputLink>
                </apex:column>
                <apex:column >
                    <apex:facet name="header"><b>Owner</b></apex:facet>
                    {!o.owner}
                </apex:column>
                <apex:column >
                    <apex:facet name="header"><b>Account</b></apex:facet>
                    {!o.accountName}
                </apex:column>
                <apex:column >
                    <apex:facet name="header"><b>Status</b></apex:facet>
                    {!o.status}
                </apex:column>
                <apex:column >
                    <apex:facet name="header"><b>Created Date</b></apex:facet>
                    {!o.createdDate}
                </apex:column>
                <apex:column >
                    <apex:facet name="header"><b>Last Touched Date</b></apex:facet>
                    {!o.lastTouchedDate}
                </apex:column>
            </apex:pageBlockTable>
        </apex:pageBlock>

        <script>
            var prevselected;
            $(document).ready(function() {
                $("table tr td input[name=LQSelection]:radio").click(function(srcc) {
                    try {
                        $(".inputselect").closest('tr').css('background-color', 'transparent');
                        $(this).closest('tr').css('background-color', '#C7D6E9');
                    } catch(e) {alert(e);}
                });
            });

            function selectRow() {
                var selectedVal = '{!selectedLeadQual}';
                $("table tr td input[name=LQSelection]:radio").each(function() {
                    if(selectedVal != "" && $(this).val() != "") {
                        if(selectedVal == $(this).val()) {
                            prevselected = $(this).val();
                            $(this).attr("checked",true);
                            $(this).closest('tr').css('background-color', '#C7D6E9');
                        }
                    }
                });
            }
            selectRow();

            function loadLeadQualDet(id) {
                loadLeadQualDet1(id);
            }
        </script>

        <apex:actionFunction name="loadLeadQualDet1" action="{!loadLeadQualDet}" rerender="LeadQualPanel" status="ajaxStatus">
            <apex:Param name="param1" value="" />
        </apex:actionFunction>
    </apex:form>
</apex:page>