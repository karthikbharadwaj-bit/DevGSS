<apex:page id="ArticleVersions" controller="ArticleVersionsController">
    <apex:pageBlock >
        <apex:pageBlockTable value="{!versions}" var="v">
            <apex:column value="{!v.VersionNumber}"/>
            <apex:column headerValue="Title">
                <apex:outputLink value="/apex/NewArticlePage?id={!v.KnowledgeArticleId}">{!v.Title}</apex:outputLink>
            </apex:column>
            <apex:column headerValue="Published by" value="{!v.LastModifiedBy.Name}"/>
            <apex:column value="{!v.LastModifiedDate}"/>
            <apex:column value="{!v.CreatedDate}"/>
        </apex:pageBlockTable>
    </apex:pageBlock>
</apex:page>