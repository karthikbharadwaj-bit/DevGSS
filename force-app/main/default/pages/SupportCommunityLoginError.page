        <script type="text/javascript">
            const PAGE_NAME = '/SupportCommunityLogin';
            const LOGIN_PAGE = 'services/auth/sso/RC_IdentityConnect_AutoLogin';
            function getUrlParams (url) {
                url = url || window.location.search;
                url = url.split('#')[0];
                var urlParams = {};
                var queryString = url.split('?')[1];
                if (!queryString) {
                    if (url.search('=') !== false) {
                        queryString = url;
                    }
                }
                if (queryString) {
                    var keyValuePairs = queryString.split('&')
                    for (var i = 0; i < keyValuePairs.length; i++) {
                        var keyValuePair = keyValuePairs[i].split('=');
                        var paramName = keyValuePair[0];
                        var paramValue = keyValuePair[1] || '';
                        urlParams[paramName] = decodeURIComponent(paramValue.replace(/\+/g, ' '))
                    }
                }
                return urlParams
            }
            function init() {
                const params = getUrlParams();
                const errorCode = params['ErrorCode'] || 'Remote Error';
                const errorDesc = params['ErrorDescription'] || '';
                document.getElementById('error_block__code').innerText = errorCode;
                document.getElementById('error_block__desc').innerText = errorDesc;
            }
            function openLogin() {
                document.location.href = LOGIN_PAGE + "?startURL=" + encodeURIComponent(PAGE_NAME);
            }
            function goHome() {
                self.close();
            }
        </script>
