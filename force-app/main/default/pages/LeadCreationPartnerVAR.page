    <script>
        /**
         * Set newLead.Lead_Brand_Name__c in hidden field
         * trigger rerendering Tier field with new picklist options
         * @param string value - value for newLead.Lead_Brand_Name__c
         */
        function setRCBrand(value){
            const brandHidden = document.getElementById('{!$Component.partnerForm.brandHidden}');
            brandHidden.value = value;
            if (value === '{!AVAYA_OFFICE}' || value === '{!ATOS_OFFICE}' || value === '{!RAINBOW_OFFICE}') {
                handleTierPicklist(value);
            }else if(value){
            	handleTierPicklist(value);
            }
            else {
                brandHidden.onchange();
            }
        }
        function setRCTierValue(hiddenId,value) {
            document.getElementById(hiddenId).value = value;
        }
        function populatePartnerId(){
            console.log('Enter');
            actionPopulatePartnerId();
        }
        function getCountryState(){
            console.log('getState');
            actionGetState();
        }
        function clearPicklist(picklist) {
            while (picklist && picklist.firstChild) {
                picklist.removeChild(picklist.firstChild);
            }
        }
        function createOption(value) {
            const option = document.createElement('option');
            option.text = value;
            option.label = value;

            return option;
        }
        function populatePicklist(picklist, values) {
            values.forEach(val => {
                picklist.add(createOption(val));
            });
        }
        function setDisabled(element, value) {
            element.disabled = value;
        }
        function handleTierPicklist(value) {
            const tierPicklist = document.getElementById('{!$Component.partnerForm.tierPicklist}');
            let tiers = '';
            if (value === '{!AVAYA_OFFICE}') {
                tiers = '{!avayaTiers}'.split(';');
                setDisabled(tierPicklist, false);
            	clearPicklist(tierPicklist);
            	populatePicklist(tierPicklist, tiers);
            } else if (value === '{!ATOS_OFFICE}') {
                tiers = '{!atosTiers}'.split(';');
                setDisabled(tierPicklist, false);
            	clearPicklist(tierPicklist);
            	populatePicklist(tierPicklist, tiers);
            } else if (value === '{!RAINBOW_OFFICE}') {
                tiers = '{!rainbowTiers}'.split(';');
                setDisabled(tierPicklist, false);
            	clearPicklist(tierPicklist);
            	populatePicklist(tierPicklist, tiers);
            } else {
                otherBrands(value); //CMR-358329
            }
        }
    </script>

    <script type="text/javascript">

        function containsOther(val) {
            if (val != null && (val.indexOf('Other - specify') > -1 || val.indexOf('Other - write in') > -1)) {
                return true;
            }
            return false;
        }

        function onAdditionalQuestionPicklistSelect(e) {
            var $that = $(e),
                $textArea = $(document.getElementById($that.prop('id') + 'TextArea')),
                $spanError = $(document.getElementById($that.prop('id') + 'Error')),
                isOtherSelected = containsOther($that.val()) ;
            if (isOtherSelected === true) {
                $textArea.toggle(true);
                $textArea.focus();
            } else {
                $textArea.toggle(false);
                $textArea.val('');
            }
            $spanError.toggle(false);
        }

        function customFormValidate() {
            var result = true;
            if (document.getElementById('{!$Component.partnerForm.leadAdditionalQuestions}').childNodes.length === 0) {
                return true;
            }

            var picklistIds = ['{!$Component.partnerForm.existingSolutionProviderList}',
                '{!$Component.partnerForm.promptingChangeList}',
                '{!$Component.partnerForm.competitorsList}',
                '{!$Component.partnerForm.decisionMakerList}'];

            for (var i = 0; i < picklistIds.length; ++i) {
                result = result && validateAdditionalQuestionPicklist(picklistIds[i]);
                if (result === true) {
                    saveAdditionalQuestionAnswer(picklistIds[i]);
                }
            }
            return result;
        }

        function validateAdditionalQuestionPicklist(picklistId) {
            var result = true;
            var isOtherSelected = containsOther($(document.getElementById(picklistId)).val()) ;
            if (isOtherSelected) {
                var $ctrl = $(document.getElementById(picklistId + 'TextArea'));
                var error = validateQuestionUserValue($ctrl.val());
                $ctrl.toggleClass('inputWithErrors', error.length > 0);
                result = (error.length === 0);
            }
            return result;
        }

        function validateQuestionUserValue(value) {
            if (!value || value.trim().length === 0) {
                return 'Please, enter value';
            }
            return '';
        }

        function saveAdditionalQuestionAnswer(picklistId) {
            var $picklist = $(document.getElementById(picklistId)),
                $hidden = $(document.getElementById(picklistId + 'Hidden')),
                answer = '',
                isOtherSelected = containsOther($(document.getElementById(picklistId)).val());

            if($picklist.val() != null){
                answer = ($picklist.context.multiple) ? $picklist.val().join(';') : $picklist.val();
            }
            if (isOtherSelected) {
                answer += ';' + $(document.getElementById(picklistId + 'TextArea')).val();
            }
            console.log(picklist, answer, $hidden);
            $hidden.val(answer);
        }
    </script>

