                    var showCount = 0;
                    if (depValue && depValue != undefined && depValue.length != 0) {
                        console.log(depValue);
                        $('.select3').prev().html('Please select product issue');
                        $(".select3").append($('<option selected="true"></option>').val("Please select product issue").html("Please select product issue"));
                        for (var i = 0; i < depValue.length; i++) {
                            ++showCount;
                            $(".select3").append($('<option></option>').val(depValue[i]).html(depValue[i]));

                        }
                    }

                    if (showCount != 0) {
                        optionsExist = 'true';
                        $('.level3').show();
                    }
                    return optionsExist;

                }

                function getOptionsLevel4(selVal) {
