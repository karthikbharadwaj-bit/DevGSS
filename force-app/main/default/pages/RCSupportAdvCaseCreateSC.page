                }

                function getDescStorageKey() {
                    return 'SF_CASE_DESC';
                }

                function storeDescriptionValue() {
                    var val = $('.desc').val();
                    if (val && val.length > 1) {
                        window.sessionStorage.setItem(getDescStorageKey(), val);
                    }
                }

                function restoreDescriptionValue() {
                    var val = window.sessionStorage.getItem(getDescStorageKey());
                    if (val) {
                        var ctrl = $('.desc');
                        var currentVal = ctrl.val();
                        if (ctrl && ctrl.length > 1) {
                            val += '\n\n' + currentVal;
                        }
                        ctrl.val(val);
                        window.sessionStorage.removeItem(getDescStorageKey());
                    }
                }
