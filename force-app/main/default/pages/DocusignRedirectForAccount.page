<apex:page standardController="Account" extensions="DocusignRedirectForAccountExtension" action="{!redirect}"  showHeader="false" sidebar="false">
    <head>
        <apex:slds />
    </head>

    <body class="slds-scope" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
        <div class="demo-only" style="height:4rem">
            <div class="slds-notify_container slds-is-relative">
                <div class="slds-notify slds-notify_toast slds-theme_error" role="status">
                    <span class="slds-icon_container slds-icon-utility-error slds-m-right_small slds-no-flex slds-align-top" title="Description of icon when needed">
                        <svg class="slds-icon slds-icon_small" aria-hidden="true">
                            <use xlink:href="/_slds/icons/utility-sprite/svg/symbols.svg#error"></use>
                        </svg>
                    </span>
                    <div class="slds-notify__content">
                        <h2 class="slds-text-heading_small">{! errorMessage }</h2>
                        <p class="slds-align_absolute-center"><a href="{!'/one/one.app?#/sObject/'+ accId + '/view'}" class="slds-p-right_xx-small">Go back</a> to the Account record.</p>
                    </div>
                </div>
            </div>
        </div>
    </body>
</apex:page>