<apex:page controller="ImplementationSurveyController" standardStylesheets="true" cache="false" id="ImplementationSurvey" showHeader="false">
<style>
    input[type="radio"] {
        border:none !important;
        border-color: white !important;
        margin-top: 0px;
        position: relative;
        padding-left:14px !important;
        width:12px!important;
        height:12px!important;
    }
    
    b {
        color:#798496;
        font-family:Verdana,Geneva,Arial,Helvetica,sans-serif; 
        font-size:11px; 
        font-style:normal;
        line-height:20px;
    }
    
  	label {
		vertical-align:middle !important;
		font-size:12px;
		float:right;
		margin-left:5px;
    }
    .content {
        background: white; 
        border: 1px solid #919191; 
        width: 693px;
        box-shadow: 0px 0px 30px 1px; 
        padding: 10px;
        margin: 0px auto;
        border-radius: 15px 15px 15px 15px;
        border-radius: 15px 15px 15px 15px;
        -moz-border-radius: 15px 15px 15px 15px;
        -webkit-border-radius: 15px 15px 15px 15px;
    }

    p {
        color:black;line-height:20px;
    }
</style>
<apex:stylesheet value="{!URLFOR($Resource.Style_Resources, 'default2.style.css')}"/>
<div class='content'>
    <div style="padding-left:4%;">
        <apex:dynamicComponent componentValue="{!logo}" />
        <br/>
        <br/>
    </div>
    <apex:form id="theForm" style="padding-left:4%;">
        <apex:outputText escape="false" rendered="{!errorflag }">
            <b>Invalid Survey</b>
        </apex:outputText>
        <apex:PageMessages escape="false"></apex:PageMessages>
        <apex:PanelGrid id="thePanel" columns="1" rendered="{!isEmpty && !(isExpired)}">
            <apex:outputText value="{!UserMsg}" escape="false" />
            <br/>
            <apex:outputText value="{!Header}" escape="false" />

            <apex:outputPanel rendered="{!(!surveyObj.Implementation__r.ProfessionalServices__c)}">
                <apex:outputText value="{!Q7}" escape="false" />
                <br/>
                <apex:outputText value="<i>(0 Not at all Satisfied and 10 extremely satisfied)</i><br><br>" escape="false" />
                        
                <apex:outputText value="&nbsp; &nbsp;1. Overall satisfaction with your Technical Onboarding Advisor.<br/>&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;&nbsp;<font color =#798496></font>"
                 escape="false" />
                <apex:SelectRadio value="{!Q71Value}" style="padding-left:3%;" disabled="{!(isExpired || respondFlag)}">
                    <apex:selectOptions value="{!Values3}" />
                </apex:SelectRadio>

                <apex:outputText value="&nbsp; &nbsp;2. Technical Onboarding Advisor’s ability to fulfill your requirements<br/>&nbsp; &nbsp;&nbsp; &nbsp;&nbsp;&nbsp;<font color =#798496></font>"
                 escape="false" />
                <apex:SelectRadio value="{!Q72Value}" style="padding-left:3%;" disabled="{!(isExpired || respondFlag)}">
                    <apex:selectOptions value="{!Values3}" />
                </apex:SelectRadio>

                <apex:outputText value="&nbsp; &nbsp;3. Communication and updates you received from your Technical Onboarding Advisor<br/>&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;<font color =#798496></font>"
                 escape="false" />
                <apex:SelectRadio value="{!Q73Value}" style="padding-left:3%;" disabled="{!(isExpired || respondFlag)}">
                    <apex:selectOptions value="{!Values3}" />
                </apex:SelectRadio>

                <apex:outputPanel rendered="{!isRiseBrand}">
                    <apex:outputText value="&nbsp; &nbsp; &nbsp;4.  Materials provided to you during your Technical Onboarding (i.e. {!riseBrandConfig.Identifier__c} with Ringcentral App, etc.)<br/>&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;" escape="false"/>
                    <apex:SelectRadio value="{!Q74Value}" style="padding-left:3%;" disabled="{!(isExpired || respondFlag)}">
                        <apex:selectOptions value="{!Values3}"/><br/>
                    </apex:SelectRadio>
                </apex:outputPanel>

                <apex:outputText value="<font color=black>Please let us know any comments you have about your Technical Onboarding experience or suggestions <br/>on how we can improve.</font> <br></br>"
                 escape="false" />
                <apex:InputTextArea Rows="4" cols="100" id="comment" style="width:88%;" onchange="checkLength(this, 2000);" value="{!comments}"
                 disabled="{!(isExpired || respondFlag)}" />
            </apex:outputPanel>

            <apex:outputText value="{!footer}" escape="false" />
            <apex:commandButton value="Submit" action="{!save}" style="margin-left:40%;" />
            
        </apex:PanelGrid>
    </apex:form>

</div>
<script>
var maximumLength = 2000;

function checkLength(control,maximum) {
    var length = control.value.length;
    if (length > maximum) {
        alert('Please limit your message to ' + maximumLength
        + ' characters. There are currently ' + length + '.');
        return false;
    }
    return true;
}

function validate(form) {
    var controls = form.elements;
    if (!checkLength(controls.textArea, maximumLength)) {
        return false;
    }
    return true;
}
</script>

</apex:page>