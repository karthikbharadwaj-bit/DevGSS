<apex:page StandardController="Implementation__c" extensions="ImplementationSettingsPhoneSystem" lightningStylesheets="true">
    
    <style>
        .outputText {
        margin-left: 9%;
        font-weight: bold;
        font-size: 12px;
        margin-top: 5px;
        }
        .table {
        width: 100%;
        display: table;
        }
        .table .row {
        display: table-row;
        }
        .table .row .column {
        display: table-cell; //
        }
        .heading {
        font-size: 14px;
        text-align: center;
        background: #027C6F;
        height: 20px;
        display: table-caption !important;
        color: white;
        font-family: "Calibri", "sans-serif";
        font-weight: bold;
        }
        .checkBoxStyle{
        /*height: 12px;
        width: 12px;*/
        }
        body{
        font-size: 70%;
        }
    </style>
    
    <apex:variable var="uiTheme" value="Classic" 
                   rendered="{!$User.UIThemeDisplayed == 'Theme3'}">
        <style>
            .appoinmentscontentwrap input[type="checkbox"]
            {
            margin-left: 10% !important;
            margin: 5px 7px;
            }
        </style>
    </apex:variable>
    
    <apex:variable var="uiTheme" value="lightningDesktop" 
                   rendered="{!$User.UIThemeDisplayed == 'Theme4d'}">
        <style>
            body label 
            {
            white-space:nowrap;
            } 
            td,.inputwrap{
            display: flex;
            padding: 2px 0;
            }
            .appoinmentscontentwrap
            {
            margin: 0 2px;
            padding: 0.35em 0.625em 0.75em;
            }
            .appoinmentscontentwrap input[type="checkbox"]
            {
            <!--margin: 0 2px 8px 8px;-->
            }
            
                        
        </style>
    </apex:variable>
    <apex:form id="mainForm">
        <apex:inputHidden value="{!Implementation__c.Brand__c}" id="theHiddenInput"/>
        <apex:pageBlock >
            <!--Implementation check list non AT&T brands--> 
            <apex:outputPanel rendered="{!objImplementation.Brand__c !='AT&T Office@Hand'}"> 
                <apex:outputpanel id="opPanel" layout="none" style="overflow:auto;width:90%"> 
                    <div class="table">
                        <div class="row heading">Settings/Phone System</div>
                        <div class="row">
                            <div class="column">
                                <div class="outputText" style="margin-left: 5% !important;">
                                    <apex:outputText value="Foundational Topics" />
                                </div>
                                <apex:selectcheckboxes value="{!foundationalTopicsList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxes1" styleClass="checkBoxStyle" >
                                    <apex:selectOptions value="{!foundationalTopicsOptions}" />
                                </apex:selectcheckboxes>
                            </div>
                            
                            <div class="column">
                                <div class="outputText" style="margin-left: 5% !important;">
                                    <apex:outputText value="Progressive Topics" />
                                </div>
                                <apex:selectcheckboxes value="{!progressiveTopicsList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxes2" styleClass="checkBoxStyle" >
                                    <apex:selectOptions value="{!progressiveTopicsOptions}" />
                                </apex:selectcheckboxes>
                            </div>

                            <div class="column">
                                <div class="outputText" style="margin-left: 5% !important;">
                                    <apex:outputText value="Special Request" />
                                </div>
                                 <apex:selectcheckboxes value="{!specialRequestList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxes3" styleClass="checkBoxStyle" >
                                        <apex:selectOptions value="{!specialRequestOptions}" />
                                </apex:selectcheckboxes>

                                <div class="outputText" style="margin-left: 5% !important;">
                                    <apex:outputText value="Regional Requirements" />
                                </div>
                                <apex:selectcheckboxes value="{!regionalRequirementsList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxes4" styleClass="checkBoxStyle" >
                                    <apex:selectOptions value="{!regionalRequirementsOptions}" />
                                </apex:selectcheckboxes>                           
                            </div>                        
                        </div>
                    </div>
                                 
                    <apex:outputPanel rendered="{!isDisabled}" >                    
                        <div id="EditButton" >
                            <apex:outputPanel rendered="{!DisplayEditBtn}" >
                                <apex:commandButton value="Edit" onClick="EnableEdit(); return false;" disabled="{!objImplementation.Implementation_Status_2__c == 'Completed'}"/>
                            </apex:outputPanel>
                        </div> 
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!Not(isDisabled)}"  >                    
                        <div id="SaveButton" >                  
                            <apex:commandButton value="Save" action="{!saveImplementation}"   oncomplete="window.top.location='/{!objImplementation.Id}';"/>                                              
                        </div>                  
                    </apex:outputPanel>
                    <apex:actionFunction name="setEditable" action="{!saveImplementation}" reRender="chk1,chk2,chk3,opPanel">
                        <apex:param name="editable" value="editable" assignTo="{!strEdit}" />
                    </apex:actionFunction>    
                </apex:outputpanel>
            </apex:outputPanel>
            <!--ATT implementation check List changes--> 
            <apex:outputPanel rendered="{!objImplementation.Brand__c == 'AT&T Office@Hand'}"> 
                <apex:outputpanel id="opPanel12" layout="none" style="overflow:auto;width:90%"> 
                    <div class="table">
                        <div class="row heading">Settings/Phone System</div>
                        <div class="row">
                            <div class="column">
                                <div class="outputText" style="margin-left: 14% !important;">
                                    <apex:outputText value="Account Review" />
                                </div>
                                <apex:selectcheckboxes value="{!accountReviewsList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxATT1" styleClass="checkBoxStyle" >
                                    <apex:selectOptions value="{!lstAccountReviewOptions}" />
                                </apex:selectcheckboxes>
                            </div>
                            
                            <div class="column">
                                <div class="outputText" style="margin-left: 7% !important;">
                                    <apex:outputText value="Company Numbers and Info" />
                                </div>
                                <apex:selectcheckboxes value="{!companyNumbersInfoList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxATT2" styleClass="checkBoxStyle" >
                                    <apex:selectOptions value="{!companyNumbersInfoOptions}" />
                                </apex:selectcheckboxes>
                            </div>
                            
                            <div class="column">
                                <div class="outputText" style="margin-left: 7% !important;">
                                    <apex:outputText value="Users" />
                                </div>
                                <apex:selectcheckboxes value="{!usersList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxATT3" styleClass="checkBoxStyle">
                                    <apex:selectOptions value="{!lstAUserOptions}" />
                                </apex:selectcheckboxes>
                            </div>
                            
                            <div class="column">
                                <div class="outputText" style="margin-left: 10% !important;">
                                    <apex:outputText value="Phones & Devices" />
                                </div>
                                <apex:selectcheckboxes value="{!phonesDevicesList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxATT4" styleClass="checkBoxStyle" >
                                    <apex:selectOptions value="{!phonesDevicesOptions}" />
                                </apex:selectcheckboxes>
                                <!--  Appointment section would be used after releasing of Implementation scheduler. -->
                                <div class="outputText" style="margin-left: 10% !important; margin-top: 17px;">
                                    <apex:outputText value="Appointments"/>
                                </div>
                                <apex:outputPanel layout="block" styleClass="appoinmentscontentwrap">
                                    <apex:outputPanel layout="block" styleClass="inputwrap" rendered="{!displayTelusValue}">
                                    <apex:inputCheckBox id="chkATT6" value="{!objImplementation.Welcome_Call_Completed__c}" disabled="{!isDisabled}" />
                                    <apex:outputLabel value="Welcome Call Completed" for="chkATT6"/>
                                    </apex:outputPanel>
                                    <apex:outputPanel layout="block" styleClass="inputwrap">
                                    <apex:inputCheckbox id="chkATT1" value="{!objImplementation.First_Call_Completed__c}" disabled="{!isDisabled}"/> 
                                    <apex:outputLabel value="First Call Completed" for="chkATT1"/>
                                    </apex:outputPanel>
                                    <apex:outputPanel layout="block" styleClass="inputwrap">
                                    <apex:inputCheckBox id="chkATT2" value="{!objImplementation.Second_Call_Completed__c}" disabled="{!isDisabled}" /> 
                                    <apex:outputLabel value="Second Call Completed" for="chkATT2"/>
                                    </apex:outputPanel>
                                    <apex:outputPanel layout="block" styleClass="inputwrap">
                                    <apex:inputCheckBox id="chkATT3"  value="{!objImplementation.Third_Call_Completed__c}" disabled="{!isDisabled}" /> 
                                    <apex:outputLabel value="Third Call Completed" for="chkATT3"/>
                                    </apex:outputPanel>
                                    <apex:outputPanel layout="block" styleClass="inputwrap">
                                    <apex:inputCheckBox id="chkATT4"  value="{!objImplementation.Fourth_Call_Completed__c}" disabled="{!isDisabled}" /> 
                                    <apex:outputLabel value="Fourth Call Completed" for="chkATT4"/>
                                    </apex:outputPanel>
                                    <apex:outputPanel layout="block" styleClass="inputwrap">
                                    <apex:inputCheckBox id="chkATT5"  value="{!objImplementation.Final_Call_Completed__c}" disabled="{!isDisabled}" /> 
                                    <apex:outputLabel value="Final Call Completed" for="chkATT5"/>
                                    </apex:outputPanel>      
                                    <apex:outputPanel layout="block" styleClass="inputwrap">
                                    <apex:inputCheckBox id="noShow1"  value="{!objImplementation.No_Show__c}" disabled="{!isDisabled}" /> 
                                    <apex:outputLabel value="No Show" for="noShow1"/>
                                    </apex:outputPanel>
                                    <!--<apex:inputCheckBox id="noShow"  value="{!objImplementation.No_Show__c}" disabled="{!isDisabled}" /> 
                                    <apex:outputText value="No Show"/> -->
                                </apex:outputPanel>
                            </div>
                            
                            <div class="column">
                                <div class="outputText" style="margin-left: 13% !important;">
                                    <apex:outputText value="Group" />
                                </div>
                                <apex:selectcheckboxes value="{!groupsList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxATT5" styleClass="checkBoxStyle" >
                                    <apex:selectOptions value="{!groupsOptions}" />
                                </apex:selectcheckboxes></div>
                            <div class="column">
                                <div class="outputText" style="margin-left: 14% !important;">
                                    <apex:outputText value="Tools" />
                                </div>
                                <apex:selectcheckboxes value="{!toolsInfoList}" layout="pageDirection" disabled="{!isDisabled}" id="CheckBoxATT6" styleClass="checkBoxStyle">
                                    <apex:selectOptions value="{!toolsOptions}" />
                                </apex:selectcheckboxes>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Added and modified on 12th June 2015 to make read only of implementation Checklists only for sales profile -->              
                    <apex:outputPanel rendered="{!isDisabled}" >                    
                        <div id="EditButton" >
                            <apex:outputPanel rendered="{!DisplayEditBtn}" >
                                <!--<input type="button" value="Edit" onClick="EnableEdit();" />   -->  
                                <apex:commandButton value="Edit" onClick="EnableEdit(); return false;"/>                                           
                                
                            </apex:outputPanel>
                            
                        </div> 
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!Not(isDisabled)}"  >                    
                        <div id="SaveButton" >                  
                            <apex:commandButton value="Save" action="{!saveImplementation}"   oncomplete="window.top.location='/{!objImplementation.Id}';"/>                                              
                        </div>                  
                    </apex:outputPanel>
                    <apex:actionFunction name="setEditable" action="{!saveImplementation}" reRender="chkATT1,chkATT2,chkATT3,opPanel12">
                        <apex:param name="editable" value="editable" assignTo="{!strEdit}" />
                    </apex:actionFunction>    
                </apex:outputpanel>
           </apex:outputPanel>
        </apex:pageBlock>       
    </apex:form>
    <script>
    function EnableEdit() {     
        setEditable('editable');
    }        
    </script> 
</apex:page>