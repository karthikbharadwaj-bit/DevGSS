<apex:page controller="AccountSurveyController" showHeader="false" sidebar="false" standardStylesheets="false">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
    <style type="text/css">
        
        body {
            font-family: Verdana, Geneva, Arial, Helvetica, sans-serif !important;
            font-size: 11px !important;
            font-style: normal !important;
            line-height: 20px !important;
        }
        
        .rating {
            background:  #F0F0F0;
            border: 1.5px solid #696969;
        }
        .rating:hover{
            box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.2), 0 3px 10px 0 rgba(0, 0, 0, 0.19);
        }
        .rating-onclick {
            box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.2), 0 3px 10px 0 rgba(0, 0, 0, 0.19);
        }
        .title{
            background: #50a0dc;
            color: #ffffff;
        }
        .text{
            color: #ffffff;
            font-size: large;
            background: #50a0dc;
        }
        div.card{
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
        }
        div.card-text{
            font-size: large;
        }
        .radioStyle label{
            font-size: large;
            padding : 5px;
        }
        .error{
            color:red;
            padding: 5rem;
        }
        .thank-you{
            font-weight: bold;
            padding: 5rem;
        }
        .rating-label{
            font-size:medium;
            font-weight:bold;
            margin-top:5px !important;
            
        }
        input[type=radio] { 
            margin-left: 10px;
            padding : 5px;
        }
    </style>
    <script>
        function changeCSS(val){
            if(val == '1'){
                document.getElementById('{!$Component.surveyForm.one}').className = 'col text-center rating rating-onclick';
                document.getElementById('{!$Component.surveyForm.two}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.three}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.four}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.five}').className = 'col text-center rating';
            }
            else if(val == '2'){
                document.getElementById('{!$Component.surveyForm.one}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.two}').className = 'col text-center rating rating-onclick';
                document.getElementById('{!$Component.surveyForm.three}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.four}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.five}').className = 'col text-center rating';
            }
            else if(val == '3'){
                document.getElementById('{!$Component.surveyForm.one}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.two}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.three}').className = 'col text-center rating rating-onclick';
                document.getElementById('{!$Component.surveyForm.four}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.five}').className = 'col text-center rating';
            }
            else if(val == '4'){
                document.getElementById('{!$Component.surveyForm.one}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.two}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.three}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.four}').className = 'col text-center rating rating-onclick';
                document.getElementById('{!$Component.surveyForm.five}').className = 'col text-center rating';
            }
            else if(val == '5'){
                document.getElementById('{!$Component.surveyForm.one}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.two}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.three}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.four}').className = 'col text-center rating';
                document.getElementById('{!$Component.surveyForm.five}').className = 'col text-center rating rating-onclick';
            }
        }
    </script>
    <apex:form id="surveyForm" rendered="{!showSurveyForm}">
    <div class="container mt-3">
    <div class = "card mx-auto w-75" style="margin-top:7%">         
            <div class = "card-title px-3 py-3 title">
               <h2 class="text-center">
                  Account Survey  
                </h2>
            </div>
            <div class="card-body">
            <div class = "card-text">
                <apex:outputText value="1. What is your overall Satisfaction with AT&T Office at Hand powered by RingCentral?"/>               
            </div>
            <div class="row" style="margin-top:1rem;">
                <div class="col mx-1 rating-label">
                    Not Satisfied
                </div>
                <div class="col mx-1 rating-label">
                    <span class="float-end">Extremely Satisfied</span>
                </div>
            </div>    
            <div class="row mx-1 my-2" style="line-height:2rem; font-weight:bolder; font-size:15px">
                    <apex:outputPanel id="one" styleClass="col text-center rating" onclick="setRating('1')">1</apex:outputPanel>
                    <apex:outputPanel id="two" styleClass="col text-center rating" onclick="setRating('2')">2</apex:outputPanel>
                    <apex:outputPanel id="three" styleClass="col text-center rating" onclick="setRating('3')">3</apex:outputPanel>
                    <apex:outputPanel id="four" styleClass="col text-center rating" onclick="setRating('4')">4</apex:outputPanel>
                    <apex:outputPanel id="five" styleClass="col text-center rating" onclick="setRating('5')">5</apex:outputPanel>
            </div>  
            <apex:actionFunction name="setRating" action="{!getRating}" rerender="myHiddenField" oncomplete="changeCSS('{!rating}')">
                <apex:param name="p1" value="" assignTo="{!rating}" />
            </apex:actionFunction>
            <div class = "card-text" style="margin-top:2rem !important">
                <apex:outputText value=" 2. Are you using the AT&T Office@Hand Video conference solution that is included in your system?"/>
            </div>
            <div class = "row mx-0 my-2" style="margin-top:1rem !important">
                <apex:selectRadio styleClass="row radioStyle" value="{!useVideoConference}">
                <apex:selectOptions value="{!Options}"/>
                </apex:selectRadio>
            </div>
            <div class="row">
                <div class="col text-center" >
                   <apex:commandButton styleClass="btn btn-primary text" action="{!submitSurvey}" value="Submit"/>
                </div>
            </div>
        </div>                
    </div>
    </div>
    </apex:form>     
    <apex:pageBlock rendered="{!showThankYou}">
        <div class="card mx-auto w-75" style="margin-top:10%">
            <h2 class="text-center thank-you">
                Thank you for your feedback!
            </h2>               
        </div>
    </apex:pageBlock>    
    <apex:pageBlock rendered="{!showError}">
        <div class="card mx-auto w-75" style="margin-top:10%">
            <h2 class="text-center error">
                We encountered an error. Please try again!
            </h2>
        </div>
    </apex:pageBlock>
</apex:page>