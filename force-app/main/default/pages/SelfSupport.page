<apex:page showHeader="false" sidebar="false">
<html>
<head>
    <meta charset="utf-8" />
    <title><apex:insert name="title" />RingCentral Customer Care Center</title>
    <meta content='width=device-width,initial-scale=1.0' name='viewport' />
    <link rel="shortcut icon" href="{!URLFOR($Resource.LearningCenter, 'favicon.ico')}" />
    <link rel="stylesheet" type="text/css" href="{!URLFOR($Resource.LearningCenterFontsLato, 'fonts.css')}" />
    <link rel="stylesheet" type="text/css" href="{!URLFOR($Resource.LearningCenterFontsLatoBold, 'fonts.css')}" />
    <link rel="stylesheet" type="text/css" href="{!URLFOR($Resource.LearningCenter, 'styles.css')}" />

    <style>
        @media screen and (min-width: 500px) {
            .header__logo__lms {
                height: 150px;
                display: inline;
                margin-top: 20px;
            }
            .logo--color {
                height: 100px;
                background-size: contain;
                background-repeat: no-repeat;
                min-width: 500px;
            }
            .main-text {
                max-width: 900px;
                text-align: center;
                margin: auto;
                margin-top: 20vh;
            }
            .main-text > div:first-of-type {
                padding: 2.5rem 0 0 0;
            }
            .main-text div
            {
                margin-top: 1.5rem;
            }
            .mobile-logo {
                display: none;
            }
            .wrapper {
                width: 100%;
                height: 100%;
            }
            .footer {
                position: fixed;
                bottom: 0;
                width: 100%;
            }
            .footer .nav--separated-links-white > li {
                margin-left: 10px;
                margin-right: 0px;
            }
        }

        @media screen and (max-width: 499px) {
            body {
                background: #ededef;
            }
            .footer {
                display: none;
            }
            .main-text {
                text-align: center;
                padding: 15px;
                margin: auto;
            }
            .main-text h2 {
                font-weight: 900;
                font-size: 28px;
                line-height: 1.8rem;
            }
            .main-text div {
                padding-top: 30px;
                font-size: .85rem;
            }
            .logo--color {
                display: none;
            }
            .header__logo {
                background: #333;
            }
            .mobile-logo {
                width: 114px;
            }
        }

    </style>
</head>
<body>
    <!-- Header -->
    <div class="container page__header" >
        <div class="header__logo">
            <a class="logo--color" href="http://www.ringcentral.com/"></a>
            <img class="mobile-logo" src="{!URLFOR($Resource.LiveAgent, 'media/ringcentral-logo.png')}" />
        </div>
    </div>

    <!-- Main text section -->
    <div class="main-text">
        <h2>Sorry, live support is not included in your service package</h2>
        <br/>
        <div>
            Please review <a href="https://success.ringcentral.com/articles/en_US/RC_Knowledge_Article/4275">this Knowledge Base article</a> to upgrade your service.
        </div>
        <div>
            For assistance with RingCentral Meetings, visit our self-service website <a href="https://success.ringcentral.com/meetings">success.ringcentral.com/meetings</a>
        </div>
        <div>
            For help locating your account credentials, <a href="https://success.ringcentral.com/articles/en_US/RC_Knowledge_Article/9964">visit our Knowledge Base</a>
        </div>
    </div>

    <!-- Footer -->
    <div class="page__footer footer">
        <div class="container container--padded">
            <div class="grid g--column md-g--row g--between g--wrap g--center g--middle">
                <div class="g-col">
                    <a href="http://www.ringcentral.com"><div class="logo--white"></div></a>
                </div>
            </div>
            <div class="delimiter--white mt2 mb2"></div>
            <div class="footer__meta grid g--between g--wrap g--v-padded g--middle">
                <div class="g-col mr4">&copy; 1999<script>document.write("-"+new Date().getFullYear());</script> RingCentral, Inc. All rights reserved</div>
                <div class="g-col">
                    <ul class="nav nav--separated-links-white">
                        <li><a rel="nofollow" title="Contact Us" href="http://www.ringcentral.com/whyringcentral/contactus.html">Contact Us</a></li>
                        <li><a rel="nofollow" title="About RingCentral" href="http://www.ringcentral.com/whyringcentral/company.html">About RingCentral</a></li>
                        <li><a rel="nofollow" title="Affiliates and Partners" href="https://ringcentral.com/partner/overview.html">Affiliates and Partners</a></li>
                        <li><a rel="nofollow" title="RingCentral Legal Pages" href="https://ringcentral.com/legal.html">Legal</a></li>
                        <li><a rel="nofollow" title="Security Policy" href="https://ringcentral.com/security-statement.html">Security Policy</a></li>
                        <li><a title="Privacy Policy" href="https://ringcentral.com/legal/privacy-policy.html">Privacy Policy</a></li>
                        <li><a title="Site Map" href="https://ringcentral.com/sitemap.html">Site Map</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
</apex:page>