<apex:page controller="PicklistSiteopsController" language="{!selectedLanguage}">

    <apex:form rendered="{!IF(targetSobject != null, true, false)}">
        <apex:repeat var="targetField" value="{!targetSobjectFields}">
            <apex:inputField value="{!targetSobject[targetField]}" html-data-id="{!targetField}"/>
        </apex:repeat>
    </apex:form>

</apex:page>