                    -webkit-box-shadow: 0px -54px 54px -20px #236FBD inset;
                    -moz-box-shadow: 0px -42px 54px -20px #236FBD inset;
                    border-radius: 10px 10px 0px 0px;
                    -webkit-border-radius: 10px 10px 0px 0px;
                    -moz-border-radius: 10px 10px 0px 0px;
                    font-family: Arial,Helvetica,sans-serif;
                    text-align: center;
                }
                .tabbed-area > ul > li >a{
                    padding-top:20px;
                    text-align:center;
                    color: white;
                    text-decoration: none;
                    font-size: 13px;
                    font-family: Arial,Helvetica,sans-serif;
                    text-align: center;
                    font-weight: bolder;
                }
                .tabbed-area > ul > li:hover{
                    background: white;
                    cursor: pointer;
                    box-shadow: 0px -42px 54px -20px rgba(73, 72, 72, 0.98) inset;
                }
                .tabbed-area > ul > li.tabActiveHeader{
                    background: white;
                    cursor: pointer;
                    box-shadow: 0px -54px 54px -20px orange inset;
                }
                .tabbed-area > ul > li.tabActiveHeader > a {
                    padding-top:20px;
                    text-align:center;
                    color: black;
                    text-decoration: none;
                    font-size: 13px;
                    font-family: Arial,Helvetica,sans-serif;
                    text-align: center;
                    font-weight: bolder;
                }
                .tabContentWrapper{
                    border: 1px solid #C1C9CA;
                    width: 86%;
                    padding: 20px;
                    margin-left: 40px;
                    min-height: 124px;
                    border-top: 6px solid orange;
                    margin-top: -3px;
                    border-radius: 0px 15px 15px 0px;
                }
                .removeMargin{
                    padding-left: 0px;
                    -webkit-padding-start: 0px;
                }
                .lightInsight{
                }
                .errorTab{
                    border-top: 3px solid red;
                }
                .blockHeader {
                    width: 45%;
                    padding: 7px 1px 5px 11px;
                    box-shadow: 1px 0px 16px 1px gray;
                }

                .blockHeader > h3{
                    font-size: 17px;
                }
                .fullwidthWithBorder{
                    /*width: 96%;*/
                    outline:none;
                    margin-top: 11px;
                    height: 125px;
                    resize: none;
                    box-shadow: 0px 0px 7px 0px lightblue inset;
                    -webkit-box-shadow: 0px 0px 7px 0px lightblue inset;
                    -moz-box-shadow: 0px 0px 7px 0px lightblue inset;
                    font-size: 12px !important;
                    line-height: 1 !important;
                    border: 1px solid lightgray !important;
                    border-radius: 10px !important;
                    -webkit-border-radius: 10px !important;
                    -moz-border-radius: 10px !important;
                    box-sizing : border-box;
                    padding : 5px;
                }
                .box-wrap{

                    border: 1px solid #C1C9CA;
                    width: 1360px;
                    /* border-radius: 15px; */
                    padding: 20px;
                    margin-left: 40px;
                    min-height: 124px;
                    border-top: 6px solid orange;
                    margin-top: -3px;
                    border-radius: 0px 15px 15px 15px;
                }
                .footerNotesC {
                    width: 1160px;
                    padding: 20px;
                }
                #overlay {
                    background: url("/resource/1398195934000/EmailValidation/loading.gif") no-repeat scroll center center rgba(177, 177, 177, 0.71);
                    border: 0px solid #000000;
                    bottom: 0;
                    left: 0;
                    opacity: 0.75;
                    position: fixed;
                    top: 0;
                    visibility: hidden;
                    width: 100%;
                    border-radius: 15px;
                    z-index: 1000;
                }

                .fixedTextAreaSize, .discoveryNotes, .managerNotes, .fullwidthWithBorder {
                    width: 650px;
                }

                .mutualPlanSum, .rcExecAlignSum {
                    width: 630px;
                    outline:none;
                    margin-top: 11px;
                    resize: none;
                    box-shadow: 0px 0px 7px 0px lightblue inset;
                    -webkit-box-shadow: 0px 0px 7px 0px lightblue inset;
                    -moz-box-shadow: 0px 0px 7px 0px lightblue inset;
                    font-size: 12px !important;
                    line-height: 1 !important;
                    border: 1px solid lightgray !important;
                    border-radius: 10px !important;
                    -webkit-border-radius: 10px !important;
                    -moz-border-radius: 10px !important;
                    box-sizing : border-box;
                    padding : 5px;
                }

                .currentSituation, .benefits, .problems, .decisionMaking, .impact, .competitiveLandscape, .idealSituation, .relationshipBuildingExtras, .discoveryNotesOld {
                    outline:none;
                    resize: none;
                    width: 1300px;
                    height: 600px;
                    box-shadow: 0px 0px 7px 0px lightblue inset;
                    -webkit-box-shadow: 0px 0px 7px 0px lightblue inset;
                    -moz-box-shadow: 0px 0px 7px 0px lightblue inset;
                    font-size: 12px !important;
                    line-height: 1 !important;
                    border: 1px solid lightgray !important;
                    border-radius: 10px !important;
                    -webkit-border-radius: 10px !important;
                    -moz-border-radius: 10px !important;
                    box-sizing : border-box;
                    padding : 5px;
                }

                .hidden {
                    display: none;
                }
                .rcExecAlignSum select {
                    display:none;
                }
            </style>
            <script>

                //--------------------------------------Function to initiate tab nature-------------------------------------------
                function initiateTabs(tabWrapper,options){
                    var optionsJson = jQuery.parseJSON(options);
                    if(optionsJson.activeTab != null){
                        $(tabWrapper).children('.tabdiv').hide().eq(optionsJson.activeTab).show();
                    }
                    else{
                        $(tabWrapper).children('.tabdiv').hide().eq(0).show();
                    }
                };
                //-------------------------------------Function to check and show errors in discovery tab-------------------------
                function CheckErrorTabs(){
                    $.each($(".box-wrap").children(".tabdiv"),function(){
                        var parent = $(this);
                        $(this).find(".errorMsg").filter(function(){

                            $(".box-wrap").siblings("ul").find("li[id*="+parent.attr('id')+"]").each(function(){
                                $(this).addClass("errorTab");
                                //     alert($(this).attr("id"));

                            });
                        });
                    });
                };
                //-------------------------------------Function to check and show errors in discovery tab-------------------------
                //-------------------------------------Function to check length of field on page level/7/3/2014----------------------------
                function TextAreaLengthCheck(areaId,FieldName,validlength){

                    $(areaId).keyup(function () {
                        var maxLength = validlength;
                        var text = $(this).val();
                        var textLength = text.length;
                        if (textLength > maxLength) {
                            $(this).val(text.substring(0, (maxLength)));
                            alert("Sorry, you are only " + maxLength + " characters allowed for "+FieldName);
                        }
                        else {
                            //alert("Required Min. 500 characters");
                        }
                    });
                };
                //------------------------Methods to show and hide overlay on page----------------------------
                function showOverlay() {
                    var o = document.getElementById('overlay');
                    o.style.visibility = 'visible';
                }
                function hideOverlay() {
                    var o = document.getElementById('overlay');
                    o.style.visibility = 'hidden';
                }
                //------------------------Method to  refresh parent page of current Inline page--------------
                function parentRefresh(){
                    //--------------------Accessing parent view url and reloading----------------------------
                    window.top.location.href = '{!redirectUrl}';
                }
                //------------------------Method to confirm user action--------------------------------------
                function ConfirmUserAction(msg){
                    var action = confirm(msg);
                    if(action){
                        parentRefresh();
                    }else{

                        return false;
                    }

                }
            </script>

            <div class="btnDiv" id="readModeButton"   >
                <apex:outputpanel rendered="{!viewMode == 'read'}">
                    <apex:commandButton value="Edit" reRender="container" action="{!showEdit}" status="renderMeStatus" style="padding: 8px 20px 8px 20px;" />
                </apex:outputpanel>
                <apex:outputpanel rendered="{!viewMode == 'edit'}">
                    <apex:commandButton value="Save" action="{!save}" status="renderMeStatus" style="padding: 8px 20px 8px 20px;" oncomplete="parentRefresh();"/>
                    <apex:commandButton value="Cancel"  onClick="return ConfirmUserAction('Do you really want to continue without saving changes?')" status="renderMeStatus" style="padding: 8px 20px 8px 20px;"/>
                </apex:outputpanel>

            </div>
            <!-- -------------------------New Discovery section starts------------------------- -->
            <div  class="NewDiscoverySection">
                <div class="pbHeader" id ="innerheaderDiv"  style="background: none;border: none;">
                    <table border="0" cellpadding="0" cellspacing="0">
                        <tbody>
                        <tr>
                            <td class="pbTitle" style="padding-left: 0px;">
                                <h2 class="mainTitle" style="color: #084B8A;font-size: 15px;"></h2>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <apex:outputpanel style="padding-left: 40px;background: none;border: none;height:inherit !important;">

                    <div style="margin-top: -10px;">

                        <div class="tabbed-area" >

                            <ul class="tabs group" id="tabsItems">
                                <li id="#box0"><a>History tracking</a></li>
                                <li class="tabActiveHeader" id="#box1"><a>Summary</a></li>
                                <li id="#box2"><a>Current Situation</a></li>
                                <li id="#box4"><a>Problems</a></li>
                                <li id="#box6"><a>Impact</a></li>
                                <li id="#box8"><a>Ideal Situation</a></li>
                                <li id="#box3"><a>Benefits</a></li>
                                <li id="#box5"><a>Decision Making</a></li>
                                <li id="#box9"><a>Relationship Building Extras</a></li>
                                <li id="#box7"><a>Competitive Landscape</a></li>
                            </ul>

                            <div class="box-wrap" id="sss">

                                <!-- ###################################### Summary ###################################### -->
                                <div id="box1" class="tabdiv">
                                    <apex:outputpanel id="summary">
                                        <apex:panelGrid columns="2" border="0" width="98%" style="margin-bottom: 10px;">
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Current Situation"/> <c:helpIcon helpText="Information about the company's current state. Tell me about your current communication solution"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4"  style="height: 200px;" styleclass="fullwidthWithBorder notes currentSituationSum"  value="{!lq.Current_Situation__c}" onchange="setValToElement($(this).val(), $('.currentSituation'));"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Benefits"/> <c:helpIcon helpText="How would their business be positively impacted by resolving these problems? What would it mean to your business if these problems were resolved?"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4"  style="height: 200px;" styleclass="fullwidthWithBorder notes benefitsSum"  value="{!lq.Benefits__c}" onchange="setValToElement($(this).val(), $('.benefits'));"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Problems"/> <c:helpIcon helpText="What are the challenges they have with their current solution?"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4" style="height: 200px;"  styleclass="fullwidthWithBorder notes problemsSum"  value="{!lq.Problems__c}" onchange="setValToElement($(this).val(), $('.problems'));"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Decision Making"/> <c:helpIcon helpText="What is their decision making progress? Who are the decision makers? What is their project time frame?"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4"  style="height: 200px;" styleclass="fullwidthWithBorder notes decisionMakingSum"  value="{!lq.Decision_Making_Process__c}" onchange="setValToElement($(this).val(), $('.decisionMaking'));"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Impact"/> <c:helpIcon helpText="What are the impacts of the problems they are experiencing?"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4"  style="height: 200px;" styleclass="fullwidthWithBorder notes impactSum"  value="{!lq.Impact__c}" onchange="setValToElement($(this).val(), $('.impact'));"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Competitive Landscape"/> <c:helpIcon helpText="What other solutions are they looking for? What are we replacing?"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4"  style="height: 200px;" styleclass="fullwidthWithBorder notes competitiveLandscapeSum"  value="{!lq.Competitive_Landscape__c}" onchange="setValToElement($(this).val(), $('.competitiveLandscape'));" />
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Ideal Situation"/> <c:helpIcon helpText="What would be their ideal solution? How would they like their communication system to work?"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4"  style="height: 200px;" styleclass="fullwidthWithBorder notes idealSituationSum"  value="{!lq.Ideal_Situation__c}" onchange="setValToElement($(this).val(), $('.idealSituation'));"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Relationship Building Extras"/> <c:helpIcon helpText="Any RBEs that were conducted"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4"  style="height: 200px;" styleclass="fullwidthWithBorder notes relationshipBuildingExtrasSum"  value="{!lq.Relationship_Building_Extras__c}" onchange="setValToElement($(this).val(), $('.relationshipBuildingExtras'));"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Next Steps"/> <c:helpIcon helpText="Confirm the customer is willing to meet. What is the next ideal meeting time? How would they like to meet, who shoud attend?"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4" style="height: 120px;"  styleclass="fullwidthWithBorder discoveryNotes"  value="{!lq.NextSteps__c}" id="nxt"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Coaching Notes"/>
                                                </div>
                                                <div>
                                                    <apex:inputTextarea rows="4"  style="height: 120px;" styleclass="fullwidthWithBorder managerNotes"  value="{!lq.CoachingNotes__c}" id="mngr"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel"  value="Mutual Plan"/> <c:helpIcon helpText="Information about the Mutual Plan."/>
                                                </div>
                                                <div>
                                                    <apex:inputField styleclass="mutualPlanSum"  value="{!lq.Mutual_Plan__c}" onchange="setValToElement($(this).val(), $('.mutualPlan'));"/>
                                                </div>
                                            </apex:outputpanel>
                                            <apex:outputpanel >
                                                <div>
                                                    <apex:outputLabel styleclass="textlabel" value="RC Executive Alignment"/> <c:helpIcon helpText="Information about RC Executive Alignment"/>
                                                </div>
                                                <div>
                                                    <apex:inputField styleclass="rcExecAlignSum" value="{!lq.RC_Executive_Alignment__c}" onchange="setValToElement($(this).val(), $('.rcExecAlign'));"/>
                                                </div>
                                            </apex:outputpanel>
                                        </apex:panelGrid>
                                    </apex:outputpanel>
                                </div>

                                <div id="box0" class="tabdiv">
                                    <div >
                                        <apex:pageBlock >
                                            <apex:pageBlockTable value="{!history}" var="historyItem" cellpadding="2" styleClass="tableBorder" rendered="true">
                                                <apex:column >
                                                    <apex:facet name="header">User Name</apex:facet>
                                                    <apex:outputText >{!historyItem.changer}</apex:outputText>
                                                </apex:column>
                                                <apex:column >
                                                    <apex:facet name="header">Modified field</apex:facet>
                                                    <apex:outputText >{!historyItem.fieldName}</apex:outputText>
                                                </apex:column>
                                                <apex:column >
                                                    <apex:facet name="header">Modified date</apex:facet>
                                                    <apex:outputText value="{0, date, M/d/yyyy HH:mm:ss}">
                                                        <apex:param value="{!historyItem.modifyDate + offset}"/>
                                                    </apex:outputText>
                                                </apex:column>
                                            </apex:pageBlockTable>
                                        </apex:pageBlock>
                                    </div>
                                </div>

                                <!-- ###################################### Current Situation ###################################### -->
                                <div id="box2" class="tabdiv">
                                    <apex:panelGrid columns="1"  border="0" columnClasses="panelgridFull" style="width:98%">
                                        <apex:outputpanel >
                                            <div class="blockHeader textlabel"><h3>What to look for</h3></div> <br/>
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>Understand their Company, their Industry, Geography, Size of Company - Learn more about them and their team/department </li>
                                                    <li>What are typical business problems that companies in their industry face that might be leading them to consider change? What is important to the business as a whole?</li>
                                                    <li>What are their cultural priorities and views around internal and external communications?</li>
                                                    <li>What does their current communications environment look like? (Legacy systems, on-prem, cloud technologies, PBX, Web Conferencing, IM, etc)</li>
                                                </ul>
                                            </div><br/>
                                            <div class="blockHeader textlabel"><h3>Current Situation Questions</h3></div> <br/>
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>Tell me about your current situation. How does your team currently communicate internally? (Voice, Collaboration, IM, Meetings, Conference calls, Contact Center)</li>
                                                    <li>How is your team currently communicating externally? (Voice, Collaboration, IM, Meetings, Conference calls, Contact Center)</li>
                                                    <li>Tell me about your office locations</li>
                                                    <li>Say more about your role in this process? Elaborate on some of the other team members who will be involved?</li>
                                                </ul>
                                            </div>
                                            <div>
                                                <apex:outputLabel styleclass="textlabel"  value="Current Situation"/>
                                            </div>
                                            <div>
                                                <apex:inputTextarea rows="4"   styleclass="notes currentSituation"  value="{!lq.Current_Situation__c}" onchange="setValToElement($(this).val(), $('.currentSituationSum'));"/>
                                            </div>
                                        </apex:outputpanel>
                                    </apex:panelGrid>
                                </div>

                                <!-- ###################################### Benefits ###################################### -->
                                <div id="box3" class="tabdiv">
                                    <apex:panelGrid columns="1"  border="0" columnClasses="panelgridFull" style="width:98%" id="benefits">
                                        <apex:outputpanel >
                                            <div class="blockHeader textlabel"><h3>What to look for</h3></div> <br/>
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>The purpose of benefit questions is to prompt the customer to express what the benefits of their ideal solution would be. What will the business achieve or change with a better communications solution?</li>
                                                    <li>Benefit questions focus the interaction on the value of a solution, not the problem. Get the Customer to tell you what the value of a solution means to them. </li>
                                                </ul>
                                            </div><br/>
                                            <div class="blockHeader textlabel"><h3>Benefit Questions</h3></div> <br/>
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>What would some of the benefits be of creating this ideal situation?</li>
                                                    <li>If we could do this, what gains would you realize as a result of solving the problems you currently have?</li>
                                                    <li>How would an improved business communications system be of benefit?</li>
                                                    <li>Why would you benefit from this communications upgrade?</li>
                                                    <li>How would that make life easier for your employees? For your customers?</li>
                                                    <li>What’s the benefit of…</li>
                                                    <li>What would be some examples of how this solution could benefit your…</li>
                                                </ul>
                                            </div>
                                            <div>
                                                <apex:outputLabel styleclass="textlabel"  value="Benefits"/>
                                            </div>
                                            <div>
                                                <apex:inputTextarea rows="4"   styleclass="notes benefits"  value="{!lq.Benefits__c}" onchange="setValToElement($(this).val(), $('.benefitsSum'));"/>
                                            </div>
                                        </apex:outputpanel>
                                    </apex:panelGrid>
                                </div>

                                <!-- ###################################### Problems ###################################### -->
                                <div id="box4" class="tabdiv">
                                    <apex:panelGrid columns="1"  border="0" columnClasses="panelgridFull" style="width:98%" id="problems">
                                        <apex:outputpanel >
                                            <div class="blockHeader textlabel"><h3>What to look for</h3></div> <br/>
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>Business Drivers: Deeper understanding of business drivers and pain points. (Check the Industry Tab in SFDC for pain points)</li>
                                                    <li>What is the business problem(s) that need solving? </li>
                                                    <li>What Is driving the decision? (Impending Changes, Improvement of Productivity, Minimizing Risks). </li>
                                                </ul>
                                            </div><br/>
                                            <div class="blockHeader textlabel"><h3>Problem Questions</h3></div> <br/>
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>What do you like about your current solution? What do you dislike about your current solution? </li>
                                                    <li>What would you like to see altered or improved?</li>
                                                    <li>Elaborate on that problem a bit more for me.Tell me more about that pain point</li>
                                                    <li>What has changed recently in your environment that spurred interest in making this a project?</li>
                                                    <li>When it comes to the executive team, how do they feel about these issues?</li>
                                                </ul>
                                            </div><br/>
                                            <div>
                                                <apex:outputLabel styleclass="textlabel"  value="Problems"/>
                                            </div>
                                            <div>
                                                <apex:inputTextarea rows="4"   styleclass="discoveryNotes problems"  value="{!lq.Problems__c}" onchange="setValToElement($(this).val(), $('.problemsSum'));"/>
                                            </div>
                                        </apex:outputpanel>
                                    </apex:panelGrid>
                                </div>


                                <!-- ###################################### Decision Making ###################################### -->
                                <div id="box5" class="tabdiv">
                                    <apex:panelGrid columns="1"  border="0" columnClasses="panelgridFull" style="width:98%" id="decisionMaking">
                                        <apex:outputpanel >
                                            <div class="blockHeader textlabel"><h3>What to look for</h3></div> <br/>
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>The decision making process and the people involved in making the decision</li>
                                                    <li>What makes up their entire evaluation criteria?</li>
                                                    <li>Are they formalizing the decision process with an RFP? If so, who is writing it? Can it be influenced before publication?</li>
                                                    <li>What is your Give-Get strategy for this opportunity?</li>
                                                </ul>
                                            </div><br/>
                                            <div class="blockHeader textlabel"><h3>Decision Making Questions</h3></div> <br/>
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>Tell me more about the players that will be involved in the decision making process?</li>
                                                    <li>Elaborate on the economic buyer?</li>
                                                    <li>Say more about the steps in your decision making process? How did you come up with your decision making process?</li>
                                                    <li>How will the budgetary/finance issues be handled?</li>
                                                    <li>Tell me more about your internal budget approval process?</li>
                                                    <li>Describe the implementation timeline and how that relates to a decision date</li>
                                                </ul>
                                            </div>
                                            <div>
                                                <apex:outputLabel styleclass="textlabel"  value="Decision Making"/>
                                            </div>
                                            <div>
                                                <apex:inputTextarea rows="4"   styleclass="notes decisionMaking"  value="{!lq.Decision_Making_Process__c}" onchange="setValToElement($(this).val(), $('.decisionMakingSum'));"/>
                                            </div>
                                        </apex:outputpanel>
                                    </apex:panelGrid>
                                </div>

                                <!-- ###################################### Impact ###################################### -->
