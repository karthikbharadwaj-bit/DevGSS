                                        <apex:outputpanel >
                                            <div class="blockHeader textlabel"><h3>RBE</h3></div> <br/>
                                            <!--<div class="blockHeader textlabel"><h3>What to look for</h3></div> <br/>-->
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>Your success hinges largely on strong client relationships. Exceptional client service constitutes a core value for the business, and we always aim to become a trusted partner of our clients, rather than viewing ourselves as a vendor. Differentiate yourself from the competition through strong relationships, and become a trusted partner – not just a sales rep</li>
                                                    <li>Get to know their industry and company</li>
                                                    <li>Get to know the person, their interests, their personality, their family</li>
                                                    <li>Go the extra mile</li>
                                                    <li>Add a personal touch</li>
                                                    <li>Be more than just a sales rep</li>
                                                    <li>Be more than just an email address</li>
                                                    <li>Remember: People buy from people</li>
                                                </ul>
                                            </div><br/>
                                            <!--<div class="blockHeader textlabel"><h3>Motivation Questions</h3></div> <br/>
                                            <div>
                                                <ul class="removeMargin textlabel lightInsight">
                                                    <li>Can you please give me an overview of your company?</li>
                                                    <li>Can you tell me about your organization?</li>
                                                    <li>Who are the people leading the investigation of new solutions?</li>
                                                    <li>Can you share what led you to contact RingCentral and begin these communications?</li>
                                                    <li>How can we help you?</li>
                                                </ul>
                                            </div>
                                            <apex:outputLabel styleclass="textlabel"  value="Motivation Notes"/>
                                            <apex:inputTextarea rows="8"   styleclass="fullwidthWithBorder"  value="{!wrpNotes.sMotivations2}"/> -->
                                            <div>
                                                <apex:outputLabel styleclass="textlabel"  value="Relationship Building Extras"/>
                                            </div>
                                            <div>
                                                <apex:inputTextarea rows="4"   styleclass="notes relationshipBuildingExtras"  value="{!lq.Relationship_Building_Extras__c}"  onchange="setValToElement($(this).val(), $('.relationshipBuildingExtrasSum'));"/>
                                            </div>
                                        </apex:outputpanel>
                                    </apex:panelGrid>
                                </div>

                            </div>
                        </div>
                    </div>
                </apex:outputpanel>
            </div>

            <apex:outputpanel rendered="{!viewMode == 'read'}" >
                <script>
                    $(".NewDiscoverySection").find("input,select,textarea").prop('disabled',true);
                </script>
            </apex:outputpanel>
            <apex:actionStatus id="renderMeStatus" onStart="showOverlay();" onstop="jsLoad();hideOverlay();"/>


            <!-- -------------------------New Discovery section ends------------------------- -->
            <div class="btnDiv" id="readModeButton"   >
                <apex:outputpanel rendered="{!viewMode == 'read'}">
                    <apex:commandButton value="Edit" reRender="container" action="{!showEdit}" status="renderMeStatus" style="padding: 8px 20px 8px 20px;" />
                </apex:outputpanel>
                <apex:outputpanel rendered="{!viewMode == 'edit'}">
                    <apex:commandButton value="Save" action="{!save}" status="renderMeStatus" style="padding: 8px 20px 8px 20px;" oncomplete="parentRefresh();"/>
                    <apex:commandButton value="Cancel"  onClick="return ConfirmUserAction('Do you really want to continue without saving changes?')" status="renderMeStatus" style="padding: 8px 20px 8px 20px;"/>
                </apex:outputpanel>

            </div>

            <script>
                function jsLoad(){
                    initiateTabs('.box-wrap','{"activeTab" : 0}');
                    $("#tabsItems").find("li").on('click',function(){

                        var targetId = $(this).attr('id');
                        $(".box-wrap").children('.tabdiv').hide();
                        $(targetId).show();
                        $(this).siblings().removeClass('tabActiveHeader');
                        $(this).addClass('tabActiveHeader');
                    });

                    CheckErrorTabs();
                    <!-- ---------------------------------------------As/Simplion/7/3/2014-------------------- -->
                    TextAreaLengthCheck('.discoveryNotes','Discovery Notes',32000);
                    TextAreaLengthCheck('.discoveryNextStep','Next Step',32000);
                    TextAreaLengthCheck('.notes','Manger Notes',32000);
                }

                jsLoad();

                function setFocusOnLoad() {
                    $('.discoveryNotes').blur();
                    $('.discoveryNextStep').blur();
                    $('.notes').blur();
                }
                <!-- ---------------------------------------------As/Simplion/7/3/2014-------------------- -->
                //sets given value to the given element. Needed to dynamically change text from current situation inputTextarea on Sum page to current situation inputTextarea on current situation page.
                function setValToElement(value, field) {
                    $(field).val(value);
                }
            </script>

        </apex:form>
    </apex:outputpanel>
    <div id="overlay"></div>
</apex:page>