<apex:page standardController="Opportunity" extensions="OpportunityDiscoveryControllerEBM">
    <apex:outputpanel id="container">
        <apex:form >
            <script src="{!URLFOR($Resource.JqueryAccordion, 'JqueryAccordion/jquery-1.9.1.js')}"></script>
            <style>
                .textlabel {
                    color: #084B8A;
                    font-size: 13px
                }
                #innerheaderDiv {
                    padding:10px !important;
                    width: 50%;
                    margin: 0px 28px;
                }
                .NewDiscoverySection{
