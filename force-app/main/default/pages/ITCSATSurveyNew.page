<apex:page showHeader="false">
    <head>
        <title>IT CSAT Survey</title>
    </head>

    <style type="text/css">
        .radio-group .slds-radio_button-group {
            display: flex;
            border: 0;
        }

        .radio-group .slds-radio_button-group .slds-radio_button {
            flex-grow: 1;
            text-align: center;
        }

        .radio-group .slds-radio_button-group .slds-radio_button__label {
            width: 100%;
        }

        .comment-textarea .slds-form-element__control .slds-textarea {
            min-height: 100px;
        }

        .message-icon use {
            fill: white;
        }
    </style>

    <div style="width: 750px; padding: 10px; margin: 0 auto;">
        <apex:includeLightning />
        <div id="lightning" />
        <script>
            $Lightning.use("c:itCsatSurveyNewApp", function () {
                $Lightning.createComponent("c:itCsatSurveyNew", {}, "lightning");
            });
        </script>
    </div>


</apex:page>