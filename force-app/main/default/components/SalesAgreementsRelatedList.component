<apex:component >
    <apex:attribute name="quotes" type="Quote[]" description="Quotes to show"/>
    <style type="text/css">
        body {
            margin: 0;
        }
    </style>

    <apex:form id="list">
        <apex:pageBlock title="Sales Agreements">
            <!--<apex:pageBlockButtons>-->
                <!--<apex:commandButton action="{!getQuotes}" value="Refresh" reRender="list"/>-->
            <!--</apex:pageBlockButtons>-->
            <apex:pageBlockTable value="{!quotes}" var="q">
                <apex:column headerValue="Sales Agreement Number">
                    <apex:outputLink value="{!URLFOR($Action.Quote.View, q.Id)}"
                                     target="_parent">
                            {!q.QuoteNumber}
                    </apex:outputLink>
                </apex:column>
                <apex:column headerValue="Sales Agreement Name">
                    <apex:outputLink value="{!URLFOR($Action.Quote.View, q.Id)}"
                                     target="_parent">
                            {!q.Name}
                    </apex:outputLink>
                </apex:column>
                <apex:column value="{!q.Status}"/>
                <apex:column value="{!q.First_Year_Cost_of_Service__c}"/>
                <apex:column value="{!q.First_Year_Discount__c}"/>
                <apex:column value="{!q.ProServ_Sold_Date__c}"/>
            </apex:pageBlockTable>
        </apex:pageBlock>
    </apex:form>
</apex:component>