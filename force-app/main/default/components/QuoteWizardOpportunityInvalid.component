<apex:component id="QuoteWizardOpportunityInvalid">
    <apex:attribute name="recordTypeId" description="Record Type Id" type="String" required="true"/>
    <apex:attribute name="accId" description="Account Id" type="String" required="true"/>
    <head>
        <style>
            html,
            body,
            iframe {
                height: 100%;
                width: 100%;
            }
            html body.sfdcBody {
                padding: 0; /* Fix default padding */
            }
            .placeholder-container {
                display: flex;
                flex-direction: column;
                justify-content: center;
                height: 100%;
            }
            .placeholder-text {
                text-align: center;
                font-size: large;
            }
        </style>
    </head>
    <body>
        <div class="placeholder-container">
            <div class="placeholder-text">
                Opportunity was created with errors, you cannot proceed with Quote creation. <br></br>
                Please, create new opportunity using 
                <strong>
                    <a href="/apex/OpportunityCreationForm?RecordType={!recordTypeId}&accid={!accId}&ent=Opportunity&save_new=1&sfdc.override=1">this link</a>
                </strong>.
            </div>
        </div>
    </body>
</apex:component>