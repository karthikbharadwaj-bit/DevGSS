<apex:component controller="RCSupportControllerHandler">
    <script src="{!URLFOR($Resource.RCSupportPortal, 'supportPortal/js/libs/jquery-1.8.2.js')}"></script>
    <style>
        .my-case {
            margin-top: -10px !important;
        }
        .contact-support-container article.app {
            padding: 24px!important;
        }
        .contact-support-container .img-container.chat_support {
            background: url('{!URLFOR($Resource.RCSupportPortal, 'supportPortal/img/icon_2.png')}') 34px 10px no-repeat;
            display: block;
            width: 200px;
        }
        .contact-support-container .img-container.case2 {
            background: url('{!URLFOR($Resource.RCSupportPortal, 'supportPortal/img/icon_1.png')}') 26px 0px no-repeat;
            display: block;
            width: 200px;
        }
        .contact-support-container .img-container.call_support2 {
            background: url('{!URLFOR($Resource.RCSupportPortal, 'supportPortal/img/icon_3.png')}') 29px 5px no-repeat;
            display: block;
            width: 200px;
        }
        .contact-support-container .img-container.community2 {
            background: url('{!URLFOR($Resource.RCSupportPortal, 'supportPortal/img/icon_4.png')}') 48px 0px no-repeat;
            display: block;
            width: 200px;
        }
        .newapp {
            height: 315px !important;
            width: 174px !important;
        }
        .contact-support-container .container-desc h3 {
            font-size: 20px!important;
            margin-bottom: 10px !important;
        }
        .chat-content {
            width: 240px;
            float: left;
        }
        .dockableContainer {
            max-height: 498px !important;
        }
        .coveo-labels{
            margin: .95rem 0;
        }
         .slds-button {
            line-height: 1.875rem;
        }
         .cSnapInsPreChat .form__name-row {
            line-height: 1.5;
        }
         .cSnapInsPreChat .form__name-row {
            line-height: 1.5;
        }
        .dockableContainer .slds-input {
            line-height: 1.875rem;
        }
        .dockableContainer .slds-input:focus {
            box-shadow: rgb(0, 112, 210) 0px 0px 3px;
            border: 1px solid #e4e5e6 !important;
        }
        .dockableContainer .pre-chat__form label {
            font-size: 12px !important;
            font-weight: 500 !important;
        }
        .pre-chat__message {
            font-weight: 500 !important;
        }

    </style>
    <Style>
        .Chat_OfflineMsg {
            background: url('{!URLFOR($Resource.RCSupportPortal, 'supportPortal/img/icon_2.png')}') no-repeat scroll transparent;
            display: block;
            height: 200px;
            float: right;
            width: 200px;
            position: absolute;
            margin-left: 260px;
        }
        .chat-content a.link_set {
            color: #4541E3;
            cursor: pointer;
            margin-top: 16px;
            position: absolute;
            margin-left: -80px;
            font-weight: initial;
            word-break: break-all;
            width: 240px;
        }
        .caseStatus-button {
            margin-left: -21px;
            width: 220px;
        }
    </Style>
    <style type="text/css">
        #overlay11 {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #000;
            filter: alpha(opacity=70);
            -moz-opacity: 0.7;
            -khtml-opacity: 0.7;
            -ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=70)";
            opacity: 0.7;
            z-index: 9999;
            display: none;
        }
        .content a {
            text-decoration: none;
        }
        .popup {
            width: 900px;
            margin-top: -100px;
            margin-left: 50px;
            display: none;
            position: fixed;
            z-index: 10000;
        }
        .content {
            min-width: 416px;
            width: 374px;
            min-height: 165px;
            margin: 50px auto;
            background: #f3f3f3;
            position: relative;
            z-index: 103;
            padding: 10px;
            border-radius: 5px;
            box-shadow: 0 2px 5px #000;
        }
        .content p {
            clear: both;
            color: #555555;
            text-align: justify;
        }
        .content p a {
            color: #d91900;
            font-weight: bold;
        }
        .content .x {
            float: right;
            height: 16px;
            left: 10px;
            position: relative;
            top: -10px;
            width: 20px;
            border-top-right-radius: inherit;
            border-bottom-left-radius: inherit;
        }
        .content .x:hover {
            cursor: pointer;
        }
        .container-desc {
            margin-top: -30px;
        }
        .contact-support-container .container-desc h3 {
            color: rgb(79, 146, 242);
        }
        .chat-wrapper {
            width: 300px;
            padding: 20px;
            position: fixed;
        }
        #liveagent_button_offline_57334000000GnN7{
            -webkit-filter: grayscale(100%);
            filter: grayscale(100%);
            filter: gray;
            filter: url("data:image/svg+xml;utf8,<svg version='1.1' xmlns='http://www.w3.org/2000/svg' height='0'><filter id='greyscale'><feColorMatrix type='matrix' values='0.3333 0.3333 0.3333 0 0 0.3333 0.3333 0.3333 0 0 0.3333 0.3333 0.3333 0 0 0 0 0 1 0' /></filter></svg>#greyscale");
        }
    </style>
    <apex:form forceSSL="{!isGuestUser}">

        <c:RCSystemStatus Text="Contact Support" rendered="{!!UKPortal}" />
        <c:RCSystemStatusUK Text="Contact Support" rendered="{!UKPortal}" />

        <!-- <apex:include pageName="RCSystemStatus"/>-->
        <div class="contact-support-container">
            <div style='display:none' id='divAccountDL'>
                <apex:inputHidden value="{!accountDL}" />
            </div>
            <div style='display:none' id='divServiceName'>
                <apex:inputHidden value="{!serviceName}" />
            </div>
            <apex:variable var="redirectURL" value="http://www.ringcentral.com/inc/php/salesforce/salesforce.php?NEXTPAGE=community&EMAIL={!objUser.Email}&FIRSTNAME={!objUser.Name}&SFDCID={!objUser.Id}" />
            <apex:outputLink value="{!IF(isGuestUser,'https://community.ringcentral.com',redirectURL)}">
                <article role="application" class=" newapp app">
                    <div class="img-container community2"></div>
                    <div class="container-desc">
                        <h3>Ask the Community</h3>Our community of customers and product experts are ready to answer your questions.</div>
                </article>
            </apex:outputLink>


            <a href="" onclick="embedded_svc.inviteAPI.inviteButton.acceptInvite()">
                <article class=" newapp app" role="application">
                    <div class="img-container chat_support"></div>
                    <div class="container-desc">
                        <h3>Chat with Us</h3>If you need an easier way to get assistance, please chat with us.
                        <br/> <span style="font-size: 13.5px;">Available: 24/7</span>
                    </div>
                </article>
            </a>
                <article class=" newapp app" id="liveagent_button_offline_57334000000GnN7" style="display: none" role="application">
                    <div class="img-container chat_support"></div>
                    <div class="container-desc">
                        <h3>Chat with Us</h3>If you need an easier way to get assistance, please chat with us.
                        <br/> <strong>No Agent Available</strong>
                    </div>
                </article>

            <article role="application" class="newapp app" style="z-index:999;Zindex:999;">
                <apex:commandLink action="{!openCase}" style="z-index:999;Zindex:999;">

                    <div class="img-container case2"></div>
                    <div class="container-desc">
                        <h3>Open a Case</h3>If you can't find an answer or need personalized assistance, simply open a case.
                        <br />
                        <br />
                        <apex:outputpanel rendered="{!isGuestUser == true}">
                            <strong>Already opened a case?</strong>
                        </apex:outputpanel>
                        <br />
                        <br />

                    </div>
                </apex:commandLink>

                <apex:commandLink styleClass="button-contact check-my-status my-case" action="{!openMyCase}" rendered="{!isGuestUser == true}" type="text/html">
                    Check My Case Status
                </apex:commandLink>

            </article>

            <a href='{!$Site.CurrentSiteUrl}RCCallSupport?src=6'>

                <article role="application" class="newapp app last">
                    <!-- <article role="application" class="newapp app last"> -->
                    <div class="img-container call_support2"></div>
                    <div class="container-desc">
                        <h3>Call Support</h3>If you have a critical issue or need assistance opening a case, please call us.
                        <br/>For other requests, please open a case online.
                    </div>
                </article>
            </a>
        </div>
        <div class="check-status">
            <apex:outputPanel id="thePanel" layout="block">

                <c:RCSupportAdvMyCase rendered="{!showCaseList}" />
            </apex:outputPanel>

        </div>

    </apex:form>
    <script type="text/javascript">
        // Support - Inbound Chat
        if (!window._laq) {
            window._laq = [];
        }
        window._laq.push(function() {
            liveagent.showWhenOnline('57334000000GnN7', document.getElementById('liveagent_button_online_57334000000GnN7'));
            liveagent.showWhenOffline('57334000000GnN7', document.getElementById('liveagent_button_offline_57334000000GnN7'));
        });
    </script>
    <script type='text/javascript' src='https://c.la4-c2-chi.salesforceliveagent.com/content/g/js/38.0/deployment.js'></script>
    <script type='text/javascript'>
        liveagent.init('https://d.la4-c2-chi.salesforceliveagent.com/chat', '572800000008OQL', '00D80000000aRUX');
    </script>
</apex:component>