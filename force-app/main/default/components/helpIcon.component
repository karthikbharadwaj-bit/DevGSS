<apex:component selfClosing="true">
    <apex:attribute name="helpText" description="Help Text." type="String" required="true"/>
    <div class="mouseOverInfoOuter" id="searchInvoiceHelper" onfocus="addMouseOver(this)" onmouseover="addMouseOver(this)" tabindex="0" >
         <!-- <img src="/s.png" alt="" class="helpIcon" title="" /> !-->
        <apex:outputPanel rendered="{!$User.UITheme == 'Theme4d'}">
            <apex:image value="{!URLFOR($Resource.HelpIcon_Leadsearch, '/HelpICon/help_orange.png')}">
            </apex:image>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!$User.UITheme == 'Theme3'}">
            <img src="/s.png" alt="" class="helpIcon" title="" />
        </apex:outputPanel>
                          
        <div class="mouseOverInfo" id="searchInvoiceHelperText" style="display: none; left: 16px;">
            
            <div class="body">{!helpText}</div>
        </div>
        
    </div>
</apex:component>