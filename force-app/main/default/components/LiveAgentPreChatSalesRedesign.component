            <input type='hidden' name='liveagent.prechat:Adobe_Target_Id_History__c' id="Adobe_Target_Id_History__c"/>
            <input type='hidden' name='liveagent.prechat:BMID_Old__c' id="BMID_Old__c"/>
           	<input type='hidden' name='liveagent.prechat:RC_Visitor_ID__c' id="RC_Visitor_ID__c"/>            
            <input type="hidden" name="liveagent.prechat.save:ContactFirstName" value="PreChat_Firstname__c" />
            <input type="hidden" name="liveagent.prechat.save:ContactLastName" value="PreChat_Lastname__c" />
            <input type="hidden" name="liveagent.prechat.save:ContactEmail" value="PreChat_Email__c" />
            <input type="hidden" name="liveagent.prechat.save:ContactPhone" value="PreChat_Phone__c" />
            <input type="hidden" name='liveagent.prechat:Company' id='company' value="Unavailable" />
            <input type='hidden' name='liveagent.prechat.save:Company' value="PreChat_Company__c" />
            <input type="hidden" name="liveagent.prechat.save:NumberOfEmployees" value="PreChat_Number_of_Employees__c" />
            <input type='hidden' name='liveagent.prechat.save:OriginalReferrer' value="Original_Referrer__c" />
            <input type="hidden" name="liveagent.prechat.save:BMID" value="BMID__c" />
            <input type="hidden" name="liveagent.prechat.save:AID" value="AID__c" />
            <input type="hidden" name="liveagent.prechat.save:SID" value="SID__c" />
            <input type="hidden" name="liveagent.prechat.save:PID" value="PID__c" />
            <input type="hidden" name="liveagent.prechat.save:RCMT" value="RCMT__c" />
            <input type="hidden" name="liveagent.prechat.save:RCKW" value="RCKW__c" />
            <input type="hidden" name="liveagent.prechat.save:gw_referer" value="GW_Referer__c" />
            <input type="hidden" name="liveagent.prechat.save:Adobe_Target_Id__c" value="Adobe_Target_Id__c" />
            <input type="hidden" name="liveagent.prechat.save:Transaction_Id__c" value="Transaction_Id__c" />
            <input type="hidden" name="liveagent.prechat.save:Adobe_Target_Id_History__c" value="Adobe_Target_Id_History__c" />
           	<input type="hidden" name="liveagent.prechat.save:BMID_Old__c" value="BMID_Old__c" />
         	<input type="hidden" name="liveagent.prechat.save:RC_Visitor_ID__c" value="RC_Visitor_ID__c" />            
            
            <input type="hidden" name="liveagent.prechat:preChatType" value="{!IF(gated,'Gated','Ungated')}"/>
            <input type="hidden" name="liveagent.prechat.save:preChatType" value="PreChatFormType__c" />

          </div>

          <div class="errors">
            <p id="error-text" class="hide">Please complete all fields</p>
          </div>

          <input type='submit' value='Chat with sales' id='prechat_submit' class="chat-button" />

          <p>
            if you are a current customer in need of support
