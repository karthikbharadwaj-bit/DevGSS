    <!-- This script takes the endpoint URL parameter passed from the deployment page and makes it the action for the form -->
    <script type='text/javascript'>

        /*
         * LiveAgent
         */
        var type = {!gated} ? 'gated' : 'ungated';
        var liveAgent = new LiveAgent(type);

        // change window size
        window.onload = function() {
            liveAgent.trackInit();
            // liveAgent.trackTyping();
            liveAgent.trackFocus();
            changeScreenSize();
            restoreEmployeesRequired();
        };

        // validation
        var elements = document.getElementsByClassName('input-field');
        for (var i = 0; i < elements.length; i++) {
          elements[i].addEventListener('change', function(e) {
            if(e.target.value) {
              e.target.classList.remove('has-error')
            }
          });
        }


        (function() {
            function handlePageLoad() {
                try {
                    var endpointMatcher = new RegExp("[\\?\\&]endpoint=([^&#]*)");
                    var domainMatcher = new RegExp("(https?:\\/\\/(.+?\\.)?(salesforce|salesforceliveagent)\\.com(\\/[A-Za-z0-9\\-\\._~:\\/\\?#\[\\]@!$&'\\(\\)\*\\+,;\\=]*)?)");
                    var endpointValue = endpointMatcher.exec(document.location.search)[1] || '';
                    var escapedEndpoint = decodeURIComponent(endpointValue.replace(/javascript/gi, ''));
                    
                    if (domainMatcher.test(escapedEndpoint) === true) {
                        document.getElementById('prechatForm').setAttribute('action', escapedEndpoint);
                        parseEndpoint(escapedEndpoint);
                    }
                } catch (e) { console.log(e); }
            }

            if (window.addEventListener) {
                window.addEventListener('load', handlePageLoad, false);
            } else {
                window.attachEvent('onload', handlePageLoad);
            }
        })();

        // parse endpoint and load scripts
        var endpoint = '';
        function parseEndpoint(endpointParam){
            if (endpointParam) {
                var parser = document.createElement('a');
                parser.href = endpointParam;
                var endpoint = parser.protocol +'//'+ parser.hostname;
                if (endpoint) {
                    liveagent.details.preChatInit(endpoint + '/chat', 'detailCallback');
                }
            }
        }

        // change color of selector
        (function() {
            var selectColor = function(event) {
                event.target.style.color = "#4a4a4c";
            };
            var selectEl = document.getElementById('employees_selector');
                selectEl.style.color = '#757575';
            if (selectEl.addEventListener) {
                selectEl.addEventListener("change", selectColor, false);
                // selectEl.addEventListener("focus", selectColor, false);
            } else {
                selectEl.attachEvent('onchange', selectColor);
                // selectEl.attachEvent('onclick', selectColor);
            }
        })();


        // handle form submit
        var prechatSubmit = function(event) {
            event.preventDefault();

            var validated;
            if({!gated}) validated = validateFormGated();
            else validated = validateFormUngated();

            if (validated) {
                // Set the visitor's name for the agent in the Console to first and last name provided by the customer
                if({!gated}) {
                    document.getElementById("prechat_field_name").value = document.getElementById("firstName").value + " " + document.getElementById("lastName").value;
                }

                liveAgent.trackSubmit();

                // save number of employees to transcript
                var employeesSelector = document.getElementById('employees_selector');
                var selected = employeesSelector.options[employeesSelector.selectedIndex];
                var value = selected.getAttribute('data-value');
                var noeTranscriptField = document.getElementById('number_of_employees');
                noeTranscriptField.value = value;

                event.target.submit();
                return true;
            }
        }


        var prechatForm = document.getElementById('prechatForm');
        if (prechatForm.addEventListener) {
            prechatForm.addEventListener("submit", prechatSubmit);
        } else {
            prechatForm.attachEvent('submit', prechatSubmit);
        }

        function validateFormUngated() {
          var formValid = true;
          var fields = [];

          // Company Size
          fields.push({
              id: "employees_selector",
              rules: [{
                  pass: document.getElementById("employees_selector").value.trim(),
                  message: 'Please provide your company size',
              }]
          });

          fields.forEach(function(field){

              var valid = true;
              var message = '';
              var errorText = document.getElementById('error-text');
              var input = document.getElementById(field.id);
              field.rules.forEach(function(rule){
                  if (!rule.pass) {
                      valid = false;
                      message = rule.message;
                  }
              });
              if (valid) {
                input.classList.remove('has-error');
                errorText.classList.add('hide');
              } else {
                formValid = false;
                input.classList.add('has-error');
                errorText.classList.remove('hide');
              }

          });
          changeScreenSize();
          return formValid;
        }

        function validateFormGated(){
          var formValid = true;
          var fields = [];

          // First Name
          fields.push({
              id: "firstName",
              rules: [{
                  pass: document.getElementById("firstName").value.trim(),
                  message: 'Please provide your first name',
              }]
          });
          // Last Name
          fields.push({
              id: "lastName",
              rules: [{
                  pass: document.getElementById("lastName").value.trim(),
                  message: 'Please provide your last name',
              }]
          });
          // Email
          var email = document.getElementById("email").value.trim();
          fields.push({
              id: "email",
              rules: [
              {
                  pass: validateEmail(email),
                  message: 'Email is invalid',
              },
              {
                  pass: email,
                  message: 'Please provide your email',
              }]
          });

          // Company Size
          fields.push({
              id: "employees_selector",
              rules: [{
                  pass: document.getElementById("employees_selector").value.trim(),
                  message: 'Please provide your company size',
              }]
          });

          fields.forEach(function(field){

              var valid = true;
              var message = '';
              var errorText = document.getElementById('error-text');
              var input = document.getElementById(field.id);
              field.rules.forEach(function(rule){
                  if (!rule.pass) {
                      valid = false;
                      message = rule.message;
                  }
              });
              if (valid) {
                input.classList.remove('has-error');
                errorText.classList.add('hide');
              } else {
                formValid = false;
                input.classList.add('has-error');
                errorText.classList.remove('hide');
              }

          });
          changeScreenSize();
          return formValid;
        }

        function old_validateForm(){
            var formValid = true;
            var fields = [];
            // First Name
            fields.push({
                errorsId: "firstNameError",
                rules: [{
                    pass: document.getElementById("firstName").value.trim(),
                    message: 'Please provide your first name'
                }]
            });
            // Last Name
            fields.push({
                errorsId: "lastNameError",
                rules: [{
                    pass: document.getElementById("lastName").value.trim(),
                    message: 'Please provide your last name'
                }]
            });
            // Email
            var email = document.getElementById("email").value.trim();
            fields.push({
                errorsId: "emailError",
                rules: [
                    {
                        pass: validateEmail(email),
                        message: 'Email is invalid'
                    },
                    {
                        pass: email,
                        message: 'Please provide your email'
                    }]
            });
            // Phone
            fields.push({
                errorsId: "phoneError",
                rules: [{
                    pass: document.getElementById("phone").value.trim(),
                    message: 'Please provide your phone'
                }]
            });
            // Company Name
            fields.push({
                errorsId: "companyError",
                rules: [{
                    pass: document.getElementById("company").value.trim(),
                    message: 'Please provide your company name'
                }]
            });
            // Number of employees
            fields.push({
                errorsId: "employees_selectorError",
                rules: [{
                    pass: document.getElementById("employees_selector").value.trim(),
                    message: 'Please provide how many employees working in your company',
                }]
            });

            fields.forEach(function(field){
                var valid = true;
                var message = '';
                var errorContainer = document.getElementById(field.errorsId);
                field.rules.forEach(function(rule){
                    if (!rule.pass) {
                        valid = false;
                        message = rule.message;
                    }
                });
                if (valid) {
                    errorContainer.style.display="none";
                } else {
                    formValid = false;
                    errorContainer.innerHTML = message;
                    errorContainer.style.display="block";
                }
            });
            changeScreenSize();
            return formValid;
        }

        function validateEmail(email){
            var re = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
            return re.test(email);
        }

        // change window size
        function changeScreenSize() {
            var container = document.getElementById('container');
            var contentWidth = container.offsetWidth;
            var contentHeight = container.offsetHeight;
            var width = contentWidth + (window.outerWidth - window.innerWidth);
            var height = contentHeight + (window.outerHeight - window.innerHeight);
            window.resizeTo(width, height);
        }

        //set empty value for an option to restore native required browser behaviour
        function restoreEmployeesRequired() {
            var placeholder = document.getElementById('employees_selector_placeholder');
            placeholder.value = "";
        }

        //actions on page load
        // function onLoadAction() {
        //     changeScreenSize();
        //     restoreEmployeesRequired();
        // }

        // pre-chat routing
        function detailCallback(details) {
            // read customDetails
            var urlParts = [];
            var titleParts = [];
            for (var i = 0; i < details.customDetails.length; i++) {
                var detail = details.customDetails[i];
                if (detail.label === "url") {
                    // save URL to Transcript
                    var originalReferrer = document.getElementById('original_referrer');
                    originalReferrer.value = details.customDetails[i].value;
                    //parse URL
                    var parser = document.createElement('a');
                    parser.href = detail.value;
                    var hostname = parser.hostname;
                    // parse pathname
                    var pathname = parser.pathname;
                    urlParts = pathname ? pathname.split('/').filter(function(el) {
                        return el
                    }) : [];
                    // parse marketing params
                    var search = parser.search.replace('?', '');
                    var vars = search ? search.split("&") : [];
                    var params = ['BMID', 'AID', 'SID', 'PID', 'RCMT', 'RCKW', 'BMID_Old__c', 'RC_Visitor_ID__c'];
                    if (Array.isArray(vars)) {
                        for (var j = 0; j < vars.length; j++) {
                            var pair = vars[j].split("=");
                            var paramName = pair[0].toUpperCase();
                            if (params.indexOf(paramName) > -1) {
                                // save param to Transcript
                                var inp = document.getElementById(paramName);
                                if (inp) {
                                    inp.value = pair[1];
                                }
                            }
                        }
                    }
                } else if (detail.label === "title") {
                    // parse title
                    var title = detail.value;
                    titleParts = title ? title.split(' ') : [];
                } else if (detail.label === "user_log"){
                    //
                    var user_log = document.getElementById('user_log');
                    user_log.value = detail.value;
                } else if (detail.label === "ref"){
                    // General Web Referrer site info
                    var gw_referer = document.getElementById('gw_referer');
                    gw_referer.value = detail.value;
                } else if (detail.label === "Adobe_Target_Id__c"){
                    // A/B 360 Analytics
                    var adobeTargId = document.getElementById('Adobe_Target_Id__c');
                    adobeTargId.value = detail.value;
                } else if (detail.label === "Transaction_Id__c"){
                    // A/B 360 Analytics
                    var transaction = document.getElementById('Transaction_Id__c');
                    transaction.value = detail.value;
                } else if (detail.label === "phone"){
                    // Dynamic Phone Number
                    var phone = detail.value;
                    if (phone){
                        var dynamicPhone = document.getElementById('dynamicPhone');
                        dynamicPhone.innerHTML = phone;
                    }
                }
            }
            // route rules
            var haystack = urlParts.concat(titleParts);
            var keywords = ['fax', 'pro'];
            var routeTo = '';
            if (Array.isArray(haystack)) {
                for (var a = 0; a < haystack.length; a++) {
                    var haystackItem = haystack[a].toLowerCase();
                    if (keywords.indexOf(haystackItem) > -1) {
                        routeTo = haystackItem;
                        break;
                    }
                }
            }
            var button_id = '';
            if (routeTo === 'fax') {
                button_id = '{!IF(type=='ProActive',buttons['US_ProActive_Fax']+','+buttons['US_Team_ProActive_Chats'],buttons['US_Fax']+','+buttons['US_Team'])}'; // US ProActive - Fax || US Fax
            } else if (routeTo === 'pro') {
                button_id = '{!IF(type=='ProActive',buttons['US_ProActive_Pro']+','+buttons['US_Team_ProActive_Chats'],buttons['US_Pro']+','+buttons['US_Team'])}'; // US ProActive - Pro || US Pro
            }
            var employeesSelector = document.getElementById('employees_selector');
            var employeesSelectorOptions = employeesSelector.getElementsByTagName('option');
            if (button_id) {
                // create liveagent.prechat.buttons element with button id for routing
                for (var n = 0; n < employeesSelectorOptions.length; n++) {
                    employeesSelectorOptions[n].value = button_id;
                }
            }
        }
    </script>

</apex:component>