            <!-- searchKnowledge: Searches knowledge article based on the text, this assumes that Knowledge is setup -->
            <!--  <input type="hidden" name="liveagent.prechat.knowledgeSearch:CaseSubject" value="true"/> -->
            <!-- Marketing params 'BMID', 'AID', 'SID', 'PID', 'RCMT', 'RCKW'-->
            <input type='hidden' name='liveagent.prechat:BMID' id='BMID' />
            <input type='hidden' name='liveagent.prechat:AID' id='AID' />
            <input type='hidden' name='liveagent.prechat:SID' id='SID' />
            <input type='hidden' name='liveagent.prechat:PID' id='PID' />
            <input type='hidden' name='liveagent.prechat:RCMT' id='RCMT' />
            <input type='hidden' name='liveagent.prechat:RCKW' id='RCKW' />
            <input type='hidden' name='liveagent.prechat:NumberOfEmployees' id='number_of_employees' />
            <input type='hidden' name='liveagent.prechat:OriginalReferrer' id='original_referrer' />
            <input type='hidden' name='liveagent.prechat:user_log' id="user_log"/>
            <input type='hidden' name='liveagent.prechat:gw_referer' id="gw_referer"/>
            <input type='hidden' name='liveagent.prechat:Adobe_Target_Id__c' id="Adobe_Target_Id__c"/>
