<aura:component implements="force:appHostable,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable" access="global"
                controller = "Lead_ReferAsReseller">
    
          <aura:handler name="init" value="{!this}" action="{!c.redirectToPartnerRequest}"/>
   
</aura:component>