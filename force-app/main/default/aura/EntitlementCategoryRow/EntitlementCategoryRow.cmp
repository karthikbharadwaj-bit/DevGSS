<aura:component>

    <aura:attribute name="categoryName" type="String"/>
    <aura:attribute name="data" type="List"/>
    <aura:attribute name="index" type="Integer"/>
    <aura:attribute name="isShowList" type="Boolean"/>
    <aura:attribute name="class" type="String"/>
    <aura:attribute name="isGroupedView" type="Boolean" default="false"/>

    <!-- Action row -->
    <tbody class="{!v.class}">
    <tr>
        <td colspan="9" class="category-row">
            <div class="action-wrapper entitlement" onclick="{!c.showList}">
                <div class="show-action">
                    <lightning:icon class="arrow-icon" iconName="{!v.isShowList ? 'utility:down' : 'utility:right'}"
                                    size="xx-small" alternativeText="{!v.isShowList ? 'down' : 'right'}"/>
                    <p class="slds-text-color--weak slds-p-left--large">{!v.categoryName} ({!v.data.length})</p>
                </div>
            </div>
        </td>
    </tr>
    </tbody>


    <!-- List -->
    <aura:if isTrue="{!v.isShowList}">
        <tbody class="{!v.class}">
        <aura:iteration items="{!v.data}" var="item">
            <aura:if isTrue="{!and(v.isGroupedView, item.isGrouped)}">
                <c:EntitlementGroupedLicenseRow data="{!item}"/>
                <aura:set attribute="else">
                    <c:EntitlementRow data="{!item}"/>
                </aura:set>
            </aura:if>
        </aura:iteration>
        </tbody>
    </aura:if>

</aura:component>