<aura:component controller="DQ_QueueMemberTooltipController">
	<aura:attribute name="queueId" type="String" />
	<aura:attribute name="users" type="String" access="PRIVATE" />
	<aura:handler name="init" value="{!this}" action="{!c.onInit}" />


	<aura:if isTrue="{!v.users}">
		<lightning:helptext content="{!v.users}" iconName="utility:groups" class="slds-m-horizontal_x-small" />
	</aura:if>
</aura:component>