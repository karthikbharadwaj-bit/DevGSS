<aura:event type="APPLICATION">
    <aura:attribute name="opportunityId" type="String" />
    <aura:attribute name="currencyIsoCode" type="String" />
    <aura:attribute name="servicePlan" type="String" />
    <aura:attribute name="rcTier" type="String" />
    <aura:attribute name="rcUserId" type="String" />
    <aura:attribute name="paymentPlan" type="String" />
    <aura:attribute name="numberDLs" type="Decimal" />
    <aura:attribute name="contractDays" type="Integer" />
    <aura:attribute name="currentDiscounts" type="String" />
    <aura:attribute name="recordTypeName" type="String" />
    <aura:attribute name="stageName" type="String" description="Opportunity.StageName"/>
    <aura:attribute name="effectiveNoOfEmployeesRange" type="String" description="Opportunity.Effective_No_of_Employees_Range__c"/>
    <aura:attribute name="defaultUpsellStatus" type="String" description="Upsell status for use if Quote has not been created yet"/>
    <aura:attribute name="tiers" type="List" description="List of Tiers (Service Plans)"/>
    <aura:attribute name="initialQuote" type="Quote" description="Primary or last modified Quote"/>
    <aura:attribute name="quoteTypeValues" type="String[]" description="Quote.QuoteType__c (Quote Stage in Wisard) picklist values"/>
    <aura:attribute name="initialTermMonthsValues" type="String[]" description="Initial Term picklist values"/>
    <aura:attribute name="specialTermsValues" type="String[]" description="Special Terms picklist values"/>
    <aura:attribute name="termMonthsValues" type="String[]" description="Renewal Term picklist values"/>
    <aura:attribute name="statusValues" type="String[]" description="Agreement Status picklist values"/>
    <aura:attribute name="proServStatusValues" type="String[]" description="ProServ Status picklist values"/>
</aura:event>