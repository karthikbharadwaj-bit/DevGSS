<aura:component >
<aura:attribute type="List" name="DQQuoteList" />
    <aura:if isTrue="{!not(empty(v.DQQuoteList))}">
    <table class="slds-table slds-table_bordered slds-table_cell-buffer"> 
        <thead>
            <tr class="slds-text-title_caps">
                <th scope="col">
                    <div class="slds-truncate">Quote Name</div>
                </th>
                <th scope="col">Status</th>
                <th scope="col"></th>
                <th scope="col"></th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            <aura:iteration items="{!v.DQQuoteList}" var="objQuoteRec" indexVar="rowIndex">
                <tr >
                    <td scope="col" style="width:15%">
                        {!objQuoteRec.Name}
                    </td>
                    <td>Approved</td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </aura:iteration>
        </tbody>
    </table>
    <aura:set attribute="else">
        <br/>
        <span>No Quote Record</span>
    </aura:set>
</aura:if>
</aura:component>