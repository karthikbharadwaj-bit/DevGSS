<aura:component controller="DocuSignController">

    <!-- Attributes -->
    <aura:attribute name="app" type="Object"/>
    <aura:attribute name="primaryQuoteId" type="String"/>

    <!-- Component Attributes -->
    <aura:attribute name="isEnvelopesLoading" type="Boolean"/>

    <!-- Methods -->
    <aura:method name="refreshEnvelopes"/>

    <!-- Event Handlers -->
    <aura:handler name="envelopeVoidClicked" event="c:ComponentEvent" action="{! c.envelopeVoidClicked }"/>

    <!-- Register Event -->
    <aura:registerEvent name="docuSignEnvelopeListRefresh" type="c:ComponentEvent"/>

    <lightning:layoutItem size="12" class="fade-in-base" aura:id="fadeInContainer">
        <div class="section fade-in-card_1">
            <div class="slds-grid slds-grid_vertical-align-center slds-m-bottom_small">
                <h2 class="slds-text-heading_medium slds-col_bump-right">Envelopes</h2>
                <lightning:buttonIcon iconName="utility:refresh"
                                      alternativeText="Refresh"
                                      disabled="{! v.isEnvelopesLoading }"
                                      onclick="{! c.refreshEnvelopes }"/>

                <c:Button label="New Envelope"
                          variant="brand"
                          class="slds-m-left_medium"
                          onclick="{! c.openSendTab }"/>
            </div>
            <aura:if isTrue="{! and(not(v.isEnvelopesLoading), v.app.envelopes.length > 0) }">
                <lightning:layout
                    class="slds-media__body slds-border_bottom slds-text-title_caps header">
                    <lightning:layoutItem size="3">
                        <p>Envelope</p>
                    </lightning:layoutItem>
                    <lightning:layoutItem size="7">
                        <p>Attachments</p>
                    </lightning:layoutItem>
                    <lightning:layoutItem size="1">
                        <p>Status</p>
                    </lightning:layoutItem>
                </lightning:layout>
                <ul>
                    <aura:iteration items="{! v.app.envelopes }" var="envelope" indexVar="index">
                        <c:DocuSignEnvelope envelope="{! envelope }" app="{! v.app }"/>
                    </aura:iteration>
                </ul>
            </aura:if>

            <!-- Info Message -->
            <aura:if isTrue="{! and(not(v.isEnvelopesLoading), v.app.envelopes.length == 0) }">
                <p class="info-message slds-p-around_small slds-text-align_center">No Envelopes found</p>
            </aura:if>

            <!-- Loading Placeholder -->
            <aura:if isTrue="{! v.isEnvelopesLoading }">
                <c:LoadingPlaceholder type="list"/>
            </aura:if>

        </div>
    </lightning:layoutItem>
</aura:component>