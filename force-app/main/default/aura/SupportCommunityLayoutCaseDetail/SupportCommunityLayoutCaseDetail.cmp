<aura:component description="Support Community Layout Case Detail" implements="forceCommunity:layout" access="global">
    <aura:attribute name="header" type="Aura.Component[]" required="false"/>
    <aura:attribute name="sideLeft" type="Aura.Component[]" required="false"/>
    <aura:attribute name="center" type="Aura.Component[]" required="false"/>
    <div>
        <div class="wrapper">
            <div class="sc-case-detail__header">{!v.header}</div>
            <div class="sc-case-detail__main">
                <div class="sc-case-detail__left">{!v.sideLeft}</div>
                <div class="sc-case-detail__center">{!v.center}</div>
            </div>
            <c:lwcToasts/>
            <c:lwcModal/>
            <c:lwcSpinner/>
        </div>
    </div>
</aura:component>