<aura:component description="RefundManagementProduct">
    <!-- Attributes -->
    <aura:attribute name="app" type="object"/>
    <aura:attribute name="transaction" type="object"/>
    <aura:attribute name="product" type="object"/>

    <aura:attribute name="padding" type="Integer"/>
    <aura:attribute name="offset" type="Integer"/>

    <!-- Handlers -->
    <aura:handler name="change" value="{! v.product.refund.value }" action="{! c.onRefundValueChanged }" />

    <!-- Registered Events -->
    <aura:registerEvent name="RefundManagementEvent" type="c:RefundManagementEvent"/>

    <!-- Methods -->
    <aura:method name="focus" action="{! c.focus }"/>

    <tr class="{! join(' ', 'product', (v.product.isExpandable ? 'clickable' : '')) }"
        onclick="{! v.product.isExpandable ? c.toggleExpand : null}">

        <!-- Name -->
        <td colspan="4"
            class="product__name slds-truncate"
            style="{!'padding-left: '+v.padding+'rem;'}"
            title="{!v.product.name}">
            <lightning:buttonIcon class="{! join(' ', 'slds-m-right_small expand-icon',
                    v.product.isExpandable ? '' : 'slds-hide') }"
                                  variant="bare"
                                  iconName="{! v.product.isExpanded ? 'utility:down' : 'utility:right'}"
                                  size="small"
                                  alternativeText="{! v.product.isExpanded ? 'Collapse' : 'Expand'}"/>
            {# v.product.name }
        </td>

        <!-- TOTAL -->
        <td>
            <aura:if isTrue="{! and(not(v.product.isRefunded), and(v.product.isRefundable, not(v.app.isReadOnly))) }">
                <a onclick="{! c.onAmountClick }"
                   href="javascript:void(0);"
                   class="action-link transaction-amount"
                   title="Copy value to refund amount"
                   aura:id="transactionAmount">
                    <c:outputCurrency value="{! v.product.amount }"
                                      currencyCode="{! v.product.currencyCode }"/>
                </a>

                <aura:set attribute="else">
                    <c:outputCurrency value="{! v.product.amount }"
                                      currencyCode="{! v.product.currencyCode }"/>
                </aura:set>
            </aura:if>
        </td>

        <!-- AVAILABLE REFUND AMOUNT -->
        <td>
            <aura:if isTrue="{! not(v.product.isBillingTransaction) }">
                <c:outputCurrency value="{! v.product.availableRefund }"
                                  currencyCode="{! v.product.currencyCode }"/>
                <aura:set attribute="else">
                    <c:outputCurrency value="{! v.product.availableRefund }"
                                      currencyCode="{! v.product.currencyCode }"/>
                </aura:set>
            </aura:if>
        </td>

        <!-- REFUNDED AMOUNT -->
        <aura:if isTrue="{! !empty(v.app.approval.record.Account__r.Billing_ID__c) }">
            <td>
                <aura:if isTrue="{! !!v.product.isBillingTransaction }">
                    <c:outputCurrency value="{! v.product.refundedAlready }"
                                    currencyCode="{! v.product.currencyCode }"/>
                </aura:if>
            </td>
        </aura:if>

        <!-- REFUND AMOUNT -->
        <td colspan="2" aura:id="refundCell" onclick="{! c.stopPropagation }">
            <aura:if isTrue="{! v.product.isRefunded }">

                Refunded

                <aura:set attribute="else">
                    <lightning:input label="Refund Amount"
                                     name="RefundAmount"
                                     variant="label-hidden"
                                     class="refund-input"
                                     value="{! v.product.refund.value }"
                                     type="Number"
                                     onchange="{! c.refundChanged }"
                                     onblur="{! c.refundBlurred }"
                                     aura:id="refundInput"
                                     min="{! v.product.refund.min }"
                                     max="{! v.product.refund.max }"
                                     disabled="{! or(v.product.refund.disabled, v.app.isReadOnly) }"
                                     step="0.01"
                                     messageWhenRangeOverflow="Refund amount should be less than or equal to available refund"
                                     messageWhenRangeUnderflow="Refunds amount cannot be negative"
                                     formatter="decimal"/>
                </aura:set>
            </aura:if>
        </td>
    </tr>


    <aura:if isTrue="{! v.product.isExpanded }">

        <!-- Product Items Header -->
        <tr class="slds-text-title--caps header product-items-header">
            <th colspan="{! v.app.totalOfColumns }" class="product-items-header__name" style="{!'padding-left: '+(v.padding+v.offset)+'rem;'}">
                <div class="slds-truncate">Item</div>
            </th>
        </tr>

        <!-- Product Items -->
        <aura:iteration items="{! v.product.productItems }" var="item">
            <c:RefundManagementItem
                app="{! v.app }"
                item="{! item }"
                padding="{! v.padding + v.offset }"
                offset="{! v.offset }"/>
        </aura:iteration>

    </aura:if>

</aura:component>