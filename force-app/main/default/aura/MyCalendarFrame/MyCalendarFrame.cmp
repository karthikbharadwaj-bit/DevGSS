<aura:component implements="forceCommunity:availableForAllPageTypes" >
    <aura:attribute name="communityName" type="String" access="global" />
    <aura:attribute name="lmsNamespace" type="String" default="" access="global" />
    <iframe src="{! '' + (v.communityName == '' ? '' : '/' + v.communityName) + '/apex/' + (v.lmsNamespace == '' ? '' : v.lmsNamespace + '__') + 'iltcalendar?inline=1'}" style="width: 100%; height: 1000px; border: 0px; background-color: white;" />
</aura:component>