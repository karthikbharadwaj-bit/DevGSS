<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    <aura:attribute type="String" name="avayaLegalComments"/>
    <!--Added by Ishwarya to get respective Community Details-->
    <aura:attribute name="communityDetailsRecord" type="Object"/>
    
    <div style="font-size:120%">Enter comments for {!v.communityDetailsRecord.Portal_Main_Label__c} Legal Below</div>
    <lightning:textarea value="{!v.avayaLegalComments}"/>
</aura:component>