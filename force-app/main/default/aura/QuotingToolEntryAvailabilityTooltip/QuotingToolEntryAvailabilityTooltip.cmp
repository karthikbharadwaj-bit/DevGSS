<aura:component>
    <aura:attribute name="position" type="String" default="bottom-left"/>
    <aura:attribute name="countries" type="String"/>
    <aura:attribute name="countriesText" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <span class="countries slds-m-left--x-small"
          onmouseover="{!c.mouseOverIcon}"
          onmouseout="{!c.mouseOutIcon}">

        <lightning:icon iconName="utility:info"
                        class="countries__icon"
                        size="xx-small"
                        alternativeText="Supported Countries"/>

    </span>
</aura:component>