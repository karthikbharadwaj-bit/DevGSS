<aura:component implements="flexipage:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,force:hasRecordId,force:hasSObjectName"
                controller="Order_SubmitButtonController">
    <ltng:require scripts="{!$Resource.rcnotify + '/rcnotify.js'}" afterScriptsLoaded="{!c.validateSubmitOrder}" />
    <aura:handler event="aura:waiting" action="{!c.showSpinner}"/>
    <aura:handler event="aura:doneWaiting" action="{!c.hideSpinner}"/>
    <div class="slds-is-relative">
        <div class="spinnerHolder">
            <lightning:spinner alternativeText="Loading..." aura:id="loadingSpinner"  class="slds-hide" size="small"/>
        </div>
    </div>
</aura:component>