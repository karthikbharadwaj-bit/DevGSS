                                                changeOrderId="{!v.changeOrderId}"
                                                ExistingChangeOrder="{!v.ExistingChangeOrder}"
                                                showChangeRequestCMP="{!v.showChangeRequestCMP}"
                                                recordId="{!v.recordID}"
                                                accountId="{!v.accountId}"
                                                oppType="{!v.oppType}"
                                                oppStage="{!v.oppStage}"
                                                isReadOnlyProfile="{!v.isReadOnly}"
                                                ShowOnlyRC="{!v.ShowOnlyRC}"
                                                baseURL="{!v.baseURL}" communityDetailsRecord="{!v.communityDetailsRecord}"
                                                oppCountry="{!v.accCountry}"/>
                    </lightning:card>
                </aura:if>
            </aura:if>
            <aura:if isTrue="{!!v.ShowOnlyRC}">
                <aura:if isTrue="{!and(v.ShowRecordDetail,!v.showChangeRequestCMP)}">
                    <br/>
                    <lightning:card variant="Narrow" title="Quotes" iconName="standard:quotes">
                        <!--<iframe src="{!v.baseURL+'/apex/Quotewizard?Id='+v.recordID}"
                            width="100%" height="1000px" frameBorder="0"/>-->
                        <c:Quote_OpportunityQuotes isChangeOrderSubmitted="{!v.isChangeOrderSubmitted}"
                                                changeOrderId="{!v.changeOrderId}"
                                                ExistingChangeOrder="{!v.ExistingChangeOrder}"
                                                showChangeRequestCMP="{!v.showChangeRequestCMP}"
                                                recordId="{!v.recordID}"
                                                accountId="{!v.accountId}"
                                                oppType="{!v.oppType}"
                                                oppStage="{!v.oppStage}"
                                                isReadOnlyProfile="{!v.isReadOnly}"
                                                baseURL="{!v.baseURL}"
                                                ShowOnlyRC="{!v.ShowOnlyRC}" quoteFieldsMap="{!v.quoteFieldsMap}" translationsMap="{!v.translationsMap}" communityDetailsRecord="{!v.communityDetailsRecord}" oppCountry="{!v.accCountry}"/>
                    </lightning:card>
                </aura:if>

                <aura:if isTrue="{!v.hasReadAccess}">
                    <aura:if isTrue="{!and(v.ShowRecordDetail,!v.showChangeRequestCMP)}">

                        <lightning:card variant="Narrow" iconName="standard:case" title="{!v.translationsMap.Deal_Status + ':'}">
                            <div class="slds-m-around_xx-small">
                                <aura:if isTrue="{!v.DealStatusMessage}">
                                    <div class="errorMessageDiv">
                                        <div class="slds-is-relative errorMessageDiv">
                                            <div class="slds-notify slds-notify_toast slds-theme_error norecordsmsg" role="status">
                                                <div class="slds-notify__content">
                                                    <h2 class="slds-text-heading_small"> {!v.translationsMap.No_Records_to_display}</h2>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </aura:if>
                                <aura:if isTrue="{!!v.DealStatusMessage}">
                                    <table class="slds-table slds-table_bordered slds-table_cell-buffer">
                                        <thead>
                                            <tr>
                                                <th scope="col">
                                                    <strong><div class="slds-truncate" title="{!v.translationsMap.Deal_Status_Name}">{!v.translationsMap.Deal_Status_Name}</div></strong>
                                                </th>
                                                <th scope="col">
                                                    <strong><div class="slds-truncate" title="{!v.translationsMap.Status}">{!v.translationsMap.Status}</div></strong>
                                                </th>
                                                <th scope="col">
                                                    <strong><div class="slds-truncate" title="{!v.translationsMap.Type}">{!v.translationsMap.Type}</div></strong>
                                                </th>
                                                <th scope="col">
                                                    <strong><div class="slds-truncate" title="{!v.translationsMap.Created_Date}">{!v.translationsMap.Created_Date}</div></strong>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <aura:iteration items="{!v.OpportunityRecord.Deal_Supports__r}" var="dealStatus">
                                                <tr>
                                                    <th scope="row" data-label="Deal Status Name">
                                                        <div class="slds-truncate" title="{!dealStatus.Name}">
                                                            <!--<a href="{!'/partner/s/dealsupport?id='+dealStatus.Id}">
                                                        {!dealStatus.Name}
                                                    </a> -->
                                                            <a href="{!v.DealSupportURLLink +dealStatus.Id}">
                                                                {!dealStatus.Name}
                                                            </a>
                                                        </div>
                                                    </th>
                                                    <th scope="row" data-label="Status">
                                                        <div class="slds-truncate" title="{!dealStatus.Status__c}">
                                                            {!dealStatus.Status__c}
                                                        </div>
                                                    </th>
                                                    <th scope="row" data-label="Type">
                                                        <div class="slds-truncate" title="{!dealStatus.Type__c}">
                                                            {!dealStatus.Type__c}
                                                        </div>
                                                    </th>
                                                    <th scope="row" data-label="Created Date">
                                                        <div class="slds-truncate" title="{!dealStatus.CreatedDate}">
                                                            <span><lightning:formattedDateTime value="{!dealStatus.CreatedDate}"
                                                                                            month="numeric"
                                                                                            day="numeric"
                                                                                            year="numeric"
                                                                                            hour="2-digit"
                                                                                            minute="2-digit"
                                                                                            timeZone="{!$Locale.timezone}"/></span>
                                                        </div>
                                                    </th>
                                                </tr>
                                            </aura:iteration>
                                        </tbody>
                                    </table>
                                </aura:if>
                            </div>
                        </lightning:card>
                    </aura:if>
                    <aura:if isTrue="{!v.showCreateDealStatus}">
                        <lightning:card title="{!v.translationsMap.New_Deal_Support}" iconName="standard:case">
                            <div class="slds-grid slds-wrap">
                                <div class="slds-col slds-size_1-of-6"></div>
                                <div class="slds-col slds-size_1-of-6 slds-p-horizontal_x-small slds-p-top_large" style="color:gray;">
                                    <abbr class="slds-required slds-float_right">* </abbr>
                                    <span class="slds-float_right">{!v.translationsMap.Type}:</span>

                                </div>
                                <div class="slds-col slds-size_2-of-6 slds-p-horizontal_x-small hideRequiredLabel" >
                                    <!--<span><lightning:textarea aura:id="ds_type"   value="{!v.DSType}" variant="label-hidden"/></span>-->
                                    <lightning:select variant="label-hidden" aura:id="ds_type" value="{!v.DSType}" messageWhenValueMissing="Choose one!" required="true">
                                        <option value="">--Select Type--</option>
                                        <option value="Change Order">{!v.translationsMap.Change_Order}</option>
                                        <option value="Change Account">{!v.translationsMap.Change_Account}</option>
                                        <option value="Initial Order">{!v.translationsMap.Initial_Order}</option>
                                        <option value="Discount Request">{!v.translationsMap.Discount_Request}</option>
                                        <option value="Lead Conversion">{!v.translationsMap.Lead_Conversion}</option>
                                        <option value="New Contact Request">{!v.translationsMap.New_Contact_Request}</option>
                                        <option value="New Contract Request">{!v.translationsMap.New_Contract_Request}</option>
                                    </lightning:select>
                                </div>
                                <div class="slds-col slds-size_2-of-6"></div>
                                <div class="slds-col slds-size_1-of-6"></div>
                                <div class="slds-col slds-size_1-of-6 slds-p-horizontal_x-small slds-p-top_medium" style="color:gray;">
                                    <abbr class="slds-required slds-float_right">* </abbr>
                                    <span class="slds-float_right">{!v.translationsMap.Comments}:</span>

                                </div>
                                <div class="slds-col slds-size_2-of-6 slds-p-vertical_medium slds-p-horizontal_x-small">
                                    <span><lightning:textarea aura:id="comments" required="true"  value="{!v.comment}" variant="label-hidden"/></span>
                                </div>
                                <div class="slds-col slds-size_2-of-6"></div>


                                <div class="slds-form-element slds-form-element_horizontal slds-align_absolute-center slds-p-around_medium" style="bottom-border:.25rem !important;">
                                    <lightning:button variant="brand" label="{!v.translationsMap.Submit}" iconName="action:check" iconPosition="left" name="Submit" type="button"  onclick="{!c.createDealSupport}"/>
                                    <lightning:button variant="brand" type="cancel" iconName="action:close" iconPosition="left" name="Cancel" label="{!v.translationsMap.Cancel}" onclick="{!c.cancelDealSupport}"/>
                                </div>
                            </div>
                        </lightning:card>
                    </aura:if>
                </aura:if>
            </aura:if>
        </aura:if>
        <div aura:id="generateContractDiv"></div>
        <div aura:id="quotingToolDiv"></div>
        <div aura:id="generateAccChecklistDiv"></div>
        <!--MODAL SECTION STARTS  -->
        <div aura:id="selectedAcctDiv"></div>
        <!--MODAL SECTION ENDS  -->
        <div aura:id="listViewDiv"></div>
        <div aura:id="docuSignDiv"></div>
    </aura:if>

</aura:component>