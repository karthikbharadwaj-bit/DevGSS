<aura:component  implements="forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,force:lightningQuickAction,flexipage:availableForRecordHome,force:hasRecordId,force:hasSObjectName,flexipage:availableForAllPageTypes"
                access="global" controller="Partner_OpportunitiesMain" >
    <aura:attribute name="showChecklistCMP" type="Boolean"/>
    <aura:attribute name="showChangeRequestCMP" type="Boolean"/>
    <aura:attribute name="ExistingChangeOrder" type="Boolean" default="false"/>
    <aura:attribute name="changeOrderId" type="String"  />
    <aura:attribute name="isChangeOrderSubmitted" type="Boolean" default="false"/>
    <aura:attribute name="baseURL" type="String"/>
    <aura:attribute name="DealSupportURLLink" type="String"/>
    <aura:attribute name="recordID" type="String"/>
    <aura:attribute name="areaCodeList" type="Area_Codes__c[]"/>
    <aura:attribute name="existingAreaCodeList" type="List"/>
    <aura:attribute name="ShowListView" type="boolean" default="true"/>
    <aura:attribute name="ShowRecordDetail" type="boolean" default="false" />
    <aura:attribute name="ShowSpinnerOpp" type="boolean" default="true" />
    <aura:attribute name="ShowComponentButtons" type="boolean" default="false" />
    <aura:attribute name="ShowEditSection" type="boolean" default="false" />
    <aura:attribute name="ShowNewSection" type="boolean" default="false" />
    <aura:attribute name="showQuotes" type="Boolean" default="false" />
    <aura:attribute name="ShowOnlyRC" type="Boolean" default="false"/>
    <aura:attribute name="isIgnite" type="Boolean" default="false"/>
    <aura:attribute name="isIgniteUQTFlow" type="Boolean" default="false"/>
     <aura:attribute name="ShowOnlyALE" type="Boolean" default="false" />
    <aura:attribute name="oppType" type="String"/>
    <aura:attribute name="accountId" type="String"/>
    <aura:attribute name="oppStage" type="String" />
    <aura:attribute name="showProcessOrder" type="Boolean" default="true"/>
    <aura:attribute name="OpportunityRecord" type="Opportunity" default="{
                                                                         'SObjectType': 'Opportunity'
                                                                         }"/>
    <aura:attribute name="objAccountCheckList" type="Account_Checklist__c" default="{'sobjectType':'Account_Checklist__c'}"/>

    <aura:registerEvent name="goBackEvent" type="c:Partner_OpportunitiesGoBackEvent"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler event="aura:waiting" action="{!c.showSpinner}"/>
    <aura:handler event="aura:doneWaiting" action="{!c.hideSpinner}"/>
    <aura:attribute name="Message" type="boolean" default="false" />
    <aura:attribute name="DealStatusMessage" type="boolean" default="false" />

    <aura:attribute name="ShowConAcc" type="boolean"/>
    <aura:attribute name="ShowOnlyAvaya" type="boolean" default="false"/>
    <aura:attribute name="fromcustomer" type="boolean" default="false"/>
    <aura:attribute name="showCreateDealStatus" type="boolean" default="false" />
    <aura:attribute name="comment" type="String"/>
    <aura:attribute name="DSType" type="String"/>
    <aura:attribute name="isReadOnly" type="boolean" default="true" />
    <aura:attribute name="isSingleLogin" type="boolean" default="false" />

    <aura:attribute name="partnerCommunity" type="List"/>
    <aura:attribute name="hasReadAccess" type="boolean" default="true"/>
    <aura:attribute name="communityDetailsRecord" type="Object"/>
    <aura:attribute name="showMitelShare" type="boolean" /> <!-- PBC-9705 P2CSharing-->

    <aura:registerEvent type="c:ToastEvent" name="ToastEvent"/>
    <aura:attribute name="addressList" type="Account_Checklist_Address__c[]"/>
    <aura:attribute name="ShippingAddressList" type="Quote_PartnerDetailController.AccountCheckListAddressWrapp[]"/>

    <!-- Avaya Cloud Specialist Assignment-->
    <aura:handler name="cloudSpecialistValueEvent" event="c:Partner_CloudSpecialistSearchEvent" action="{!c.handleCloudSpecialistEvent}"/>
    <aura:attribute name="cloudSpecialistContactId" type="String"/>

    <aura:attribute name="accCountry" type="String"/><!--ACO 3.0-->

    <aura:attribute name="ShowOnlyAtos" type="boolean" default="false"/>
    <aura:attribute name="tierNames" type="List" default="['Office']"/>

    <aura:attribute name="employeeListDisplayed" type="List" />
    <aura:attribute name="selectedEmployeeValue" type="string" access="public" />

    <aura:attribute name="RCMeetings" type="boolean" default="false"/>
    <aura:attribute name="Est12MPriceStd" type="string"/>
    <aura:attribute name="Est12MPriceRCMeetings" type="string"/>

    <aura:attribute name="oppFieldsMap" type="Map" />
    <aura:attribute name="accFieldsMap" type="Map" />
    <aura:attribute name="dealSupportFieldsMap" type="Map" />
    <aura:attribute name="quoteFieldsMap" type="Map" />
    <aura:attribute name="translationsMap" type="Map" />
    <aura:attribute name="PRMSpecificTranslationsMap" type="Map" />

    <aura:attribute name="isShowUnifiedQuotingWizard" type="boolean"/>
    <aura:attribute name="salesQuote" type="Quote" default="{'SObjectType': 'Quote'}"/>
    <aura:attribute name = "showPartnerChecklistCMP" type="Boolean"/>
    <aura:attribute name="processOrdercontext" type="String"/>
    <aura:attribute name="changeOrderFlow" type="boolean" default="false"/>
    <aura:attribute name="caseRecordTypeId" type="String"/>
    <aura:attribute name="isExistingBusiness" type="Boolean" default="false"/>

    <aura:if isTrue="{!!v.hasReadAccess}">
        <div class="slds-notify_container slds-is-relative">
            <div class="slds-notify slds-notify_toast slds-theme_error" role="alert">
                <div class="slds-notify__content">
                    <h2 class="slds-text-heading_small">{!v.translationsMap.Insufficient_privileges_to_view_Opportun}</h2>
                </div>
            </div>
        </div>
    </aura:if>
    <aura:if isTrue="{!v.hasReadAccess}">
        <aura:if isTrue="{!v.ShowSpinnerOpp}">
            <div class="slds-is-relative">
                <div class="spinnerHolder">
                    <lightning:spinner alternativeText="Loading..." aura:id="loadingSpinner" class="slds-hide" size="medium"/>
                </div>
            </div>
        </aura:if>

        <aura:if isTrue="{!v.showChecklistCMP}">
            <c:Quote_AccountCheckList communityDetailsRecord="{!v.communityDetailsRecord}" ShippingAddressList="{!v.ShippingAddressList}" addressList="{!v.addressList}"  areaCodeList="{!v.areaCodeList}" objAccountCheckList="{!v.objAccountCheckList}" recordID="{!v.recordID}" parent="{!this}" oppType="{!v.oppType}" accountId="{!v.accountId}" showChecklistCMP="{!v.showChecklistCMP}" oppCountry="{!v.accCountry}" partnerCommunityName="{!v.partnerCommunity}" OpportunityRecord="{!v.OpportunityRecord}" showProcessOrder="{!v.showProcessOrder}" processOrdercontext="{!v.processOrdercontext}" />

        </aura:if>

        <aura:if isTrue="{!v.showPartnerChecklistCMP}">
            <div class="slds-m-around_xx-large">
        <!-- Modal/Popup Box starts here-->
        <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
            <div class="slds-modal__container">
                <!-- Modal/Popup Box Header Starts here-->
                <header class="slds-modal__header">
                    <lightning:buttonIcon iconName="utility:close"
                                          onclick="{! c.closeModel }"
                                          alternativeText="close"
                                          variant="bare-inverse"
                                          class="slds-modal__close"/>
                    </header>
             <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
             <div class="slds-form--stacked slds-p-around--medium slds-m-bottom--x-small">
            <c:Quote_AccountCheckList aura:id="AccountCheckList" communityDetailsRecord="{!v.communityDetailsRecord}" ShippingAddressList="{!v.ShippingAddressList}" addressList="{!v.addressList}" areaCodeList="{!v.areaCodeList}" dealSupportExists="{v.dealSupportExists}" isAvaya="{!v.isAvaya}" isFromCheckOutPage= "true" objAccountCheckList="{!v.objAccountCheckList}" recordID="{!v.recordID}" fromProcessOrder="true"  showSpinner="{!v.showSpinner}" parent="{!this}" oppType="{!v.oppType}" accountId="{!v.accountId}" showChecklistCMP="{!v.showPartnerChecklistCMP}" salesQuote="{!v.salesQuote}" IsOpenInCommunity="{!v.IsOpenInCommunity}" showProductSection="{!v.showProductSection}" partnerCommunityName="{!v.partnerCommunity}" OpportunityRecord="{!v.OpportunityRecord}" showProcessOrder="{!v.showProcessOrder}" processOrdercontext="{!v.processOrdercontext}" />
       		 </div>
             </div>
             <footer class="slds-modal__footer">
                  <lightning:button variant="brand"
                                              label="Submit"
                                              title="Next"
                                              onclick="{!c.handleSave}"/>
                        <lightning:button variant="neutral"
                                          label="Cancel"
                                          title="Cancel"
                                          onclick="{! c.closeModel }"/>
            </footer>
                </div>
            </section>
                 <div class="slds-backdrop slds-backdrop_open"></div>

        </div>
          </aura:if>

        <aura:if isTrue="{!v.showChangeRequestCMP}">
            <c:Quote_OrderChangeRequest accountId="{!v.accountId}" isChangeOrderSubmitted="{!v.isChangeOrderSubmitted}" changeOrderId="{!v.changeOrderId}" ExistingChangeOrder="{!v.ExistingChangeOrder}" recordID="{!v.recordID}" showChangeRequestCMP="{!v.showChangeRequestCMP}" OpportunityRecord="{!v.OpportunityRecord}"/>
        </aura:if>
        <aura:if isTrue="{!!v.showChangeRequestCMP}">
            <!-- Display Opportunity details -->
            <aura:if isTrue="{!v.ShowRecordDetail}">
                <lightning:card variant="Narrow" title="{!v.translationsMap.Opportunity_Detail}" iconName="standard:opportunity">
                    <aura:if isTrue="{!not(v.isIgniteUQTFlow)}">
                        <div class="slds-form-element slds-form-element_horizontal slds-align_absolute-center slds-p-around_medium" style="border-bottom:.25rem !important;">
                            <aura:if isTrue="{!v.OpportunityRecord.StageName != '7. Closed Won'}">
                                <aura:if isTrue="{!!v.isReadOnly}">
                                    <lightning:button variant="brand" label="{!v.translationsMap.Edit}" iconName="action:edit" iconPosition="left" onclick="{!c.showEditSectionAres}" />
                                </aura:if>
                            </aura:if>
                            <aura:if isTrue="{!v.ShowComponentButtons}">
                                <lightning:button variant="brand" label="{!v.translationsMap.Go_Back}" iconName="action:recall" iconPosition="left" onclick="{!c.goBackToViewList}" />
                            </aura:if>
                        </div>
                    </aura:if>
                    <aura:set attribute="actions">
                        <aura:if isTrue="{!v.ShowComponentButtons}">
                            <aura:if isTrue="{!!v.isReadOnly}">
                                <aura:if isTrue="{!!v.ShowOnlyRC}">
                                    <aura:if isTrue="{!v.oppType != 'Existing Business'}">
                                        <lightning:button variant="brand" label="{!v.translationsMap.Account_checklist}" onclick="{!c.goToQuoteTool}" />
                                    </aura:if>
                                </aura:if>
                            </aura:if>
                            <aura:if isTrue="{!v.isIgniteUQTFlow}">
                                <lightning:button variant="neutral" label="{!v.translationsMap.Go_Back}" onclick="{!c.goBackToViewList}" class="action-button"/>
                            </aura:if>
                        </aura:if>
                        <aura:if isTrue="{!and(v.OpportunityRecord.StageName != '7. Closed Won', v.isIgniteUQTFlow)}">
                            <aura:if isTrue="{!!v.isReadOnly}">
                                <lightning:button variant="brand" label="{!v.translationsMap.Edit}" onclick="{!c.showEditSectionAres}" class="action-button"/>
                            </aura:if>
                        </aura:if>
                        <aura:if isTrue="{!and(v.ShowComponentButtons, v.isIgniteUQTFlow, v.ShowOnlyRC)}">
                            <div class="process-order-button-container">
                                <lightning:button variant="brand" label="Process Order" class="action-button" onclick="{!c.processOrder}" disabled="{!v.showProcessOrder}"/>
                                <aura:if isTrue="{!not(empty(v.processOrdercontext))}">
                                    <span class="process-order-tooltip">{!v.processOrdercontext}</span>
                                </aura:if>
                            </div>
                            <lightning:button variant="brand" label="Create a Case" onclick="{!c.openCreateCaseForm}" class="action-button"/>
                        </aura:if>
                    </aura:set>

                    <div class="slds-grid slds-wrap">

                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small  alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.Name}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small ">
                            <span>{!v.OpportunityRecord.Name}</span>
                        </div>

                        <div class="slds-col slds-size_1-of-7">
                            <span></span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small  alignRight" style="color:gray;">
                            <span>{!v.accFieldsMap.Name}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small ">
                            <span>{!v.OpportunityRecord.Account.Name}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.translationsMap.Billing_Street}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Account.BillingStreet}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-border_top">
                            <span></span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.translationsMap.Billing_City}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Account.BillingCity}</span>
                        </div>
                         <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.translationsMap.Billing_State_Province}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Account.BillingState}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-border_top">
                            <span></span>
                        </div>

                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.translationsMap.Billing_Country}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Account.BillingCountry}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.translationsMap.Billing_Postal_Code}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Account.BillingPostalCode}</span>
                        </div>

                        <aura:if isTrue="{!and(and(!v.ShowConAcc,!v.isSingleLogin),v.ShowOnlyRC)}">
                            <div class="slds-col slds-size_1-of-7 slds-border_top">
                                <span></span>
                            </div>
                        </aura:if>

                        <aura:if isTrue="{!!and(and(!v.ShowConAcc,!v.isSingleLogin),v.ShowOnlyRC)}">
                         <div class="slds-col slds-size_4-of-7 slds-border_top">
                            <span></span>
                        </div>
                        </aura:if>
                        <aura:if isTrue="{!or(v.ShowConAcc,v.isSingleLogin)}">
                            <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                                <span>{!v.oppFieldsMap.Partner_Account__c}</span>
                            </div>
                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                <span>{!v.OpportunityRecord.Partner_Account__r.Name}</span>
                            </div>
                            <div class="slds-col slds-size_1-of-7 slds-border_top">
                                <span></span>
                            </div>
                        </aura:if>
                        <aura:if isTrue="{!or(v.ShowOnlyRC, or(v.ShowConAcc,v.isSingleLogin))}">
                            <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                                <span>{!v.oppFieldsMap.Partner_Contact__c}</span>
                            </div>
                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                <span>{!v.OpportunityRecord.Partner_Contact__r.FirstName}&nbsp;{!v.OpportunityRecord.Partner_Contact__r.LastName}</span>
                            </div>
                        </aura:if>
                        <!-- <aura:if isTrue="{!and(v.ShowOnlyRC,!v.ShowConAcc)}">
                            <div class="slds-col slds-size_4-of-7">
                                <span></span>
                            </div>
                        </aura:if> -->
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.Brand_Name__c}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Brand_Name__c}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-border_top">
                            <span></span>
                        </div>

                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.Number_of_Employees__c}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Number_of_Employees__c}</span>
                        </div>

                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.translationsMap.Created_Date_Time}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>
                                <lightning:formattedDateTime value="{!v.OpportunityRecord.CreateDateTime__c}"
                                                             month="numeric"
                                                             day="numeric"
                                                             year="numeric"
                                                             hour="2-digit"
                                                             minute="2-digit"
                                                             timeZone="{!$Locale.timezone}"/>
                            </span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-border_top">
                            <span></span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.CloseDate}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>
                                <lightning:formattedDateTime value="{!v.OpportunityRecord.CloseDate}"
                                                             month="numeric"
                                                             day="numeric"
                                                             year="numeric"/>
                            </span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.Existing_Solution_Provider__c}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Existing_Solution_Provider__c}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-border_top">
                            <span></span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.Decision_Maker__c}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Decision_Maker__c}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.Prompting_Change__c}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Prompting_Change__c}</span>
                        </div>
                        <!-- Added Rainbow Office condition for ALE -->
                        <aura:if isTrue="{!and(!v.ShowOnlyRC,v.communityDetailsRecord.Brand_Name__c!='Rainbow Office')}">
                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                                <span>{!v.communityDetailsRecord.Portal_Cloud_Specialist__c}</span>
                            </div>

                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                <!-- <span>{!v.OpportunityRecord.Avaya_Cloud_Specialist__c}</span>-->
                                <span>{!v.OpportunityRecord.Portal_Cloud_Specialist__r.Name}</span>
                            </div>
                        </aura:if>
                        <!-- Added Rainbow Office condition for ALE -->
                        <aura:if isTrue="{!or(v.ShowOnlyRC,v.communityDetailsRecord.Brand_Name__c=='Rainbow Office')}">
                            <div class="slds-col slds-size_1-of-7 slds-border_top">
                                <span></span>
                            </div>
                            <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                                <span></span>
                            </div>
                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                <span></span>
                            </div>
                        </aura:if>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.Partner_ID__c}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Partner_ID__c}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-border_top">
                            <span></span>
                        </div>

                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.Tier_Name__c}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Tier_Name__c}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.StageName}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.StageName}</span>
                        </div>

                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>{!v.oppFieldsMap.Primary_Opportunity_Contact__c}</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.OpportunityRecord.Primary_Opportunity_Contact__r.Name}</span>
                        </div>
