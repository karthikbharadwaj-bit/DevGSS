<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    
    <aura:attribute name="menuItem1" type="Boolean" required="false" />
    <aura:attribute name="menuItem2" type="Boolean" required="false" /> 
    <aura:attribute name="imageURL" type="String"/>
    <aura:attribute name="publicURL" type="String"/>
    <aura:attribute name="Title" type="String"/>
    <aura:attribute name="isPDF" type="Boolean"/>
    <aura:attribute name="isModalOpen" type="boolean" default="false"/>
    <aura:attribute name="isPPT" type="boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <aura:if isTrue="{!v.menuItem1==false}">
       
        <div class="divCss">
            <img src="{!v.imageURL}"/>
        </div>
        <div>
            <!--<BR></BR>-->
           <center> <a onclick="{!c.changeBooleanValue}" style="width:100%;font-weight:bold;font-size:16px;font-color:black!important;">{!v.Title}</a></center>
           
            <!--<lightning:button label="{!v.Title}" variant="Brand" value="true" onclick="{!c.changeBooleanValue}"></lightning:button>-->
        </div>
    
        <aura:set attribute="else">
            
            <div class="divCss">
                <img src="{!v.imageURL}"/>
            </div>
            <!--<BR></BR>-->
            <div>
                <center><a onclick="{!c.changeBooleanValue}" style="width:100%;font-weight:bold;font-size:16px;font-color:black!important;">{!v.Title}</a></center>
                <!--<lightning:button label="{!v.Title}" variant="Brand" value="true" onclick="{!c.changeBooleanValue}"></lightning:button>-->
            </div>
            
            <aura:if isTrue="{!v.isModalOpen}">
                {!v.Title}
                <!-- Modal/Popup Box starts here-->
                <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                    <div class="slds-modal__container">
                        <!-- Modal/Popup Box Header Starts here-->
                        <header class="slds-modal__header">
                            <lightning:buttonIcon iconName="utility:close"
                                                  onclick="{! c.closeModel }"
                                                  alternativeText="close"
                                                  variant="bare-inverse"
                                                  class="slds-modal__close"/>
                            <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!v.Title}</h2>
                        </header>
                        <!--Modal/Popup Box Body Starts here -->
                        
                        <div class="slds-modal__content slds-m-around_none" style="overflow: initial;" id="modal-content-id-1">
                            <aura:if isTrue="{!not(v.isPDF)}">
                                
                                <iframe style="width:100%;" height="600" src="{!v.publicURL}"></iframe>
                            </aura:if>
                            <aura:if isTrue="{!v.isPDF}">
                                
                                <ui:scrollerWrapper class="sWrapTest">                     
                                    <iframe style="width:100%;" height="600" src="{!v.publicURL}"></iframe>
                                </ui:scrollerWrapper>
                                <!--</ui:scrollerWrapper><ui:scrollerWrapper class="scrollerSize">-->
                            </aura:if>
                        </div>
                        
                        <!-- Modal/Popup Box Footer Starts here-->
                        <footer class="slds-modal__footer">
                            <lightning:button variant="neutral"
                                              label="Cancel"
                                              title="Cancel"
                                              onclick="{! c.closeModel }"/>
                        </footer>
                    </div>
                </section>
                <div class="slds-backdrop slds-backdrop_open"></div>
            </aura:if>
            <aura:if isTrue="{!v.isPPT}">
                <iframe  width="0" height="0" tabindex="-1" src="{!v.publicURL}"></iframe>
            </aura:if>
        </aura:set>
    </aura:if>
    
   
    
</aura:component>