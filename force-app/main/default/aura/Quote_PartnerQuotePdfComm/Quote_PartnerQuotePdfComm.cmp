<aura:component implements="lightning:isUrlAddressable,force:appHostable,forceCommunity:availableForAllPageTypes" access="global" >
	 <aura:attribute name="quoteId" type="String" access="global"/>
    <aura:handler name="init" value="{!this}" action="{!c.loadData}"/>
	<iframe src="{! '/partner/apex/Quote_PartnerQuotePDF?Id=' + v.quoteId }" width="100%" height="3000px;" frameBorder="0"/>
</aura:component>