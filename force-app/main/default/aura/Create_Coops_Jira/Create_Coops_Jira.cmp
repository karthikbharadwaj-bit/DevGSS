<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader" access="global"
                controller="CreateCoopsJiraController">
    <aura:handler name="init" value="{!this}" action="{!c.createCoopsJiraTicket}"/>
    <lightning:card title="Please wait for the Jira to get created!">   
    </lightning:card>
    <aura:attribute name="spinner" type="boolean" default="FALSE"/>
     <aura:if isTrue="{!v.spinner}">
        <div aura:id="spinnerId" class="slds-spinner_container"  style="Top: 250px; Bottom: 270px">
            <div class="slds-spinner--brand  slds-spinner slds-spinner--medium slds-is-relative"  role="alert">
                <span class="slds-assistive-text">Loading...</span>
                <div class="slds-spinner__dot-a"></div>
                <div class="slds-spinner__dot-b"></div>
            </div>
        </div>
    </aura:if>
</aura:component>