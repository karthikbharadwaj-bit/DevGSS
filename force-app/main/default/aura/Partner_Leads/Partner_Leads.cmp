                           <div class="slds-col slds-size_1-of-3 slds-color__text_gray-9 slds-p-vertical_small">
                               <span>{!v.leadFieldsMap.Installation_Service_Provider__c}</span>
                           </div>
                           <div class="slds-col slds-size_2-of-3">
                               <lightning:outputField fieldName="Installation_Service_Provider__c" variant="label-hidden" />
                           </div>
