                                class="slds-col slds-size_1-of-2 slds-grid slds-border_top slds-grid_vertical-align-center slds-gutters_small">
                                <div class="slds-col slds-size_1-of-3 slds-color__text_gray-9 slds-p-vertical_small">
                                    <span>Allow sharing this deal data with Mitel?</span>
