                                        <aura:set attribute="else">
                                            <lightning:outputField fieldName="Mitel_Data_Sharing__c"
                                                                   variant="label-hidden" />
                                        </aura:set>
                                    </aura:if>
                                </div>
                            </div>
                        </aura:if>
                    </aura:if>
                </div>
            </lightning:card>
        </lightning:recordEditForm>
    </aura:if>
    <div aura:id="lookupSearchDiv"></div>
    <c:Modals />
</aura:component>