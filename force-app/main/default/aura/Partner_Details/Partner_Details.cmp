                                                    <span><lightning:inputField fieldName="Partner_Email_Address_Accounts_Payable__c" aura:id="emailAddressbob" variant="label-hidden" messageWhenValueMissing="Complete this Field"/></span>
                                                </div>
                                                
                                                <!--
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                        <span>Invoicing Partner ID</span>
                                                    </div>                        
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
