<!--
* Created By     : Girish
* Created Date   : 22-11-2019
* Description    : Component for Partners tab in community - Partner_Details

Change History
*******************************************************************************************************************************************
SCRUM/Jira ModifiedBy      Date        Description Tag
*******************************************************************************************************************************************

*******************************************************************************************************************************************
*/-->
<aura:component implements="forceCommunity:availableForAllPageTypes" access="global"
                controller="PartnerDetailsController">
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <aura:attribute name="selTabId" type="String" default="partnerTab" />
    <aura:attribute name="selSubTabId" type="String" default="detailTab" />
    <aura:attribute name="gridColumns" type="List" />
    <!--<aura:attribute name="gridData" type="Object" /> -->
    <aura:attribute name="PartnerList" type="Object[]" /> 
    <aura:attribute name="PartnerContactsList" type="Contact[]" /> 
    <aura:attribute name="AccountRecord" type="Account" /> 
    <aura:attribute name="ShowListView" type="Boolean" default="true" /> 
    <aura:attribute name="ShowRecordDetail" type="Boolean" default="false" />
    <aura:attribute name="isNewContact" type="Boolean" default="false" />
    <aura:attribute name="AccountId" type="string"/>
    <aura:attribute name="showContactListView" type="boolean" default="false"/>
    <aura:attribute name="contact" type="Contact"
                    default="{
                             'SObjectType': 'Contact',
                             'FirstName': '',
                             'LastName': '',
                             'Email': '',
                             'Phone': '',
                             'Partner_Role_Type__c': ''
                             }">            
    </aura:attribute>
    
    
    <aura:attribute name="gridExpandedRows" type="List"/>
    
    <aura:attribute name="custGridColumns" type="List" />
    <aura:attribute name="custGridData" type="Object" /> 
    <aura:attribute name="custGridExpandedRows" type="List"/>
    <aura:attribute name="baseURL" type="String"/>
    <aura:attribute name="RespectiveTabURL" type="string"/>
    <aura:attribute name="isAvaya" type="Boolean" default="false"/>
    <aura:attribute name="isMasterAgent" type="Boolean" default="false"/>
    <aura:attribute name="isLoaded" type="Boolean" default="false"/>
    <aura:attribute name="masterPartnerId" type="String"/>        
    
    <aura:attribute name="partnerRegData" type="List"/>
    <aura:attribute name="partnerRegColumns" type="List"/>
    <aura:attribute name="selectedRowsCount" type="Integer" default="0"/>
    <aura:attribute name="maxRowSelection" type="Integer" default="5"/>
    
    <aura:attribute name="newParterVisible" type="Boolean" default="false" />   
    
    <aura:attribute name="pageNumber" type="integer" default="1"/>
    <aura:attribute name="totalPages" type="integer" default="0"/>
    <aura:attribute name="totalRecords" type="integer" default="0"/>
    <aura:attribute name="recordStart" type="integer" default="0"/>
    <aura:attribute name="recordEnd" type="integer" default="0"/>
    
    <aura:attribute name="pageNumber_pr" type="integer" default="1"/>
    <aura:attribute name="totalPages_pr" type="integer" default="0"/>
    <aura:attribute name="totalRecords_pr" type="integer" default="0"/>
    <aura:attribute name="recordStart_pr" type="integer" default="0"/>
    <aura:attribute name="recordEnd_pr" type="integer" default="0"/>   
    
    <aura:attribute name="NewOnBehalf" type="boolean" default="false"/> 
    <aura:attribute name="ShowOnlyRC" type="boolean" default="false"/>
    <aura:attribute name="ShowOnlyALE" type="boolean" default="false"/>
    <aura:attribute name="ShowOnlyAtos" type="boolean" default="false"/>
    <aura:attribute name="ShowOnlyAvaya" type="boolean" default="false"/>
    <aura:attribute name="masterPartnerContactId" type="String"/>
    <aura:attribute name="masterPartnerContactName" type="String"/>
    <aura:attribute name="masterPartnerAccountName" type="String"/>
    <aura:handler name="populatePartnerEvent" event="c:Partner_SearchContactEvent" action="{!c.handlePartnerComponentEvent}"/>
    <aura:attribute name="partnerSelectedValue" type="String" />
    <aura:attribute name="partnerTypes" type="List"/>
    <aura:attribute name="createdUserName" type="String" description="Automatically created UserName for New User creation"/>    
    <aura:attribute name="isDuplicateUserName" type="boolean" default="false"/>
    <aura:attribute name="userNameInput" type="String" default=""/>    
    <aura:attribute name="isBackButtonVisible" type="boolean" default="false"/>
    <aura:attribute name="userNameSuffix" type="String" default=""/>    
    
    <!-- CREATE VARIABLE-->
    <aura:attribute name="searchResult" type="List" description="use for store and display account list return from server"/>
    <aura:attribute name="searchKeyword" type="String" description="use for store user search input"/>
    <aura:attribute name="searchKeywordCust" type="String" description="use for store user search input"/>
    <aura:attribute name="Message" type="boolean" default="false" description="use for display no record found message"/>
    <aura:attribute name="TotalNumberOfRecord" type="integer" default="0" description="use for display Number of records"/>
    <aura:attribute name="searchBy" type="String" default="name"/>
    <aura:attribute name="workingWithPartnerVal" type="String" default="No"/>
    <aura:attribute name="isWorkingWithPartner" type="boolean" default="false"/>
    
    
    <aura:handler event="aura:waiting" action="{!c.showSpinner}"/>
    <aura:handler event="aura:doneWaiting" action="{!c.hideSpinner}"/>
    <aura:attribute name="ShowSpinnerOpp" type="boolean" default="true" />
    <aura:attribute name="isReadOnly" type="boolean" default="true" />
    
    <aura:attribute name="MessageRegPartners" type="boolean" default="false"/>
    
    <aura:attribute name="partnerCommunity" type="List"/>
    <aura:attribute name="communityDetailsRecord" type="Object"/>
    
    <!-- filter input -->
    <aura:attribute name="filter" type="String" />   
    <aura:attribute name="showConfirmModal" type="boolean" default="false"/>
    <aura:attribute name="userContact" type="Contact"/>
    <aura:attribute name="contactIds" type="Contact[]" />
    
    <aura:attribute name="showDetailSection" type="boolean" default="true" />
    <aura:attribute name="showEditSection" type="boolean" default="false" />
    
    <aura:attribute name="translationsMap" type="Map" />
    <aura:attribute name="partnerFieldsMap" type="Map" />
    <aura:attribute name="contactFieldsMap" type="Map" />
    <aura:attribute name="PRMSpecificTranslationsMap" type="Map" />
    
    <!-- Added for JIRA - 6286 Bill On Behalf PRM/CRM start-->   
    <aura:attribute name="isPartnerTypeBillOnBehalf" type="boolean" default="false"/>  
    <aura:attribute name="partnerTypeListDisplayed" type="List"/>
    <aura:attribute name="selectedPartnerType" type="String"/>
    <aura:attribute name = "errors" type="String"/>
    
    <!--Added for JIRA - 6286 Bill On Behalf PRM/CRM end-->
	<!--Added for BOB Second set of Changes for JIRA - 6286 start-->
    <aura:attribute name="invoiceCopyPartnerList" type="List"/>
    <aura:attribute name="invoiceCopyPartnerMap" type="Map"/>
    <aura:attribute name="selectedInvoiceCopyPartner" type="String"/>
    <aura:attribute name="BusinessIdentityValue" type="List"/>
    <aura:attribute name="selectedBusinessIdentity" type="String"/>
    <aura:attribute name="isBillingSupport" type="boolean" default="false"/>
    <aura:attribute name="portalMasterName" type="String"/>
    <aura:attribute name="portalMasterPartnerId" type="String"/>
    <aura:attribute name="Notes" type="String"/>
    <aura:attribute name="NGBSAccId" type="String"/>
    <!--Added for BOB Second set of Changes for JIRA - 6286 end-->
    
    <!--BUSINESS IDENTITY, COUNTRY STATE ATTRIBUTES -->
    <aura:attribute name="countriesAvailable" type="String[]" />
    <aura:attribute name="selectedCountryValue" type="String" />
    <aura:attribute name="mapCountryBrandValueKeys" type="String[]" />
    <aura:attribute name="mapStateValueKeys" type="String[]" />
    <aura:attribute name="allCountries" type="String[]" />
    
    <aura:attribute name="countryStateMapData" type="Map"/>
    <aura:attribute name="businessCountryMapData" type="Map"/>
    <!--Added for Wholesale Reseller Changes for PRM - 55 start-->
    <aura:attribute name="isPartnerTypeWholesaleReseller" type="boolean" default="false"/>  
    <aura:attribute name="showBillingFeedType" type="boolean" default="false"/>  
    <aura:attribute name="settlementTypes" type="String[]" />
    <aura:attribute name="settlementTypesValueKeys" type="String[]" />
    <aura:attribute name="selectedSettlementPartner" type="String" />
    <aura:attribute name="selectedSettlementRatePartner" type="String" />
    <aura:attribute name="settlementPartnerList" type="List"/>
    <aura:attribute name="billingFeedTypesMap" type="Map" />
    <aura:attribute name="availableBillingFeedTypes" type="String[]" />
    <aura:attribute name="selectedBillingFeedType" type="String" />
    <aura:attribute name="settlementPartnerMap" type="Map" />
    <!--Added for Wholesale Reseller Changes for PRM - 55 end-->
    
    <aura:if isTrue="{!v.ShowSpinnerOpp}">
        <div class="slds-is-relative">
            <div class="spinnerHolder">
                <lightning:spinner alternativeText="{!v.translationsMap.Loading+'...'}" aura:id="loadingSpinner" class="slds-hide" size="medium"/>
            </div>
        </div>
    </aura:if>
    
    <aura:if isTrue="{!v.isLoaded}">
        <aura:if isTrue="{!!v.isAvaya}">
            <aura:if isTrue="{!!v.isMasterAgent}">
                <div class="slds-notify_container slds-is-relative">
                    <div class="slds-notify slds-notify_toast slds-theme_error" role="alert">
                        <div class="slds-notify__content">
                            <h2 class="slds-text-heading_small">{!v.translationsMap.Insufficient_privileges_to_view_partner}</h2>
                        </div>
                    </div>
                </div>  
            </aura:if>
        </aura:if>
    </aura:if>    
    <aura:if isTrue="{!or(v.isAvaya,v.isMasterAgent)}">
        <aura:if isTrue="{!v.ShowListView}">
            <lightning:tabset onselect="{!c.tabSelected}" class="tabsetClass"
                              selectedTabId="{!v.selTabId}">
                <lightning:tab  id="partnerTab" iconName="utility:people"> 
                    <aura:set attribute="label">
                        {!v.translationsMap.Current_Partners}
                    </aura:set>
                    <div class="slds-m-around_medium">                
                        <lightning:layout>
                            <lightning:layoutItem size="4" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                <lightning:input label="{!v.translationsMap.Keyword}" value="{!v.searchKeyword}"                                         
                                                 placeholder="{!v.translationsMap.search_placeholder +'...'}" 
                                                 aura:id="searchField"/>
                                
                            </lightning:layoutItem>
                            <lightning:layoutItem size="2" class="slds-p-horizontal_small slds-p-vertical_x-small">
                                <lightning:select name="searchBy" value= "{!v.searchBy}" label="{!v.translationsMap.Search_by_Accounts}">
                                    <option value="name">{!v.translationsMap.Name}</option>
                                    <option value="phone">{!v.translationsMap.Phone}</option>
                                    <option value="billingCity">{!v.translationsMap.City}</option>
                                    <option value="billingCountry">{!v.translationsMap.Country}</option>
                                    <option value="billingState">{!v.translationsMap.State}</option>
                                </lightning:select>
                            </lightning:layoutItem>
                            <lightning:layoutItem size="2" class="slds-p-top_x-large">
                                <lightning:button onclick="{!c.searchPartners}"
                                                  variant="brand"
                                                  label="{!v.translationsMap.Search}" iconName="utility:search"/> 
                            </lightning:layoutItem>
                            <lightning:layoutItem size="2" class="slds-p-horizontal_small slds-p-vertical_x-small" alignmentBump="left">	
                                <lightning:select aura:id="pageSize" label="{!v.translationsMap.Display_Partners_Per_Page+':'}" onchange="{!c.onSelectChange}">
                                    <option text="50" value="50" selected="true"/>
                                    <option text="100" value="100" />
                                    <option text="150" value="150" />
                                    <option text="200" value="200" />
                                </lightning:select>
                                
                            </lightning:layoutItem> 
                            
                        </lightning:layout>
                        
                        <!-- ERROR MESSAGE IF NOT RECORDS FOUND--> 
                        <aura:if isTrue="{!v.Message}">
                            <div class="slds-notify_container slds-is-relative">
                                <div class="slds-notify slds-notify_toast slds-theme_error norecordsmsg" role="alert">
                                    <div class="slds-notify__content">
                                        <h2 class="slds-text-heading_small">{!v.translationsMap.No_Records_Found +'...'}</h2>
                                    </div>
                                </div>
                            </div>
                        </aura:if>
                        <aura:if isTrue="{!!v.Message}">
                            
                            <div class="slds-m-around_xx-small slds-p-top_x-large">        
                                <table class="slds-table slds-table_bordered slds-table_cell-buffer slds-table_fixed-layout">
                                    <thead>
                                        <tr>
                                            <th scope="col" style="width:14rem;">
                                                <strong><div class="slds-truncate" title="{!v.partnerFieldsMap.Name}">{!v.partnerFieldsMap.Name}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.Partner_ID}">{!v.translationsMap.Partner_ID}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.PRMSpecificTranslationsMap.Master_Agent_Channel_Manager}">{!v.PRMSpecificTranslationsMap.Master_Agent_Channel_Manager}</div></strong>
                                            </th>
                                            <aura:if isTrue="{!!v.isMasterAgent}">
                                                <th scope="col">
                                                    <strong><div class="slds-truncate" title="{!v.translationsMap.Partner_Account}">{!v.translationsMap.Partner_Account}</div></strong>
                                                </th>
                                            </aura:if>
                                            <aura:if isTrue="{!!v.ShowOnlyRC}">
                                                <th scope="col">
                                                    <strong><div class="slds-truncate">{!v.PRMSpecificTranslationsMap.Portal_Link_ID}</div></strong>
                                                </th>
                                            </aura:if>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.Contacts}">{!v.translationsMap.Contacts}</div></strong>
                                            </th>
                                            <!--<th scope="col">
                                                            <strong><div class="slds-truncate" title="Phone Number">Phone Number</div></strong>
                                                        </th>-->
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.City}">{!v.translationsMap.City}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.State_Province}">{!v.translationsMap.State_Province}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.Zip}">{!v.translationsMap.Zip}</div></strong>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <aura:iteration items="{!v.PartnerList}" var="partnerList"> 
                                            <tr>
                                                <th scope="row" data-label="Account Name" style="width:14rem;">
                                                    <div class="slds-truncate" title="{!partnerList.accountName}"
                                                         data-value="{!partnerList.name}">
                                                        <!--<a href="{!'/partner/s/partnerdetails?id='+partnerList.name}">
                                                            {!partnerList.accountName} 
                                                        </a>-->
                                                        <a href="{!v.RespectiveTabURL +'?id=' +partnerList.name}">
                                                            {!partnerList.accountName} 
                                                        </a>
                                                    </div>
                                                </th> 
                                                <th scope="row" data-label="Partner ID">
                                                    <div class="slds-truncate" title="{!partnerList.partnerId}">
                                                        {!partnerList.partnerId} 
                                                    </div>
                                                </th> 
                                                <!--Partner_Channel_Manager__c--> 
                                                <th scope="row" data-label="Partner Channel Manager">
                                                    <div class="slds-truncate" title="{!partnerList.partnerChannelManager}">
                                                        {!partnerList.partnerChannelManager} 
                                                    </div>
                                                </th> 
                                                <!--Partner_Channel_Manager__c--> 
                                                <aura:if isTrue="{!!v.isMasterAgent}">
                                                    <th scope="row" data-label="Partner Account" style="width:14rem;">
                                                        <div class="slds-truncate" title="{!partnerList.partnerAccountName}">
                                                            {!partnerList.partnerAccountName} 
                                                        </div>
                                                    </th>
                                                </aura:if>
                                                <aura:if isTrue="{!!v.ShowOnlyRC}">
                                                    <th scope="row">
                                                        <div class="slds-truncate" title="{!partnerList.externalSID}">
                                                            {!partnerList.externalSID}
                                                        </div>
                                                    </th> 
                                                </aura:if>
                                                <th scope="row" data-label="Contacts">
                                                    <div class="slds-truncate" title="{!partnerList.contacts}"
                                                         data-value="{!partnerList.name}">
                                                        <!--<a href="{!'/partner/s/partnerdetails?selectedTab=contactTab&amp;id='+partnerList.name}">
                                                            {!partnerList.contacts} 
                                                        </a>-->
                                                        <a href="{!v.RespectiveTabURL +'?selectedTab=contactTab&amp;id=' +partnerList.name}">
                                                            {!partnerList.contacts} 
                                                        </a>
                                                    </div>
                                                </th>
                                                
                                                <th scope="row" data-label="City">
                                                    <div class="slds-truncate" title="{!partnerList.billingCity}">
                                                        {!partnerList.billingCity} 
                                                    </div>
                                                </th>
                                                <th scope="row" data-label="State/Province">
                                                    <div class="slds-truncate" title="{!partnerList.billingState}">
                                                        {!partnerList.billingState} 
                                                    </div>
                                                </th>
                                                <th scope="row" data-label="Zip">
                                                    <div class="slds-truncate" title="{!partnerList.billingPostalCode}">
                                                        {!partnerList.billingPostalCode} 
                                                    </div>
                                                </th>
                                            </tr>
                                        </aura:iteration>
                                    </tbody>
                                </table>
                            </div>
                            <div class="slds-clearfix">                
                                <div class="slds-float_right">            
                                    <lightning:button disabled="{!v.pageNumber == 1}"
                                                      variant="brand" aura:id="prevPage"
                                                      label="{!v.translationsMap.Prev}" onclick="{!c.handlePrev}" iconName="utility:chevronleft" iconPosition="left"/>            
                                    <lightning:button disabled="{!or(v.pageNumber == v.totalPages,v.totalPages == 0)}"
                                                      aura:id="nextPage" variant="brand"
                                                      label="{!v.translationsMap.Next}" onclick="{!c.handleNext}" iconName="utility:chevronright" iconPosition="right"/>
                                </div>
                                <p class="slds-truncate">{!v.translationsMap.Displaying}&nbsp;{!v.recordStart}-{!v.recordEnd} &nbsp;{!v.translationsMap.Of} &nbsp;{!v.totalRecords} | {!v.translationsMap.Page}&nbsp; {!v.pageNumber}&nbsp;{!v.translationsMap.Of}&nbsp;{!v.totalPages}</p>
                            </div>
                        </aura:if>
                    </div>
                </lightning:tab>
                
                <aura:if isTrue="{!!v.isMasterAgent}">
                    <!-- Display Partners registered -->
                    <lightning:tab label="{!v.translationsMap.Partner_Registrations}" id="registeredPartners"  iconName="utility:adduser"> 
                        <lightning:layout>
                            <lightning:layoutItem  class="slds-p-top_medium slds-p-horizontal_x-small">	
                                <aura:if isTrue="{!!v.isReadOnly}">
                                    <lightning:button label="{!v.translationsMap.New_Partner}" variant="brand" iconName="action:new" iconPosition="left" onclick="{!c.registerNewPartner}" />
                                </aura:if>
                            </lightning:layoutItem>
                            
                            <lightning:layoutItem size="2" class="slds-p-horizontal_small slds-p-vertical_x-small" alignmentBump="left">	
                                <lightning:select aura:id="pageSize_pr" label="{!v.translationsMap.Display_Partners_Per_Page +':'}" onchange="{!c.onSelectChange_pr}">
                                    <option text="50" value="50" selected="true"/>
                                    <option text="100" value="100" />
                                    <option text="150" value="150" />
                                    <option text="200" value="200" />
                                </lightning:select>                                    
                            </lightning:layoutItem> 
                        </lightning:layout>
                        <aura:if isTrue="{!v.MessageRegPartners}">
                            <div class="slds-notify_container slds-is-relative">
                                <div class="slds-notify slds-notify_toast slds-theme_error norecordsmsg" role="alert">
                                    <div class="slds-notify__content">
                                        <h2 class="slds-text-heading_small">{!v.translationsMap.No_Records_Found+'...'}</h2>
                                    </div>
                                </div>
                            </div>
                        </aura:if>
                        <aura:if isTrue="{!!v.MessageRegPartners}">
                            <div class="slds-m-around_xx-small"> 
                                <table class="slds-table slds-table_bordered slds-table_cell-buffer slds-table_fixed-layout">
                                    <thead>
                                        <tr>
                                            <th scope="col" style="width:14rem;">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.Company_Name}">{!v.translationsMap.Company_Name}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.Partner_ID}">{!v.translationsMap.Partner_ID}</div></strong>
                                            </th>
                                            
                                            <aura:if isTrue="{!!v.ShowOnlyRC}">
                                                <th scope="col">
                                                    <strong><div class="slds-truncate">{!v.PRMSpecificTranslationsMap.Portal_Link_ID}</div></strong>
                                                </th>
                                            </aura:if>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.First_Name}">{!v.translationsMap.First_Name}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.Last_Name}">{!v.translationsMap.Last_Name}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.Email}">{!v.translationsMap.Email}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.Phone}">{!v.translationsMap.Phone}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.City}">{!v.translationsMap.City}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.State_Province}">{!v.translationsMap.State_Province}</div></strong>
                                            </th>
                                            <th scope="col">
                                                <strong><div class="slds-truncate" title="{!v.translationsMap.Zip}">{!v.translationsMap.Zip}</div></strong>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <aura:iteration items="{!v.partnerRegData}" var="partnerRegData"> 
                                            <tr>
                                                <th scope="row" data-label="Company Name" style="width:14rem;">
                                                    <div class="slds-truncate" title="{!partnerRegData.Partner_Company_Name__c}">
                                                        {!partnerRegData.Partner_Company_Name__c} 
                                                        
                                                    </div>
                                                </th>
                                                <th scope="row" data-label="Company Name">
                                                    <div class="slds-truncate" title="{!partnerRegData.Partner_ID__c}">
                                                        {!partnerRegData.Partner_ID__c} 
                                                        
                                                    </div>
                                                </th>
                                                <!--<aura:if isTrue="{!$Label.c.AVAYACLOUDOFFICE == v.partnerCommunity}">-->
                                                <aura:if isTrue="{!!v.ShowOnlyRC}">   
                                                    <th scope="row" data-label="Company Name">
                                                        <div class="slds-truncate" title="{!partnerRegData.External_SID__c}">
                                                            {!partnerRegData.External_SID__c} 
                                                            
                                                        </div>
                                                    </th>
                                                </aura:if>
                                                <th scope="row" data-label="First Name">
                                                    <div class="slds-truncate" title="{!partnerRegData.Partner_First_Name__c}">
                                                        {!partnerRegData.Partner_First_Name__c} 
                                                        
                                                    </div>
                                                </th>
                                                <th scope="row" data-label="Last Name">
                                                    <div class="slds-truncate" title="{!partnerRegData.Partner_Last_Name__c}">
                                                        {!partnerRegData.Partner_Last_Name__c} 
                                                    </div>
                                                </th>
                                                <th scope="row" data-label="Email">
                                                    <div class="slds-truncate" title="{!partnerRegData.Partner_Email_Address__c}">
                                                        {!partnerRegData.Partner_Email_Address__c} 
                                                    </div>
                                                </th>
                                                <th scope="row" data-label="Phone">
                                                    <div class="slds-truncate" title="{!partnerRegData.Partner_Phone__c}">
                                                        {!partnerRegData.Partner_Phone__c} 
                                                    </div>
                                                </th>
                                                <th scope="row" data-label="City">
                                                    <div class="slds-truncate" title="{!partnerRegData.Partner_City__c}">
                                                        {!partnerRegData.Partner_City__c} 
                                                    </div>
                                                </th> <th scope="row" data-label="State/Province">
                                                <div class="slds-truncate" title="{!partnerRegData.Partner_State__c}">
                                                    {!partnerRegData.Partner_State__c} 
                                                </div>
                                                </th>
                                                <th scope="row" data-label="Zip">
                                                    <div class="slds-truncate" title="{!partnerRegData.Partner_Zip__c}">
                                                        {!partnerRegData.Partner_Zip__c} 
                                                    </div>
                                                </th>
                                            </tr>
                                        </aura:iteration>
                                    </tbody>
                                </table>
                            </div>
                            <div class="slds-clearfix">                
                                <div class="slds-float_right">            
                                    <lightning:button disabled="{!v.pageNumber_pr == 1}"
                                                      variant="brand" aura:id="prevPage_pr"
                                                      label="{!v.translationsMap.Previous}" onclick="{!c.handlePrev_pr}" iconName="utility:chevronleft" iconPosition="left"/>            
                                    <lightning:button disabled="{!or(v.pageNumber_pr == v.totalPages_pr,v.totalPages_pr == 0)}"
                                                      aura:id="nextPage_pr" variant="brand"
                                                      label="{!v.translationsMap.Next}" onclick="{!c.handleNext_pr}" iconName="utility:chevronright" iconPosition="right"/>
                                </div>
                                <p class="slds-truncate">{!v.translationsMap.Displaying}&nbsp; {!v.recordStart_pr}-{!v.recordEnd_pr} {!v.translationsMap.Of} {!v.totalRecords_pr} | {!v.translationsMap.Page}&nbsp;{!v.pageNumber_pr} {!v.translationsMap.Of}&nbsp;{!v.totalPages_pr}</p>
                            </div> 
                        </aura:if>
                    </lightning:tab>
                    
                    <aura:if isTrue="{! v.newParterVisible }">
                        <lightning:tab label="{!v.translationsMap.New_Partner_Registration}" id="partnerTabRegistration" iconName="utility:new">
                            <div style="float:right">
                                <lightning:buttonIcon iconName="utility:close" title="Close" size="medium" onclick="{!c.closeForm}"/>
                            </div>
                            <!--Partner registration Form -->
                            
                            <lightning:card variant="Narrow" >		
                                
                                <lightning:recordEditForm 
                                                          aura:id="partnerRegistrationForm"
                                                          onsubmit="{!c.handleSubmitPR}"
                                                          onsuccess="{!c.handleSuccessPR}"
                                                          onerror="{!c.handleErrorPR}"                
                                                          objectApiName="Partner_Request__c">
                                    
                                    <div class="slds-grid slds-wrap">
                                        <!-- ADDITIONAL FIELD FOR NEW ON BEHALF START -->
                                        <aura:if isTrue="{!v.NewOnBehalf}">
                                            <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                <span class="heading" style="font-weight: bold;">{!v.translationsMap.Partner_Contact}: <lightning:helptext content="Click on Search Icon to choose the Partner Contact"/></span>
                                                <abbr class="slds-required" title="required">* </abbr>
                                            </div>
                                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                <span class="heading" style="font-weight: bold;">
                                                    {!v.masterPartnerContactName}&nbsp;&nbsp;<lightning:buttonIcon iconName="utility:search" variant="bare" onclick="{!c.createLookup}" alternativeText="Please choose a Master Partner Contact" />
                                                </span>
                                            </div>
                                            <div class="slds-col slds-size_4-of-7">
                                                <span></span>
                                            </div>    
                                        </aura:if>
                                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
