                                            <span>{!v.translationsMap.Last_Name}</span>
                                        </div>                        
                                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                            <span><lightning:inputField fieldName="Partner_Last_Name__c" variant="label-hidden" required="true"/></span>
                                        </div>
                                        
                                        
                                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                            <span>{!v.translationsMap.Title}</span>
                                        </div>                        
                                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                            <span><lightning:inputField fieldName="Partner_Title__c" variant="label-hidden" /></span>
                                        </div>
                                        <div class="slds-col slds-size_1-of-7">
                                            <span></span>
                                        </div>
