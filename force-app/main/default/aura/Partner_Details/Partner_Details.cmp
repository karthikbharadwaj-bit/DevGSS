                                        </div>
                                        
                                        
                                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                            <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                            <span>{!v.translationsMap.City}</span>
                                        </div>                        
                                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                            <span><lightning:inputField fieldName="Partner_City__c" variant="label-hidden" required="true"/></span>
                                        </div>
                                        <div class="slds-col slds-size_1-of-7">
                                            <span></span>
                                        </div>
                                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
