                    </lightning:tab>
                    
                    <lightning:tab label="{!v.translationsMap.Contacts}" title="Contacts" id="contactTab" onactive="{!c.getContactList}">
                        
                        <aura:if isTrue="{!v.showContactListView}">
                            <lightning:card title="{!v.translationsMap.Contacts}"
                                            iconName="standard:contact">
                                <aura:set attribute="actions">
                                    
                                    <aura:if isTrue= "{!v.isAvaya}">
                                        <aura:if isTrue="{!!v.isReadOnly}">
                                            <lightning:button label="{!v.translationsMap.New}" variant="brand" iconName="action:new" iconPosition="left" onclick="{!c.newContact}"/>
                                        </aura:if>
                                    </aura:if>
                                </aura:set>
                                <div class="slds-m-around_xx-small">        
                                    <table class="slds-table slds-table_bordered slds-table_cell-buffer  slds-table_fixed-layout">
                                        <thead>
                                            <tr class="slds-text-title_caps">
                                                <th scope="col">
                                                    <strong><div class="slds-truncate" title="Name">{!v.translationsMap.Contact_Name}</div></strong>
                                                </th>
                                                <th scope="col">
                                                    <strong><div class="slds-truncate" title="Email">{!v.translationsMap.Email}</div></strong>
                                                </th>
                                                <th scope="col">
                                                    <strong><div class="slds-truncate" title="Phone Number">{!v.translationsMap.Phone_Number}</div></strong>
                                                </th>
                                                <th scope="col">
                                                    <strong><div class="slds-truncate" title="Role">{!v.translationsMap.Role}</div></strong>
                                                </th>
                                                <!-- Commented temporarily <aura:if isTrue="{!!v.isReadOnly}">
                                                    <aura:if isTrue="{!!v.ShowOnlyRC}">
                                                        <aura:if isTrue="{!v.isAvaya}">
                                                            <th scope="col">
                                                                <strong><div class="slds-truncate" title="Create User">{!v.translationsMap.Create_User}</div></strong>
                                                            </th>
                                                        </aura:if>
                                                    </aura:if>
                                                </aura:if>Commented temporarily-->
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <aura:iteration items="{!v.PartnerContactsList}" var="contact"> 
                                                <tr>
                                                    <th scope="row" data-label="Contact Name">
                                                        <div class="slds-truncate" title="{!contact.contact.Name}">
                                                            {!contact.contact.Name}
                                                        </div>
                                                    </th>
                                                    <th scope="row" data-label="Email">
                                                        <div class="slds-truncate" title="{!contact.contact.Email}">
                                                            {!contact.contact.Email}
                                                        </div>
                                                    </th>
                                                    <th scope="row" data-label="Phone Number">
                                                        <div class="slds-truncate" title="{!contact.contact.Phone}">
                                                            {!contact.contact.Phone}
                                                        </div>
                                                    </th>
                                                     <th scope="row" data-label="Phone Number">
                                                        <div class="slds-truncate" title="{!contact.contact.Phone}">
                                                            {!contact.contact.Business_Role__c}
                                                        </div>
                                                    </th>
                                                    <!-- Commented temporarily <aura:if isTrue="{!!v.isReadOnly}">
                                                        <aura:if isTrue="{!!v.ShowOnlyRC}">
                                                    <aura:if isTrue="{!v.isAvaya}">
                                                        <td>
                                                            <aura:if isTrue="{!contact.hasUser}">
                                                                <div class="slds-truncate" title="Create User" value = "{!contact.contact}">
                                                                    <lightning:button variant="brand"
                                                                                      label="{!v.translationsMap.Create_User}"
                                                                                      title="Create User"
                                                                                      value = "{!contact.contact}"
                                                                                      onclick="{!c.createUserShowAlert}"/>
                                                                </div>
                                                            </aura:if>
                                                            <aura:if isTrue="{! not(contact.hasUser)}">
                                                                <div class="slds-truncate" title="User Created">
                                                                    <span>{!v.translationsMap.User_Created}</span>
                                                                </div>
                                                            </aura:if>
                                                            
                                                        </td>
                                                            </aura:if>
                                                        </aura:if>
                                                    </aura:if>Commented temporarily-->
                                                </tr>
                                            </aura:iteration>
                                        </tbody>
                                    </table>
                                </div>
                                
                            </lightning:card>
                        </aura:if>
                        <aura:if isTrue="{!v.isNewContact}"> 
                            <lightning:card title="{!v.translationsMap.New_Contact}" iconName="standard:contact"> 
                                
                                <div class="slds-is-relative">
                                    <div class="spinnerHolder">
                                        <lightning:spinner alternativeText="Loading..." aura:id="loadingSpinner" class="slds-hide" size="medium"/>
                                    </div>
                                </div> 
                                
                                <lightning:recordEditForm
                                                          aura:id="newContactFormSection"
                                                          objectApiName="Contact">
                                    <div class="slds-grid slds-wrap"> 
                                        <div class="slds-col slds-size_1-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6 slds-p-horizontal_x-small slds-p-top_medium alignRight" style="color:gray;">
                                            <span>{!v.contactFieldsMap.FirstName}:</span>
                                        </div>                        
                                        <div class="slds-col slds-size_2-of-6 slds-p-vertical_medium slds-p-horizontal_x-small">
                                            <span><lightning:inputField fieldName="FirstName" value="{!v.contact.FirstName}" variant="label-hidden"/></span>
                                        </div>
                                        <div class="slds-col slds-size_2-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6 slds-p-horizontal_x-small slds-p-top_medium alignRight" style="color:gray;">
                                            <abbr class="slds-required slds-float_right">* </abbr>
                                            <span>{!v.contactFieldsMap.LastName}:</span>
                                        </div>                        
                                        <div class="slds-col slds-size_2-of-6 slds-p-vertical_medium slds-p-horizontal_x-small">
                                            <span><lightning:inputField fieldName="LastName" value="{!v.contact.LastName}" variant="label-hidden" required="true"/></span>
                                        </div>
                                        <div class="slds-col slds-size_2-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6 slds-p-horizontal_x-small slds-p-top_medium alignRight" style="color:gray;">
                                            <abbr class="slds-required slds-float_right">* </abbr>
                                            <span>{!v.translationsMap.Email}:</span>
                                        </div>                        
                                        <div class="slds-col slds-size_2-of-6 slds-p-vertical_medium slds-p-horizontal_x-small">
                                            <span><lightning:inputField fieldName="Email"  value="{!v.contact.Email}" variant="label-hidden" required="true" aura:id="contactEmail"/></span>
                                        </div>
                                        <div class="slds-col slds-size_2-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6 slds-p-horizontal_x-small slds-p-top_medium alignRight" style="color:gray;">
                                            <abbr class="slds-required slds-float_right">* </abbr>
                                            <span>{!v.translationsMap.Phone}:</span>
                                        </div>                        
                                        <div class="slds-col slds-size_2-of-6 slds-p-vertical_medium slds-p-horizontal_x-small">
                                            <span><lightning:inputField fieldName="Phone" value="{!v.contact.Phone}" variant="label-hidden" aura:id="phoneNumberforContact" required="true"/></span>
                                        </div>
                                        <div class="slds-col slds-size_2-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6 slds-p-horizontal_x-small slds-p-top_medium alignRight" style="color:gray;">                                        
                                            <abbr class="slds-required slds-float_right">* </abbr>
                                            <!-- <span>Role:</span> -->
                                            <span>{!v.contactFieldsMap.Partner_Portal_View__c}:
                                                <!-- JIRA 5042 change begins -->
                                            <lightning:helptext content="Full: Contact will have access to all records under this partner; Limited: Contact will only have access to their own records"/></span>
                                            	<!-- JIRA 5042 change ends -->
                                        </div>                        
                                        <div class="slds-col slds-size_2-of-6 slds-p-vertical_medium slds-p-horizontal_x-small">
                                            <!-- <span><lightning:inputField fieldName="Partner_Role_Type__c" value="{!v.contact.Partner_Role_Type__c}" variant="label-hidden" required="true"  aura:id="partnerRoleType"/></span> -->
                                            <!-- Added aura:if for ALE issue 4804 -->
                                            <aura:if isTrue="{!!v.ShowOnlyALE}">
                                                <span><lightning:inputField fieldName="Partner_Portal_View__c" value="{!v.contact.Partner_Portal_View__c}" variant="label-hidden" required="true"  aura:id="partnerRoleType"/></span>
                                            </aura:if>
                                            <!-- Added for ALE issue 4804 -->
                                            <aura:if isTrue="{!v.ShowOnlyALE}">
                                                <span>
                                                    <lightning:select name="Partner_Portal_View__c" aura:id="partnerRoleType" value="{!v.contact.Partner_Portal_View__c}" variant="label-hidden" class="label-hidden" >
                                                        <option value="Full">{!v.translationsMap.Full}</option>
                                                        <option value="Limited">{!v.translationsMap.Limited}</option>
                                                    </lightning:select>
                                                </span>
                                            </aura:if>
                                        </div>
                                        <div class="slds-col slds-size_2-of-6"></div>
                                        <div class="slds-col slds-size_1-of-6"></div>
                                    </div>
                                    <div class="slds-form-element slds-form-element_horizontal slds-align_absolute-center slds-p-around_medium" style="bottom-border:.25rem !important;">
                                        <lightning:button variant="brand" label="{!v.translationsMap.Submit}" name="Submit" type="button" iconName="action:check" iconPosition="left" onclick="{!c.createContact}"/>
                                        <lightning:button variant="brand" type="cancel" name="Cancel" label="{!v.translationsMap.Cancel}" iconName="action:close" iconPosition="left" onclick="{!c.cancelContact}"/>            
                                    </div>
                                </lightning:recordEditForm>
                            </lightning:card>
                        </aura:if>
                    </lightning:tab>
                    
                </lightning:tabset>
            </lightning:card>
        </aura:if>
    </aura:if>  
    
    <!-- SHOW LOADING SPINNER-->
    <div class="spinnerHolder">
        <lightning:spinner aura:id="Id_spinner" class="slds-hide" />
    </div>
    <div aura:id="lookupSearchDiv"></div>
    <aura:if isTrue="{!v.showConfirmModal}">
        <div class="slds-m-around--xx-large">            
            
            <!--Modal Box Start-->
            <div role="dialog" class="slds-modal slds-fade-in-open ">
                <div class="slds-modal__container">
                    
                    <!--Modal Box Header-->                    
                    <div class="slds-modal__content slds-p-around--medium">
                        <b><p>UserName : <span>{!v.createdUserName}</span>
                            </p></b>
                        <aura:if isTrue="{!v.isDuplicateUserName}">                           
                            <br/>
                            <span><b>{!v.translationsMap.User_Not_Available_Text}</b></span>
                            <div class="slds-col slds-has-flexi-truncate slds-size_3-of-5 slds-p-vertical_small">                                                                    
                                <lightning:input type="email" aura:id="userNameInput"
                                                 name="Username" required = "true" 
                                                 value="{!v.userNameInput}" maxlength = "76"
                                                 label="Enter a Username to verify" />                                    
                            </div>
                            <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-vertical_small">
                                <lightning:button variant="brand" value="Verify"
                                                  label="Verify" name="Verify"
                                                  type="button" iconName="action:check"
                                                  iconPosition="left"
                                                  onclick="{!c.VerifyUserShowAlert}"/>
                            </div>                                              
                        </aura:if>
                        <aura:if isTrue="{!!v.isDuplicateUserName}">
                            <p>
                                <br/>                                
                                {!v.translationsMap.Are_you_sure_you_want_to_create_a_new_U}                                
                            </p>
                        </aura:if>
                    </div>
                    <!--Modal Box Button-->
                    <div class="slds-modal__footer">
                        <aura:if isTrue="{!v.isDuplicateUserName}">
                            <lightning:button variant="brand" value="Back" label="Back" name="Back"
                                              type="button" iconName="action:check" iconPosition="left" onclick="{!c.createUser}"/>
                            
                        </aura:if>
                        <aura:if isTrue="{!!v.isDuplicateUserName}">
                            <lightning:button variant="brand" value="Yes" label="Yes" name="Yes"
                                              type="button" iconName="action:check" iconPosition="left" onclick="{!c.createUser}"/>
                        </aura:if>                            
                        <lightning:button variant="brand" value="No" type="cancel" name="Cancel" label="{!v.translationsMap.Canel}" iconName="action:close" iconPosition="left" onclick="{!c.createUser}"/>            
                    </div>
                </div>
            </div>
            <div class="slds-backdrop slds-backdrop--open"></div>            
            
        </div>
        
    </aura:if>
</aura:component>