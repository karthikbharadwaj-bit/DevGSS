                                                <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                <span>{!v.communityDetailsRecord.Portal_Master_Agent_Channel_Manager__c}</span>
                                            </div>
                                        </aura:if>
                                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                            <span><lightning:inputField fieldName="Master_Agent_Channel_Manager__c" variant="label-hidden" required="true"/></span>
                                        </div>
                                        <!--Added for PBC-10852 starts-->
                                        <aura:if isTrue="{!!v.ShowOnlyRC}">
