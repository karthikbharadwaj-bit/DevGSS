                                                    <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                    <span>Email(Accounts Payable)
                                                        <lightning:helptext content="Contact Email for the Accounts Payable Contact Role"/>
                                                    </span>
                                                </div>                        
