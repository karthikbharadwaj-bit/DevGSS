                                            </div>
                                        </aura:if>
                                        
                                        <aura:if isTrue="{!!v.ShowOnlyRC}">
                                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                <span>{!v.PRMSpecificTranslationsMap.Master_Agent_Channel_Manager}
                                                <!-- JIRA 5042 change begins -->
                                                    <aura:if isTrue="{!v.ShowOnlyALE}">
                                                        <lightning:helptext content="ALE channel manager aligned to this partner."/>
                                                    </aura:if>
                                                    <aura:if isTrue="{!v.ShowOnlyAtos}">
                                                        <lightning:helptext content="ATOS channel manager aligned to this partner."/>
                                                    </aura:if>
                                                    <aura:if isTrue="{!v.ShowOnlyAvaya}">
                                                        <lightning:helptext content="AVAYA channel manager aligned to this partner."/>
                                                    </aura:if>
                                            	<!-- JIRA 5042 change ends -->
                                                </span>
                                            </div>
                                        </aura:if>
                                        <aura:if isTrue="{!v.ShowOnlyRC}">
