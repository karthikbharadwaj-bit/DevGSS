                                                            <aura:iteration items="{!v.invoiceCopyPartnerList}" var="invoiceCopypartner">
                                                                <option value="{!invoiceCopypartner}" selected="{!invoiceCopyPartner==v.selectedInvoiceCopyPartner}">{!invoiceCopypartner}</option>
                                                            </aura:iteration> 
                                                            
                                                        </lightning:select>
                                                    </span>
                                                </div>
                                                <!--Added for BOB Second set of Changes for JIRA - 6286 end-->
                                                <div class="slds-col slds-size_1-of-7">
                                                    <span></span>
                                                </div>
                                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                    <span>Business Identity</span>
                                                </div> 
                                                <!--Added for BOB Second set of Changes for JIRA - 6286 start-->                       
                                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small customPicklist">
                                                    <span><lightning:select aura:id="BusinessIdentity" name="BusinessIdentity__c" variant="label-hidden" class="label-hidden" onchange="{!c.onChangeBusiness}"
                                                                            value='{!v.selectedBusinessIdentity}' messageWhenValueMissing="Complete this field.">
                                                        <aura:iteration items="{!v.BusinessIdentityValue}" var="BusinessIdentityVal">
                                                            <option value="{!BusinessIdentityVal}" selected="{!BusinessIdentityVal==v.selectedBusinessIdentity}">{!BusinessIdentityVal}</option>
                                                        </aura:iteration>
                                                        </lightning:select>
                                                    </span>
                                                </div>
                                                <!--Added for BOB Second set of Changes for JIRA - 6286 end-->
                                                <!--PBC-9615 Start-->
                                                <aura:if isTrue="{!not(v.isPartnerTypeWholesaleReseller)}">
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_xxx-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>Partner Requires Billing feed?</span>
                                                    </div>
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                        <span><lightning:inputField fieldName="Partner_Requires_Billing_feed__c" variant="label-hidden" required="true" aura:id="partnerReqBillingFeed" onchange="{!c.onPartnerRequiresBillingFeedChange}"/>
                                                        </span>
                                                    </div>
                                                    <aura:if isTrue="{!v.showBillingFeedType}">
                                                        <div class="slds-col slds-size_1-of-7">
                                                            <span></span>
                                                        </div>
                                                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                            <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                            <span>Billing Feed Type</span>
                                                        </div>
                                                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small customPicklist">
                                                            <span>
                                                                
                                                                <lightning:select value="{!v.selectedBillingFeedType}" aura:id="selectedBillingFeedType" name="Billing_Feed_Type__c"
                                                                                  variant="label-hidden" class="label-hidden" messageWhenValueMissing="Complete this field.">                                                    
                                                                    <aura:iteration items="{!v.availableBillingFeedTypes}"  var="mapKey" >
                                                                        <option value="{!mapKey}" selected="{!mapKey==v.selectedBillingFeedType}">{!mapKey}</option>
                                                                    </aura:iteration>
                                                                </lightning:select>
                                                            </span>
                                                        </div>
                                                    </aura:if>
                                                </aura:if>
                                                <!--PBC-9615 End-->
                                            </div>
                                            <div class="slds-grid slds-wrap">
                                                <div class="slds-col slds-size_3-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                    <span> Do you want a Billing Support Contact Role to be created?
                                                        <lightning:helptext content=" Check if you need an additional Partner Contact with Billing Support Contact Role"/>   
                                                    </span>
                                                </div> 
                                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignLeft">
                                                    <span>
                                                        <lightning:input type="checkbox" name="Billsupport"  aura:id="checkbs" checked="{!v.isBillingSupport}"/>
                                                    </span>
                                                </div> 
                                            </div>
                                            <aura:if isTrue="{!v.isBillingSupport}">
                                                <div class="slds-grid slds-wrap">
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>First Name(Billing Support)
                                                            <lightning:helptext content="Contact First Name for the Billing Support Contact Role"/>   
                                                        </span>
                                                    </div>                        
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                        <span><lightning:inputField fieldName= "Partner_First_Name_Billing_Support__c" variant="label-hidden" aura:id="firstnamebs"/></span>
                                                    </div>
                                                    <div class="slds-col slds-size_1-of-7">
                                                        <span></span>
                                                    </div>
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>Last Name(Billing Support)
                                                            <lightning:helptext content="Contact Last Name for the Billing Support Contact Role"/>  
                                                        </span>
                                                    </div>                        
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                        <span><lightning:inputField fieldName="Partner_Last_Name_Billing_Support__c" variant="label-hidden" aura:id="lastnamebs"/></span>
                                                    </div>
                                                    
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>Phone(Billing Support)
                                                            <lightning:helptext content="Contact Phone for the Billing Support Contact Role"/> 
                                                        </span>
