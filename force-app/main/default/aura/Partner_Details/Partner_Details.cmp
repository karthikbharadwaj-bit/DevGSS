                                                    <option value="Yes" selected="true">{!v.translationsMap.Yes}</option>       
                                                </lightning:select>                                      
                                            </span>
                                        </div>
                                        
                                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                            <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                            <span>{!v.contactFieldsMap.Partner_Portal_View__c}
                                                <lightning:helptext content="{!v.translationsMap.Partner_Help_Text_Full}"/></span>
                                        </div>                       
                                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                            <span><lightning:inputField fieldName="Partner_Portal_View__c" variant="label-hidden" required="true"/></span>
                                        </div>
                                        
                                        <aura:if isTrue="{!v.isWorkingWithPartner}">
                                            <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                <span class="heading" style="font-weight: bold;">{!v.translationsMap.Partner_Account}: <lightning:helptext content="Click on Search Icon to choose the Partner Contact"/></span>
                                                <abbr class="slds-required" title="required">* </abbr>
                                            </div>
                                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                <span style="font-weight: bold;">
