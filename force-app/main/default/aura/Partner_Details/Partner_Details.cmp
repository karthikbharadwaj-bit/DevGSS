                                                        <span><lightning:inputField fieldName="Partner_Email_Address_Billing_Support__c" aura:id="emailAddressbs" variant="label-hidden" messageWhenValueMissing="Complete this Field"/></span>
                                                    </div>
                                                </div>
                                            </aura:if>
                                        </aura:if>
                                            <!-- Added for JIRA - 6286 Bill On Behalf PRM/CRM end-->  
                                            <!--Added for Wholesale Reseller Changes for PRM - 55 start-->
                                            <aura:if isTrue="{!v.isPartnerTypeWholesaleReseller}">
                                                <div class="slds-grid slds-wrap">
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>Settlement Type</span>
                                                    </div> 
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small customPicklist">
                        
                                                        <lightning:select name="Settlement_Type__c" aura:id="selectedSettlementType" variant="label-hidden" class="label-hidden">
                                                            <aura:if isTrue="{!v.settlementTypesValueKeys.length == 0}">
                                                                <option value="--None--">--None--</option>
                                                            </aura:if>
                                                            <aura:iteration items="{!v.settlementTypesValueKeys}"  var="mapKey" >
                                                                <option value="{!mapKey}">{!mapKey}</option>
                                                            </aura:iteration>
                                                        </lightning:select>
                                                        
                                                    </div>
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>Settlement Partner ID</span>
                                                    </div>                        
                                                    
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small customPicklist">
                                                        <span>
                                                            
                                                            <lightning:select aura:id="SettlementPartnerSelect" name="Settlement_Partner_ID__c" variant="label-hidden" class="label-hidden" 
                                                                                                                value="{!v.selectedSettlementPartner}" 
                                                                                                                messageWhenValueMissing="Complete this field.">
                                                                
                                                                <aura:iteration items="{!v.settlementPartnerList}" var="settlementPartner">
                                                                    <option value="{!settlementPartner}" selected="{!settlementPartner==v.selectedSettlementPartner}">{!settlementPartner}</option>
                                                                </aura:iteration> 
                                                            </lightning:select>
                                                        </span>
                                                    </div>
                                                    
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>Partner Tax Exemptions
                                                        </span>
                                                    </div>                        
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                        <span><lightning:inputField fieldName="Partner_Tax_Exemptions__c" required="true" variant="label-hidden"  aura:id="partnerTaxExemptions" messageWhenValueMissing="Complete this Field"/></span>
                                                    </div>
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_xxx-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>Settlement Rate Partner ID
                                                        </span>
                                                    </div>   
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small customPicklist">
                                                        <span>
                                                            <lightning:select aura:id="SettlementRatePartnerSelect" name="Settlement_Rate_Partner_ID__c" variant="label-hidden" class="label-hidden" 
                                                                                                                value="{!v.selectedSettlementRatePartner}" 
                                                                                                                messageWhenValueMissing="Complete this field.">
                                       
                                                                <aura:iteration items="{!v.settlementPartnerList}" var="settlementRatePartner">
                                                                    <option value="{!settlementRatePartner}" selected="{!settlementRatePartner==v.selectedSettlementRatePartner}">{!settlementRatePartner}</option>
                                                                </aura:iteration> 
                                                                                                                  
                                                            </lightning:select>
                                                        </span>
                                                    </div>
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                        <span>DUNS Number</span>
                                                    </div>                        
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                        <span><lightning:inputField fieldName= "DUNS_Number__c" variant="label-hidden" aura:id="dunsNumber"/></span>
                                                    </div>
                                                    <div class="slds-col slds-size_1-of-7">
                                                        <span></span>
                                                    </div>
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                        <span>CAGE Number</span>
                                                    </div>                        
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                        <span><lightning:inputField fieldName= "CAGE_Number__c" variant="label-hidden" aura:id="cageNumber"/></span>
                                                    </div>
                                          
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_xxx-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>Should customer be able to Live purchase on SW?</span>
                                                    </div>
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                        <span><lightning:inputField fieldName="Should_customer_be_able_to_Live_purchase__c" required="true" variant="label-hidden" aura:id="shouldCustLivePurchase"/>
                                                        </span>
                                                    </div>
                                                    <div class="slds-col slds-size_1-of-7">
                                                        <span></span>
                                                    </div>
                                                    <div class="slds-col slds-size_1-of-7 slds-p-around_xxx-small alignRight" style="color:gray;">
                                                        <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                        <span>Partner Requires Billing feed?</span>
                                                    </div>
                                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                        <span><lightning:inputField fieldName="Partner_Requires_Billing_feed__c" variant="label-hidden" required="true" aura:id="partnerReqBillingFeed" onchange="{!c.onPartnerRequiresBillingFeedChange}"/>
                                                        </span>
                                                    </div>
                                                    <aura:if isTrue="{!v.showBillingFeedType}">
                                                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                            <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                            <span>Billing Feed Type</span>
                                                        </div>
                                                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small customPicklist">
                                                            <span>
                                                                <lightning:select value="{!v.selectedBillingFeedType}" aura:id="selectedBillingFeedType" name="Billing_Feed_Type__c"
                                                                variant="label-hidden" class="label-hidden" messageWhenValueMissing="Complete this field.">                                                    
                                                                    <aura:iteration items="{!v.availableBillingFeedTypes}"  var="mapKey" >
                                                                        <option value="{!mapKey}" selected="{!mapKey==v.selectedBillingFeedType}">{!mapKey}</option>
                                                                    </aura:iteration>
                                                                </lightning:select>
                                                            </span>
                                                        </div>
                                                    </aura:if>
                                                </div>
                                            </aura:if>
                                            <!--Added for Wholesale Reseller Changes for PRM - 55 end-->
                                        <div class="slds-col slds-size_1-of-7">
                                            <span></span>
                                        </div>
                                        
                                        <div class="slds-form-element slds-form-element_horizontal slds-align_absolute-center slds-p-around_medium" style="bottom-border:.25rem !important;">
                                            <lightning:button variant="brand" label="{!v.translationsMap.Apply_Now}" type="submit" iconName="utility:forward" iconPosition="right"/>
                                            <lightning:button variant="brand" type="cancel" name="Cancel" label="{!v.translationsMap.Cancel}" iconName="action:close" iconPosition="left" onclick="{!c.closeForm}"/>            
                                        </div>
                                        
                                    </div>
                                    <div class="slds-is-relative">
                                        <div class="spinnerHolder">
                                            <lightning:spinner alternativeText="Loading..." aura:id="loadingSpinner" class="slds-hide" size="medium"/>
                                        </div>
                                    </div>
                                </lightning:recordEditForm>
                            </lightning:card>
                            
                            
                        </lightning:tab>
                    </aura:if>      
                </aura:if>
            </lightning:tabset> 
        </aura:if>  
        <!--Display Partner Record Details and Contact Details-->
        <aura:if isTrue="{!v.ShowRecordDetail}">
            <lightning:card variant="Narrow" title="{!v.translationsMap.Partner_Details}" iconName="utility:people"> 
                <aura:set attribute="actions">
                    <lightning:button variant="brand" label="{!v.translationsMap.Go_Back}" iconName="action:recall" onclick="{!c.goBackToViewList}" />
                </aura:set>
                <lightning:tabset selectedTabId="{!v.selSubTabId}">
                    <lightning:tab label="{!v.translationsMap.Details}" id="detailTab" onactive="{!c.getAccList}">
                        <aura:if isTrue="{!v.showDetailSection}">
                            <aura:if isTrue="{!v.isAvaya}"> 
                                <div class="edit-btn-wrap">
                                    <lightning:button variant="brand" label="{!v.translationsMap.Edit}" iconName="action:edit" iconPosition="left" onclick="{!c.editDetail}"/>
                                </div>  
                            </aura:if>
                            <div class="slds-grid slds-wrap">
                                <div class="slds-col slds-size_1-of-6 slds-p-around_x-small alignRight" style="color:gray;">
                                    <span>{!v.partnerFieldsMap.Name}</span>
                                </div>                        
                                <div class="slds-col slds-size_2-of-6 slds-p-around_x-small">
                                    <span>{!v.AccountRecord.Name}</span>
                                </div>
                                <!--<div class="slds-col slds-size_1-of-7">
                                    <span></span>
                                </div>-->
                                <aura:if isTrue="{!!v.isMasterAgent}">
                                    <div class="slds-col slds-size_1-of-6 slds-p-around_x-small alignRight" style="color:gray;">
                                        <span>{!v.translationsMap.Partner_Account}</span>
                                    </div>                        
                                    <div class="slds-col slds-size_2-of-6 slds-p-around_x-small">
                                        <span>{!v.AccountRecord.Partner_Account__r.Name}</span>
                                    </div>  
                                </aura:if>
                                <aura:if isTrue="{!v.isMasterAgent}">
                                    <div class="slds-col slds-size_1-of-6">
                                        <span></span>
                                    </div>
                                    <div class="slds-col slds-size_2-of-6">
                                        <span></span>
                                    </div>
                                </aura:if>
                                <div class="slds-col slds-size_1-of-6 slds-p-around_x-small slds-border_top alignRight"  style="color:gray;">
                                    <span>{!v.translationsMap.Partner_ID}</span>
                                </div>                        
                                <div class="slds-col slds-size_2-of-6 slds-p-around_x-small slds-border_top">
                                    <span>{!v.AccountRecord.Partner_ID__c}</span>
                                </div>
                                <!--<div class="slds-col slds-size_1-of-7 slds-border_top">
                                    <span></span>
                                </div>-->
                                <aura:if isTrue="{!v.ShowOnlyAvaya}">
                                    <div class="slds-col slds-size_1-of-6 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                                        <span>RingCentral Channel Manager</span>
                                    </div>                        
                                    <div class="slds-col slds-size_2-of-6 slds-p-around_x-small slds-border_top">
                                        <span>{!v.AccountRecord.Channel_Manager_Name__c}</span>
                                    </div>
                                    <aura:set attribute="else">
                                        <div class="slds-col slds-size_1-of-6 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                                            <span>{!v.partnerFieldsMap.Inside_Sales_Rep__c}</span>
                                        </div>                        
                                        <div class="slds-col slds-size_2-of-6 slds-p-around_x-small slds-border_top">
                                            <span>{!v.AccountRecord.Channel_Manager_Name__c}</span>
                                        </div> 
                                    </aura:set>
                                </aura:if>                             
                                <div class="slds-col slds-size_1-of-6 slds-p-around_x-small slds-border_top alignRight"  style="color:gray;">
                                    <span>{!v.translationsMap.Billing_City}</span>
                                </div>                        
                                <div class="slds-col slds-size_2-of-6 slds-p-around_x-small slds-border_top">
                                    <span>{!v.AccountRecord.BillingCity}</span>
                                </div>
                                <!--<div class="slds-col slds-size_1-of-7 slds-border_top">
                                    <span></span>
                                </div>-->
                                <!-- Added for JIRA - PBC 10653 End-->
                                <div class="slds-col slds-size_1-of-6 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                                    <span>{!v.translationsMap.Billing_State_Province}</span>
                                </div>                        
                                <div class="slds-col slds-size_2-of-6 slds-p-around_x-small slds-border_top">
                                    <span>{!v.AccountRecord.BillingState}</span>
                                </div> 
                                <div class="slds-col slds-size_1-of-6 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                                    <span>{!v.translationsMap.Billing_Postal_Code}</span>
                                </div>                        
                                <div class="slds-col slds-size_2-of-6 slds-p-around_x-small slds-border_top">
