                                            </div>
                                            <div class="slds-col slds-size_4-of-7">
                                                <span></span>
                                            </div>
                                        </aura:if>
                                        <!--PBC-10852 ends-->
                                        <!-- Added for JIRA - 6286 Bill On Behalf PRM/CRM start-->                                       
                                        <!--Added for Mitel PRM-145 starts-->
                                        <aura:if isTrue="{!v.ShowOnlyRC}">
                                            <div class="slds-col slds-size_1-of-7"></div>
                                            <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                <span>Partner Classification</span>
                                            </div>
                                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                <span><lightning:inputField fieldName="Partner_Classification__c" variant="label-hidden" /></span>
                                            </div>    
                                        </aura:if>
                                        <!--Added for Mitel PRM-145 ends-->
                                        <aura:if isTrue="{!or(v.ShowOnlyAtos,or(v.ShowOnlyAvaya,v.ShowOnlyALE))}">
                                            <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                <span>Partner Type</span>
                                            </div>
                                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small customPicklist">
                                                <span>
                                                    <lightning:select aura:id="partnerTypeSelect" name="partnerType__c" variant="label-hidden" class="label-hidden" 
                                                                                                        value='{!v.selectedPartnerType}' onchange="{!c.onchangePT}"
                                                                                                                    messageWhenValueMissing="Complete this field.">
                                                    <aura:iteration items="{!v.partnerTypeListDisplayed}" var="partnertype" indexVar="index">
                                                    <option value="{!partnertype}" selected="{!partnertype==v.selectedPartnerType}">{!partnertype}</option>
                                                    </aura:iteration>
                                                    </lightning:select>
                                                </span>
                                            </div>
                                            <div class="slds-col slds-size_1-of-7">
                                                <span></span>
                                            </div>
                                        </aura:if>
                                        <aura:if isTrue="{!v.isPartnerTypeBillOnBehalf}">
                                            <div class="slds-grid slds-wrap">                                           
                                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                    <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                    <span>First Name(Accounts Payable)
                                                        <lightning:helptext content="Contact First Name for the Accounts Payable Contact Role"/>   
                                                    </span>
                                                </div>                        
                                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                    <span><lightning:inputField fieldName= "Partner_First_Name_Accounts_Payable__c" variant="label-hidden" aura:id="firstnamebob"/></span>
                                                </div>
                                                <div class="slds-col slds-size_1-of-7">
                                                    <span></span>
                                                </div>
                                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                    <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                    <span>Last Name(Accounts Payable)
                                                        <lightning:helptext content="Contact Last Name for the Accounts Payable Contact Role"/>  
                                                    </span>
                                                </div>                        
                                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                                    <span><lightning:inputField fieldName="Partner_Last_Name_Accounts_Payable__c" variant="label-hidden" aura:id="lastnamebob"/></span>
                                                </div>
                                                
                                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                                    <abbr class="slds-required slds-float_right" title="required">* </abbr>
                                                    <span>Phone(Accounts Payable)
                                                        <lightning:helptext content="Contact Phone for the Accounts Payable Contact Role"/> 
                                                    </span>
                                                </div>                        
