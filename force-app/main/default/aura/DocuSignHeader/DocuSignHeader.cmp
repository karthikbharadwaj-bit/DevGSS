<aura:component description="DocuSignHeader">

    <!-- Attributes -->
    <aura:attribute name="app" type="Object"/>

    <lightning:layoutItem class="docusign-header slds-page-header">
        <div class="slds-page-header__row">

            <!-- Nav Buttons -->
            <aura:if isTrue="{! v.app.tabs.isSendActive }">
                <div class="slds-col slds-no-flex slds-p-right_medium slds-border_right slds-m-right_medium">
                    <c:Button label="Manage DocuSign"
                              iconName="action:back"
                              onclick="{! c.openManageTab }"/>
                </div>
            </aura:if>

            <!-- Tab Name -->
            <div class="slds-page-header__col-title">
                <div class="slds-media slds-media_center">
                    <div class="slds-media__figure">
                        <lightning:icon iconName="standard:work_order_item"/>
                    </div>
                    <div class="slds-media__body">
                        <h1 class="slds-page-header__title slds-truncate">
                            {! v.app.tabs.currentTabName }
                        </h1>
                    </div>
                </div>
            </div>
        </div>
    </lightning:layoutItem>
</aura:component>