<design:component label="SC Knowledge Banner">
    <design:attribute name="image_inx" label="Image order index" description="Enter index of Order from Support Community Image lnk where 'Place' equals '
knowledge banner'"/>
    <design:attribute name="link_title" label="Link label" />
    <design:attribute name="description" label="Link description" description="use the '${link}' construct to indicate a place for link"/>
    <design:attribute name="targetAttr" label="Target link (new tab or not)" datasource="Tab,Here" default="Tab" />
</design:component>