<aura:component implements="force:hasRecordId,force:lightningQuickAction,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,lightning:actionOverride,lightning:isUrlAddressable"
                access="global">
    <aura:attribute name="approvalRecordId" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.initComponent}"/>

    <c:lsaCreation recordId="{!v.approvalRecordId}"/>
</aura:component>