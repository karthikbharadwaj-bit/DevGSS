<aura:component implements="forceCommunity:availableForAllPageTypes" description="Support Community Phone">
    <aura:attribute name="phone" type="String" default="" />
    <aura:attribute name="phoneNumber" type="String" default="" />
    <aura:handler name="init" action="{!c.doInit}" value="{!this}"/>
    <p>{!$Label.c.SC_sales} <a href="{!'tel:'+v.phoneNumber}">{!v.phone}</a></p>
</aura:component>