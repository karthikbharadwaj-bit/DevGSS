                <div class="slds-size--6-of-12 slds-grid">
                    <div class="slds-form-element">
                        <div class="slds-form-element__control">
                            <lightning:select class="select-auto-width" label="Attachment - Security Addendum" value="{!v.objApprovalRec.Security_Addendums__c}" >
                                <option value="">None</option>
                                <option value="Standard">Standard</option>
