<aura:component >
    <aura:attribute name="detailComments" type="String"/>
    <aura:attribute name="approvalComments" type="String"/>
    <aura:attribute name="objApprovalRec" type="Approval__c" default="{'sobjectType': 'Approval__c','Standard_Terms__c' : 'true'}"/>
    <aura:attribute name="partnerQuoteId" type="String" />
    <aura:attribute name="IsOpenInCommunity" type="Boolean" />
    <aura:attribute access="public" name="sObjectAttachedFiles" type="List" default="[]"/>
    <aura:attribute name="isStandard" type="Boolean" default="true"/>
    
     <!--Added by Ishwarya to get respective Community Details-->
     <aura:attribute name="communityDetailsRecord" type="Object"/>
     <aura:attribute name="baseURL" type="string"/>
    
     <aura:attribute name="translationsMap" type="Map" />

    <div class="slds-form--stacked slds-p-around--medium slds-m-bottom--x-small">
        <!--<div class="slds-size- -1-of-1 slds-grid">
            All Standard Terms &nbsp; 
            <lightning:input variant="label-hidden" name="testBoolean" label="Test Boolean" 
                             type="radio" checked="{!v.objApprovalRec.Standard_Terms__c}" onclick="{!c.checkStandardTerms}" />
		</div>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;OR
        <br/> -->
        <div class="slds-size--1-of-1 slds-grid">
           {!v.translationsMap.Word_document_s_attached} &nbsp; 
            <lightning:input variant="label-hidden" name="testBoolean" label="Test Boolean" 
                             type="checkbox" aura:id="RELATED_OPTIONS" checked="{!v.objApprovalRec.document_attached__c}" 
                             />
            <!--onclick="{!c.checkWorkDocumentAttached}" -->
		</div>
        <br/>
        <aura:if isTrue="{!v.objApprovalRec.document_attached__c}">
            <div class="slds-size--1-of-1 slds-grid">
                Request for RingCentral approval(s) &nbsp; 
                <lightning:input variant="label-hidden" name="testBoolean" label="Test Boolean" 
                                 type="checkbox" aura:id="RELATED_OPTIONS" checked="{!v.objApprovalRec.RC_Approvals__c}" />
            </div>
            <br/>
            <div class="slds-size--1-of-1 slds-grid">
                <span>Request for Ringcentral to generate final documents for sign <br/> 
                    <p style="color:red">(By clicking on this box, {!v.communityDetailsRecord.Portal_Main_Label__c} represents and warrant that all<br/>
                    documents are either standard (unmodified) or all revisions and<br/>
                    deviations have been fully disclosed to and duly approved by <br/>
                    RingCentral.)</p> </span>  &nbsp; <lightning:input variant="label-hidden" name="testBoolean" label="Test Boolean" type="checkbox" checked="{!v.objApprovalRec.RC_final_documents_for_sign__c}" />
            </div>
        </aura:if>
    </div>
    <aura:if isTrue="{!v.objApprovalRec.document_attached__c}">
        <br/>
        <div style="font-size:120%">Comments</div> <!--Detail -->
                <lightning:textarea value="{!v.detailComments}"/>
       <!-- <br/>
        <div style="font-size:120%">Approval comments</div>
                <lightning:textarea value="{!v.approvalComments}"/> -->
        <br/>
        <h3 style="background-color: #D3D3D3" class="slds-section-title--divider">Finalized Contract Info ({!v.communityDetailsRecord.Portal_Main_Label__c} Legal Use Only)</h3>
        <div class="slds-form--stacked slds-p-around--medium slds-m-bottom--x-small">
            <div class="slds-size--1-of-1 slds-grid">
                <div class="slds-size--6-of-12 slds-grid">
                    <div class="slds-form-element">
                        <div class="slds-form-element__control">
                            <lightning:select class="select-auto-width" label="RC Entity" value="{!v.objApprovalRec.RC_Entity__c}" >
                                <option value="">None</option>
                                <option value="USA">USA</option>
                                <option value="Canada">Canada</option>
                                <option value="France">France</option>
                            </lightning:select>
                            <!-- <lightning:input aura:id="{!IF(index == 0,country,'dup')}" required="true" variant="label-hidden" value="{!addr.Country__c}" type="text" /> -->
                        </div>
                    </div>
                </div>
                <div class="slds-size--6-of-12 slds-grid">
                    <div class="slds-form-element">
                        <div class="slds-form-element__control">
                            <lightning:select class="select-auto-width" label="Commercial MSA" value="{!v.objApprovalRec.Commercial_MSA__c}">
                                <option value="">None</option>
                                <option value="Standard">Standard</option>
                                <option value="Non-Standard  w TOS online">Non-Standard w TOS online</option>
                                <option value="Non-Standard w TOS hardwired">Non-Standard w TOS hardwired</option>
                            </lightning:select>
                            <!-- <lightning:input aura:id="{!IF(index == 0,country,'dup')}" required="true" variant="label-hidden" value="{!addr.Country__c}" type="text" /> -->
                        </div>
                    </div>
                </div>
            </div>
            <br/>
            <div class="slds-size--1-of-1 slds-grid">
                <div class="slds-size--6-of-12 slds-grid">
                    <div class="slds-form-element">
                        <label class="slds-form-element__label" for="NDA">NDA</label>
                        <div class="slds-form-element__control">
                            <div style="width:100%">  
                                <div style="float:left">No</div> 
                                <div style="float:left">
                                    <lightning:input name="NDA" label="" type="toggle" checked="{!v.objApprovalRec.NDA__c}"
                                                     messageToggleActive="" messageToggleInactive=""/>
                                </div>
                                <div style="float:left">&nbsp;Yes</div>
                            </div> 
                        </div>
                    </div>
                   <!-- <div class="slds-form-element">
                        <div class="slds-form-element__control">
                            <lightning:select class="select-auto-width" label="Participant Agreement" value="{!v.objApprovalRec.Participant_Agreement__c}" >
                                <option value="">None</option>
                                <option value="Standard">Standard</option>
                                <option value="Non-Standard">Non-Standard</option>
                            </lightning:select>
                        </div>
                    </div> -->
                </div>
                <div class="slds-size--6-of-12 slds-grid">
                    <div class="slds-form-element">
                        <label class="slds-form-element__label" for="NDA">Evaluation Agreement</label>
                        <div class="slds-form-element__control">
                            <div style="width:100%">  
                                <div style="float:left">No</div> 
                                <div style="float:left">
                                    <lightning:input name="NDA" label="" type="toggle" checked="{!v.objApprovalRec.POC__c}"
                                                     messageToggleActive="" messageToggleInactive=""/>
                                </div>
                                <div style="float:left">&nbsp;Yes</div>
                            </div> 
                        </div>
                    </div>
                </div>
            </div>
            <!--<br/>
             <div class="slds-size- -1-of-1 slds-grid">
                <div class="slds-size- -6-of-12 slds-grid">
                </div>
                <div class="slds-size- -6-of-12 slds-grid">
                    <div class="slds-form-element">
                        <div class="slds-form-element__control">
                            <lightning:select class="select-auto-width" label="Order Form" value="{!v.objApprovalRec.Order_Form__c}" >
                                <option value="">None</option>
                                <option value="Standard">Standard</option>
                                <option value="Non-Standard">Non-Standard</option>
                            </lightning:select>
                        </div>
                    </div>
                </div>
            </div>
            <br/> 
            <div class="slds-size- -1-of-1 slds-grid">
                <div class="slds-size- -6-of-12 slds-grid">
                    <div class="slds-form-element">
                        <label class="slds-form-element__label" for="NDA">Amendment No</label>
                        <div class="slds-form-element__control">
                            <lightning:input variant="label-hidden" type="number" value="{!v.objApprovalRec.Amendment__c}"/>
                        </div>
                    </div>
                </div>
                <div class="slds-size- -6-of-12 slds-grid">
                </div>
            </div> -->
        </div> 
        <br/>
        <h3 style="background-color: #D3D3D3" class="slds-section-title--divider">Finalized Attachments ({!v.communityDetailsRecord.Portal_Main_Label__c} Legal Use Only)</h3>
        <div class="slds-form--stacked slds-p-around--medium slds-m-bottom--x-small">
            <div class="slds-size--1-of-1 slds-grid">
                <div class="slds-size--6-of-12 slds-grid">
                    <div class="slds-form-element">
                        <div class="slds-form-element__control">
                            <lightning:select class="select-auto-width" label="Service Attachment - Enterprise Support" value="{!v.objApprovalRec.SOW__c}" >
                                <option value="">None</option>
                                <option value="Standard">Standard</option>
                                <option value="Non-Standard">Non-Standard</option>
                            </lightning:select>
                            <!-- <lightning:input aura:id="{!IF(index == 0,country,'dup')}" required="true" variant="label-hidden" value="{!addr.Country__c}" type="text" /> -->
                        </div>
                    </div>
                </div>
                <div class="slds-size--6-of-12 slds-grid">
                    <div class="slds-form-element">
                        <div class="slds-form-element__control">
                            <lightning:select class="select-auto-width" label="Attachment - SLA-Office" value="{!v.objApprovalRec.SLA__c}" >
                                <option value="">None</option>
                                <option value="">Standard</option>
