            <br/>
            <div class="slds-size--1-of-1 slds-grid">
                <div class="slds-size--6-of-12 slds-grid">
                    <!-- <div class="slds-form-element">
                        <div class="slds-form-element__control">
                            <lightning:select class="select-auto-width" label="Service Attachment - Engage Voice" value="{!v.objApprovalRec.Service_Attachment_Engage_Voice__c}" >
