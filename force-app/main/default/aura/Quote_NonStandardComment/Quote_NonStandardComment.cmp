                            <lightning:select class="select-auto-width" label="Attachment - Data Processing Addendum" value="{!v.objApprovalRec.Model_Clauses__c}" >
                                <option value="">None</option>
                                <option value="Standard">Standard</option>
                                <option value="Non-Standard">Non-Standard</option>
                            </lightning:select>
