<design:component label="SupportCommunityTheme">
    <design:attribute name="preloader" label="Show preloader" />
    <design:attribute name="showTitle" label="Show Search Title" />
    <design:attribute name="loginUrl" label="SSO Login URL" />
    <design:attribute name="VideoURL" label="URL of video background" />
    <design:attribute name="VideoType" label="MIME Type of video background" />
    <design:attribute name="Phone" label="US domain (obsolete)" description="For change domain - open Custom Settings -> SupportCommunityLanguages" />
    <design:attribute name="UK_domain" label="UK domain (obsolete)" description="For change domain - open Custom Settings -> SupportCommunityLanguages" />
</design:component>