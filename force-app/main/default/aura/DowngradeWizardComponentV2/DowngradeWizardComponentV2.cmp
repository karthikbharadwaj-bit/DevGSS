<aura:component controller="DowngradeWizardController">
        
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <aura:attribute name="wizardType" type="String"/>
    <aura:attribute name="wizardName" type="String"/>
    <aura:attribute name="accId" type="String"/>
    <aura:attribute name="global" type="Map" default="{isLoading: false}"/>
    <aura:attribute name="oppInfo" type="String"/>
    <aura:attribute name="oppId" type="String"/>
    <aura:attribute name="validationType" type="String"/>
    <aura:attribute name="opportunityWizardData" type="Map"/>
    <aura:attribute name="fieldValues" type="Map"/>
    <aura:attribute name="requiredFields" type="List"/> 
    <aura:attribute name="showAccountLockWarning" type = "Boolean" default="false"/>
    <aura:attribute name="showKeyDealFields" type = "Boolean" default="false"/>
    <aura:attribute name="showKeyDealOther" type = "Boolean" default="false"/>
    <aura:attribute name="isFieldsMandatory" type = "Boolean" default="true"/>

    <aura:if isTrue="{!v.wizardType}">
        <div>
             <!-- header -->
             <div class="slds-page-header">
                <div class="slds-grid slds-grid--vertical-align-center">
                    <div class="slds-col slds-has-flexi-truncate">
                        <lightning:icon iconName="custom:custom3" size="medium"
                                        class="slds-icon slds-icon-standard-coaching slds-m-right--small"
                                        alternativeText="wizard"/>
                        <h1 class="slds-page-header__title slds-m-right--small slds-align-middle slds-truncate slds-show--inline-block"
                            title=""><span class="capitalize">{!v.wizardName}</span> Wizard</h1>
                    </div>
                </div>
            </div>  

            <aura:if isTrue="{!v.showAccountLockWarning}">
                <div class="slds-grid">
                    <div class="slds-col slds-p-horizontal_large" style="text-align: center;">
                        <h1 style="font-size: 20px;">{!$Label.c.DW_Title_CloseOpportunity}</h1>
                        <p style="font-size: 15px; padding: 3px;">{!$Label.c.DW_Message_CloseOpportunity}</p>
                        <lightning:button type="Cancel" name="cancel" label="Cancel" class="slds-button_neutral" onclick="{!c.cancel}"/>
                        <lightning:button type="submit" name="Submit" label="Ok" class="slds-button_brand"  onclick="{!c.submitWithoutFields}"/>
                    </div>
                </div>
                <aura:set attribute="else">
                    <!-- content -->
                    <div class="slds-grid">
                        <div class="slds-col slds-p-horizontal_large ">
                        <aura:if isTrue="{!v.isFieldsMandatory}">
							<div class="slds-notify slds-notify_alert slds-m-bottom_large slds-text-heading_medium" role="alert">
                            <h1>Please fill the below fields to {!v.wizardName} this Opportunity </h1></div>
                        </aura:if>                        
                        <lightning:recordEditForm objectApiName="Opportunity" recordId="{!v.oppId}"  onsubmit="{!c.submit}" >    
                            <lightning:inputField  fieldName="Type" disabled ="false" style="display:none;"/>
                            <aura:iteration items="{!v.requiredFields}" var="field">
                                <lightning:inputField  fieldName="{!field}" required = "{!v.isFieldsMandatory}"/>
                            </aura:iteration>  
                            <aura:if isTrue="{!v.showKeyDealFields}">
                                <lightning:inputField  fieldName="Key_Deal_Integration__c" required = "true" onchange="{!c.handleKeyDealIntegrationField}"/>
                                <aura:if isTrue="{!v.showKeyDealOther}">
                                    <lightning:inputField  fieldName="Key_Deal_Integration_Other__c" required = "true"/>
                                </aura:if>                                
                            </aura:if>
                            <div class="slds-align_absolute-center">                                 
                            <lightning:button type="Cancel" name="cancel" label="Cancel" class="slds-button_neutral" onclick="{!c.cancel}"/>
                            <lightning:button type="submit" name="Submit" label="Submit" class="slds-button_brand"/>
                            </div>   
                        </lightning:recordEditForm>
                        
                        </div>
                    </div>
                  </aura:set>
            </aura:if>
        </div>
    </aura:if>

    <c:Toasts/>
    <c:Spinner/>
    <c:Modals/>

</aura:component>