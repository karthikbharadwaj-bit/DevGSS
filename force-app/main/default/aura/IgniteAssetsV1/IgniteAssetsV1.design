<design:component label="Ignite Assets">
    <design:attribute name="Show" label="Enable Assets" description="Show or Hide Assets" default="true" />
    <design:attribute name="Promo" label="Enable Category or Date" description="Assets Category or Promo Date" default="true" />
    <design:attribute name="AssetLabel" label="Assets Category or Promo Date" placeholder="Category or Date"/>

    <design:attribute name="ImageURL" label="Image" placeholder="Filename" description="Key sensitive use underscore ( _ ) on space"/>
    <design:attribute name="PublicURL" label="Assets Link" placeholder="https://link.com" />
    <design:attribute name="Title" label="Asset Title" placeholder="Your Title" />
    <design:attribute name="ShowDes" label="Enable Descriptions" description="For assets descriptions" default="false" />
    <design:attribute name="Description" label="Descriptions" placeholder="Input some descriptions"/>
    
</design:component>