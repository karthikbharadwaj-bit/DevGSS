<aura:component extends="forceCommunity:navigationMenuBase" implements="forceCommunity:availableForAllPageTypes">
    <aura:handler name="init" action="{!c.doInit}" value="{!this}"/>
    <aura:handler name="init" value="{!v.menuItems}" action="{!c.doInit}"/>
    <aura:handler name="change" value="{!v.menuItems}" action="{!c.itemsChange}"/>
    <aura:attribute name="current" type="Map" default=" {'label': 'US', 'value': 'en_US'}" />
    <aura:attribute name="menuItemsNew" type="List" default="[]" />
    <aura:attribute name="loading" type="Boolean" default="true" />
    <aura:attribute name="loginFirstClick" type="Boolean" default="true" />
    <aura:attribute name="options" type="List" default="[
    {'label': 'US', 'value': 'en_US'}
    ]"/>
    <aura:attribute name="user" type="User" />
    <ul class="community-navigation-menu" onclick="{!c.onClick}" style="{! v.loading ? 'visibility: hidden;':''}">
    <aura:iteration items="{! v.menuItemsNew }" var="item" >
        <li class="{!item.active ? 'tab-item active' : 'tab-item'}">
            <aura:if isTrue="{! item.subMenu }">
                <div class="menu-title has-submenu" onclick="{!c.openSubMenu}">{!item.label}</div>
                <ul class="main-menu-item">
                    <aura:iteration items="{! item.subMenu }" var="subItem">
                        <li class="dropdown-content-item" >
                                <span data-menu-item-id="{! subItem.id }" class="a" >
                                    {! subItem.label }
                                </span>
                        </li>
                    </aura:iteration>
                </ul>
                <aura:set attribute="else">
                    <div class="menu-title"><span class="a" data-menu-item-id="{!item.id}" href="javascript:void(0);"> {! item.label }</span></div>
                </aura:set>
            </aura:if>
        </li>
    </aura:iteration>
        <li class="tab-item mobile-only">
            <div class="menu-title has-submenu" onclick="{!c.openSubMenu}">Language</div>
            <ul class="main-menu-item">
                <aura:iteration items="{!v.options}" var="item" indexVar="inx">
                    <li class="{!'dropdown-content-item' + (item.checked?' checked':'')}" role="presentation" onclick="{!c.select}" data-value="{!item.value}">
                        <lightning:icon iconName="utility:check" size="xx-small" alternativeText="" />
                        <span class="slds-truncate" title="{!item.label}">{!item.label}</span>
                    </li>
                </aura:iteration>
            </ul>
        </li>
        <li class="tab-item mobile-only">
            <div class="menu-title">
                <aura:if isTrue="{!v.user}">
                    <span class="a" data-menu-item-id="0" href="javascript:void(0)" onclick="{!c.logoutClick}">Log out</span>
                    <aura:set attribute="else">
                        <span class="a" data-menu-item-id="0" href="javascript:void(0)" onclick="{!c.loginButton}">Login</span>
                    </aura:set>
                </aura:if>
            </div>
        </li>

    </ul>
</aura:component>