<aura:component implements="forceCommunity:searchInterface" access="global" >
    <aura:attribute name="placeholder" default="Search..." type="String" />
    <aura:attribute name="inited" default="false" type="Boolean" />
    <aura:attribute name="link" default="diabled" type="String"  />
    <!--<div onkeyup="{!c.redirectKey}" class="sc-search_place">-->
            <!--<lightning:buttonIcon iconName="utility:search" variant="container" alternativeText="Search" onclick="{!c.searchClick}"/>-->
            <!--<lightning:input aura:id="searchField" label="" type="search" placeholder="{!v.placeholder}"/>-->
    <!--</div>-->
    <aura:handler name="init" action="{!c.doInit}" value="{!this}"/>
    <aura:attribute name='name' type='String' default='communityCoveo' access='global' />
    <aura:attribute name='searchHub' type='String' default='Box16SupportCommunity' access='global' />
    <aura:attribute name='searchPageName' type='String' default='search/%40uri' access='global' />
    <aura:attribute name='customTokenGeneration' type='Boolean' default='true' access='global' />
    <aura:attribute name='doinit' type='Boolean' default='false' access='global' />
    <!--<aura:if isTrue="{!v.doinit}">-->
    <!--</aura:if>-->
</aura:component>