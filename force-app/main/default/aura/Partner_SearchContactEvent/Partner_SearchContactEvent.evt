<aura:event type="COMPONENT">
    <aura:attribute name="Id" type="String"/>
    <aura:attribute name="PartnerId" type="String"/>
    <aura:attribute name="Name" type="String"/>
    <aura:attribute name="PartnerAccountName" type="String"/>
    <aura:attribute name="PartnerAccount" type="Boolean" default="false"/>
    <aura:attribute name="PartnerCountry" type="String"/>
    <aura:attribute name="brandsPermitted" type="List" default="['RingCentral']"/>
    <aura:attribute name="accountMasterAgentChlMgr" type="String"/>
    <aura:attribute name="partnerAvailableCountries" type="String"/>    
    <aura:attribute name="accountVARTerritory" type="String"/>
    <aura:attribute name="accountPartnerType" type="String"/>
	<aura:attribute name="businessIdentity" type="String"/>    
    <aura:attribute name="territoryAlignmentMap" type="String"/>
    <aura:attribute name="insideSalesRep" type="String"/>
    <aura:attribute name="AccountId" type="String"/>
    <aura:attribute name="isMitel" type="boolean" default="false"/>
    <!--Added for mitel-->
    <aura:attribute name="partnerClassification" type="String" />
    <!--PBC-9705 P2CSharing-->
</aura:event>