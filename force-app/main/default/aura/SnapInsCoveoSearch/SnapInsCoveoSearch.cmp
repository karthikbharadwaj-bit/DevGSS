<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global" controller="SnapInsController">
    <aura:handler name="init" value="{!this}" action="{!c.onInit}" />
	<aura:attribute name="baseUrl" type="String"  access="private" />
    <iframe src="{! v.baseUrl }" width="280" height="300" frameBorder="0"/>
</aura:component>