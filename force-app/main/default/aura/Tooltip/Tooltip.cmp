<aura:component>

  <aura:attribute name="text" type="String" />
  <aura:attribute name="position" type="String" default="top" />
  <aura:attribute name="theme" type="String" default="info" />
  <aura:attribute name="iconCollection" type="String" default="utility" />
  <aura:attribute name="class" type="String" />

  <div class="{! v.class }">
    <div class="slds-form-element">
      <div class="slds-form-element__icon slds-align-middle">
        <button class="slds-button slds-button slds-button--icon"
                aria-describedby="help"
                onmouseover="{!c.onMouseOver}"
                onmouseout="{!c.onMouseOut}">
          <lightning:icon iconName="{! v.iconCollection + ':' + v.theme }" size="xx-small" />
          <span class="slds-assistive-text">Help</span>
        </button>
      </div>
    </div>
  </div>

</aura:component>