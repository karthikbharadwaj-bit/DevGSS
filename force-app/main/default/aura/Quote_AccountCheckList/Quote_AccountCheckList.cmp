<aura:component implements="forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,force:lightningQuickAction,flexipage:availableForRecordHome,force:hasRecordId,force:hasSObjectName,flexipage:availableForAllPageTypes" 
                access="global" extends="c:Quote_BaseComponent" controller="Quote_PartnerQuoteUtil">
    <aura:attribute name="ShippingAddressList" type="Quote_PartnerDetailController.AccountCheckListAddressWrapp[]"/>
    <aura:attribute name="parent" type="Aura.Component" />
    <aura:attribute name="Quote" type="Quote" default="{ 'sobjectType': 'Partner_Quote__c',
                                                       'Status__c': 'Draft'}" />
    <aura:attribute name="salesQuote" type="Quote" default="{'sobjectType':'Quote'}" />
    <aura:attribute name="dealSupportExists" type="Boolean"/>
    <aura:attribute name="showSpinner" type="Boolean" default="false"/>
    <aura:attribute name="statePickVal" type="List"/>
    <aura:attribute name="partnerContractCreated" type="Boolean" default="false"/>
    <aura:attribute name="objAccountCheckList" type="Account_Checklist__c" default="{'sobjectType':'Account_Checklist__c'}"/>
    <aura:attribute name="accountId" type="String"/>
    <aura:attribute name="addressList" type="Account_Checklist_Address__c[]"/>
    <aura:attribute name="areaCodeList" type="Area_Codes__c[]"/>
    <aura:attribute name="showChecklistCMP" type="Boolean"/>
    <aura:attribute name="standardMSAOptionValue" type="String"/>
    <aura:attribute name="isFromCheckOutPage" type="Boolean" default="false"/>
    <aura:attribute name="isAvaya" type="Boolean" default="false" />
    <aura:attribute name="isNoStandardPlayBook" type="Boolean" default="false" />
    <aura:attribute name="oppType" type="String"/>
    <aura:attribute name="recordID" type="String"/>
    <aura:method name="submitDetails" action="{!c.submitDetails}" access="PUBLIC"/> 
    <aura:attribute name="files" type="List"/>  
    <aura:attribute name="Message" type="boolean" default="false" />
    <aura:attribute name="FilesMessage" type="boolean" default="false" />
    <aura:attribute name="Attachments" type="List"/>
    <aura:attribute name="documentId" type="String"/>
    <aura:attribute name="IsOpenInCommunity" type="Boolean" />
    <aura:attribute name="showProductSection" type="Boolean" default="false" />
    <aura:attribute name="productMap" type="map"/>
    <aura:attribute name="productQuantityMap" type="map"/>
    <aura:attribute name="previousQuantiy" type="String" />
    <!-- COUNTRY STATE ATTRIBUTES -->
    <aura:attribute name="mapCountryKeys" type="object" />
    <aura:attribute name="mapCountryValueKeys" type="String[]" />
    <aura:attribute name="mapShappingCountryValueKeys" type="String[]" />
    <aura:attribute name="mapData" type="Map"/>
    <aura:attribute name="communityDetailsRecord" type="Object"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="baseURL" type="String"/>
    <aura:attribute name="fromProcessOrder" type="Boolean" default="false"/>
     <!-- Added for PRM-247 -->
    <aura:attribute name="removesingaporelist" type="object" />
    
    <!--ACO 3.0-->
    <aura:attribute name="oppCountry" type="String"/>
    <aura:attribute name="partnerCommunityName" type="String"/>
    <aura:attribute name="showVAR" type="Boolean"/>
    <aura:attribute name="isVATReadOnly" type="Boolean" default="false"/>
    <aura:attribute name="ShowOnlyAtos" type="boolean" default="false"/>
    <aura:attribute name="ShowOnlyALE" type="boolean" default="false"/>
    <aura:attribute name="isShippingRequired" type="boolean" default="true"/> 
    
    <aura:attribute name="customerAccount" type="Account"/>
    <aura:attribute name="OpportunityRecord" type="Opportunity" default="{
                                                                         'SObjectType': 'Opportunity'
                                                                         }" />
    <aura:attribute name="mapLegalCountryKeys" type="object" />
    <aura:attribute name="paymentListDisplayed" type="List" /><!--5575 -->
    <aura:attribute name="showPaymentDropDown" type="Boolean" default="false"/><!--5575 -->
	
	<aura:attribute name="translationsMap" type="Map" />

	<aura:attribute name="showProcessOrder" type="Boolean" />
	<aura:attribute name="processOrdercontext" type="String" default="" />
    
    <aura:if isTrue="{!!v.isFromCheckOutPage}">
        <div class="slds-m-around_xx-large">
            <!-- Modal/Popup Box starts here-->
            <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                <div class="slds-modal__container">
                    <!-- Modal/Popup Box Header Starts here-->
                    <header class="slds-modal__header">
                        <lightning:buttonIcon iconName="utility:close"
                                              onclick="{! c.closeModel }"
                                              alternativeText="close"
                                              variant="bare-inverse"
                                              class="slds-modal__close"/>
                        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!v.translationsMap.Order_details_PI}</h2>
                    </header>
                    <!--Modal/Popup Box Body Starts here-->
                    <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                        <div class="slds-form--stacked slds-p-around--medium slds-m-bottom--x-small">
                            <div class="orderdetailsmainwrap">
                                <div class="slds-size--1-of-1 slds-grid">
                                    <div class="slds-size--6-of-12 slds-grid">
                                        <div class="slds-form-element">
                                            <label class="slds-form-element__label" for="Paymentmethod">{!v.translationsMap.Payment_method}</label>
                                            <div class="slds-form-element__control">
                                                <!--    <input id="inputNameSample1" class="slds-input" type="text" placeholder="Ms." />
                                               -->
                                                
                                                    <lightning:select aura:id="paymentSelect" name="Payment__c" variant="label-hidden"
                                class="label-hidden" onchange='{!c.paymentMethodChange}' value='{!v.objAccountCheckList.Payment_Method__c}'>
                                                    <option value="">None</option>
                                <aura:iteration items="{!v.paymentListDisplayed}" var="payment" indexVar="index">
                                    <option value="{!payment}" selected="{!payment==v.objAccountCheckList.Payment_Method__c}"
                                        >{!payment}</option>
                                </aura:iteration>
                            </lightning:select>
                                                    
                                               <!-- <div style="width:100%" class="paymentoggle">  
                                                    <div style="float:left">Credit Card </div> 
                                                    <div style="float:left">-->
                                                        <!--<aura:if isTrue="{!v.communityDetailsRecord.Brand_Name__c == 'Unify Office'}">
                                                     <lightning:input name="Paymentmethod" label="" type="toggle" checked="true" disabled="true"
                                                                     messageToggleActive="" messageToggleInactive=""/>
                                                        <aura:set attribute="else">-->
                                                        <!--<lightning:input name="Paymentmethod" label="" type="toggle" checked="{!v.objAccountCheckList.Invoice_Credit_Card__c}"
                                                                         messageToggleActive="" messageToggleInactive="" onchange='{!c.paymentMethodChange}'/>-->
                                                        <!-- </aura:set>
                                                    </aura:if>-->
                                                    <!--</div>
                                                    <div style="float:left">&nbsp;Invoice</div>
                                                </div> -->
                                                 
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                                <br/>
                                <aura:if isTrue="{!(v.objAccountCheckList.Payment_Method__c=='Invoice Billing')||(v.objAccountCheckList.Payment_Method__c=='Invoice-on-behalf')}">
                                    <!--Changes added legal fields 22-02-2020 -->
                                    <div class="slds-size--1-of-1 slds-grid">
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="">Accounts Payable email address</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input  variant="label-hidden" value="{!v.objAccountCheckList.Accounts_Payable_email_address__c}" type="text" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="">Legal Company Name</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input  variant="label-hidden" value="{!v.objAccountCheckList.Legal_Company_Name__c}" type="text" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="slds-size--1-of-1 slds-grid">
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="">Legal Physical Address</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input  variant="label-hidden" value="{!v.objAccountCheckList.Legal_Physical_Address__c}" type="text" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="">Legal City</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input  variant="label-hidden" value="{!v.objAccountCheckList.Legal_City__c}" type="text" />
                                                </div>
                                            </div>
                                        </div>
                                        
                                    </div>
                                    <br/>
                                    <div class="slds-size--1-of-1 slds-grid">
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <div class="slds-form-element__control">
                                                    <lightning:select class="select-auto-width" label="Legal Country" value="{!v.objAccountCheckList.Legal_Country__c}" onchange="{!c.onchangeCountry}">
                                                        <aura:iteration items="{!v.mapLegalCountryKeys}"  var="mapKey" indexVar="key" >  
                                                            <option value="{!mapKey.key}" selected="{!mapKey.key == v.objAccountCheckList.Legal_Country__c}">{!mapKey.key}</option>
                                                        </aura:iteration>
                                                    </lightning:select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <div class="slds-form-element__control">
                                                    <lightning:select aura:id="selectedState" class="select-auto-width" label="Legal State" name="select2"  value="{!v.objAccountCheckList.Legal_State__c}">
                                                        <aura:iteration items="{!v.mapCountryValueKeys}"  var="mapKey" >
                                                            <option value="{!mapKey}" selected="{!mapKey == v.objAccountCheckList.Legal_State__c}">{!mapKey}</option>
                                                        </aura:iteration>
                                                    </lightning:select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>                            
                                    <br/>
                                    <div class="slds-size--1-of-1 slds-grid">
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="">Legal Zip Code</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input  variant="label-hidden" value="{!v.objAccountCheckList.Legal_Zip_Code__c}" type="text" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <br/>
                                </aura:if>
                                <div class="slds-size--1-of-1 slds-grid">
                                    <div class="slds-size--2-of-12 slds-grid">
                                        <div class="slds-form-element">
                                            <label class="slds-form-element__label" for="costCenter">{!v.translationsMap.Cost_Center_PI}</label>
                                            <div class="slds-form-element__control">
                                                <!--    <input id="inputNameSample1" class="slds-input" type="text" placeholder="Ms." />
                                               -->
                                                <div style="width:100%">  
                                                    <div style="float:left">No</div> 
                                                    <div style="float:left">
                                                        <lightning:input name="costCenter" label="" type="toggle" checked="{!v.objAccountCheckList.Cost_Center__c}"
                                                                         messageToggleActive="" messageToggleInactive=""/>
                                                    </div>
                                                    <div style="float:left">&nbsp;Yes</div>
                                                </div> 
                                            </div>
                                        </div>
                                    </div>
                                    <div class="slds-size--4-of-12 slds-grid">
                                        <div class="slds-form-element">
                                            <label class="slds-form-element__label" for="taxExemption">{!v.translationsMap.Tax_Exemption_PI}</label>
                                            <div class="slds-form-element__control">
                                                <div style="width:100%">  
                                                    <div style="float:left">No</div> 
                                                    <div style="float:left">
                                                        <lightning:input name="taxExemption" label="" type="toggle" checked="{!v.objAccountCheckList.Tax_Exemptions__c}"
                                                                         messageToggleActive="" messageToggleInactive=""/>
                                                    </div>
                                                    <div style="float:left">&nbsp;Yes</div>
                                                </div> 
                                            </div>
                                        </div>
                                    </div>
                                    <!-- ACO 3.0 - starts -->
                                    <aura:if isTrue="{!v.showVAR}">
                                        <div class="slds-size--4-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <!--<label class="slds-form-element__label" for="">VAT Number</label>
                                            <div class="slds-form-element__control">
                                                <lightning:input  variant="label-hidden" value="{!v.objAccountCheckList.VAT_Number__c}" type="text" />
                                            </div>-->
                                                <aura:if isTrue="{!v.isVATReadOnly}">
                                                    <label class="slds-form-element__label" for="">{!v.translationsMap.VAT_Number_PI}</label><br></br>
                                                    {!v.objAccountCheckList.VAT_Number__c}  
                                                    <aura:set attribute="else">
                                                        <aura:if isTrue="{!!v.ShowOnlyAtos}">
                                                            <label class="slds-form-element__label" for="">VAT Number</label><br></br>
                                                            <aura:set attribute="else"><label class="slds-form-element__label" for="">VAT/GST Number</label><br></br></aura:set>
                                                        </aura:if>
                                                        <lightning:input  variant="label-hidden" value="{!v.objAccountCheckList.VAT_Number__c}" type="text" />
                                                    </aura:set>
                                                </aura:if>
                                            </div>
                                        </div>
                                    </aura:if>
                                    <!-- ACO 3.0 - ends -->
                                </div>
                                <br/>
                                
                                <!--Conditional start -->
                                <!--<aura:if isTrue="{!v.objAccountCheckList.Tax_Exemptions__c}">-->
                                <div class="slds-size--1-of-1 slds-grid">
                                    <aura:if isTrue="{!v.objAccountCheckList.Cost_Center__c}">
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="">{!v.translationsMap.Cost_Center_PI}</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input  variant="label-hidden" value="{!v.objAccountCheckList.taxExemptionCostCenter__c}" type="text" />
                                                </div>
                                            </div>
                                        </div>
                                    </aura:if>
                                    <aura:if isTrue="{!v.objAccountCheckList.Tax_Exemptions__c}">
                                        <!-- Added condition for aco 3.0 -->
                                        <aura:if isTrue="{!!v.showVAR}">
                                            <div class="slds-size--6-of-12 slds-grid">
                                                <div class="slds-form-element">
                                                    <label class="slds-form-element__label" for="taxExemption">Tax Id#</label>
                                                    <div class="slds-form-element__control">
                                                        <lightning:input  variant="label-hidden" value="{!v.objAccountCheckList.Tax_Exemption_Text__c	}" type="text" />
                                                    </div>
                                                </div>
                                            </div>
                                        </aura:if>
                                    </aura:if>
                                </div>
                                <!-- </aura:if> -->
                                <!-- Condition End -->
                                <br/>
                                <aura:if isTrue="{!!v.ShowOnlyALE}">
                                    <div class="slds-size--1-of-1 slds-grid">
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="inputNameSample1">{!v.translationsMap.Main_Number_Area_Code_PI}</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input aura:id="mainNumber" required="true" variant="label-hidden" value="{!v.objAccountCheckList.Main_Number_Area_Code__c}" type="text" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="slds-size--6-of-12 slds-grid">
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="inputNameSample1">{!v.translationsMap.Main_Fax_Area_Code_PI}</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input aura:id="mainFax" required="true"  variant="label-hidden" value="{!v.objAccountCheckList.MainFaxAreaCode__c}" type="text" /></div>
                                            </div>
                                        </div>
                                    </div>
                                </aura:if>
                            </div>
                            <br/>
                            <aura:if isTrue="{!!v.isShippingRequired}">
                                <h3 style="background-color: #D3D3D3" class="slds-section-title--divider">Billing Details</h3>
                            </aura:if>
                            <aura:if isTrue="{!v.isShippingRequired}">
                                <h3 style="background-color: #D3D3D3" class="slds-section-title--divider">{!v.translationsMap.BILLING_SHIPPING_DETAILS_PI}</h3>                                
                            </aura:if>
                            <br/>
                            
                            <div class="slds-size--1-of-1 slds-grid">
                                <div class="slds-size--6-of-12 slds-grid slds-m-bottom_small">
                                    <div class="slds-form-element">
                                        <div class="slds-form-element__control">
                                            <div style="width:100%">  
                                                <div style="float:left">{!v.translationsMap.Copy_Address_from_Account_PI} </div> 
                                                <div style="float:left">
                                                    <lightning:input name="Paymentmethod" label="" type="toggle" onchange="{!c.getAddressfromAccount}" messageToggleActive="" messageToggleInactive="" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <table class='shippingaddrtable'>
                                <aura:iteration items="{!v.ShippingAddressList}" var="addr" indexVar="index">
                                    <tr>
                                        <td>
                                            <div class="slds-form-element">
                                                <div class="slds-form-element__control">
                                                    <lightning:select class="select-auto-width" label="{!v.translationsMap.Type}" name="{!index}"   value="{!addr.acrRec.Type__c}" onchange="{!c.typeChange}">
                                                        <option value="Billing Address">{!v.translationsMap.Billing_Address_PI}</option>
                                                        <aura:if isTrue="{!v.isShippingRequired}">
                                                            <option value="Shipping Address">{!v.translationsMap.Shipping_Address_PI}</option>
                                                        </aura:if>
                                                    </lightning:select>
                                                </div>
                                            </div>
                                        </td>
                                        
                                        <td>
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="inputNameSample1">{!v.translationsMap.Address_PI}</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input aura:id="{!IF(index == 0,shippingAddress,'dup')}" required="true" variant="label-hidden" value="{!addr.acrRec.Shipping_Address__c}" type="text" />
                                                </div>
                                            </div>
                                        </td>
                                        
                                        <td>
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="inputNameSample1">{!v.translationsMap.City}</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input aura:id="{!IF(index == 0,City,'dup')}" required="true" variant="label-hidden" value="{!addr.acrRec.City__c}" type="text" />
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-form-element">
                                                <!--<label class="slds-form-element__label" for="inputNameSample1">Country</label>-->
                                                <div class="slds-form-element__control">
                                                    <lightning:select  class="select-auto-width" label="{!v.translationsMap.Country}" name="{!index}"   value="{!addr.acrRec.Country__c}" onchange="{!c.countryChange}">
                                                        <aura:iteration items="{!v.removesingaporelist}"  var="mapKey" indexVar="key" >  
                                                            <option value="{!mapKey.key}" selected="{!mapKey.key == addr.acrRec.Country__c}">{!mapKey.key}</option>
                                                        </aura:iteration>
                                                    </lightning:select>
                                                    <!-- <lightning:input aura:id="{!IF(index == 0,country,'dup')}" required="true" variant="label-hidden" value="{!addr.Country__c}" type="text" /> -->
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-form-element">
                                                <div class="slds-form-element__control">
                                                    <lightning:select  aura:id = "shippingState" class="select-auto-width" label="{!v.translationsMap.State}" name="select2"  value="{!addr.acrRec.State__c}">
                                                        <aura:iteration items="{!addr.shippingStateList}"  var="mapKey" >
                                                            <option value="{!mapKey}" selected="{!mapKey == addr.acrRec.State__c}">{!mapKey}</option>
                                                        </aura:iteration>
                                                    </lightning:select>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="inputNameSample1">{!v.translationsMap.Zipcode}</label>
                                                <div class="slds-form-element__control">
                                                    <lightning:input aura:id="{!IF(index == 0,zipcode,'dup')}" required="true" variant="label-hidden" value="{!addr.acrRec.Zip_Code__c}" type="text" /></div>
                                            </div>
                                        </td>
                                        
                                        
                                        <td class='iconscell'>
                                            <div class="slds-form-element">
                                                <label class="slds-form-element__label" for="inputNameSample1"></label>
                                                <div class="slds-form-element__control iconswrap">
                                                    <aura:if isTrue="{!v.ShippingAddressList.length - 1 != index}" >
                                                        <a onclick="{!c.copyAddressRow}" data-record="{!index}">
                                                            <lightning:buttonIcon iconName="utility:copy"  size="x-small" variant="bare" alternativeText="Copy this address to last row" />
                                                        </a>
                                                    </aura:if>
                                                    <aura:if isTrue="{!index != 0}">
                                                        <a onclick="{!c.removeAddressRow}" data-record="{!index}">
                                                            <lightning:buttonIcon iconName="utility:delete"  size="x-small" variant="bare" alternativeText="Delete this row" />
                                                        </a>
                                                        <aura:set attribute="else">
                                                            <lightning:buttonIcon iconName="utility:add"  size="medium" variant="bare" alternativeText="Add new address row" onclick="{!c.addAddressRow1}"/>
                                                        </aura:set>
                                                    </aura:if>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    
                                    <aura:if isTrue="{!and(v.isShippingRequired, addr.acrRec.Type__c == 'Shipping Address')}">
                                        <tr>
                                      		<aura:if isTrue="{!!v.ShowOnlyALE}">
                                            <td>
                                                <div class="slds-form-element">
                                                    <div class="slds-form-element__control">
                                                        <lightning:select class="select-auto-width" label="Carrier" name="{!index}"   value="{!addr.acrRec.Carrier__c}">
                                                            <option value="FedEx">FedEx</option>
                                                            <option value="UPS">UPS</option>
                                                        </lightning:select>
                                                    </div>
                                                </div>
                                            </td>
                                            </aura:if>
                                            <td>
                                                <div class="slds-form-element">
                                                    <div class="slds-form-element__control">
                                                        <lightning:select  required="{!v.isShippingRequired}" aura:id="shippingMethod" value="{!addr.acrRec.Shipping_Method__c}" class="{!index}"  name="{!addr.acrRec.Shipping_Method__c}" label="Shipping Method" messageWhenValueMissing="Choose one!">
                                                            <option value="Ground">Ground</option>
                                                            <option value="2 Day">2 Day</option>
                                                            <option value="Overnight">Overnight</option>
                                                        </lightning:select>
                                                    </div>
