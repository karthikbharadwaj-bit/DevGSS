                            </aura:set>
                        </aura:if>
                        <!--Added for BZS-4921 ends-->
                        <div class="slds-size-1-of-1 slds-grid">
                            <div class="slds-size--5-of-12 slds-grid" >
                                
                                <div class="slds-grid slds-wrap slds-align_absolute-center">   
                                    <aura:if isTrue="{!v.isFromCheckOutPage}">
                                        <lightning:fileUpload label="{!v.translationsMap.Attach_files}"
                                                              name="fileUploader"
                                                              multiple="true"
                                                              accept=".pdf, .png"
                                                              recordId="{!v.objAccountCheckList.Id}"
                                                              onuploadfinished="{!c.handleUploadFinished}" 
                                                              disabled="{!if((and(v.objAccountCheckList.Id=='',v.objAccountCheckList.Id==undefined)), true, false)}"
                                                              />
                                        <aura:set attribute="else">
                                            <lightning:fileUpload label="{!v.translationsMap.Attach_files}"
                                                                  name="fileUploader"
                                                                  multiple="true"
                                                                  accept=".pdf, .png"
                                                                  recordId="{!v.objAccountCheckList.Id}"
                                                                  onuploadfinished="{!c.handleUploadFinished}" 
                                                                  disabled="{!if((and(v.objAccountCheckList.Id=='',v.objAccountCheckList.Id==undefined)), true, false)}"
                                                                  />
                                        </aura:set>
                                    </aura:if>
                                </div>
                            </div>
                        </div>
                        <br/>
