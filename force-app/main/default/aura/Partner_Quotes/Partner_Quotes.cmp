<aura:component implements="forceCommunity:availableForAllPageTypes" access="global"
                controller="PartnerQuoteListController">
    <!-- INIT METHOD -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="selectedValue" type="string" access="public"/>
    <aura:attribute name="partnerAccounts" type="List"/>
    <!-- PAGINATION ATTRIBUTES -->
    <aura:attribute name="pageNumber" type="integer" default="1" />
    <aura:attribute name="totalPages" type="integer" default="0" />
    <aura:attribute name="totalRecords" type="integer" default="0" />
    <aura:attribute name="recordStart" type="integer" default="0" />
    <aura:attribute name="recordEnd" type="integer" default="0" />
    
    <aura:attribute name="ShowRecordDetail" type="boolean" default="false" />
    <aura:attribute name="quoteList" type="Partner_Quote__c[]" />
    <aura:attribute name="Message" type="boolean" default="false" />
    <aura:attribute name="viewAll" type="boolean" default="false" />
    
    <aura:attribute name="partnerAccountName" type="String" />
    
    <aura:attribute name="ShowConAcc" type="boolean" default="false" />
    <aura:attribute name="ShowOnlyAvaya" type="boolean" default="false" />
    <aura:attribute name="isSingleLogin" type="boolean" default="false" />
    
    <aura:attribute name="searchBy" type="String" default="Name" />
    <aura:attribute name="searchKeyword" type="String" />
    <aura:attribute name="baseURL" type="string"/>
    <aura:attribute name="OpportunityURLLink" type="string"/>
    <aura:attribute name="partnerCommunity" type="List"/>
    
    <!-- DISPLAY SPINNER -->
    <aura:attribute name="ShowSpinnerQuote" type="boolean" default="true" />
    <aura:handler event="aura:waiting" action="{!c.showSpinner}" />
    <aura:handler event="aura:doneWaiting" action="{!c.hideSpinner}" />
    
    <aura:handler name="populatePartnerEvent" event="c:Partner_SearchContactEvent" action="{!c.handlePartnerComponentEvent}"/>
    <aura:attribute name="showChangeRequestCMP" type="Boolean"/>
    <aura:attribute name="changeOrderId" type="String"/>
    
    <aura:attribute name="quoteFieldsMap" type="Map" />
    <aura:attribute name="translationsMap" type="Map" />
    <aura:attribute name="PRMSpecificTranslationsMap" type="Map" />
    
    <aura:attribute name="ExistingChangeOrder" type="Boolean" default="false"/><!-- Fix for CRM-4287-->
    <aura:attribute name="isChangeOrderSubmitted" type="Boolean" default="false"/><!--Fix for CRM-4287 isChangeOrderSubmitted attribute-->

    <aura:if isTrue="{!v.showChangeRequestCMP}">
        <c:Quote_OrderChangeRequest  isChangeOrderSubmitted="{v.isChangeOrderSubmitted}" changeOrderId="{!v.changeOrderId}" ExistingChangeOrder="true"  showChangeRequestCMP="{!v.showChangeRequestCMP}"/>
    </aura:if> 
    
    <aura:if isTrue="{!v.ShowSpinnerQuote}">
        <div class="slds-is-relative">
            <div class="spinnerHolder">
                <lightning:spinner alternativeText="Loading..." aura:id="loadingSpinner" class="slds-hide"
                                   size="medium" />
            </div>
        </div>
    </aura:if>
    <aura:if isTrue="{!!v.showChangeRequestCMP}">
        <div class="slds-grid slds-wrap">
            <!-- Page Name-->
            <div class="slds-col slds-has-flexi-truncate slds-size_1-of-1">
                <h1 class="slds-page-header__title slds-m-right_small slds-align-middle slds-truncate" title="Quotes">
                    <lightning:icon iconName="standard:quotes" /><b> &nbsp; {!v.translationsMap.Quotes}</b></h1>
            </div>
            <!-- Filter by -->
            <aura:if isTrue="{!v.ShowConAcc}">
                <div class="slds-col slds-has-flexi-truncate slds-size_2-of-5 slds-p-top_small slds-p-left_small">
                    <div class="slds-grid slds-grid_align-left">
                        <div class="slds-col slds-grow-none durationtoggle">
                            <div class="slds-grid togglewrap">
                                <label for="filterType" class="slds-form-element__label
                                                               slds-grid_align-center">{!v.translationsMap.Filter_By}: </label>
                                <span style="font-weight: 600;padding-top:1%;">
                                    &nbsp; {!v.translationsMap.Partner_Account}
                                </span>
                                <lightning:input aura:id="filterType" type="toggle" name="filterAccounts" checked="{!v.viewAll}"
                                                 onchange="{!c.toggleFilterBy}" />
                                <span style="font-weight: 600;padding-top:1%;">
                                    &nbsp; {!v.translationsMap.All_Accounts}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="slds-col slds-has-flexi-truncate slds-size_2-of-5">
                    
                </div>
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5">
                    
                </div>
            </aura:if>
            <!--PARTNER ACCOUNT SECTION-->
            <aura:if isTrue="{!!v.viewAll}">
                <aura:if isTrue="{!v.ShowConAcc}">
                    <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-around_medium">
                        
                        <label for="partnerAccountIdDiv" class="slds-form-element__label">{!v.translationsMap.View_Records_by_Partner}:</label>
                        
                        <lightning:buttonIcon iconName="utility:search" variant="bare" onclick="{!c.createAccountLookup}"
                                              alternativeText="{!v.translationsMap.Please_choose_a_Partner_Account}" />
                        
                        <div id="partnerAccountIdDiv"
                             class="slds-p-top_x-small slds-box slds-box_xx-small slds-truncate boxheight">
                            {!v.partnerAccountName}
                        </div>
                        
                    </div>
                </aura:if>
            </aura:if>
            <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-around_medium">
                <lightning:input label="{!v.translationsMap.Keyword}" value="{!v.searchKeyword}"                                         
                                 placeholder="{!v.translationsMap.search_placeholder +'...'}" 
                                 aura:id="searchField"/>
            </div>
            <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-around_medium">
                <lightning:select name="searchBy" value= "{!v.searchBy}" label="{!v.translationsMap.Search_by +':'}">
                    <option value="Name">{!v.translationsMap.Name}</option>
                    <option value="Status__c">{!v.translationsMap.Status}</option>
                    <option value="Opportunity__r.Name">{!v.translationsMap.Opportunity}</option>
                    <option value="Product_Edition__r.Name">{!v.translationsMap.Package}</option>
                    <option value="Opportunity__r.Account.BillingCountry">{!v.translationsMap.Country}</option>
                    <option value="Opportunity__r.Account.BillingState">{!v.translationsMap.State}</option>
                    <aura:if isTrue="{!v.isSingleLogin}">
                        <option value=" Opportunity__r.Partner_Account__r.Partner_ID__c">{!v.translationsMap.Partner_ID}</option>
                        <option value=" Opportunity__r.Partner_Account__r.Name">{!v.translationsMap.Partner_Name}</option>
                    </aura:if>
                    
                </lightning:select>
            </div>
            <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-around_medium searchBtnWrap">
                <lightning:button onclick="{!c.doFilterSearch}"
                                  variant="brand"
                                  label="{!v.translationsMap.Search}" iconName="utility:search"/> 
            </div>
            <aura:if isTrue="{!!v.viewAll}">
                <aura:if isTrue="{!!v.ShowConAcc}">
                    <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-around_medium"></div>
                </aura:if>
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-around_medium slds-float_right">
                    <lightning:select aura:id="pageSize" label="{!v.translationsMap.Display_Quotes_Per_Page +':'}" onchange="{!c.onSelectChange}">
                        <option text="50" value="50" selected="true"/>
                        <option text="100" value="100"/>
                        <option text="150" value="150"/>
                        <option text="200" value="200"/>
                    </lightning:select>
                </div>
            </aura:if>
            <aura:if isTrue="{!v.viewAll}">
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-around_medium slds-float_right"></div>
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-around_medium slds-float_right">
                    <lightning:select aura:id="pageSizeForAll" label="{!v.translationsMap.Display_Quotes_Per_Page +':'}" onchange="{!c.onSelectChange}">
                        <option text="50" value="50" selected="true"/>
                        <option text="100" value="100"/>
                        <option text="150" value="150"/>
                        <option text="200" value="200"/>
                    </lightning:select>            
                </div>  
            </aura:if>
        </div>
        <aura:if isTrue="{!!v.Message}">
            <aura:if isTrue="{!v.ShowRecordDetail}">
                
                <div class="slds-m-around_xx-small">
                    
                    <table class="slds-table slds-table_bordered slds-table_cell-buffer slds-table_fixed-layout">
                        <thead>
                            <tr>
                                
                                <th scope="col">
                                    <strong>
                                        <div class="slds-truncate" title="{!v.translationsMap.Quote_Name}">{!v.translationsMap.Quote_Name}</div>
                                    </strong>
                                </th>
                                
                                <th scope="col"  style="width:14rem;">
                                    <strong>
                                        <div class="slds-truncate" title="{!v.translationsMap.Opportunity_Name}">{!v.translationsMap.Opportunity_Name}</div>
                                    </strong>
                                </th>
                                
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="{!v.translationsMap.Status}">{!v.translationsMap.Status}</div>
                                </th>
                                <th scope="col">
                                    <div class="slds-truncate" id="column-group-header">{!v.translationsMap.Primary}</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="{!v.translationsMap.Package}">{!v.translationsMap.Package}</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="{!v.translationsMap.License +'(#)'}">{!v.translationsMap.License +'(#)'}</div>
                                </th>
                                <th class="" scope="col">
                                    <div class="slds-truncate" title="{!v.translationsMap.Payment_Term}">{!v.translationsMap.Payment_Term}</div>
                                </th>
                                
                                <aura:if isTrue="{!or(v.ShowConAcc,v.isSingleLogin)}">
                                    <th scope="col">
                                        <strong>
                                            <div class="slds-truncate" title="{!v.translationsMap.Partner_Account}">{!v.translationsMap.Partner_Account}</div>
                                        </strong>
                                    </th>
                                    
                                    <th scope="col">
                                        <strong>
                                            <div class="slds-truncate" title="{!v.translationsMap.Partner_ID}">{!v.translationsMap.Partner_ID}</div>
                                        </strong>
                                    </th>
                                    <aura:if isTrue="{!v.ShowConAcc}">
                                        <th scope="col">
                                            <strong><div class="slds-truncate" title="{!v.translationsMap.Partner_Contact}">{!v.translationsMap.Partner_Contact}</div></strong>
                                        </th>
                                    </aura:if>
                                </aura:if>
                            </tr>
                        </thead>
                        <tbody>
                            <aura:iteration items="{!v.quoteList}" var="quote" indexVar="index">
                                <tr>
                                    <th scope="row" data-label="Name">
                                        <div class="slds-truncate" title="{!quote.Name}" data-value="{!quote.Id}">
                                            <a class="{!index}" onclick="{!c.redirectTOQuoteTool}">
                                                <!-- <a href="{!'/partner/s/quotetool?step=5&amp;id='+quote.Id}"> -->
                                                {!quote.Name}
                                            </a>
                                            
                                        </div>
                                    </th>
                                    <th scope="row" data-label="Opportunity Name"  style="width:14rem;">
                                        <div class="slds-truncate" title="{!quote.Opportunity__r.Name}">
                                            <!-- <a href="{!'/partner/s/partneropportunities?id='+quote.Opportunity__r.Id}">
                                            {!quote.Opportunity__r.Name}
                                        </a>-->
                                            <a href="{!v.OpportunityURLLink +quote.Opportunity__r.Id}" >
                                                {!quote.Opportunity__r.Name}
                                            </a>
                                        </div>
                                    </th>
                                    
                                    <th scope="row" data-label="Quote Status">
                                        <div class="slds-truncate" title="{!quote.Status__c}">{!quote.Status__c}</div>
                                    </th>
                                    <th scope="row" data-label="Primary Quote" id="{!index}">
                                        <lightning:input type="checkbox" disabled="true" checked="{!quote.Primary__c}"
                                                         title="{!quote.Primary__c}" onchange="{!c.updatePartnerQuotes}" />
                                    </th>
                                    <th scope="row" data-label="Product Edition">
                                        <div class="slds-truncate" title="{!quote.Product_Edition__r.Name}">{!quote.Product_Edition__r.Name}</div>
                                    </th>
                                    <th scope="row" data-label="No of Licenses">
                                        <div class="slds-truncate" title="{!quote.Number_of_Licenses__c}">{!quote.Number_of_Licenses__c }</div>
                                    </th>
                                    <th  scope="row" data-label="Payment Term">
                                        <div class="slds-truncate" title="{!quote.Payment_Term__c}">{!quote.Payment_Term__c}</div>
                                    </th>
                                    
                                    <aura:if isTrue="{!or(v.ShowConAcc,v.isSingleLogin)}">
                                        <th scope="row" data-label="Partner Account">
                                            <div class="slds-truncate" title="{!quote.Opportunity__r.Partner_Account__r.Name}">
                                                {!quote.Opportunity__r.Partner_Account__r.Name}
                                            </div>
                                        </th> 
                                        
                                        <th scope="row" data-label="PartnerId">
                                            <div class="slds-truncate" title="{!quote.Opportunity__r.Partner_Account__r.Partner_ID__c}">
                                                {!quote.Opportunity__r.Partner_Account__r.Partner_ID__c}
                                            </div>
                                        </th>
                                        <aura:if isTrue="{!v.ShowConAcc}">
                                            <th scope="row" data-label="Partner Contact">
                                                <div class="slds-truncate" title="{!quote.Opportunity__r.Partner_Contact__r.Name}">
                                                    {!quote.Opportunity__r.Partner_Contact__r.Name}
                                                </div>
                                            </th>
                                        </aura:if>
                                    </aura:if>
                                    
                                </tr>
                            </aura:iteration>
                        </tbody>
                    </table>
                </div>
            </aura:if>
            <!--PREVIOUS/NEXT-->
            <div class="slds-clearfix">
                <div class="slds-float_right">
                    <lightning:button disabled="{!v.pageNumber == 1}" variant="brand" aura:id="prevPage" label="{!v.translationsMap.Previous}"
                                      onclick="{!c.handlePrev}" iconName="utility:chevronleft" iconPosition="left" />
                    <lightning:button disabled="{!or(v.pageNumber == v.totalPages,v.totalPages == 0)}" aura:id="nextPage"
                                      variant="brand" label="{!v.translationsMap.Next}" onclick="{!c.handleNext}" iconName="utility:chevronright"
                                      iconPosition="right" />
                </div>
                <p class="slds-truncate">{!v.translationsMap.Displaying}&nbsp; {!v.recordStart}-{!v.recordEnd} &nbsp;{!v.translationsMap.Of} &nbsp;{!v.totalRecords} | {!v.translationsMap.Page}&nbsp; {!v.pageNumber}
                  &nbsp;{!v.translationsMap.Of}&nbsp; {!v.totalPages}</p>
            </div>
        </aura:if>
        <!-- MESSAGE -->
        <aura:if isTrue="{!v.Message}">
            <div class="errorMessageDiv">
                <div class="slds-is-relative errorMessageDiv">
                    <div class="slds-notify slds-notify_toast slds-theme_error norecordsmsg" role="alert">
                        <div class="slds-notify__content">
                            <h2 class="slds-text-heading_small">{!v.translationsMap.No_Records_Found+'...'}</h2>
                        </div>
                    </div>
                </div>
            </div>
        </aura:if>
        <div aura:id="lookupSearchDiv"></div>
    </aura:if>
</aura:component>