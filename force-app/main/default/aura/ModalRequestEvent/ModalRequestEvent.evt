<aura:event type="APPLICATION" description="ModalRequestEvent">
    <aura:attribute name="guid" type="String" />
    <aura:attribute name="show" type="Boolean" />

    <aura:attribute name="header" type="String" />
    <aura:attribute name="content" type="String" />
    <aura:attribute name="buttons" type="List" />
    <aura:attribute name="layout" type="String" />

    <aura:attribute name="params" type="Object" />

    <aura:attribute name="isCancelShown" type="Boolean" />

</aura:event>