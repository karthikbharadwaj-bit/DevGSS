<aura:component description="Support Community Blank Layout" implements="forceCommunity:layout" access="global">
    <aura:attribute name="components" type="Aura.Component[]" required="false"/>
    <div>
        <div class="wrapper">
            <div class="sc-main">
               {!v.components}
            </div>
            <c:lwcToasts/>
            <c:lwcModal/>
            <c:lwcSpinner/>
        </div>
    </div>
</aura:component>