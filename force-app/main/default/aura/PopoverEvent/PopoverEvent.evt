<aura:event type="APPLICATION" description="Event template" >
	<aura:attribute name="show" type="Boolean" description="Show/hide popover"/>
    <aura:attribute name="target" type="Map" description="Reference to the element that need to have a popover"/>
    <aura:attribute name="text" type="String" description="Popover text. Html allowed"/>
    <aura:attribute name="showIcon" type="Boolean" description="Add icon on the left from the popover"/>
    <aura:attribute name="theme" type="String" description="Popover Theme: info, warning, success, tooltip"/>
    <aura:attribute name="iconTheme" type="String" description="Icon theme: info, warning"/>
    <aura:attribute name="iconCollection" type="String" description="Icon collection set (utility, standard...)"/>
    <aura:attribute name="preferredPosition" type="String" description="Where to show tooltip: top, right, bottom, left. If space is not available position automatically" />
    <aura:attribute name="content" type="Aura.Component[]" description="Popover Content"/>
</aura:event>