                        </div>
                        <div class="slds-col slds-size_4-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;"></div>
                    </aura:if>
                    <!--Added for PRM-99 ends-->
                    </aura:if>
				    <aura:if isTrue="{!and(v.DealRegRecord.Country__c == 'Switzerland',!v.ShowOnlyRC)}">
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>Preferred Language:</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.DealRegRecord.Preferred_Language__c}</span>
                        </div>
                        <div class="slds-col slds-size_4-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;"></div>
                </aura:if>
            </div>
        </lightning:card> 
    </aura:if>
    <!-- DETAIL SECTION END -->
    
    <!-- NEW SECTION BEGIN -->
    <aura:if isTrue="{!v.ShowNewSection}">
        <aura:if isTrue="{!v.ShowOnlyRC}">
            <div>
                <div class="dealsconditionswrap">
                    <label>All qualified deals should have the following criteria -</label>
                    <ul>
                        <li>Customer has shown interest in a UCaaS or CCaaS solution</li>
                        <li>You have spoken to the Customer and have discussed RingCentral</li>
                        <li>You have informed the Customer that they will be registered with RingCentral</li>
                        <li>Customer is willing to have a conversation with you about RingCentral within 30 days</li>
                        <li>Buying decision will occur within the next 12 months</li>
                    </ul>
                </div>
            </div>
        </aura:if>
        <lightning:card variant="Narrow" title="{!v.translationsMap.New_Deal_Registration}"  iconName="standard:lead">       
            <lightning:recordEditForm
                                      aura:id="newRecordFormSection"
                                      onsubmit="{!c.handleSubmitNew}"
                                      onsuccess="{!c.handleSuccessNew}"
                                      onerror="{!c.handleError}"  
                                      objectApiName="Deal_Registration__c">
                
                <div class="slds-grid slds-wrap">
                <!--Added for QTC-943 starts -->
                    <aura:if isTrue="{!v.ShowOnlyRC}">
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;" >
                            <span>Partner Program:</span>
                            <abbr class="slds-required">* </abbr>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                            <lightning:inputField aura:id="PartnerProgram" fieldName="Partner_Program__c" variant="label-hidden" />
                                                           
                        </div>
                        <div class="slds-col slds-size_4-of-7 slds-p-around_x-small alignRight" style="color:gray;"></div>
                    </aura:if>
                    <!--Added for QTC-943 ends -->				
                    <!-- ADDITIONAL FIELD FOR NEW ON BEHALF START -->
                    <!--<aura:if isTrue="{!v.NewOnBehalf}">-->
                    <!-- Single Login if -->
                    <aura:if isTrue="{!or(v.isSingleLogin,v.NewOnBehalf)}">
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                            <span class="heading" style="font-weight: bold;">{!v.DealRegFieldsMap.Partner_Contact__c}: <lightning:helptext content="{!v.translationsMap.Search_Icon_to_Choose_Partner_Contact}"/></span>
                            <abbr class="slds-required" title="required">* </abbr>
                        </div>                        
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                            <span style="font-weight: bold;"><!--<lightning:inputField fieldName="Partner_Contact__c" variant="label-hidden"/>-->
                                {!v.partnerContactName}&nbsp;&nbsp;
                                <lightning:buttonIcon iconName="utility:search" variant="bare"
                                                      onclick="{!c.createLookup}"
                                                      alternativeText="{!v.translationsMap.Please_choose_a_Partner_Contact}" />
                            </span>
                        </div>
                        <div class="slds-col slds-size_1-of-7">
                            <span></span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                            <span>{!v.translationsMap.Partner_ID}:</span>
                        </div>                        
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                            <span>{!v.partnerId}&nbsp;&nbsp;</span>
                        </div>                     
                    </aura:if>
                    <!-- Ignite change start -->
                    <aura:if isTrue="{!and(v.ShowOnlyRC,v.partnerContactName)}">
                    <!--    <div class="slds-col slds-size_4-of-7"> 
                            <span></span>
                        </div> -->
                        <aura:if isTrue="{!v.NewOnBehalf}">
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                            <span>Installation Service Provider:</span>
                            <abbr class="slds-required">* </abbr>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small customPicklist" onmouseover="{!c.toggledisplayTextON}" onmouseout="{!c.toggledisplayTextOFF}">
                            <lightning:select name="Installation_Service_Provider__c" aura:id="selectedProvider" variant="label-hidden" class="label-hidden" value="{!v.selectedProviderValue}">
                                <aura:iteration items="{!v.mapPSValueKeys}" var="psPartner" >   
                                    <option value="{!psPartner}" selected="{!psPartner.value==v.selectedProviderValue}">{!psPartner}</option>                                            
                                </aura:iteration>
                            </lightning:select>                               
                        </div>
                        <div class="slds-col slds-size_4-of-7 slds-p-around_x-small alignRight" style="color:gray;"></div> 
                        <aura:if isTrue="{!v.displayText}">                                   
                            <div class="slds-col slds-size_3-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                <p>
                                    <lightning:formattedRichText value="&lt;b&gt;RC Technical Onboarding Install&lt;/b&gt; handles deals under 100 seats with express setup."/>
                                </p>
                                <p>
                                    <lightning:formattedRichText value="&lt;b&gt;Partner Install, Certified Delivery Partner&lt;/b&gt; means partners lead installation solo or with ProServices."/>
                                </p>
                                <p>
                                    <lightning:formattedRichText value="&lt;b&gt;Customer Self-Install&lt;/b&gt; means the customer sets up the RingEx product without assistance (UCaaS only)."/>
                                </p>
                            </div>
                            <div class="slds-col slds-size_1-of-7">
                                <span></span>
                            </div>
                            <div class="slds-col slds-size_3-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                
                                <p>
                                    <lightning:formattedRichText value="&lt;b&gt;RC ProServices Install&lt;/b&gt; for customers requiring white glove service, complex deployment I.e. RCX or RCCC, or customized integrations."/>
                                </p>
                                
                                <p>
                                    <lightning:formattedRichText value="&lt;b&gt;Enroll in CDP for Partner Install&lt;/b&gt; allows partners to register for certification so they can lead the install."/>
                                </p>
                            </div>
                        </aura:if>
                    </aura:if>
                    </aura:if>
                    <!-- Ignite change end -->
                    <!-- ADDITIONAL FIELD FOR NEW ON BEHALF END -->
                    <!-- Install field in New for ignite start-->
                    <aura:if isTrue="{!v.ShowOnlyRC}">
                        <aura:if isTrue="{!!v.NewOnBehalf}">
                            <div class="slds-col slds-size_4-of-7">
                                <span></span>
                            </div>
                            <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                <span>Installation Service Provider:</span>
                            <abbr class="slds-required">* </abbr>
                            </div>
                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small customPicklist" onmouseover="{!c.toggledisplayTextON}" onmouseout="{!c.toggledisplayTextOFF}">
                                <lightning:select name="Installation_Service_Provider__c" aura:id="selectedInstallProvider" variant="label-hidden" class="label-hidden" value="{!v.installProviderValue}">
                                    <aura:iteration items="{!v.mapInstallPSValuesKeys}" var="psPartners" >   
                                        <option value="{!psPartners}" selected="{!psPartners.value==v.installProviderValue}">{!psPartners}</option>                                            
                                    </aura:iteration>
                                </lightning:select>                               
                            </div>
                            <aura:if isTrue="{!v.displayText}">                                   
                                <div class="slds-col slds-size_3-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                    <p>
                                        <lightning:formattedRichText value="&lt;b&gt;RC Technical Onboarding Install&lt;/b&gt; handles deals under 100 seats with express setup."/>
                                    </p>
                                    <p>
                                        <lightning:formattedRichText value="&lt;b&gt;Partner Install, Certified Delivery Partner&lt;/b&gt; means partners lead installation solo or with ProServices."/>
                                    </p>
                                    <p>
                                        <lightning:formattedRichText value="&lt;b&gt;Customer Self-Install&lt;/b&gt; means the customer sets up the RingEx product without assistance (UCaaS only)."/>
                                    </p>
                                </div>
                                <div class="slds-col slds-size_1-of-7">
                                    <span></span>
                                </div>
                                <div class="slds-col slds-size_3-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                    
                                    <p>
                                        <lightning:formattedRichText value="&lt;b&gt;RC ProServices Install&lt;/b&gt; for customers requiring white glove service, complex deployment I.e. RCX or RCCC, or customized integrations."/>
                                    </p>
                                    
                                    <p>
                                         <lightning:formattedRichText value="&lt;b&gt;Enroll in CDP for Partner Install&lt;/b&gt; allows partners to register for certification so they can lead the install."/>
                                    </p>
                                </div>
                            </aura:if>
                        </aura:if>
                    </aura:if>   
                    <!-- Install field in New for ignite end-->
                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                        <span>{!v.translationsMap.First_Name}:</span>
                        <abbr class="slds-required">* </abbr>
                    </div>                        
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                        <span><lightning:inputField fieldName="First_Name__c" variant="label-hidden" required="true"/></span>
                    </div>
                    <div class="slds-col slds-size_1-of-7">
                        <span></span>
                    </div>
                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                        <span>{!v.translationsMap.Last_Name}:</span>
                        <abbr class="slds-required">* </abbr>
                    </div>                        
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                        <span><lightning:inputField fieldName="Last_Name__c" variant="label-hidden" required="true"/></span>
                    </div>                
                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                        <span>{!v.DealRegFieldsMap.Business_Title__c}:</span>
                    </div>                        
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
