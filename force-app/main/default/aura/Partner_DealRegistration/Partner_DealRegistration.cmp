<!--
* Created By     : Ishwarya
* Created Date   : 16-12-2019
* Description    : Component for Deal Registrations - Partner_DealRegistration

Change History
*******************************************************************************************************************************************
SCRUM/Jira ModifiedBy      Date        Description 									Tag
*******************************************************************************************************************************************
*******************************************************************************************************************************************
*/-->
<aura:component implements="forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,force:lightningQuickAction,flexipage:availableForRecordHome,force:hasRecordId,force:hasSObjectName,flexipage:availableForAllPageTypes"
                access="global" controller="Partner_DealRegistration">
    <!-- INIT METHOD -->
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="blockedDomains" type="List"/>
    
    <aura:handler event="aura:waiting" action="{!c.showSpinner}"/>
    <aura:handler event="aura:doneWaiting" action="{!c.hideSpinner}"/>
    
    <aura:attribute name="dealRegList" type="Deal_Registration__c[]"/>
    <aura:attribute name="partnerAccounts" type="List"/>
    <aura:attribute name="viewAll" type = "boolean" default="false"/>
    <aura:attribute name="selectedAccountValue" type="string" access="public"/>
    <aura:attribute name="selectedStatusValue" type="string" access="public"/>    
    <aura:attribute name="Message" type="boolean" default="false" />    
    <aura:attribute name="recordID" type="String"/>
    <aura:attribute name="ShowListView" type="boolean" default="false"/>
    <aura:attribute name="NewOnBehalf" type="boolean" default="false"/>
    <aura:attribute name="DealRegRecord" type="Deal_Registration__c"/>
    <aura:attribute name="ShowRecordDetail" type="boolean" default="false" />
    <aura:attribute name="ShowSpinnerOpp" type="boolean" default="true" />
    <aura:attribute name="ShowEditSection" type="boolean" default="false" />
    <aura:attribute name="ShowNewSection" type="boolean" default="false" />   
    <aura:attribute name="ShowOtherExistingSoln" type="boolean" default="false" />
    <aura:attribute name="ShowOtherCompetitor" type="boolean" default="false" /> 
    <aura:attribute name="ShowOtherPrompting" type="boolean" default="false" /> 
    <aura:attribute name="ShowOtherDecision" type="boolean" default="false" />
    <aura:attribute name="ShowDealRejReasonSection" type="boolean" default="false" />
    <aura:attribute name="ShowBlockedDomainSection" type="boolean" default="false" />
    <aura:attribute name="baseURL" type="string"/>
    <aura:attribute name="RespectiveTabURL" type="string"/>
    <aura:attribute name="partnerClassification" type="string"/><!-- PBC-9705 P2CSharing-->
    
    <aura:attribute name="searchBy" type="String" default="Company_Name__c"/> 
    <aura:attribute name="searchKeyword" type="String"/>
    
    <aura:attribute name="partnerContactId" type="String"/>
    <aura:attribute name="partnerContactName" type="String"/>
    <aura:attribute name="partnerAccountName" type="String"/>
    <aura:attribute name="partnerId" type="String"/>
    
    
    <aura:handler name="populatePartnerEvent" event="c:Partner_SearchContactEvent" action="{!c.handlePartnerComponentEvent}"/>
    
    <aura:attribute name="ShowConAccFields" type="boolean" default="false"/>  
    <aura:attribute name="ShowOnlyAvaya" type="boolean" default="false"/>
    <aura:attribute name="isMasterAgent" type="boolean" default="false"/>
    <aura:attribute name="ShowOnlyRC" type="boolean" default="false"/>
    <aura:attribute name="ShowOnlyATOS" type="boolean" default="false"/>
    <aura:attribute name="ShowRequiredErrorSection" type="boolean" default="false" />
    <aura:attribute name="isReadOnly" type="boolean" default="true" />
    <aura:attribute name="isSingleLogin" type="boolean" default="false" />
    <aura:attribute name="isReseller" type="boolean" default="false" />
    <aura:attribute name="CountryReq" type="boolean" default="false" />
    
    <!-- PAGINATION ATTRIBUTES -->
    <aura:attribute name="pageNumber" type="integer" default="1"/>
    <aura:attribute name="totalPages" type="integer" default="0"/>
    <aura:attribute name="totalRecords" type="integer" default="0"/>
    <aura:attribute name="recordStart" type="integer" default="0"/>
    <aura:attribute name="recordEnd" type="integer" default="0"/>
    
    <!-- COUNTRY STATE ATTRIBUTES -->
    <aura:attribute name="countriesAvailable" type="String[]" />
    <aura:attribute name="mapCountryKeys" type="String[]" />
    <aura:attribute name="mapCountryValueKeys" type="String[]" />
    <aura:attribute name="mapData" type="Map"/>
    
    <!-- BZS-9016 start -->
    <aura:attribute name="countriesforBI" type="String[]" />
    <aura:attribute name="isWholeSalePartner" type="boolean" />

    <aura:attribute name="BrandCountriesForBIMap" type="Map" />
    <aura:attribute name="BICountriesCSList" type="List" />
    <aura:attribute name="brandsListforBI" type="List" />
    <!-- BZS-9016 end -->
    
    <!-- Added for multiple countries in ACO 3.0 -->
    <aura:attribute name="partnerAvailableCountries" type="String[]" />
    
    <aura:attribute name="mapDataBrand" type="Map"/>
    
    <aura:attribute name="mapCompData" type="Map"/>
    <aura:attribute name="mapCountryCompKeys" type="object" />
    <aura:attribute name="mapCountryCompValKeys" type="List" />
    <aura:attribute name="selectedCompItems" type="List" default="[]"/>
    
    <aura:attribute name="mapEmpData" type="Map"/>
    <aura:attribute name="mapEmpCompKeys" type="object" />
    <aura:attribute name="mapEmpCompValKeys" type="List" />
    
    <aura:attribute name="partnerCommunity" type="List"/>
    <aura:attribute name="communityUrl" type="String"/>
    <aura:attribute name="communityDetailsRecord" type="Object"/>
    <aura:attribute name="selectedBrandValue" type="String"/>
    
    <aura:attribute name="logdPartnrCntry" type="String"/>
    
    <aura:attribute name="isCurrentSubPartnerFullAccess" type="boolean" default="false" />
    <aura:attribute name="isCurrentContactPCM" type="boolean" default="false" />
    <aura:attribute name="partnerhasAllCntryAcess" type="boolean" default="true"/>
    <aura:attribute name="editionListDisplayed" type="List" />
    <aura:attribute name="selectedEditionValue" type="string" access="public"/>
    
    <aura:attribute name="brandsPermitted" type="List" default="['RingCentral']"/>
    <aura:attribute name="brandsPermitted_Guest" type="List" />
     <aura:attribute name="isNotAvaya" type="boolean" default="false" />
    <!-- Avaya Cloud Specialist Assignment-->
    <aura:handler name="cloudSpecialistValueEvent" event="c:Partner_CloudSpecialistSearchEvent" action="{!c.handleCloudSpecialistEvent}"/>
    <aura:attribute name="cloudSpecialistContactId" type="String"/>
    
    <aura:attribute name="isNationalPartnerAccount" type="boolean" default="false" />
    <aura:attribute name="isNationalPartnerAccountNew" type="boolean" default="false" />
    <aura:attribute name="portalUserList" type="List" />
    <aura:attribute name="searchUser" type="String"/>    
    <aura:attribute name="insideSalesRep" type="String"/>
    <aura:attribute name="insideSalesRepNew" type="String"/> 
    <aura:attribute name="territoryAlignmentMap" type="String"/>
    
    <aura:attribute name="tierNames" type="List" default="['Office']"/>
    <aura:attribute name="selectedTierValue" type="String"/>
    
    <aura:attribute name="RCMeetings" type="boolean" default="false"/>
    <aura:attribute name="translationsMap" type="Map" />
    <aura:attribute name="PRMSpecificTranslationsMap" type="Map" />
    <aura:attribute name="DealRegFieldsMap" type="Map" />
    <aura:attribute name="PRMSpecifictranslation" type="object" />
    <!-- PS MAP ATTRIBUTES Ignite starts New OnBehalf-->
    <aura:attribute name="selectedProviderValue" type="string" access="public" default="--Please Select--"/>
    <aura:attribute name="mapPSValueKeys" type="List" default="['--Please Select--']"/>
    <aura:attribute name="displayText" type="Boolean" default="false"/>
    <aura:attribute name="psPartnerId" type="String" />
    <aura:attribute name="defaultPSValue" type="String" default="--Please Select--"/>
    <aura:handler name="change" value="{!v.partnerContactId}" action="{!c.getPickListValuesPS}"/>    <!-- Ignite -->

    <!-- PS MAP ATTRIBUTES Ignite New  -->
    <aura:attribute name="userId" type="String"/>
    <aura:attribute name="mapInstallPSValuesKeys" type="List" default="[--Please Select--']"/>
    <aura:attribute name="installProviderValue" type="string" access="public" default="--Please Select--"/>
    <aura:attribute name="defaultinstallPSValue" type="String" default="--Please Select--"/>
    <!-- PS MAP ATTRIBUTES ends -->
    <aura:attribute name="isGuestUser" type="boolean" default="false" />
    <aura:attribute name="isGuest" type="boolean" default="false" />
    <aura:attribute name="showGuestLogin" type="boolean" default="false" />
    <aura:attribute name="partnerContact" type="Map" />
    <lightning:navigation aura:id="navService"/>
    <aura:attribute name="GuestEmail" type="String"/>
    <aura:attribute name="wholesalePckEditions" type="List" default="[]" />
    <!--BZS-9020-->
    <aura:attribute name="selectedWholesaleEditionValue" type="string" access="public" />
    <!--BZS-9020-->
    <aura:attribute name="ShowMitelCustomerType" type="boolean" default="false"/><!--Added for Mitel PRM-145-->
    <aura:attribute name="isMitel" type="boolean" default="false"/><!--PRM-145-->
    <aura:attribute name="selectedCountry" type="String" /> <!-- Added for Switzerland-->
    <aura:attribute name="ShowMitelDataShare" type="boolean" default="false"/><!--Added for Mitel-->
    <aura:attribute name="ShowMitelShareDetailPage" type="boolean" default="false"/><!--PBC-9705 P2CSHaring-->
    
    <aura:attribute name="ShowOnlyALE" type="boolean" default="false"/><!--pbc-10695-->

    <!-- DISPLAY SPINNER --> 
    <aura:if isTrue = "{!!v.isGuest}">
        <aura:if isTrue="{!v.ShowSpinnerOpp}">
            <div class="slds-is-relative">
                <div class="spinnerHolder">
                    <lightning:spinner alternativeText="Loading..." aura:id="loadingSpinner" class="slds-hide" size="medium"/>
                </div>
            </div>
        </aura:if>  
    </aura:if>
    <!-- LIST VIEW START -->
    <aura:if isTrue="{!v.ShowListView}">
        <div>
            <div class="slds-grid slds-wrap">
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5">
                    <h1 class="slds-page-header__title slds-m-right_small slds-align-middle slds-truncate"
                        title="Deals"><lightning:icon iconName="standard:lead"/><b> &nbsp;{!v.translationsMap.Registered_Deals} </b></h1>
                </div>  
                
                <div class="slds-col slds-has-flexi-truncate slds-size_3-of-5"/> 
                <!-- BUTTONS IN LIST VIEW -->
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5">           
                    
                </div>
                <aura:if isTrue="{!v.ShowConAccFields}">
                    <div class="slds-col slds-has-flexi-truncate slds-size_2-of-5 slds-p-top_small slds-p-left_small">                        
                        <div class="slds-grid slds-grid_align-left">
                            <div class="slds-col slds-grow-none durationtoggle">
                                <div class="slds-grid togglewrap">
                                    <label for="filterType" class="slds-form-element__label
                                                                   slds-grid_align-center">{!v.translationsMap.Filter_By}:</label>
                                    <span style="font-weight: 600;padding-top:1%;">
                                       &nbsp; {!v.DealRegFieldsMap.Partner_Account__c}
                                    </span>
                                    <lightning:input aura:id="filterType" type="toggle"
                                                     name="filterAccounts" checked="{!v.viewAll}"
                                                     onchange="{!c.toggleFilterBy}"/>
                                    <span style="font-weight: 600;padding-top:1%;">
                                        &nbsp; {!v.translationsMap.All_Accounts} 
                                    </span>
                                </div>
                            </div>                                                            
                        </div>
                    </div>
                    <div class="slds-col slds-has-flexi-truncate slds-size_2-of-5"> 
                        
                    </div>
                    <div class="slds-col slds-has-flexi-truncate slds-size_1-of-5">           
                        
                    </div>
                </aura:if>
                <!-- ACCOUNT DROP DOWN -->
                <aura:if isTrue="{!!v.viewAll}">
                    <aura:if isTrue="{!v.ShowConAccFields}"> 
                        <div class="slds-col slds-has-flexi-truncate slds-size_1-of-6 slds-p-top_medium">
                            
                            <label for="partnerAccountIdDiv" class="slds-form-element__label">{!v.translationsMap.Filter_By}: </label>
                            
                            <lightning:buttonIcon iconName="utility:search" variant="bare"
                                                  onclick="{!c.createAccountLookup}"
                                                  alternativeText="{!v.translationsMap.Please_choose_a_Partner_Contact}"/>                             
                            
                            <div id="partnerAccountIdDiv" class="slds-p-top_x-small slds-box slds-truncate slds-box_xx-small boxheight">
                                 {!v.partnerAccountName} 
                                
                            </div>
                        </div>
                    </aura:if>
                </aura:if>
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-6 slds-p-around_medium">
                    <lightning:input label="{!v.translationsMap.Keyword}" value="{!v.searchKeyword}"                                         
                                     placeholder="{!v.translationsMap.search_placeholder + '...'}"  
                                     aura:id="searchField"/>
                </div>
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-6 slds-p-around_medium">
                    <lightning:select name="searchBy" value= "{!v.searchBy}" label="{!v.translationsMap.Search_by+':'}">
                        <option value="Company_Name__c">{!v.DealRegFieldsMap.Name}</option>
                        <option value="Email_Address__c">{!v.translationsMap.Email}</option>
                        <option value="Forecasted_Users__c">{!v.DealRegFieldsMap.Forecasted_Users__c}</option>
                        <!--<aura:if isTrue="{!!v.ShowOnlyRC}"><option value="Avaya_CloudOffice_Specialist__c">{!v.communityDetailsRecord.Portal_Cloud_Specialist__c}</option></aura:if>-->
                         <aura:if isTrue="{!!or(v.ShowOnlyRC,or(or(v.communityDetailsRecord.Brand_Name__c=='RingCentral with Eastlink',v.communityDetailsRecord.Brand_Name__c=='RingCentral mit ecotel'),v.communityDetailsRecord.Brand_Name__c=='RingCentral for Symphony'))}">
                            <!--pbc-10695-->
                            <option value="Portal_Cloud_Specialist__r.Name">{!v.communityDetailsRecord.Portal_Cloud_Specialist__c}</option>
                        </aura:if>
                        <aura:if isTrue="{!v.isSingleLogin}">
                                <option value="Partner_Account__r.Partner_ID__c">{!v.DealRegFieldsMap.Partner_ID__c}</option>
                                <option value="Partner_Account__r.name">Partner Name</option>
                         </aura:if>
                        <option value="Country__c">{!v.DealRegFieldsMap.Country__c}</option>
                        <option value="State__c">{!v.DealRegFieldsMap.State__c}</option>
                        
                    </lightning:select>
                </div>
                <!-- DEAL STATUS DROP DOWN -->
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-6 slds-p-around_medium">
                    <lightning:select name="DealStatus" label="{!v.translationsMap.Deal_Status +':'}" aura:id="DealStatus" value="{!v.selectedStatusValue}">                  
                        <option value="Approved">{!v.translationsMap.Approved}</option>
                        <option value="Pending Approval" selected="true">{!v.translationsMap.Pending_Approval}</option>
                        <option value="Rejected">{!v.translationsMap.Rejected}</option>    
                        <option value="Any">{!v.translationsMap.Any}</option>    
                    </lightning:select>
                </div>
                <!-- BUTTON FOR FILTER -->
                <div class="slds-col slds-has-flexi-truncate slds-size_1-of-6  slds-p-around_medium">
                    <div style="padding-top:23px;"> 
                        <lightning:button variant="brand" label="{!v.translationsMap.Go}" iconName="utility:forward" iconPosition="right" onclick="{!c.doFilter}" />
                    </div> 
                </div>
                <aura:if isTrue="{!v.viewAll}">
                    <div class="slds-col slds-has-flexi-truncate slds-size_1-of-6  slds-p-around_medium"/>
                </aura:if>
                <aura:if isTrue="{!!v.ShowConAccFields}"> 
                    <div class="slds-col slds-has-flexi-truncate slds-size_1-of-6  slds-p-around_medium"/>
                </aura:if>
                <!--<div class="slds-col slds-has-flexi-truncate slds-size_1-of-5 slds-p-around_medium"/>-->
                <!-- LIST FOR PAGINATION -->
                <aura:if isTrue="{!!v.viewAll}">
                    <div class="slds-col slds-has-flexi-truncate slds-size_1-of-6  slds-p-vertical_medium slds-float_right">
                        <lightning:select aura:id="pageSize" label="{!v.translationsMap.Display_Deals_Per_Page}" onchange="{!c.onSelectChange}">
                            <option text="50" value="50" selected="true"/>
                            <option text="100" value="100"/>
                            <option text="150" value="150"/>
                            <option text="200" value="200"/>
                        </lightning:select>            
                    </div>  
                </aura:if>
                <aura:if isTrue="{!v.viewAll}">
                    <div class="slds-col slds-has-flexi-truncate slds-size_1-of-6  slds-p-vertical_medium slds-float_right">
                        <lightning:select aura:id="pageSizeForAll" label="{!v.translationsMap.Display_Deals_Per_Page}" onchange="{!c.onSelectChange}">
                            <option text="50" value="50" selected="true"/>
                            <option text="100" value="100"/>
                            <option text="150" value="150"/>
                            <option text="200" value="200"/>
                        </lightning:select>            
                    </div>  
                </aura:if>
                <lightning:layout>
                    <aura:if isTrue="{!!v.ShowConAccFields}">
                        <!--<aura:if isTrue="{! or(and(!v.ShowOnlyAvaya,!v.ShowOnlyRC),and(!v.ShowConAccFields,ShowOnlyRC))}">-->
                        <lightning:layoutItem class="slds-p-horizontal_small slds-p-around_x-small slds-size_3-of-2">
                            <!--<aura:if isTrue="{!!v.isReadOnly}">-->
                            <aura:if isTrue="{!and(!v.isReadOnly,v.isReseller)}">
                                <lightning:button variant="brand"  label="{!v.translationsMap.New}" iconName="action:new" iconPosition="left" onclick="{!c.showNewSectionArea}" />
                            </aura:if>
                        </lightning:layoutItem>
                    </aura:if>
                    <!--<aura:if isTrue="{!and(!v.ShowOnlyRC,v.isMasterAgent)}">-->
                    <aura:if isTrue="{!v.isMasterAgent}">    
                        <lightning:layoutItem class="slds-p-horizontal_small slds-p-around_x-small slds-size_3-of-2">
                            <!--<aura:if isTrue="{!!v.isReadOnly}">-->
                            <aura:if isTrue="{!and(!v.isReadOnly,v.isReseller)}">
                                <lightning:button variant="brand"  label="{!v.translationsMap.New}" iconName="action:new" iconPosition="left" onclick="{!c.showNewSectionArea}" />
                            </aura:if>
                        </lightning:layoutItem>
                    </aura:if>
                    <aura:if isTrue="{!v.ShowConAccFields}">
                        <lightning:layoutItem class="slds-p-horizontal_small slds-p-around_x-small slds-size_6-of-2">
                            <aura:if isTrue="{!!v.isReadOnly}">
                                <lightning:button variant="brand"   label="{!v.translationsMap.New_on_behalf_of}" iconName="action:new" iconPosition="left" onclick="{!c.showNewBehalfSectionArea}" />
                            </aura:if>
                        </lightning:layoutItem>
                    </aura:if>
                    <!--Show for Sub Partner with full Access-->
                    <!-- <aura:if isTrue="{!v.ShowOnlyRC}">-->
                    <aura:if isTrue="{!v.isCurrentSubPartnerFullAccess}">
                        <lightning:layoutItem class="slds-p-horizontal_small slds-p-around_x-small slds-size_3-of-2">
                            <aura:if isTrue="{!!v.isReadOnly}">
                                <lightning:button variant="brand"  label="{!v.translationsMap.New_on_behalf_of}" iconName="action:new" iconPosition="left" onclick="{!c.showNewBehalfSectionArea}" />
                            </aura:if>
                        </lightning:layoutItem>
                    </aura:if>
                    <!-- </aura:if>-->
                </lightning:layout>
                
            </div>
        </div>
        <!-- DISPLAY MESSAGE WHEN NO RECORDS FOUND -->       
        <aura:if isTrue="{!v.Message}">
            <div class="errorMessageDiv">
                <div class="slds-is-relative errorMessageDiv">
                    <div class="slds-notify slds-notify_toast slds-theme_error norecordsmsg" role="alert">
                        <div class="slds-notify__content">
                            <h2 class="slds-text-heading_small">{!v.translationsMap.No_Records_Found +'...'}</h2>
                        </div>
                    </div>
                </div>  
            </div>
        </aura:if>
        <!-- LIST OF RECORDS -->
        <aura:if isTrue="{!!v.Message}">
            <div class="slds-m-around_xx-small slds-p-top_large">        
                <table class="slds-table slds-table_bordered slds-table_cell-buffer slds-table_fixed-layout">
                    <thead>
                        <tr>
                            
                            <th scope="col" style="width:14rem;">
                                <strong><div class="slds-truncate" title="{!v.DealRegFieldsMap.Company_Name__c}">{!v.DealRegFieldsMap.Company_Name__c}</div></strong>
                            </th> 
                            <aura:if isTrue="{!v.ShowOnlyRC}">
                                <th scope="col">
                                    <strong>
                                        <div class="slds-truncate" title="{!v.DealRegFieldsMap.Name}">{!v.DealRegFieldsMap.Name}</div>
                                    </strong>
                                </th> 
                            </aura:if>
                            <th scope="col">
                                <strong><div class="slds-truncate" title="{!v.DealRegFieldsMap.Company_Name__c}">{!v.DealRegFieldsMap.Email_Address__c}</div></strong>
                            </th>
                            <th scope="col">
                                <strong><div class="slds-truncate" title="{!v.DealRegFieldsMap.Status__c}">{!v.DealRegFieldsMap.Status__c}</div></strong>
                            </th>
                            <th scope="col">
                                <strong><div class="slds-truncate" title="{!v.DealRegFieldsMap.Forecasted_Users__c}">{!v.DealRegFieldsMap.Forecasted_Users__c}</div></strong>
                            </th>                            
                            
                            <aura:if isTrue="{!or(v.ShowConAccFields,v.isSingleLogin)}">
                                <th scope="col">
                                    <strong><div class="slds-truncate" title="{!v.translationsMap.Partner}">{!v.translationsMap.Partner}</div></strong>
                                </th>
                                <th scope="col">
                                    <strong><div class="slds-truncate" title="{!v.DealRegFieldsMap.Partner_ID__c}">{!v.DealRegFieldsMap.Partner_ID__c}</div></strong>
                                </th>
                                <!-- <th scope="col">
                                    <strong><div class="slds-truncate" title="Partner Channel Manager">Partner Channel Manager</div></strong>
                                </th> -->
                                <aura:if isTrue="{!v.ShowConAccFields}">
                                    <th scope="col">
                                        <strong><div class="slds-truncate" title="{!v.DealRegFieldsMap.Partner_Contact__c}">{!v.DealRegFieldsMap.Partner_Contact__c}</div></strong>
                                    </th>
                                </aura:if>
                            </aura:if>
                            <aura:if isTrue="{!!or(v.ShowOnlyRC,or(or(v.communityDetailsRecord.Brand_Name__c=='RingCentral with Eastlink',v.communityDetailsRecord.Brand_Name__c=='RingCentral mit ecotel'),v.communityDetailsRecord.Brand_Name__c=='RingCentral for Symphony'))}">
                                <!--pbc-10695--> 
                                <th scope="col">
                                    <strong><div class="slds-truncate" title="{!v.communityDetailsRecord.Portal_Cloud_Specialist__c}">{!v.communityDetailsRecord.Portal_Cloud_Specialist__c}</div></strong>
                                </th>
                            </aura:if>
                            <th scope="col">
                                <strong><div class="slds-truncate" title="{!v.DealRegFieldsMap.Country__c}">{!v.DealRegFieldsMap.Country__c}</div></strong>
                            </th>
                            <th scope="col">
                                <strong><div class="slds-truncate" title="{!v.DealRegFieldsMap.State__c}">{!v.DealRegFieldsMap.State__c}</div></strong>
                            </th>
                            <th scope="col">
                                <strong><div class="slds-truncate" title="{!v.translationsMap.Created_Date}">{!v.translationsMap.Created_Date}</div></strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <aura:iteration items="{!v.dealRegList}" var="dealRecord"> 
                            <tr>
                                
                                <th scope="row" data-label="Name" style="width:14rem;">
                                    <div class="slds-truncate" title="{!dealRecord.Company_Name__c}"
                                         data-value="{!dealRecord.Id}">
                                        <!--<a href="{!'/partner/s/partnerdealregistration?id='+dealRecord.Id}">
                                            {!dealRecord.Company_Name__c} 
                                        </a>  -->
                                        <a href="{!v.RespectiveTabURL +'?id=' +dealRecord.Id}">
