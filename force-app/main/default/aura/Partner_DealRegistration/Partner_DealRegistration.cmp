                        <span><lightning:inputField fieldName="RC_Overlay__c"  variant="label-hidden" /></span>
                    </div> -->
                    <!--<div class="slds-col slds-size_1-of-7 slds-p-around_x-small" style="color:gray;">
                        <span  class="slds-float_right">Is RFP Needed</span>
                    </div>                        
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                        <span ><lightning:inputField fieldName="Is_RFP_Needed__c" variant="label-hidden"/></span>
                    </div>-->
                    <!--<aura:if isTrue="{!!v.ShowOnlyRC}">
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                            <span>Is RFP Needed</span>
                             <abbr class="slds-required" >* </abbr>
                        </div>                        
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                            <span ><lightning:inputField fieldName="Is_RFP_Needed__c" variant="label-hidden"/></span>
                        </div>
                        <div class="slds-col slds-size_4-of-7">
                            <span></span>
                        </div>
                        <c:Partner_CloudSpecialistSearch communityDetailsRecord="{!v.communityDetailsRecord}"/>
                    </aura:if>-->
                    <aura:if isTrue="{!!v.isGuestUser}">
                   <aura:if isTrue="{!!or(v.ShowOnlyRC,or(or(v.communityDetailsRecord.Brand_Name__c=='RingCentral with Eastlink',v.communityDetailsRecord.Brand_Name__c=='RingCentral mit ecotel'),v.communityDetailsRecord.Brand_Name__c=='RingCentral for Symphony'))}">
                    <!--pbc-10695-->
                        <c:Partner_CloudSpecialistSearch communityDetailsRecord="{!v.communityDetailsRecord}"/>
                    </aura:if>
                    </aura:if>
                    <aura:if isTrue="{!or(v.ShowOnlyRC,v.ShowOnlyATOS)}">
                    <!--<aura:if isTrue="{!and(v.ShowOnlyAvaya,v.ShowOnlyRC)}">-->
                        <!--<aura:if isTrue="{!or(or(and(v.NewOnBehalf, v.isNationalPartnerAccount),and(and(!v.NewOnBehalf, v.isNationalPartnerAccountNew),!v.isSingleLogin)),and(and(v.isSingleLogin,v.isNationalPartnerAccount),!v.NewOnBehalf))}">-->
                        <aura:if isTrue="{!or(and(v.NewOnBehalf, !(empty(v.territoryAlignmentMap))),
                                                                and(and(v.isSingleLogin,!v.NewOnBehalf),!(empty(v.territoryAlignmentMap))))}">
                            <div aura:id="userPane" class="slds-form-element slds-lookup slds-is-close">
                                <div class='slds-grid align'>
                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                        <span>RC Strategic Partner Manager:
                                            <!--<aura:if isTrue="{!or(and(v.NewOnBehalf, !(empty(v.territoryAlignmentMap))),
                                                                and(and(v.isSingleLogin,!v.NewOnBehalf),!(empty(v.territoryAlignmentMap))))}">-->
                                                <lightning:helptext class='territorymaphelp' content="Please use Territory Alignment Map to find Strategic Partner Manager for required territory"/>
                                            <!--</aura:if>-->
                                        </span>
                                        <abbr class="slds-required" >* </abbr>                                    
                                        <!--<aura:if isTrue="{!or(and(v.NewOnBehalf, !(empty(v.territoryAlignmentMap))),
                                                            and(and(v.isSingleLogin,!v.NewOnBehalf),!(empty(v.territoryAlignmentMap))))}">-->
                                            <div>
                                                <a href="" onclick="{!c.previewFile}">
                                                    Territory Alignment Map
                                                </a>
                                            </div>
                                        <!--</aura:if>-->
                                    </div>                        
                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small dropdownwrap">             
                                        <div class="slds-form-element__control" >
                                            <ui:inputText aura:id="usersearch"  placeholder="Search Users.."
                                                          class="slds-lookup__search-input slds-input input-no-border" value="{!v.searchUser}" updateOn="keyup" keyup="{!c.onInputChange}" click="{!c.onSearchInputClick}" required="true" />
                                        </div>
                                        <div id="listbox-unique-id"  class="lookup-container cloudspecdropdown slds-p-horizontal_x-small" role="listbox" >
                                            <ul class="slds-listbox slds-listbox_vertical slds-dropdown slds-dropdown_fluid slds-lookup__menu" aura:id="dropDownList" role="presentation">
                                                <aura:if isTrue="{!not(empty(v.portalUserList))}">
                                                    <aura:iteration var="userRecord" items="{!v.portalUserList}" indexVar="index">
                                                        <li role="presentation" class="slds-listbox__item" onclick="{!c.selectedUser}" data-username="{!userRecord.Strategic_Partner_Manager__r.Full_Name__c}" 
                                                            data-userid="{!userRecord.Strategic_Partner_Manager__r.Id}" >
                                                            <div id="listbox-option-unique-id-01" class="slds-media slds-listbox__option slds-listbox__option_entity slds-listbox__option_has-meta" role="option">
                                                                <span class="slds-media__body">
                                                                    <span class="slds-listbox__option-text slds-listbox__option-text_entity">{!userRecord.Strategic_Partner_Manager__r.Full_Name__c}</span>
                                                                    <span class="slds-listbox__option-meta slds-listbox__option-meta_entity">{!userRecord.Strategic_Partner_Manager__r.Email}</span>
                                                                </span>
                                                            </div>
                                                        </li>
                                                    </aura:iteration>
                                                </aura:if>
                                                <aura:if isTrue="{!(empty(v.portalUserList))}">
                                                    <div class="nousers">No Users Found..</div>
                                                </aura:if>
                                            </ul>
                                        </div>                                    
                                    </div>
                                </div>
                            </div>
                        </aura:if>
                    </aura:if>
                    <aura:if isTrue="{!v.ShowOnlyRC}">
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                            <span>Forecasted Contact Center Users:</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                            <span>
                                <lightning:inputField fieldName="Forecasted_Contact_Center_Users__c" value="{!v.ForecastCCU}" variant="label-hidden" />
                            </span>
                        </div>
                        <div class="slds-col slds-size_1-of-7"></div>
                    </aura:if>
                    <aura:if isTrue="{!or(v.ShowOnlyRC,v.ShowOnlyALE)}"><!--pbc-10695--> 
                        <!--Added for PRM-83 starts-->
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;" >
                            <span>{!v.PRMSpecificTranslationsMap.Partners_CRM_Opportunity_ID}:</span>
                        </div>    
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                            <span><lightning:inputField fieldName="Partners_CRM_Opportunity_ID__c" variant="label-hidden" /></span>                             
                        </div>
                        <!--Added for PRM-83 ends-->
                    </aura:if>
                    <!--<aura:if isTrue="{!v.ShowOnlyRC}">
                        <div class="slds-col slds-size_1-of-7"></div>
                    </aura:if>-->
                    <aura:if isTrue="{!v.isMitel}">
                        <!--Added for Mitel PRM-145 starts-->
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;" >
                            <span>Is this an existing Mitel Customer?:</span>
                            <abbr class="slds-required">* </abbr>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                            <span><lightning:inputField fieldName="Mitel_Customer_or_Prospect__c" aura:id="isMitelCustomer" variant="label-hidden" onchange="{!c.changeMitelCustomer}"/></span>                             
                        </div>
                        <div class="slds-col slds-size_1-of-7"></div>
                        <aura:if isTrue="{!v.ShowMitelCustomerType}">
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;" >
                            <span>What Type of Mitel Customer or Prospect?:</span>
                            <abbr class="slds-required">* </abbr>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                               <span><lightning:inputField fieldName="Type_of_Customer_or_Prospect__c" aura:id="mitelCustomerType" variant="label-hidden" onchange="{!c.changeMitelType}"/></span>                             
                        </div>
                            <aura:if isTrue="{!v.ShowMitelDataShare}">
                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;" >
                                    <span>Allow sharing this deal data with Mitel?:</span>
                                    <lightning:helptext class="mitelHelpText" content="By clicking yes, you consent to RingCentral sharing with Mitel Networks, Inc. (in its capacity as a RingCentral partner) account and opportunity data."/>
                                    <abbr class="slds-required">* </abbr>
                                </div>
                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                    <span><lightning:inputField fieldName="Mitel_Data_Sharing__c" aura:id="mitelDataShare" variant="label-hidden" /></span>                             
                                </div>
                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;"></div>
                            </aura:if>
                            <aura:set attribute="else">
                                <div class="slds-col slds-size_3-of-7 slds-p-around_x-small alignRight" style="color:gray;"></div>
                            </aura:set>
                        </aura:if>
                        <!-- Added for Mitel PRM-145 ends--> 
                    </aura:if>
                    <!--Added for Switzerland starts-->
                    <aura:if isTrue="{!v.selectedCountry == 'Switzerland'}">
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                            <span>Preferred Language:</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                            <span>
                                <lightning:inputField fieldName="Preferred_Language__c" variant="label-hidden" />
                            </span>
                        </div>
                    </aura:if>
                    <!--Added for Switzerland ends-->
                </div>
                <aura:if isTrue="{!v.ShowRequiredErrorSection}">
                    <div class="slds-align_absolute-center">
                        <!--<div class="slds-is-relative errorMessageRequiredDiv">
                    <div class="slds-notify slds-notify_toast slds-theme_error" role="alert">
                        <div class="slds-notify__content">-->
                        
                        <h2 class="slds-text-heading_small" style="background-color:rgb(255, 255, 255);color:rgb(201, 17, 21);">*{!v.translationsMap.Fill_All_the_fields}</h2>
                        <!-- </div>
                    </div>
                </div> --> 
                        <br/>
                    </div>
                </aura:if>
                <div class="slds-form-element slds-form-element_horizontal slds-align_absolute-center slds-p-around_medium" style="bottom-border:.25rem !important;">
                    <lightning:button variant="brand" label="{!v.translationsMap.Submit}" type="submit" iconName="action:check" iconPosition="left"/>
                    <lightning:button variant="brand" type="cancel" name="Cancel" label="{!v.translationsMap.Cancel}" iconName="action:close" iconPosition="left" onclick="{!c.goBackListView}"/>            
                </div>
            </lightning:recordEditForm>
        </lightning:card>
    </aura:if>    
    <div aura:id="lookupSearchDiv"></div>
    <aura:if isTrue="{!v.showGuestLogin}">
        <c:GSPGuestLogin GuestEmail="{!v.GuestEmail}" />
    </aura:if>
</aura:component>