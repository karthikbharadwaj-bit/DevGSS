                    </div>                        
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                        <!-- Commented since Avaya cloud Specialist need to be chosen<span>{!v.DealRegRecord.Avaya_CloudOffice_Specialist__c}</span>-->
