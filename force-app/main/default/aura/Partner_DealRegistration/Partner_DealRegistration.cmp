                                            {!dealRecord.PartnerContact}
                                        </div>
                                    </th>
                                    </aura:if>
                                </aura:if>
                                <aura:if isTrue="{!!or(v.ShowOnlyRC,v.communityDetailsRecord.Brand_Name__c=='Rainbow Office')}">
