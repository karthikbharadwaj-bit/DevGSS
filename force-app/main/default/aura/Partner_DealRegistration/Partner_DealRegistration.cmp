                    <div class="slds-col slds-size_1-of-7 slds-border_top"></div>
                    <div class="slds-col slds-size_2-of-7 slds-border_top"></div>
                </aura:if>
                </aura:if>
               <!-- <aura:if isTrue="{!v.ShowOnlyRC}">-->
                <!--<aura:if isTrue="{!or(v.ShowOnlyRC,v.ShowOnlyATOS)}">-->
                    <!--  <div class="slds-col slds-size_1-of-7 slds-border_top">
                        <span></span>
                    </div>
