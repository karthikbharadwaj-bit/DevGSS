                    </div>
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                        <span>{!v.DealRegRecord.Partners_CRM_Opportunity_ID__c}</span>
                    </div>
                </aura:if> 
                
                <aura:if isTrue="{!!v.ShowOnlyRC}">
