                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                        <span>{!v.DealRegRecord.Inside_Sales_Rep__r.Full_Name__c}</span>
                    </div>                          
                </aura:if>
                <!--<aura:if isTrue="{!v.ShowOnlyRC}"><div class="slds-col slds-size_7-of-7 slds-border_top"></div></aura:if>-->
                <aura:if isTrue="{!v.ShowOnlyRC}">
                     <div class="slds-col slds-size_1-of-7 slds-border_top"></div>
                     <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                        style="color:gray;">
                        <span>{!v.DealRegFieldsMap.Name}:</span>
                    </div>
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                        <span>{!v.DealRegRecord.Name}</span>
                    </div>
                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                        style="color:gray;">
                        <span>{!v.DealRegFieldsMap.Forecasted_Contact_Center_Users__c}:</span>
                    </div>
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                        <span>{!v.DealRegRecord.Forecasted_Contact_Center_Users__c}</span>
                    </div>
                    <div class="slds-col slds-size_1-of-7 slds-border_top"></div>
                </aura:if>
                <aura:if isTrue="{!v.ShowOnlyRC}"><!--pbc-10695-->
                    <!--Added for PRM-83 starts-->
                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                        style="color:gray;">
                        <span>{!v.PRMSpecificTranslationsMap.Partners_CRM_Opportunity_ID}:</span>
                    </div>
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                        <span>{!v.DealRegRecord.Partners_CRM_Opportunity_ID__c}</span>
                    </div>
                </aura:if>
                    <!--Added for PRM-83 ends-->
                <aura:if isTrue="{!v.ShowOnlyRC}">
                    <!-- Added for QTC-943 starts -->
                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                        <span>Partner Program:</span>
                    </div>                        
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                        <span>{!v.DealRegRecord.Partner_Program__c}</span>
                    </div>
                    <div class="slds-col slds-size_1-of-7 slds-border_top">
                        <span></span>
                    </div>
                    <!--Added Install starts -->
                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                        <span>Installation Service Provider:</span>
                    </div> 
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.DealRegRecord.Installation_Service_Provider__c}</span>
                    </div>
                    <!--Added Install End-->
                    <!--Added for Mitel starts-->
                    <aura:if isTrue="{!v.DealRegRecord.Mitel_Customer_or_Prospect__c != null}">
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                             style="color:gray;">
                            <span>Is this an existing Mitel Customer or Prospect:</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                            <span>{!v.DealRegRecord.Mitel_Customer_or_Prospect__c}</span>
                        </div>
                        <div class="slds-col slds-size_1-of-7 slds-border_top"></div>
                        <aura:if isTrue="{!v.DealRegRecord.Mitel_Customer_or_Prospect__c == 'Yes'}">
                            <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                                 style="color:gray;">
                                <span>What Type of Mitel Customer or Prospect?</span>
                            </div>
                            <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                <span>{!v.DealRegRecord.Type_of_Customer_or_Prospect__c}</span>
                            </div>
                            <!--PBC-9705 P2CSHaring-->
                            <aura:if isTrue="{!v.ShowMitelShareDetailPage}">
                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                                     style="color:gray;">
                                    <span>Allow sharing this deal data with Mitel?:</span>
                                </div>
                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                    <span>{!v.DealRegRecord.Mitel_Data_Sharing__c}</span>
                                </div>
                                <div class="slds-col slds-size_4-of-7 slds-p-around_x-small slds-border_top">
                                </div>
                            </aura:if>
                            <aura:set attribute="else">
                                <div class="slds-col slds-size_3-of-7 slds-p-around_x-small slds-border_top">
                                </div>    
                            </aura:set>
                        </aura:if>
                    </aura:if>
                    <!-- Added for Mitel ends-->
                    <!--Added for PRM-99 starts-->
                   <!-- <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                        style="color:gray;">
                        <span>{!v.DealRegFieldsMap.Name}:</span>
                    </div>
                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                        <span>{!v.DealRegRecord.Name}</span>
                    </div>-->
                    <!--<div class="slds-col slds-size_4-of-7 slds-border_top">
                     <span></span>
                    </div>-->
                    <aura:if isTrue="{!v.DealRegRecord.Country__c == 'Switzerland'}">
                        <!--<div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;"></div>-->
                        <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight" style="color:gray;">
                            <span>Preferred Language:</span>
                        </div>
                        <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
