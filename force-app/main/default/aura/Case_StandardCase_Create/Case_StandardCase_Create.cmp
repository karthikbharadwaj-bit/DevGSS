<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable" access="global"
                controller="Case_StandardCaseCreate_Comp">
    
    <aura:attribute name="base64context" type="String" access="public"/>

    <aura:handler event="aura:waiting" action="{!c.showSpinner}"/>
    <aura:handler event="aura:doneWaiting" action="{!c.hideSpinner}"/>
    <div class="slds-is-relative">
        
        <div class="spinnerHolder">
            <lightning:spinner alternativeText="Loading..." aura:id="loadingSpinner" class="slds-hide" size="large" variant="brand"/>
        </div>
    </div>
    <aura:handler name="init" value="{!this}" action="{!c.createCase}"/>
   

    
</aura:component>