<!--
* Created By     : Ishwarya
* Created Date   : 03-01-2020
* Description    : Component for Deal Support Record Detail Page- Partner_DealSupportDetail

Change History
*******************************************************************************************************************************************
SCRUM/Jira ModifiedBy      Date        Description 									Tag
*******************************************************************************************************************************************

*******************************************************************************************************************************************
*/-->

<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction"
                access="global" controller="Partner_DealSupport">
    <aura:attribute name="baseURL" type="String" />
    <aura:attribute name="CustomerURLLink" type="String" />
    <aura:attribute name="PartnerURLLink" type="String" />
    <aura:attribute name="OpportunityURLLink" type="String" />
    <aura:attribute name="QuoteURLLink" type="String" />
    <aura:attribute name="LeadURLLink" type="String" />
    <aura:attribute name="recordID" type="String" />
    <aura:attribute name="ShowListView" type="boolean" default="false" />
    <aura:attribute name="ShowRecordDetail" type="boolean" default="true" />
    <aura:attribute name="ShowSpinnerOpp" type="boolean" default="true" />
    <aura:attribute name="ShowComponentButtons" type="boolean" default="false" />
    <aura:attribute name="ShowEditSection" type="boolean" default="false" />
    <aura:attribute name="selectedValue" type="string" access="public" />
    <aura:attribute name="selectedStatusValue" type="string" access="public" />
    <aura:attribute name="selectedTypeValue" type="string" access="public" />
    <aura:attribute name="ShowNewSection" type="boolean" default="false" />
    <aura:attribute name="Attachments" type="List" />
    <aura:attribute name="documentId" type="String" />
    <aura:attribute name="files" type="List" />
    <aura:attribute name="Message" type="boolean" default="false" />
    <aura:attribute name="ShowOnlyRC" type="boolean" default="false" />
    <aura:attribute name="ShowOnlyALE" type="boolean" default="false" />
    <aura:attribute name="FilesMessage" type="boolean" default="false" />
    <aura:attribute name="AttachmentsMessage" type="boolean" default="false" />
    <aura:attribute name="ShowFilesMessage" type="string" />
    <aura:attribute name="ShowOppFilesMessage" type="string" />
    <aura:attribute access="public" name="accept" type="List" default="['.pdf']" />
    <aura:attribute name="UploadDisabled" type="Boolean" default="false" />
    <aura:attribute name="isSingleLogin" type="boolean" default="false" />
    
    <aura:attribute name="accountId" type="String" />
    <aura:attribute name="DealSupportRecord" type="Deal_Support__c" default="{
                                                                             'SObjectType': 'Deal_Support__c'
                                                                             }" />
    <aura:attribute name="showAssignToRCButton" type="Boolean" />
    <aura:registerEvent name="goBackEvent" type="c:Partner_OpportunitiesGoBackEvent" />
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="ShowSpinnerDeal" type="boolean" default="true" />
    <aura:handler event="aura:waiting" action="{!c.showSpinner}" />
    <aura:handler event="aura:doneWaiting" action="{!c.hideSpinner}" />
    
    <aura:attribute name="selTabId" type="String" default="detailTab" />
    <aura:attribute name="ShowConAcc" type="boolean" />
    <aura:attribute name="Discount" type="Integer" />
    <aura:attribute name="DisableApproval" type="boolean" default="true" />
    <aura:attribute name="isPOCQuote" type="boolean" default="false" />
    <aura:attribute name="SalesOverlayQueue" type="String" />
    <aura:attribute name="ShowOnlyAvaya" type="boolean" default="false" />
    <aura:attribute name="isReadOnly" type="boolean" default="false" />
    <aura:attribute name="partnerCommunity" type="String" />
    <aura:attribute name="portalCloudSpecialist" type="String" />
    
    <aura:attribute name="communityDetailsRecord" type="Object" />
    
    <!--Added for getting files uploaded from SF Lightning - starts-->
    <aura:attribute name="AttachmentsForDeal" type="List" />
    <aura:attribute name="AttachmentsForDealMsg" type="boolean" default="false" />
    <aura:attribute name="Lightningfiles" type="List" />
    <aura:attribute name="LightningFilesMessage" type="boolean" default="false" />
    <!--Added for getting files uploaded from SF Lightning - ends-->
    <!--Added for getting files uploaded from SF Lightning opportunity AS - starts-->
    <aura:attribute name="LightningfilesOpp" type="List" />
    <aura:attribute name="LightningFilesOppMessage" type="boolean" default="false" />
    <!--Added for getting files uploaded from SF Lightning opportunity AS - END-->
    <aura:attribute name="availProServ" type="boolean" default="true" />
    
    <!-- Added attrs and aura:if for JIRA fix as part of ACO 4.0 -->
    <aura:attribute name="showChangeRequestCMP" type="Boolean" default="false" />
    <aura:attribute name="ExistingChangeOrder" type="Boolean" default="false" />
    <aura:attribute name="changeOrderId" type="String" />
    <aura:attribute name="isChangeOrderSubmitted" type="Boolean" default="false" />
    <aura:attribute name="oppID" type="String" />
    
    <!-- Added for BZS-4698 -->
    <aura:attribute name="JustificationForRejection" type="String" default="" access="public" />
    <aura:attribute name="showModal" type="boolean" default="false"/>
    <aura:attribute name="ShowOnlyAtos" type="boolean" default="false" />
    <!-- Added for BZS-4698 -->
    
    <aura:attribute name="dealSupportFieldsMap" type="Map" />
    <aura:attribute name="translationsMap" type="Map" />
    <aura:attribute name="PRMSpecificTranslationsMap" type="Map" />
    
    <aura:attribute name="TypeValueTranslation" type="String" default="" access="public" />
    <aura:attribute name="StatusValueTranslation" type="String" default="" access="public" />
    <!--Added for PBC-11030-->
    <aura:attribute name="isVATNumber" type="Boolean" default="false" />
    
    <aura:if isTrue="{!v.showChangeRequestCMP}">
        <c:Quote_OrderChangeRequest accountId="{!v.accountId}" isChangeOrderSubmitted="true"
                                    changeOrderId="{!v.changeOrderId}" ExistingChangeOrder="true" showChangeRequestCMP="{!v.showChangeRequestCMP}" />
    </aura:if>
    <aura:if isTrue="{!!v.showChangeRequestCMP}">
        <aura:if isTrue="{!v.ShowSpinnerDeal}">
            <div class="slds-is-relative">
                <div class="spinnerHolder">
                    <lightning:spinner alternativeText="{!v.translationsMap.Loading +'...'}" aura:id="loadingSpinner" class="slds-hide" size="medium" />
                </div>
            </div>
        </aura:if>
        <aura:if isTrue="{!v.Message}">
            <div class="errorMessageDivDetail">
                <div class="slds-is-relative errorMessageDivDetail">
                    <div class="slds-notify slds-notify_toast slds-theme_error norecordsmsg" role="alert">
                        <div class="slds-notify__content">
                            <h2 class="slds-text-heading_small">{!v.translationsMap.No_Records_Found +'...'}</h2>
                        </div>
                    </div>
                </div>
            </div>
        </aura:if>
        
        <aura:if isTrue="{!!v.Message}">
            <aura:if isTrue="{!v.ShowRecordDetail}">
                <!--<aura:if isTrue="{!v.DealSupportRecord.Owner.Name == $Label.c.Sales_Overlay_Queue}">
             <div class="errorMessageDiv">
                    <div class="slds-is-relative errorMessageDiv">
                        <div class="slds-notify slds-notify_toast slds-theme_error" role="alert">
                            <div class="slds-notify__content">
                                <h2 class="slds-text-heading_small">This record is assigned to RC for approval</h2>
                            </div>
                        </div>
                    </div>  
                </div>
            </aura:if>-->
                <!--<aura:if isTrue="{!v.DealSupportRecord.Owner.Name != $Label.c.Sales_Overlay_Queue}">-->
                <lightning:card variant="Narrow" title="{!v.translationsMap.Deal_Status_Details}" iconName="standard:case">                    
                    <aura:set attribute="actions">                        
                        <lightning:button variant="brand" label="{!v.translationsMap.Go_Back}" iconName="action:recall" iconPosition="left"
                                          onclick="{!c.goBackToViewList}" />
                    </aura:set>
                                        
                    <lightning:tabset selectedTabId="{!v.selTabId}">
                        <lightning:tab  id="detailTab">
                            <aura:set attribute="label">
                                {!v.translationsMap.Details}
                            </aura:set>
                            <!--<lightning:card variant="Narrow" title="Deal Support Detail" iconName="standard:case">-->
                            <!-- commented for ALE safari browser issue -->
                            <!--<div class="slds-is-relative">
                            <div class="spinnerHolder">
                                <lightning:spinner alternativeText="Loading..." aura:id="loadingSpinner" class="slds-hide" size="medium"/>
                            </div>
                        </div> -->
                            <aura:if isTrue="{!!v.ShowOnlyRC}">
                                <aura:if isTrue="{!!v.isReadOnly}">
                                    <aura:if isTrue="{!!v.ShowEditSection}">
                                        <aura:if isTrue="{!and(v.DealSupportRecord.Type__c == 'POC Request', v.ShowOnlyAvaya)}">
                                            <div
                                                 class="slds-form-element slds-form-element_horizontal slds-align_absolute-center slds-p-around_medium"
                                                 style="border-bottom:.25rem !important;">
                                                <lightning:button variant="brand" label="Edit" iconName="action:edit" iconPosition="left"
                                                                  onclick="{!c.showEditSectionAres}" />
                                                <aura:if isTrue="{!v.showAssignToRCButton}">
                                                    <lightning:button variant="brand" label="{!v.translationsMap.Assign_to_RC}" onclick="{!c.assignToRC}" />
                                                </aura:if>
                                            </div>
                                        </aura:if>
                                        <aura:if
                                                 isTrue="{!and(and(v.DealSupportRecord.Owner.Name != v.communityDetailsRecord.Portal_SalesOverlay_Queue__c,
                                                         not(v.DealSupportRecord.Type__c == 'POC Request')), and(v.DealSupportRecord.Status__c != 'Closed-Approved',v.DealSupportRecord.Status__c != 'Closed-Rejected'))}">
                                            <div
                                                 class="slds-form-element slds-form-element_horizontal slds-align_absolute-center slds-p-around_medium"
                                                 style="border-bottom:.25rem !important;">
                                                <aura:if isTrue="{!and(v.showAssignToRCButton,v.ShowOnlyAvaya)}">
                                                    <lightning:button variant="brand" label="{!v.translationsMap.Edit}" iconName="action:edit" iconPosition="left"
                                                                      onclick="{!c.showEditSectionAres}" />
                                                </aura:if>
                                                <aura:if isTrue="{!v.isPOCQuote}">
                                                    <lightning:button disabled="{!v.DealSupportRecord.POC_Conversion_to_Paid_Requested__c}"
                                                                      variant="brand" label="POC Conversion to Paid Requested"
                                                                      onclick="{!c.checkedPOCConversion}" />
                                                </aura:if>
                                                <aura:if isTrue="{!v.showAssignToRCButton}">
                                                    <lightning:button variant="brand" label="{!v.translationsMap.Assign_to_RC}" onclick="{!c.assignToRC}" />
                                                </aura:if>
                                                <aura:if isTrue="{!!v.ShowOnlyALE}">
                                                    <aura:if isTrue="{!and(v.DealSupportRecord.Type__c == 'Discount Request',v.ShowOnlyAvaya)}">
                                                        <!--<aura:if isTrue="{!$Label.c.AVAYACLOUDOFFICE == v.partnerCommunity}">
                                                 <lightning:button variant="brand" label="Assign to Avaya Deal Desk" onclick="{!c.assignToAvayaDealDesk}" disabled="{!v.DealSupportRecord.Escalated_To_Avaya_Deal_Desk__c}"/>
                                             </aura:if>
                                             <aura:if isTrue="{!$Label.c.AVAYACLOUDOFFICE != v.partnerCommunity}">-->
                                                        <lightning:button variant="brand"
                                                                          label="{!v.communityDetailsRecord.Portal_Assign_To_Deal_Desk_Label__c}"
                                                                          onclick="{!c.assignToAvayaDealDesk}"
                                                                          disabled="{!v.DealSupportRecord.Escalated_To_Avaya_Deal_Desk__c}" />
                                                        
                                                    </aura:if>
                                                </aura:if>
                                                <!--<lightning:button variant="brand" label="Test" title="Brand action" onclick="{! c.handleClick }" />-->
                                                <aura:if isTrue="{!and(v.DealSupportRecord.Type__c == 'Discount Request', v.ShowConAcc)}">
                                                    <lightning:button variant="brand" label="{!v.translationsMap.Approve}" iconName="action:check" iconPosition="left"
                                                                      aura:id="Approve" onclick="{!c.changeQuoteStatus}" />
                                                                                 <!--<Added rejectionJustification for 4698>-->
                                                    <lightning:button variant="brand" label="{!v.translationsMap.Reject}" iconName="action:close" iconPosition="left"
                                                                      aura:id="Reject" onclick="{!c.rejectionJustification}"/>
                                                    
                                                </aura:if>                                                
                                            </div>
                                        </aura:if>
                                    </aura:if>
                                </aura:if>
                            </aura:if>
                             <!-- BZS-4698 begins -->
                            <aura:if isTrue="{!v.showModal}">
                                <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" 
                                         aria-modal="true" aria-describedby="modal-content-id-1" 
                                         class="slds-modal slds-fade-in-open">
                                    <div class="slds-modal__container">
                                        <!--Modal/Popup Box Body Starts here-->
                                        <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                                            <div class="slds-col slds-size_3-of-7 slds-p-horizontal_x-small slds-p-top_large" style="color:gray;">
                                                <span  aura:id="rejectionReasonLabel" >Justification for Rejection</span>
                                            </div>
                                            <div class="slds-col slds-size_3-of-7 slds-p-horizontal_x-small">
                                                <lightning:textarea type="text"   name="rejectionreason" aura:id="rejectionReason"   value="{!v.JustificationForRejection}"/>
                                            </div>
                                        </div>
                                        <!--Modal/Popup Box Footer Starts here-->
                                        <footer class="slds-modal__footer">
                                            <lightning:button variant="neutral"
                                                              label="Cancel"
                                                              title="Cancel"
                                                              onclick="{! c.hideModel }"/>
                                            <lightning:button variant="brand"
                                                              label="Save"
                                                              title="Save"
                                                              onclick="{!c.changeQuoteStatus}"/>
                                        </footer>
                                    </div>
                                </section>
                                <div class="slds-backdrop slds-backdrop_open"></div>
                            </aura:if>
                            <!-- BZS-4698 ends -->
                            <div class="slds-grid slds-wrap">
                                <aura:if isTrue="{!v.ShowEditSection}">
                                    <div class="slds-col slds-size_2-of-7">
                                        <span></span>
                                    </div>
                                    <div class="slds-col slds-size_1-of-7 slds-p-horizontal_x-small slds-p-top_large" style="color:gray;">
                                        <span class="slds-float_right">{!v.translationsMap.Status}</span>
                                    </div>
                                    <div class="slds-col slds-size_2-of-7 slds-p-horizontal_x-small">
                                        <lightning:select name="SupportStatus" variant="label-hidden" aura:id="SupportStatus"
                                                          value="{!v.selectedStatusValue}" onchange="{!c.onChangeOfStatus}">
                                            <option value="New">{!v.translationsMap.New}</option>
                                            <option value="In Progress">{!v.translationsMap.In_Progress}</option>
                                            <option value="Ready for Signature">{!v.translationsMap.Ready_for_Signature}</option>
                                            <option value="Signature Complete">{!v.translationsMap.Signature_Complete}</option>
                                            <option value="Closed-Approved">{!v.translationsMap.Closed_Approved}</option>
                                            <option value="Closed-Rejected">{!v.translationsMap.Closed_Rejected}</option>
                                            <option value="Closed">{!v.translationsMap.Closed}</option>
                                        </lightning:select>
                                    </div>
                                    <div class="slds-col slds-size_2-of-7">
                                        <span></span>
                                    </div>
                                    <div class="slds-col slds-size_2-of-7">
                                        <span></span>
                                    </div>
                                    <aura:if isTrue="{!v.DealSupportRecord.Type__c=='Discount Request'}">
                                        <div class="slds-col slds-size_1-of-7 slds-p-horizontal_x-small slds-p-top_large"
                                             style="color:gray;">
                                            <span class="slds-float_right requiredField" aura:id="discountLabel">{!v.translationsMap.Approved_Discount}</span>
                                        </div>
                                        <div class="slds-col slds-size_2-of-7 slds-p-horizontal_x-small">
                                            <lightning:input class="discountInput" fieldName="Discount" required="true" aura:id="discount"
                                                             value="{!v.Discount}" type="number" max="100" />
                                        </div>
                                        <div class="slds-col slds-size_2-of-7">
                                            <span></span>
                                        </div>
                                    </aura:if>
                                     <!-- BZS-4698 begins -->
                                    <aura:if isTrue="{!v.DealSupportRecord.Type__c != 'Discount Request'}">
                                        <aura:if isTrue="{!and(v.ShowOnlyAtos,v.selectedStatusValue=='Closed-Rejected')}">
                                            <div class="slds-col slds-size_1-of-7 slds-p-horizontal_x-small slds-p-top_large" style="color:gray;">
                                                <span class="slds-float_right" aura:id="rejectionReasonLabel" ><span>Justification for Rejection</span></span>
                                            </div>
                                            <div class="slds-col slds-size_2-of-7 slds-p-horizontal_x-small">
                                                <lightning:textarea type="text"   name="rejectionreason" aura:id="rejectionReason"   value="{!v.JustificationForRejection}"/>
                                            </div>
                                            <div class="slds-col slds-size_2-of-7">
                                                <span></span>
                                            </div>
                                        </aura:if>
                                    </aura:if>
                  <!-- BZS-4698 ends -->
                                    <aura:if isTrue="{!v.DealSupportRecord.Type__c == 'Discount Request'}">
                                        <aura:if isTrue="{!and(v.ShowOnlyAtos,v.selectedStatusValue=='Closed-Rejected')}">
                                            <div class="slds-col slds-size_3-of-7 slds-p-horizontal_x-small slds-p-top_large" style="color:gray;">
                                                <span class="slds-float_right" aura:id="rejectionReasonLabel" ><span>Justification for Rejection</span></span>
                                            </div>
                                            <div class="slds-col slds-size_2-of-7 slds-p-horizontal_x-small">
                                                <lightning:textarea type="text"   name="rejectionreason" aura:id="rejectionReason"   value="{!v.JustificationForRejection}"/>
                                            </div>
                                            <div class="slds-col slds-size_2-of-7">
                                                <span></span>
                                            </div>
                                        </aura:if>
                                    </aura:if>
                                    <!-- BZS-4698 ends -->
                                    <aura:if
                                             isTrue="{!and(v.DealSupportRecord.Type__c=='Initial Order',v.DealSupportRecord.Brand_Name__c == 'Avaya Cloud Office')}">
                                        <div class="slds-col slds-size_1-of-7  slds-p-top_medium" style="color:gray;">
                                            <span class="slds-float_right">
                                                <!--aura:if isTrue="{!v.ShowOnlyAvaya}">Avaya</aura:if-->Avaya ProServ
                                            </span>
                                        </div>
                                        <div class="slds-col slds-size_2-of-7 slds-p-horizontal_x-small slds-p-top_medium">
                                            <lightning:input fieldName="partnerProServ" aura:id="partnerProServ" value="{!v.availProServ}"
                                                             checked="{!v.availProServ}" type="checkbox" />
                                        </div>
                                    </aura:if>
                                    <div class="slds-col slds-size_2-of-7">
                                        <span></span>
                                    </div>
                                    
                                    <div
                                         class="slds-form-element slds-form-element_horizontal slds-align_absolute-center slds-p-around_medium"
                                         style="border-bottom:.25rem !important;">
                                        <lightning:button variant="brand" label="{!v.translationsMap.Save}" name="Save" type="button" iconName="action:check"
                                                          iconPosition="left" onclick="{!c.editDealSupport}" />
                                        <lightning:button variant="brand" type="Cancel" name="Cancel" iconName="action:close"
                                                          iconPosition="left" label="{!v.translationsMap.Cancel}" onclick="{!c.cancelEditDealSupport}" />
                                    </div>
                                </aura:if>
                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                    <span>{!v.translationsMap.Name}</span>
                                </div>
                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                    <span>{!v.DealSupportRecord.Name}</span>
                                </div>
                                <div class="slds-col slds-size_1-of-7">
                                    <span></span>
                                </div>
                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small alignRight" style="color:gray;">
                                    <span>{!v.translationsMap.Customer_Account}</span>
                                </div>
                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small">
                                    <span>
                                        <!--<a href="{!'/partner/s/partnercustomers?id='+v.DealSupportRecord.Customer_Account__c}">
                                    {!v.DealSupportRecord.Customer_Account__r.Name}
                                    </a>-->
                                        <a href="{!v.CustomerURLLink  +v.DealSupportRecord.Customer_Account__c}">
                                            {!v.DealSupportRecord.Customer_Account__r.Name}
                                        </a>
                                    </span>
                                </div>
                                <aura:if isTrue="{!or(v.ShowConAcc,v.isSingleLogin)}">
                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                                         style="color:gray;">
                                        <span>{!v.translationsMap.Partner_Account}</span>
                                    </div>
                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                        <span>
                                            <!--<a href="{!'/partner/s/partnerdetails?id='+v.DealSupportRecord.Partner_Account__c}">
                                        {!v.DealSupportRecord.Partner_Account__r.Name}
                                        </a>-->
                                            <a href="{!v.PartnerURLLink +v.DealSupportRecord.Partner_Account__c}">
                                                {!v.DealSupportRecord.Partner_Account__r.Name}
                                            </a>
                                        </span>
                                    </div>
                                    <div class="slds-col slds-size_1-of-7 slds-border_top">
                                        <span></span>
                                    </div>
                                    <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                                         style="color:gray;">
                                        <span>{!v.translationsMap.Partner_Contact}</span>
                                    </div>
                                    <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                        <span>{!v.DealSupportRecord.Partner_Contact__r.FirstName}{!v.DealSupportRecord.Partner_Contact__r.LastName}</span>
                                    </div>
                                    
                                </aura:if>
                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                                     style="color:gray;">
                                    <span>{!v.translationsMap.Type}</span>
                                </div>
                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                    <span>{!v.TypeValueTranslation}</span>
                                </div>
                                <div class="slds-col slds-size_1-of-7 slds-border_top">
                                    <span></span>
                                </div>
                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                                     style="color:gray;">
                                    <span>{!v.translationsMap.Status}</span>
                                </div>
                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                    <span>{!v.StatusValueTranslation}</span>
                                </div>
                                
                                <div class="slds-col slds-size_1-of-7 slds-p-around_x-small slds-border_top alignRight"
                                     style="color:gray;">
                                    <span>{!v.translationsMap.Opportunity}</span>
                                </div>
                                <div class="slds-col slds-size_2-of-7 slds-p-around_x-small slds-border_top">
                                    <span>
                                        <!--<a href="{!'/partner/s/partneropportunities?id='+v.DealSupportRecord.Opportunity__c}">
                                    {!v.DealSupportRecord.Opportunity__r.Name}
                                    </a>-->
                                        <a href="{!v.OpportunityURLLink +v.DealSupportRecord.Opportunity__c}">
                                            {!v.DealSupportRecord.Opportunity__r.Name}
                                        </a>
                                    </span>
                                </div>
                                <div class="slds-col slds-size_1-of-7 slds-border_top">
                                    <span></span>
