<design:component label="SC Topic">
    <design:attribute name="title" label="Title" />
    <design:attribute name="count" label="Lines count" min="1" max="10" required="true"/>
    <design:attribute name="place" label="Place" datasource="Trending,Top" default="Trending" required="true" />
    <design:attribute name="targetAttr" label="Target" datasource="Tab,Here" default="Tab" />
    <design:attribute name="viewall" label="View all link" />
</design:component>