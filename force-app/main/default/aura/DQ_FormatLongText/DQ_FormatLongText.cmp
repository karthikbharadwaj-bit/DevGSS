<aura:component>
	<aura:attribute name='description' type='String' />
    <aura:attribute name='multiReason' type='List' />
    <aura:attribute name='approvalStepId' type='String' />
                    
	<aura:attribute name='descriptionValue' type="string" access='private' />
	<aura:handler name="change" value="{!v.description}" action="{!c.handleDescriptionChange}"/>
	<aura:handler name="init" value="{!this}" action="{!c.handleDescriptionChange}" />
	
	<!--<aura:if isTrue="{!v.multiReason}"> 
        <aura:iteration items="{!v.multiReason}" var='eachReason'>
        	<lightning:formattedRichText value="{!eachReason.approvalReason}"></lightning:formattedRichText>
        </aura:iteration>
        <aura:set attribute="else">
        	<lightning:formattedRichText value="{!v.descriptionValue}"></lightning:formattedRichText>
        </aura:set>
    </aura:if>
	-->
	
	<lightning:formattedRichText value="{!v.descriptionValue}"></lightning:formattedRichText>

</aura:component>