<aura:event type="APPLICATION" description="Event occurs when one of filters is changed">
    <!-- Service -->
    <aura:attribute name="Brand" type="String"/>
    <aura:attribute name="Service" type="String"/>
    <aura:attribute name="Edition" type="String"/>
    <aura:attribute name="Lines" type="Integer"/>
    <aura:attribute name="Plan" type="String"/>
    <!-- Product -->
    <aura:attribute name="ProductName" type="String"/>
    <aura:attribute name="ProductPlan" type="String"/>
    <aura:attribute name="Family" type="String"/>
    <aura:attribute name="Type" type="String"/>
    <aura:attribute name="ProductEdition" type="String"/>
    <aura:attribute name="ProductNumberOfSeats" type="String"/>
</aura:event>