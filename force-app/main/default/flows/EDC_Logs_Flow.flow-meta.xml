<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>This is to create and uodate EDC Logs when the Proserv Project record is created.</description>
        <name>Decision_1</name>
        <label>Decision for Proserv Project and EDC Logs</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Proserv_Project</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FormulaForCreateCheck</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_EDC_Logs_1</targetReference>
            </connector>
            <label>New Proserv Project</label>
        </rules>
        <rules>
            <name>Updated_ProServ_Project</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Current_Estimated_Date_of_Completion__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_EDC_Logs_2</targetReference>
            </connector>
            <label>Updated ProServ Project</label>
        </rules>
    </decisions>
    <description>Migrated from Process Bilder to Flow: Auto trigger based on value change in ‘Current Estimated Date of Completion’ date.</description>
    <environments>Default</environments>
    <formulas>
        <name>FormulaForCreateCheck</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISNEW(), NOT(ISBLANK({!$Record.Current_Estimated_Date_of_Completion__c}) ) )</expression>
    </formulas>
    <formulas>
        <name>FormulaForEDCFrom</name>
        <dataType>Date</dataType>
        <expression>PRIORVALUE({!$Record.Current_Estimated_Date_of_Completion__c})</expression>
    </formulas>
    <interviewLabel>EDC Logs {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EDC Logs Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_EDC_Logs_1</name>
        <label>Create EDC Logs 1</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>EDC_From__c</field>
            <value>
                <elementReference>$Record.Current_Estimated_Date_of_Completion__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EDC_To__c</field>
            <value>
                <elementReference>$Record.Current_Estimated_Date_of_Completion__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Modified_by__c</field>
            <value>
                <elementReference>$Record.LastModifiedById</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PM_Name__c</field>
            <value>
                <elementReference>$Record.ProServProjectManager__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ProServ_Project__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reason_for_Change_of_Date__c</field>
            <value>
                <elementReference>$Record.ProjectStatusSummary__c</elementReference>
            </value>
        </inputAssignments>
        <object>EDC_Logs__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_EDC_Logs_2</name>
        <label>Create EDC Logs 2</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>EDC_From__c</field>
            <value>
                <elementReference>FormulaForEDCFrom</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EDC_To__c</field>
            <value>
                <elementReference>$Record.Current_Estimated_Date_of_Completion__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Modified_by__c</field>
            <value>
                <elementReference>$Record.LastModifiedById</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PM_Name__c</field>
            <value>
                <elementReference>$Record.ProServProjectManager__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ProServ_Project__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reason_for_Change_of_Date__c</field>
            <value>
                <elementReference>$Record.ProjectStatusSummary__c</elementReference>
            </value>
        </inputAssignments>
        <object>EDC_Logs__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_1</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Current_Estimated_Date_of_Completion__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ProServ_Project__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
