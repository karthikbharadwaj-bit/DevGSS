    <formulas>
        <name>cdpenrollEmailId</name>
        <dataType>String</dataType>
        <expression>IF(
CONTAINS({!orgAccountLink}, &apos;sandbox&apos;), 
&apos;cdpenrollment@ringcentral.com.invalid&apos;,
&apos;cdpenrollment@ringcentral.com&apos;
 )</expression>
    </formulas>
    <formulas>
