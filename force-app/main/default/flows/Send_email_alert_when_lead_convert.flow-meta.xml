        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_RC_ProServices_Install</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Installation_Service_Provider__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>RC ProServices Install</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RC_ProServices_Install</targetReference>
            </connector>
            <label>Is RC ProServices Install</label>
        </rules>
