            <targetReference>Update_Case</targetReference>
        </connector>
        <filterFormula>{!$Record.RecordType.DeveloperName} = &apos;Close_Loop_Feedback_Medallia_Relationship&apos; || {!$Record.RecordType.DeveloperName} = &apos;Close_Loop_Feedback_Medallia_SupportSurvey&apos;</filterFormula>
