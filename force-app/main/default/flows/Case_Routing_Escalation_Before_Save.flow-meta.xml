    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>myRule_15</targetReference>
        </connector>
        <filterFormula>   ( {!$Record.RecordTypeId} = {!$Label.CaseRT_Internal_Business_Services_Id}
     &amp;&amp; ( ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;SalesOps&quot;)
       || ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;SOED&quot;) )
     &amp;&amp; ( ISNEW()
       || ISCHANGED({!$Record.Support_Escalate_To__c})
       || ISCHANGED({!$Record.RecordTypeId}) ) )
|| ( ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;Contact Center Support&quot;)
     &amp;&amp; ( ISNEW() || NOT(ISPICKVAL({!$Record__Prior.Support_Escalate_To__c}, &quot;Contact Center Support&quot;)) ) )
|| ( ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;Technical Account Engineering&quot;)
     &amp;&amp; NOT({!$Record.IsClosed}) &amp;&amp; ({!$Record.RecordType.DeveloperName} = &quot;Support_T2&quot;)
     &amp;&amp; ( ISNEW()
       || ISCHANGED({!$Record.Support_Escalate_To__c})
       || ISCHANGED({!$Record.RecordTypeId})
       || ISCHANGED({!$Record.Status}) ) )</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
