    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>myRule_3</targetReference>
        </connector>
        <filterFormula>{!$Record.RecordTypeId} = {!$Label.CaseRT_Collections_Id}
&amp;&amp; (
     ISPICKVAL({!$Record.Status}, &quot;Closed&quot;)
  || (ISPICKVAL({!$Record.Status}, &quot;Resolved&quot;) &amp;&amp; ISCHANGED({!$Record.OwnerId}))
  || (
       (
            ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;SOED&quot;)
         || ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;Professional Services&quot;)
         || ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;Sales&quot;)
         || ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;CSM&quot;)
         || ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;Billing&quot;)
         || ISPICKVAL({!$Record.Support_Escalate_To__c}, &quot;Collections&quot;)
       )
       &amp;&amp; (
            ISNEW()
         || ISCHANGED({!$Record.Support_Escalate_To__c})
         || ISCHANGED({!$Record.RecordTypeId})
       )
     )
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
