{!$Record.medallia_xm__Account_Id__c},
CASESAFEID({!$Record.Account_Name_Medallia_Response__r.Id}))</expression>
    </formulas>
    <formulas>
        <name>Is_CSM_Managed</name>
        <dataType>Boolean</dataType>
        <expression>IF(AND(NOT(ISBLANK({!$Record.medallia_xm__Contact_Id__r.Account.CSM__c})),NOT(CONTAINS({!$Label.medallia_CSM_Queue},{!$Record.medallia_xm__Contact_Id__r.Account.CSM_Name__c}))),TRUE,FALSE)</expression>
    </formulas>
    <formulas>
        <name>OwnerID</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.medallia_xm__Contact_Id__r.Account.CSM__c })), {!$Record.medallia_xm__Contact_Id__r.Account.CSM__c}, 
  IF(NOT(ISBLANK({!$Record.medallia_xm__Contact_Id__r.Account.Current_Owner__c })), {!$Record.medallia_xm__Contact_Id__r.Account.Current_Owner__c}, 
    IF(NOT(ISBLANK({!$Record.medallia_xm__Contact_Id__r.Account.OwnerId })), {!$Record.medallia_xm__Contact_Id__r.Account.OwnerId}, 
       &apos;00G2H000003qWbpUAE&apos;)))</expression>
    </formulas>
    <formulas>
        <name>OwnerID_SupportSurvey</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISNULL({!Case_Owner_Manager.Id})) &amp;&amp; NOT(ISBLANK({!Case_Owner_Manager.Id})), 
  {!Case_Owner_Manager.Id},
  IF(
    NOT(ISNULL({!Support_Owner_Manager.Id})) &amp;&amp; NOT(ISBLANK({!Support_Owner_Manager.Id})),
    {!Support_Owner_Manager.Id}, 
    IF(
      NOT(ISBLANK({!$Record.medallia_xm__Contact_Id__r.Account.CSM__c} )) &amp;&amp; {!$Record.medallia_xm__Original_case_Number__r.Account.CSM__r.IsActive}, 
      {!$Record.medallia_xm__Contact_Id__r.Account.CSM__c}, 
      IF(
        NOT(ISBLANK({!$Record.medallia_xm__Contact_Id__r.Account.Current_Owner__c })) &amp;&amp; {!$Record.medallia_xm__Original_case_Number__r.Account.Current_Owner__r.IsActive}, 
        {!$Record.medallia_xm__Contact_Id__r.Account.Current_Owner__c}, 
        IF(
          NOT(ISBLANK({!$Record.medallia_xm__Contact_Id__r.Account.OwnerId} )) &amp;&amp; {!$Record.medallia_xm__Original_case_Number__r.Account.Owner.IsActive},
           {!$Record.medallia_xm__Contact_Id__r.Account.OwnerId}, 
          &apos;00G2H000003qWbpUAE&apos;
        )
      )
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>Relationship_Case_Owner_Id</name>
        <dataType>String</dataType>
        <expression>IF( ({!$Record.medallia_xm__Contact_Id__r.Account.MRR__c} * 12) &lt; 1000,{!Get_CERT_Queue.Id}, {!Get_Closed_Loop_Team_Queue.Id} )</expression>
    </formulas>
