        <rules>
            <name>Condition_for_Create_Case_for_Support_Survey</name>
            <conditionLogic>((1 AND 5) OR (3 AND 6) OR 4) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.How_likely_to_recommend_RingCentral__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>6.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.medallia_xm__Survey_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Support Survey</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.How_satisfied_with_Technical_Support__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.How_many_times_did_you_contact_support__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>My issue is still not resolved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.How_likely_to_recommend_RingCentral__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.How_satisfied_with_Technical_Support__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Get_Support_Survey_Record_Type_ID</targetReference>
            </connector>
            <label>Condition for Create Case for Support Survey</label>
        </rules>
