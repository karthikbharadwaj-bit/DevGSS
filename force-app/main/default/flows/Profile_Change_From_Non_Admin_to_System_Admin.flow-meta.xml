        <locationY>619</locationY>
        <assignmentItems>
            <assignToReference>UserName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Username</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Var_UsersName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Full_Name__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Var_oldProfile</assignToReference>
