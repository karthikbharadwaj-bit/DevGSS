        <label>If_SysAdmin</label>
        <locationX>279</locationX>
        <locationY>412</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_SysAdmin0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>System Administrator</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>VarsAssignment</targetReference>
            </connector>
            <label>Is_SysAdmin0</label>
        </rules>
    </decisions>
    <description>This flow is to notify when the profile is changed from Non Admin to System Admin.</description>
    <environments>Default</environments>
    <interviewLabel>Profile Change From Non Admin to System Admin {!$Flow.CurrentDateTime}</interviewLabel>
