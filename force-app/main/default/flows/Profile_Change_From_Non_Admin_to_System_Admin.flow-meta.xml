        <label>Profile changed</label>
        <locationX>587</locationX>
        <locationY>619</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>crm.escalations@ringcentral.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>User : {!$User.Full_Name__c} changed profile of {!Var_UsersName} to System Administrator.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Hello Team, Username: {!UserName} user&apos;s profile changed from {!Var_oldProfile} to System Administrator on {!Var_Time}. </stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>58.0</apiVersion>
