            </connector>
            <label>Case Status Closed</label>
        </rules>
    </decisions>
    <formulas>
        <name>addEmailToComment</name>
        <dataType>String</dataType>
        <expression>&apos;Escalation request on Case &apos; &amp; {!caseQuery.CaseNumber} &amp; &apos; in &apos; &amp; {!caseQuery.RecordType.Name} &amp; &apos; submitted by &apos; &amp; {!$User.Full_Name__c} &amp; &apos;,&apos; &amp; br() &amp;
br() &amp;
&apos;Current Case owner: &apos; &amp; {!caseQuery.Owner:User.Full_Name__c}&amp; br() &amp;
&apos;Case Severity: &apos; &amp; TEXT({!caseQuery.Case_Severity__c}) &amp; br() &amp;
&apos;Case Opened: &apos; &amp; TEXT({!caseQuery.CreatedDate}) &amp; br() &amp;
&apos;Case Record Type: &apos; &amp; {!caseQuery.RecordType.Name} &amp; br() &amp;
&apos;Case Owner Manager: &apos; &amp; {!caseQuery.Owner:User.Manager.Full_Name__c} &amp; br() &amp;
&apos;Escalation Business Justification: &apos; &amp; br() &amp;
{!Case_Comment}</expression>
    </formulas>
    <formulas>
        <name>caseCreatedDate</name>
        <dataType>Number</dataType>
        <expression>(NOW() - {!caseQuery.CreatedDate}) * 24 * 60</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>emailRecipients</name>
        <dataType>String</dataType>
        <expression>{!caseQuery.Owner:User.Email} + &quot;,&quot; + {!caseQuery.Owner:User.Manager.Email} + &quot;,&quot; + &quot;supportescalations@ringcentral.com&quot;</expression>
    </formulas>
    <formulas>
