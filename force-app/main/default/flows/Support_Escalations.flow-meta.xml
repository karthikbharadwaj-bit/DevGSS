            </connector>
            <label>Case Status Open</label>
        </rules>
        <rules>
            <name>Case_Status_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseQuery.IsClosed</leftValueReference>
