    <decisions>
        <name>Case_created_date_is_equal_or_greater_30</name>
        <label>Case created date is equal or greater 30</label>
        <locationX>403</locationX>
        <locationY>422</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>equalorgreater30mins</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseCreatedDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Escalate_Case_Comment</targetReference>
            </connector>
            <label>equalorgreater30mins</label>
        </rules>
        <rules>
            <name>less30mins</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseCreatedDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Created_Date_is_Less_30_mins</targetReference>
            </connector>
            <label>less30mins</label>
        </rules>
    </decisions>
    <decisions>
        <name>Case_is_Closed</name>
