        <name>checkifrecordiscreatedorupdated</name>
        <dataType>Boolean</dataType>
        <expression>(ISNEW() || ISCHANGED({!$Record.Carrier_Seller_Email__c}) || ISCHANGED({!$Record.Account__c}))</expression>
    </formulas>
