<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Capture Snapshot details on creation of Executive Outreach Activity.</description>
    <environments>Default</environments>
    <formulas>
        <name>AccountCurrentOwnerValue</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account__r.Current_Owner__r.FirstName} + &quot; &quot; + {!$Record.Account__r.Current_Owner__r.LastName}</expression>
    </formulas>
    <formulas>
        <name>AccountExecutiveOwnerValue</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account__r.Executive_Owner__r.FirstName} + &quot; &quot; + {!$Record.Account__r.Executive_Owner__r.LastName}</expression>
    </formulas>
    <interviewLabel>Snapshot Account Details to EOA {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Snapshot Account Details to EOA Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Fields_from_Account</name>
        <label>Update Fields from Account</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>Account_Current_Owner__c</field>
            <value>
                <elementReference>AccountCurrentOwnerValue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account_Executive_Owner__c</field>
            <value>
                <elementReference>AccountExecutiveOwnerValue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Account_MRR__c</field>
            <value>
                <elementReference>$Record.Account__r.MRR__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Fields_from_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account_Current_Owner__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>Account_Executive_Owner__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <object>Executive_Outreach_Activity__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
