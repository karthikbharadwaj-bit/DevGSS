    <formulas>
        <name>ACOFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Case_Category__c}, &quot;ACO&quot;) 
&amp;&amp;(
OR(ISNEW(),
ISCHANGED({!$Record.Case_Category__c})))</expression>
    </formulas>
    <formulas>
        <name>BTBusinessPortalNewWebCaseFormula</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    ISNEW(),
    {!$Record.Brand_Account__c} = &quot;BT Business&quot;,
    CONTAINS(
        {!$CustomMetadata.BT_Case_Record_Types__mdt.BT_Case_Creation.BT_Record_Types__c},
        {!$Record.RecordType.DeveloperName}
    )
)</expression>
    </formulas>
    <formulas>
        <name>CustomEngineeringFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Case_Category__c} ,&quot;Custom Engineering&quot;)
&amp;&amp;(
OR(ISNEW(),
ISCHANGED({!$Record.Case_Category__c})))</expression>
    </formulas>
    <formulas>
        <name>CustomerPortalNewWebCasenotificationFormula</name>
        <dataType>Boolean</dataType>
        <expression>AND ( ISNEW() ,{!$Record.Original_RecordType__c} = &quot;Support_Case&quot;, ISPICKVAL( {!$Record.Origin} , &quot;Web&quot;) )</expression>
    </formulas>
    <formulas>
        <name>IgniteFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Case_Category__c} ,&quot;Ignite&quot;)
&amp;&amp;(
OR(ISNEW(),
ISCHANGED({!$Record.Case_Category__c})))</expression>
    </formulas>
    <formulas>
        <name>RCAppsFormula</name>
        <dataType>Boolean</dataType>
        <expression>(OR(ISPICKVAL({!$Record.Case_Category__c} ,&quot;RC APPS: ISV Engagement&quot;),
ISPICKVAL({!$Record.Case_Category__c} ,&quot;RC APPS: Post-Sales&quot;),
ISPICKVAL({!$Record.Case_Category__c} ,&quot;RC APPS: Pre-Sales&quot;),
ISPICKVAL({!$Record.Case_Category__c} ,&quot;RC APPS - CX&quot;),
ISPICKVAL({!$Record.Case_Category__c} ,&quot;RC APPS - UC&quot;)))
&amp;&amp;(
OR(ISNEW(),
ISCHANGED({!$Record.Case_Category__c})))</expression>
    </formulas>
    <formulas>
        <name>RCSecurityFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.Case_Category__c} ,&quot;RC Security&quot;)
&amp;&amp;(
OR(ISNEW(),
ISCHANGED({!$Record.Case_Category__c})))</expression>
    </formulas>
    <formulas>
        <name>SMSEnablementCaseNotificationFormula</name>
