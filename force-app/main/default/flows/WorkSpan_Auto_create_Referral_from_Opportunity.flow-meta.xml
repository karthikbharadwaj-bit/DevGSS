NOT(OR({!$Record.Account.Segment_Name__r.Name} = &quot;SOHO&quot;, {!$Record.Account.Segment_Name__r.Name} = &quot;Small Business&quot;)),


NOT(
OR(
ISPICKVAL({!$Record.Account.Current_Owner__r.SegmentPicklist__c}, &quot;SOHO&quot;), 
ISPICKVAL({!$Record.Owner.SegmentPicklist__c}, &quot;SOHO&quot;),
ISPICKVAL({!$Record.Account.Current_Owner__r.SegmentPicklist__c}, &quot;Small Business&quot;), 
ISPICKVAL({!$Record.Owner.SegmentPicklist__c}, &quot;Small Business&quot;))

)
)</filterFormula>
