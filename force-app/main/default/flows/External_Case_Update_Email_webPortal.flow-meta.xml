    <formulas>
        <name>AlternateEmail</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Parent.Alternate_Email__c})),
    {!$Record.Parent.Alternate_Email__c},
    &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>Brand_Account_Lower</name>
        <dataType>String</dataType>
        <expression>LOWER({!$Record.Parent.Brand_Account__c})</expression>
    </formulas>
    <formulas>
        <name>ContactEmail</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!$Record.Parent.ContactId})),
        NOT(ISBLANK({!$Record.Parent.Contact.Email}))
    ),
    {!$Record.Parent.Contact.Email},
    &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>CSMEmail</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        {!$Record.Parent.IsEscalated},
        NOT(ISBLANK({!$Record.Parent.AccountId})),
        NOT(ISBLANK({!$Record.Parent.Account.CSM__c})),
        NOT(ISBLANK({!$Record.Parent.Account.CSM__r.Email}))
    ),
    {!$Record.Parent.Account.CSM__r.Email},
    &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <description>Email Addresses</description>
        <name>Email_Addresses</name>
        <dataType>String</dataType>
        <expression>{!IF(AND(NOT(ISBLANK($Record.Parent.ContactId)), NOT(ISBLANK($Record.Parent.Contact.Email))),
    $Record.Parent.Contact.Email + &quot;,&quot;,
    &quot;&quot;
)} +
{!IF(NOT(ISBLANK($Record.Parent.Alternate_Email__c)),
    $Record.Parent.Alternate_Email__c + &quot;,&quot;,
    &quot;&quot;
)} +
$Record.Parent.Owner:User.Email</expression>
    </formulas>
    <formulas>
        <name>Email_Body</name>
        <dataType>String</dataType>
        <expression>&apos;Case Number: &apos; + {!$Record.Parent.CaseNumber} +
BR() + &apos;Case Subject: &apos; + {!$Record.Parent.Subject} +
BR() + &apos;Case Created Date: &apos; + {!Formatted_Date} +
BR() + &apos;Account Name: &apos; + {!IF(NOT(ISBLANK($Record.Parent.AccountId)), $Record.Parent.Account.Name, Null)} +
BR() + &apos;Contact Name: &apos; + {!IF(NOT(ISBLANK($Record.Parent.ContactId)), $Record.Parent.Contact.firstName + &quot; &quot; + $Record.Parent.Contact.lastName, Null)} +
BR() + &apos;---------------------------------------------------------------------------------------&apos; +
BR() + BR() + &apos;Product Area: &apos; + {!TEXT($Record.Parent.Support_Disposition_Level_1__c)}  +
BR() + &apos;Description: &apos; + {!$Record.Parent.Description}  +
BR() + BR() + BR() + &apos;Hello &apos; + {!IF(NOT(ISBLANK($Record.Parent.ContactId)), $Record.Parent.Contact.firstName + &quot; &quot; + $Record.Parent.Contact.lastName, Null)}  + &apos;,&apos; +
BR() + &apos;Your case #&apos; + {!$Record.Parent.CaseNumber} + &apos; has been updated.&apos; +
BR()+ BR() + &apos;Latest Comment:&apos; + BR() +
{!Deserialized_Comment} +
BR() + BR() +BR() + &apos;If you wish to view or post a comment to the case, please log in to the support site here: &apos; + {!$Record.Parent.Customer_Support_Portal_URL__c} +

BR() + BR() + &apos;You can also reply to this email with any updates.&apos; +

BR() + &apos;---------------------------------------------------------------------------------------&apos; +

BR() + BR() + &apos;Please do not remove code reference &apos; + {!$Record.Parent.Thread_ID__c} + &apos; since this is used to track your case.&apos; +

BR() + BR() + {!IF(CONTAINS($Record.Parent.Brand_Account__c, &quot;Canada&quot;),&quot;If we are unable to resolve your dispute, you may contact CCTS. Please see https://www.ringcentral.ca/legal/complaints.html for more information. THIS IS A SYSTEM GENERATED EMAIL, PLEASE DO NOT REPLY.&quot;, Null)}</expression>
    </formulas>
    <formulas>
        <name>Email_Subject</name>
        <dataType>String</dataType>
        <expression>&apos;Your RingCentral Support Case Was Updated – Case #&apos; + {!$Record.Parent.CaseNumber}</expression>
    </formulas>
    <formulas>
        <name>Formatted_Date</name>
        <dataType>String</dataType>
        <expression>{!TEXT(MONTH(DATEVALUE($Record.Parent.CreatedDate)))} + &apos;/&apos; + {!TEXT(DAY(DATEVALUE($Record.Parent.CreatedDate)))} + &apos;/&apos; + {!TEXT(YEAR(DATEVALUE($Record.Parent.CreatedDate)))}</expression>
    </formulas>
    <formulas>
        <name>Has_Addresses</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Email_Addresses}))</expression>
    </formulas>
    <formulas>
