<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Record_Type</name>
        <label>Check Record Type</label>
        <locationX>1016</locationX>
        <locationY>371</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Support_Record_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsSupportRecordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>True</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_to_an_Open_Case</targetReference>
            </connector>
            <label>Support Record Type</label>
        </rules>
    </decisions>
    <description>Sets Case Status to Updated by Customer</description>
    <environments>Default</environments>
    <formulas>
        <name>IsSupportRecordType</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Parent.RecordTypeName__c},
&apos;Customer_Feedback&apos;, &apos;True&apos;,
&apos;Support_Charter_SMB&apos;, &apos;True&apos;,
&apos;Support_Charter&apos;, &apos;True&apos;,
&apos;Support_Avaya&apos;, &apos;True&apos;,
&apos;Support_Ecotel&apos;, &apos;True&apos;,
&apos;Support_Frontier&apos;, &apos;True&apos;,
&apos;Support_DT&apos;, &apos;True&apos;,
&apos;Support_Glip&apos;, &apos;True&apos;,
&apos;Support_Integrations&apos;, &apos;True&apos;,
&apos;RCC_Issues&apos;, &apos;True&apos;,
&apos;Support_T1&apos;, &apos;True&apos;,
&apos;Support_T2&apos;, &apos;True&apos;,
&apos;Support_T1_VAR_Partners&apos;, &apos;True&apos;,
&apos;Reseller_VAR_Partners&apos;, &apos;True&apos;,
&apos;Support_VIPFR&apos;, &apos;True&apos;,
&apos;Support_Case&apos;, &apos;True&apos;,
&apos;Support_Telus&apos;, &apos;True&apos;,
&apos;Support_Chat&apos;, &apos;True&apos;,
&apos;Support_QoS&apos;, &apos;True&apos;,
&apos;False&apos;
)</expression>
    </formulas>
    <interviewLabel>Incoming Message from Customer {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Incoming Message from Customer</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Email_to_an_Open_Case</name>
        <label>Email to an Open Case</label>
        <locationX>1016</locationX>
        <locationY>563</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Updated by Customer</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>CNR_Status__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Updated by Customer</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>890</locationX>
        <locationY>51</locationY>
        <connector>
            <targetReference>Check_Record_Type</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND({!$Record.Incoming} = TRUE,   NOT(BEGINS({!$Record.Subject}, &quot;Automatic reply:&quot;)))</filterFormula>
        <object>EmailMessage</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
