    <formulas>
        <name>frm_computematchpercentage</name>
        <dataType>Number</dataType>
        <expression>({!var_search_tripcounter}/{!var_search_shortsearchstringssets})*100</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_computematchpercentageseparator</name>
        <dataType>Number</dataType>
        <expression>{!var_search_matchpercentage} + {!var_search_generatedresultscounter}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>frm_countshortsearchstringsets</name>
        <dataType>Number</dataType>
        <expression>LEN({!var_search_basesearchstring})/3</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_countshortsearchstringsleft</name>
        <dataType>Number</dataType>
        <expression>LEN({!var_search_dynamicsearchstring})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_createshortsearchstring</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!var_search_dynamicsearchstring})&lt;&gt;4,
LEFT({!var_search_dynamicsearchstring},3),LEFT({!var_search_dynamicsearchstring},4))</expression>
    </formulas>
    <formulas>
        <name>frm_progresspercentage</name>
        <dataType>Number</dataType>
        <expression>({!var_search_overallloopcounter}/{!var_maxiterations})*100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>frm_removespaces</name>
        <dataType>String</dataType>
        <expression>IF(LEN(SUBSTITUTE({!var_search_basesearchstring},&quot; &quot;,&quot;&quot;))&lt;&gt;4,
IF(MOD(LEN(SUBSTITUTE({!var_search_basesearchstring},&quot; &quot;,&quot;&quot;)),3)&lt;&gt;0,
IF(MOD(LEN(SUBSTITUTE({!var_search_basesearchstring},&quot; &quot;,&quot;&quot;)),3)&lt;&gt;1,
LEFT(SUBSTITUTE({!var_search_basesearchstring},&quot; &quot;,&quot;&quot;),LEN(SUBSTITUTE({!var_search_basesearchstring},&quot; &quot;,&quot;&quot;))-2),
LEFT(SUBSTITUTE({!var_search_basesearchstring},&quot; &quot;,&quot;&quot;),LEN(SUBSTITUTE({!var_search_basesearchstring},&quot; &quot;,&quot;&quot;))-1)),
SUBSTITUTE({!var_search_basesearchstring},&quot; &quot;,&quot;&quot;)),
SUBSTITUTE({!var_search_basesearchstring},&quot; &quot;,&quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>frm_removeusedshortsearchstring</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!var_search_basesearchstring})&lt;&gt;4,
SUBSTITUTE({!var_search_dynamicsearchstring},LEFT({!var_search_dynamicsearchstring},3),&quot;&quot;),SUBSTITUTE({!var_search_dynamicsearchstring},LEFT({!var_search_dynamicsearchstring},4),&quot;&quot;))</expression>
    </formulas>
