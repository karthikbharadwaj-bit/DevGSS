            </connector>
            <label>Case Owner User Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Case_Status_Update</name>
        <label>Case Status Update</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Case_Owner_Change</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Status_Change_updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Case_Comment_for_Status_Change</targetReference>
            </connector>
            <label>Case Status Change updated</label>
        </rules>
    </decisions>
    <description>Rise Partner case comments are removed from this flow and hereafter will be exclusively for AAA Brands</description>
    <environments>Default</environments>
    <formulas>
        <name>CaseComment_for_Owner_Queue</name>
        <dataType>String</dataType>
        <expression>&quot;Case Owner Assigned To&quot;+&quot;:&quot;+{!$Record.Owner:Group.Name}</expression>
    </formulas>
    <formulas>
        <name>CaseComment_for_Owner_User</name>
        <dataType>String</dataType>
        <expression>&quot;Case Owner Assigned To&quot;+&quot;:&quot;+{!$Record.Owner:User.Full_Name__c}</expression>
    </formulas>
    <formulas>
        <name>CaseCommentCreation</name>
        <dataType>String</dataType>
        <expression>&quot;Case Status Updated To&quot;+&quot;:&quot;+TEXT({!$Record.Status})</expression>
    </formulas>
    <interviewLabel>Case Comments Consolidated Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Comments Consolidated Flow</label>
    <processMetadataValues>
