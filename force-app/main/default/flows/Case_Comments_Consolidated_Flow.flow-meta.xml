    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Case_Status_Update</targetReference>
        </connector>
        <filterFormula>AND (NOT(ISBLANK( {!$Record.Account.Id})),NOT(ISBLANK({!$Record.Account.RC_Brand__c})), OR({!$Record.Account.RC_Brand__c}= &quot;Avaya Cloud Office&quot;,
{!$Record.Account.RC_Brand__c} = &quot;Unify Office&quot;,
{!$Record.Account.RC_Brand__c} = &quot;Rainbow Office&quot;,
{!$Record.Account.RC_Brand__c} = &quot;Unify Office by RingCentral&quot;))</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
