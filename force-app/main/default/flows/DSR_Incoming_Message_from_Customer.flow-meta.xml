    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Record_Type</name>
        <label>Check Record Type</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DSR_Request_Record_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Incoming</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>DSRRequestRecordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CaseStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Status</targetReference>
            </connector>
            <label>DSR Request Record Type</label>
        </rules>
    </decisions>
    <description>SR-1658181 Reopen case and alert owner on customer response to closure.</description>
    <environments>Default</environments>
    <formulas>
        <name>CaseOwnerEmail</name>
        <dataType>String</dataType>
        <expression>{!$Record.Parent.Owner:User.Email}</expression>
    </formulas>
    <formulas>
        <name>CaseStatus</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Parent.Status},
&apos;Closed&apos;, &apos;True&apos;,
&apos;Closed - No Response&apos;, &apos;True&apos;,
&apos;Closed - No Contact&apos;, &apos;True&apos;,
&apos;Closed - No Issue&apos;, &apos;True&apos;,
&apos;Closed - Duplicate&apos;, &apos;True&apos;,
&apos;Closed - Endorsed&apos;, &apos;True&apos;,
&apos;False&apos;
)</expression>
    </formulas>
    <formulas>
        <name>DSRRequestRecordType</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Parent.RecordTypeName__c},
&apos;GDPR_Request&apos;, &apos;True&apos;,
&apos;False&apos;
)</expression>
    </formulas>
    <interviewLabel>DSR Incoming Message from Customer {!$Flow.CurrentDateTime}</interviewLabel>
    <label>DSR Incoming Message from Customer</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Case_Status</name>
        <label>Update Case Status</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Send_Email_Notification</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>01234000000M7SKAA0</stringValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Record_Type</targetReference>
        </connector>
        <object>EmailMessage</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>SendEmail</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hi {!$Record.Parent.Owner:User.FirstName},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The customer has responded to {!$Record.Parent.CaseNumber} owned by you and the case has been reopened. Please review the customer’s response and action as appropriate. Please make Privacy aware of any threats of legal action against RingCentral.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!$Record.Parent.Thread_ID__c}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>Subject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>The customer has responded to {!$Record.Parent.CaseNumber} owned by you and the case has been reopened.{!$Record.Parent.Thread_ID__c}</text>
    </textTemplates>
</Flow>
