    <description>F6 - manual Task 10 build replacing the Migrate to Flow donor (quick actions unsupported, G6). P1-P5 first-match priority, one CaseComment per save. P5 verbatim omits the ebonding exclusion (SO-3: port as-is). To exclude Customer EBonded Cases (P1-P4).</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_IsPublished_RT</name>
        <dataType>Boolean</dataType>
        <expression>IF( (({!$Record.Original_RecordType__c} =&apos;Support_Purolator&apos;) || ({!$Record.Original_RecordType__c} =&apos;Support_Charter_SMB&apos;) || ({!$Record.Original_RecordType__c} =&apos;Support_Charter&apos;)) , True, False )</expression>
    </formulas>
    <formulas>
        <name>formula_P1_Body</name>
        <dataType>String</dataType>
        <expression>&quot;Partner Case Status Updated To:&quot;+&quot; &quot;+TEXT({!$Record.Partner_Case_Status__c} )</expression>
    </formulas>
    <formulas>
        <name>formula_P1_Gate</name>
        <dataType>Boolean</dataType>
        <expression>AND (NOT(ISBLANK( {!$Record.AccountId})), NOT( BEGINS(IF(ISBLANK({!$Record.Account.RC_Brand__c}), {!$Record.Brand_Identifier__c}, {!$Record.Account.RC_Brand__c}), &apos;Rise&apos;)), {!$Record.Original_RecordType__c} &lt;&gt; &apos;Support_Customer_ebonding&apos;, ISCHANGED({!$Record.Partner_Case_Status__c}  ),ISBLANK({!$Record.Brand_Identifier__c} ))</expression>
    </formulas>
    <formulas>
        <name>formula_P2_Body</name>
        <dataType>String</dataType>
        <expression>&quot;Case Severity Updated To:&quot;+&quot; &quot;+TEXT({!$Record.Case_Severity__c} )</expression>
    </formulas>
    <formulas>
        <name>formula_P2_Gate</name>
        <dataType>Boolean</dataType>
        <expression>AND (NOT(ISBLANK( {!$Record.AccountId})),NOT( BEGINS(IF(ISBLANK({!$Record.Account.RC_Brand__c}), {!$Record.Brand_Identifier__c}, {!$Record.Account.RC_Brand__c}), &apos;Rise&apos;)), {!$Record.Original_RecordType__c} &lt;&gt; &apos;Support_Customer_ebonding&apos;, ISCHANGED({!$Record.Case_Severity__c}  ),ISBLANK({!$Record.Brand_Identifier__c} ))</expression>
    </formulas>
    <formulas>
        <name>formula_P3_Body</name>
        <dataType>String</dataType>
        <expression>&quot;Case Owner Updated To:&quot;+&quot; &quot;+{!Get_Owner_Queue.Name}</expression>
    </formulas>
    <formulas>
        <name>formula_P3_Gate</name>
        <dataType>Boolean</dataType>
        <expression>AND (NOT(ISBLANK( {!$Record.AccountId})),NOT( BEGINS(IF(ISBLANK({!$Record.Account.RC_Brand__c}), {!$Record.Brand_Identifier__c}, {!$Record.Account.RC_Brand__c}), &apos;Rise&apos;)), {!$Record.Original_RecordType__c} &lt;&gt; &apos;Support_Customer_ebonding&apos;, ISCHANGED({!$Record.OwnerId}  ),ISBLANK({!$Record.Brand_Identifier__c}), BEGINS({!$Record.OwnerId} , &quot;00G&quot;) )</expression>
    </formulas>
    <formulas>
        <name>formula_P4_Body</name>
        <dataType>String</dataType>
        <expression>&quot;Case Owner Updated To:&quot;+&quot; &quot;+{!Get_Owner_User.Full_Name__c}</expression>
    </formulas>
    <formulas>
        <name>formula_P4_Gate</name>
        <dataType>Boolean</dataType>
        <expression>AND (NOT(ISBLANK( {!$Record.AccountId})), NOT( BEGINS(IF(ISBLANK({!$Record.Account.RC_Brand__c}), {!$Record.Brand_Identifier__c}, {!$Record.Account.RC_Brand__c}), &apos;Rise&apos;)), {!$Record.Original_RecordType__c} &lt;&gt; &apos;Support_Customer_ebonding&apos; , ISCHANGED({!$Record.OwnerId}  ),ISBLANK({!$Record.Brand_Identifier__c} ))</expression>
    </formulas>
    <formulas>
        <name>formula_P5_Body</name>
        <dataType>String</dataType>
        <expression>&quot;Status Updated To:&quot;+&quot; &quot;+TEXT({!$Record.Status})</expression>
    </formulas>
    <formulas>
        <name>formula_P5_Gate</name>
        <dataType>Boolean</dataType>
        <expression>AND (NOT(ISBLANK( {!$Record.AccountId})), NOT(BEGINS(IF(ISBLANK({!$Record.Account.RC_Brand__c}), {!$Record.Brand_Identifier__c}, {!$Record.Account.RC_Brand__c}), &apos;Rise&apos;)),   ISCHANGED({!$Record.Status} ),ISBLANK({!$Record.Brand_Identifier__c} ), (({!$Record.Original_RecordType__c} =&apos;Support_Charter_SMB&apos;) || ({!$Record.Original_RecordType__c} =&apos;Support_Charter&apos;)))</expression>
    </formulas>
