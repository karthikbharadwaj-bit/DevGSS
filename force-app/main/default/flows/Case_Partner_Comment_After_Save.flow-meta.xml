    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Priority_P1_P5</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.AccountId}))
&amp;&amp; NOT(BEGINS(IF(ISBLANK({!$Record.Account.RC_Brand__c}), {!$Record.Brand_Identifier__c}, {!$Record.Account.RC_Brand__c}), &quot;Rise&quot;))
&amp;&amp; ISBLANK({!$Record.Brand_Identifier__c})
&amp;&amp; (
     ( {!$Record.Original_RecordType__c} &lt;&gt; &quot;Support_Customer_ebonding&quot;
       &amp;&amp; ( ISCHANGED({!$Record.Partner_Case_Status__c})
         || ISCHANGED({!$Record.Case_Severity__c})
         || ISCHANGED({!$Record.OwnerId}) ) )
  || ( ISCHANGED({!$Record.Status})
       &amp;&amp; ( {!$Record.Original_RecordType__c} = &quot;Support_Charter_SMB&quot;
         || {!$Record.Original_RecordType__c} = &quot;Support_Charter&quot; ) )
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
