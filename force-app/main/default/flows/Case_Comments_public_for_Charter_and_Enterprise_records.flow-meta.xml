    <decisions>
        <name>Check_case_record_type_name</name>
        <label>Check case record type name</label>
        <locationX>182</locationX>
        <locationY>455</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_recordtype_is_Support_Charter_SMB_Or_Support_Charter_Enterprise</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.RecordTypeName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Support_Charter_SMB</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.RecordTypeName__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Support_Charter</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CreatedById</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Integration_services_user_Id.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Make_case_comment_public</targetReference>
            </connector>
            <label>If recordtype is Support - Charter - SMB Or Support _ Charter Enterprise</label>
        </rules>
    </decisions>
