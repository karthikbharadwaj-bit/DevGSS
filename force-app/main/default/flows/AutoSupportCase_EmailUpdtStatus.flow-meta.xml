    <decisions>
        <name>Support_Case_Status_Updated_as_Updated_by_Customer</name>
        <label>Support Case Status Updated as Updated by Customer</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Status_updated_as_Updated_by_Customer</name>
            <conditionLogic>1 AND 2 AND (NOT (3)) AND (4 OR 5) AND  6 AND 7 AND (NOT( 8))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Origin</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Auto-Email</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.RecordType.Id</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>01280000000UJWYAA4</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FromAddress</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>@ringcentral.com</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.Engage_Case_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Digital case - EN</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.Engage_Case_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Digital case - FR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Parent.CNR_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecordTypeList</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Parent.RecordType.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Listofcasestatusvalues</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>$Record.Parent.Status</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_Status_Updated_as_Updated_by_Customer_for_support_Case</targetReference>
            </connector>
            <label>Case Status updated as Updated by Customer</label>
        </rules>
    </decisions>
