    <decisions>
        <description>This is to check the existence of the Account Team Membe with Team Role as &quot;DSA Expansion&quot; and Account Owner as an Expansion Rep.</description>
        <name>Decision_for_User_through_Round_Robin</name>
        <label>Decision for User through Round Robin</label>
        <locationX>666</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Loop_All_Round_Robin_Users</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Add_the_user_as_ATM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Team_Members</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Team_Members.TeamMemberRole</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DSA Expansion</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Finish</targetReference>
            </connector>
            <label>DSA Account Team Member Exists</label>
        </rules>
        <rules>
            <name>No_DSA_Account_Team_Member_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Team_Members</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Accounts.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Loop_All_Round_Robin_Users.DSA_Rep__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_the_Active_RR_Users</targetReference>
            </connector>
            <label>No DSA Account Team Member Exists</label>
        </rules>
        <rules>
            <name>Account_Owner_Equals_ATM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Accounts.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_All_Round_Robin_Users.DSA_Rep__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Footer</targetReference>
            </connector>
            <label>Account Owner Equals ATM</label>
        </rules>
    </decisions>
    <decisions>
        <description>This is check the Stage as &quot;Closed Won&quot; of the Opportunity for the Selected Account.</description>
        <name>Send_Email_Only_when_Opportunity_Exists_on_Account</name>
        <label>Send Email Only when Opportunity Exists on Account</label>
        <locationX>182</locationX>
        <locationY>1274</locationY>
        <defaultConnector>
            <targetReference>Finish_Button</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Email_Only_when_Opportunity_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunities.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>7. Closed Won</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_ATM</targetReference>
            </connector>
            <label>Send Email Only when Opportunity Exists</label>
        </rules>
    </decisions>
