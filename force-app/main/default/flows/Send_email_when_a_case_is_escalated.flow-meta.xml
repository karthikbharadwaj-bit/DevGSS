    <formulas>
        <name>ContactCenterTAMEmail</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!$Record.AccountId})),
        NOT(ISBLANK({!$Record.Account.Contact_Center_TAM_Updated__c})),
        NOT(ISBLANK({!$Record.Account.Contact_Center_TAM_Updated__r.Email}))
    ),
    {!$Record.Account.Contact_Center_TAM_Updated__r.Email},
    &apos;&apos;
)</expression>
    </formulas>
    <formulas>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <expression>&apos;Case Subject: &apos; + {!$Record.Subject} + 
BR() + &apos;Case Number: &apos; + {!$Record.CaseNumber} +
BR() + &apos;Status: &apos; + TEXT({!$Record.Status}) +
BR() + &apos;Case Owner: &apos; + {!OwnerName}  +
BR() + &apos;Case Severity: &apos; + TEXT({!$Record.Case_Severity__c}) +
BR() + &apos;Case Description: &apos; + {!$Record.Description} +
BR() + &apos;Comment: &apos; + {!Casecommentbody} +
BR() + BR() + &apos;Thread ID: &apos; + {!$Record.Parent.Thread_ID__c}</expression>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
        <expression>&apos;New Escalated Case &apos; + {!$Record.CaseNumber} + &apos; &apos; + {!$Record.Parent.Thread_ID__c}</expression>
    </formulas>
    <formulas>
        <description>Gat case&apos;s owner&apos;s email</description>
        <name>OwnerEmail</name>
        <dataType>String</dataType>
        <expression>IF(
    BEGINS({!$Record.OwnerId},&quot;00G&quot;),
    {!$Record.Owner:Group.Email},
    {!$Record.Owner:User.Email}
)</expression>
    </formulas>
    <formulas>
        <description>Get owner&apos;s name</description>
        <name>OwnerName</name>
        <dataType>String</dataType>
        <expression>IF(
    BEGINS({!$Record.OwnerId},&quot;00G&quot;),
    {!$Record.Owner:Group.Name},
    {!$Record.Owner:User.FirstName} + &apos; &apos; + {!$Record.Owner:User.LastName}
)</expression>
    </formulas>
    <formulas>
