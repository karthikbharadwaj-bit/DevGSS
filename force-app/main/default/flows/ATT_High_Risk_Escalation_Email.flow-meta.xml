    <assignments>
        <name>Handle_Email_Error</name>
        <label>Handle Email Error</label>
        <locationX>600</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Failed to send high risk escalation email. Error: {!$Flow.FaultMessage}</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <expression>
            &apos;A case has been flagged as HIGH RISK.&apos; &amp; BR() &amp; BR() &amp;
            &apos;Case Number: &apos; &amp; {!CaseRecord.CaseNumber} &amp; BR() &amp;
            &apos;Subject: &apos; &amp; {!CaseRecord.Subject} &amp; BR() &amp;
            &apos;Status: &apos; &amp; TEXT({!CaseRecord.Status}) &amp; BR() &amp;
            &apos;Priority: &apos; &amp; TEXT({!CaseRecord.Priority}) &amp; BR() &amp;
            &apos;Account: &apos; &amp; {!CaseRecord.Account.Name} &amp; BR() &amp; BR() &amp;
            &apos;Case Link: &apos; &amp; LEFT({!$Api.Partner_Server_URL_260}, FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_260})) &amp; {!CaseRecord.Id} &amp; BR() &amp; BR() &amp;
            IF(
                NOT(ISBLANK({!escalationReasons})),
                &apos;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&apos; &amp; BR() &amp;
                &apos;AI-Powered Escalation Analysis&apos; &amp; BR() &amp;
                &apos;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&apos; &amp; BR() &amp;
                SUBSTITUTE({!escalationReasons}, CHR(10), BR()),
                &apos;&apos;
            )</expression>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
        <expression>
            &apos;[HIGH RISK CASE] &apos; &amp; {!CaseRecord.CaseNumber} &amp; &apos; - &apos; &amp; {!CaseRecord.Subject}</expression>
    </formulas>
    <interviewLabel>ATT High Risk Escalation Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ATT High Risk Escalation Email</label>
    <processMetadataValues>
