    <formulas>
        <name>emailBodyForCreator</name>
        <dataType>String</dataType>
        <expression>&quot;Dear &quot; &amp; {!$Record.SuppliedEmail} &amp; &quot;,&quot; &amp; br() &amp;
br() &amp;
&quot;Your request has been received and will be processed accordingly.&quot; &amp; br() &amp;
&quot;Ticket &quot; &amp; {!$Record.CaseNumber} &amp; &quot; has been created for your reference and updates will be provided once available.&quot; &amp; br() &amp;
br() &amp;
&quot;Sincerely,&quot; &amp; br() &amp;
&quot;Custom Engineering&quot; &amp; br() &amp;
&quot;RingCentral, Inc.&quot; &amp; br()</expression>
    </formulas>
    <formulas>
        <name>emailBodyForDistro</name>
        <dataType>String</dataType>
        <expression>&quot;Email Sender: &quot; &amp; {!$Record.SuppliedName} &amp; &quot;(&quot; &amp; {!$Record.SuppliedEmail} &amp; &quot;)&quot; &amp; br() &amp;
br() &amp;
&quot;Case Subject: &quot; &amp; {!$Record.Subject} &amp; br() &amp;
br() &amp;
&quot;Case Number: &quot; &amp; {!$Record.CaseNumber} &amp; &quot; - &quot; &amp; LEFT($Api.Enterprise_Server_URL_510, FIND( &apos;/services&apos;, $Api.Enterprise_Server_URL_510)) &amp; {!$Record.Id} &amp; br() &amp;
br() &amp;
&quot;Status: &quot; &amp; TEXT({!$Record.Status}) &amp; br() &amp;
br() &amp;
&quot;Case Description: &quot; &amp; {!$Record.Description} &amp; br() &amp;
br() &amp;
&quot;Created Date/Time: &quot; &amp; TEXT({!$Record.CreatedDate}) &amp; br() &amp;
br() &amp;
&quot;Thread ID: &quot; &amp; {!$Record.Thread_ID__c} &amp; br() &amp;
br() &amp;
&quot;Please be sure to update the Account Name, Contact Name, and Opportunity Reference fields appropriately for accurate tracking and reporting.&quot;</expression>
    </formulas>
    <formulas>
        <name>emailSubjectForCreator</name>
        <dataType>String</dataType>
