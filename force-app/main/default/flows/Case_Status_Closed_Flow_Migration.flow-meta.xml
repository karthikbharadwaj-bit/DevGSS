    <formulas>
        <name>EmailNotificationClosedCaseBusinessServices</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.RecordTypeId} = &quot;01280000000UDFUAA4&quot; &amp;&amp;
TEXT({!$Record.Status}) = &quot;Closed&quot; &amp;&amp;
NOT(CONTAINS(UPPER({!$Record.Brand_Account__c}), &quot;TELUS&quot;)) &amp;&amp;
TEXT({!$Record.Resolution_Code__c}) = &quot;Resolved Successfully&quot;</expression>
    </formulas>
    <formulas>
        <name>EmailNotificationClosedCaseITHelpdesk</name>
        <dataType>Boolean</dataType>
        <expression>(
   {!$Record.RecordType.DeveloperName} = &quot;IT_Helpdesk&quot; ||
   {!$Record.RecordType.DeveloperName} = &quot;IT_Deskside_Support&quot;
) &amp;&amp;
TEXT({!$Record.Status}) = &quot;Closed&quot; &amp;&amp;
NOT(
   TEXT({!$Record.Request_Type__c}) = &quot;Termination Request&quot; ||
   TEXT({!$Record.Request_Type__c}) = &quot;New Hire&quot;
) &amp;&amp;
ISBLANK({!$Record.ParentId}) &amp;&amp;
NOT(CONTAINS(LOWER({!$Record.Brand_Account__c}), &quot;telus&quot;))</expression>
    </formulas>
    <formulas>
        <name>EmailNotificationTerminationCaseClosed</name>
        <dataType>Boolean</dataType>
        <expression>TEXT({!$Record.Request_Type__c}) = &quot;Termination Request&quot; &amp;&amp;
TEXT({!$Record.Status}) = &quot;Closed&quot; &amp;&amp;
(
  TEXT({!$Record.Location__c})= &quot;Denver&quot; ||
   TEXT({!$Record.Location__c}) = &quot;Headquarters&quot; ||
   TEXT({!$Record.Location__c}) = &quot;Maidenhead&quot;
) &amp;&amp;
{!$Record.RecordType.Name} &lt;&gt; &quot;Support - Telus&quot; &amp;&amp;
NOT(CONTAINS(LOWER({!$Record.Brand_Account__c}), &quot;telus&quot;)) &amp;&amp;
NOT(CONTAINS(LOWER({!$Record.Brand_Account__c}), &quot;bt&quot;)) &amp;&amp;
(
  {!$Record.LastModifiedById} &lt;&gt; &quot;0052H00000DMeSzQAL&quot; &amp;&amp;  /* Alex Zandra Conde */
   {!$Record.LastModifiedById} &lt;&gt; &quot;0053400000BpyKHAAZ&quot; &amp;&amp;  /* Almond Bautista */
   {!$Record.LastModifiedById} &lt;&gt; &quot;0053400000CKKBCAA5&quot; &amp;&amp;  /* Camilo Maceda */
   {!$Record.LastModifiedById} &lt;&gt; &quot;0053400000Bo0KUAAZ&quot; &amp;&amp;  /* Christian Tibay */
   {!$Record.LastModifiedById} &lt;&gt; &quot;0052H00000CVtuoQAD&quot; &amp;&amp;  /* Daniel Tibayan */
   {!$Record.LastModifiedById} &lt;&gt; &quot;00534000008RpdPAAS&quot; &amp;&amp;  /* Jaffit Earl Padilla */
   {!$Record.LastModifiedById} &lt;&gt; &quot;0053400000BpcdRAAR&quot; &amp;&amp;  /* Jan Michael Roberto */
   {!$Record.LastModifiedById} &lt;&gt; &quot;0053400000BmwSmAAJ&quot; &amp;&amp;  /* Joana Grace Veloso */
   {!$Record.LastModifiedById} &lt;&gt; &quot;0053400000BK35cAAD&quot; &amp;&amp;  /* Joseph Roy Garcia */
   {!$Record.LastModifiedById} &lt;&gt; &quot;0052H00000CuH1zQAF&quot; &amp;&amp;  /* Lois Anthony Bernardo */
   {!$Record.LastModifiedById} &lt;&gt; &quot;0053400000AiktKAAR&quot;     /* Virgilio Ganata */
)</expression>
    </formulas>
    <formulas>
        <name>Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>PKIHoldCaseClosed</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  ISPICKVAL(PRIORVALUE({!$Record.Status}), &quot;PKI Hold&quot;),
  ISPICKVAL({!$Record.Status}, &quot;Closed&quot;),
  {!$Record.RecordTypeId}&lt;&gt; &apos;01280000000UJWYAA4&apos;,
  OR(
    LOWER({!$Record.Brand_Account__c}) = &quot;at&amp;t office@hand&quot;,
    LOWER({!$Record.Brand_Account__c}) = &quot;at&amp;t virtual receptionist&quot;,
    LOWER({!$Record.Brand_Account__c}) = &quot;ringcentral&quot;,
    LOWER({!$Record.Brand_Account__c}) = &quot;ringcentral canada&quot;,
    LOWER({!$Record.Brand_Account__c}) = &quot;ringcentral office@hand from at&amp;t&quot;,
    LOWER({!$Record.Brand_Account__c}) = &quot;ringcentral uk&quot;
  ),
  {!$Record.LastModifiedBy.ProfileId} &lt;&gt; &quot;00e80000000l1hK&quot;,
  {!$Record.LastModifiedBy.ProfileId} &lt;&gt; &quot;00e2H000001aqzI&quot;,
  {!$Record.LastModifiedBy.ProfileId}  &lt;&gt; &quot;00e2H000001aqz8&quot;,
  {!$Record.LastModifiedBy.ProfileId}  &lt;&gt; &quot;00e2H000001aqzD&quot;,
  {!$Record.LastModifiedBy.ProfileId} &lt;&gt; &quot;00eHr000001CRVIIA4&quot;,
  {!$Record.LastModifiedBy.ProfileId}  &lt;&gt; &quot;00e2H000001OYp6QAG&quot;
)</expression>
