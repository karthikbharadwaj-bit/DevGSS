    <decisions>
        <name>SlapFive_Customer_Nomination_Status</name>
        <label>SlapFive Customer Nomination Status</label>
        <locationX>842</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Nominate_this_Customer</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Can be nominated</defaultConnectorLabel>
        <rules>
            <name>Sent</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>getContactRecord.SlapFive_Customer_Nomination_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getContactRecord.SlapFive_Customer_Nomination_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TodayMinus30</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>getContactRecord.SlapFive_Last_Rejected_Nomination_Date__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sent_or_Approved_Error_Message</targetReference>
            </connector>
            <label>Sent OR Rejected status older than 30 days</label>
        </rules>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getContactRecord.SlapFive_Customer_Nomination_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_Error_Message</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
    </decisions>
