    <decisions>
        <name>Check_for_Matching_Group</name>
        <label>Check for Matching Group</label>
        <locationX>688</locationX>
        <locationY>1574</locationY>
        <defaultConnector>
            <targetReference>Add_all_Group_Ids</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not match</defaultConnectorLabel>
        <rules>
            <name>Matches_Group_to_Share</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PublicGroupName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PublicGroupName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_all_Group_Records.DeveloperName</elementReference>
                </rightValue>
            </conditions>
            <conditions>
