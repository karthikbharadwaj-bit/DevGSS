                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_GroupIdToShare</targetReference>
            </connector>
            <label>Matches Group to Share</label>
        </rules>
        <rules>
            <name>Matches_Non_GSP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_all_Group_Records.DeveloperName</leftValueReference>
