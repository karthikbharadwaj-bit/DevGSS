<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_to_determine_Flow_Actions</name>
        <label>Decision to determine Flow Actions</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Top_Target_isChanged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Top_Target__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Target_Account_Date_stamp</targetReference>
            </connector>
            <label>Top Target isChanged</label>
        </rules>
        <rules>
            <name>Company_Segment_Name</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountryandExactCalc</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Launch_Segment_Assignment_Flow</targetReference>
            </connector>
            <label>Company Segment Name</label>
        </rules>
    </decisions>
    <description>Flow on Company Object</description>
    <environments>Default</environments>
    <formulas>
        <name>CountryandExactCalc</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(
        ISNEW(), 
        NOT(
            ISBLANK({!$Record.Country__c})
        ), {!$Record.Employee_Exact__c} &gt;= 1
    ),
    ISCHANGED(
        {!$Record.Employee_Exact__c}
    ),
    ISCHANGED(
        {!$Record.Country__c}
    )
)</expression>
    </formulas>
    <formulas>
        <description>Formula that stores today&apos;s date</description>
        <name>DateToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Company {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Company Object Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Target_Account_Date_stamp</name>
        <label>Target Account Date stamp</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>Target_Account_Date_Stamp__c</field>
            <value>
                <elementReference>DateToday</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_to_determine_Flow_Actions</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Top_Target__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Country__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Employee_Exact__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account_Hierarchy__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Launch_Segment_Assignment_Flow</name>
        <label>Launch Segment Assignment Flow</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <flowName>Segment_Assignment</flowName>
        <inputAssignments>
            <name>inCompanyId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>LeadOrAccountOrCompany</name>
            <value>
                <elementReference>CompanyValue</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>CompanyValue</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <value>
            <stringValue>COMPANY</stringValue>
        </value>
    </variables>
</Flow>
