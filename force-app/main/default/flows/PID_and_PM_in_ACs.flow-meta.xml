        <label>Is Reseller partner id exist</label>
        <locationX>753</locationX>
        <locationY>526</locationY>
        <defaultConnectorLabel>No partner id exist</defaultConnectorLabel>
        <rules>
            <name>Reseller_partner_id_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Reseller_Partner_Id.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Reseller_Partner_Id.Partner_ID__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Partner_ID__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_partner_id_with_reseller_partner_id</targetReference>
            </connector>
            <label>Reseller partner id exist</label>
        </rules>
        <rules>
            <name>Non_Reseller_partner_Id_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Partner_ID__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Reseller_Partner_Id.Partner_ID__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Inside_Sales_Rep__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Partner_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_FIelds_in_Agent_Credit</targetReference>
            </connector>
            <label>Non-Reseller partner Id Exist</label>
        </rules>
    </decisions>
