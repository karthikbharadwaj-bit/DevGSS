        <connector>
            <targetReference>Change</targetReference>
        </connector>
        <filterFormula>AND(
    ISNEW(),
    {!$Record.RecordType.DeveloperName} = &quot;Customer_Feedback&quot;,
    NOT(ISPICKVAL({!$Record.Origin}, &quot;RC App&quot;)),
    {!$Record.CreatedById} != &quot;00534000009LhQeAAK&quot;,
    NOT((BEGINS({!$Record.Subject}, &quot;RC App Detractor Alert&quot;)))
)</filterFormula>
        <object>Case</object>
