    <decisions>
        <name>Check_Holiday_or_Weekend</name>
        <label>Check Holiday or Weekend</label>
        <locationX>314</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>Assign_Next_Day_as_Reminder</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Holiday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Federal_Holidays.Holiday_Day__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Day</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Federal_Holidays.Holiday_Month__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Month</elementReference>
                </rightValue>
            </conditions>
