                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Two_Days</targetReference>
            </connector>
            <label>Copy 1 of Is Saturday</label>
        </rules>
        <rules>
            <name>Copy_1_of_Is_Sunday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsToday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sunday</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Flow.CurrentDate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Current_Date</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_A_Day</targetReference>
            </connector>
            <label>Copy 1 of Is Sunday?</label>
        </rules>
    </decisions>
    <description>Autolaunched flow to determine the next schedule date when CNR follow up has to be sent</description>
    <environments>Default</environments>
    <formulas>
        <name>Add_1_Day</name>
        <dataType>Date</dataType>
        <expression>{!Holiday_Check_Date} + 1</expression>
    </formulas>
    <formulas>
        <name>Add_1_Day_DT</name>
        <dataType>DateTime</dataType>
        <expression>{!Holiday_Check_DateTime} + 24/24</expression>
    </formulas>
    <formulas>
        <name>Add_2_Days</name>
        <dataType>Date</dataType>
        <expression>{!Holiday_Check_Date} + 2</expression>
    </formulas>
    <formulas>
        <name>Add_2_Days_DT</name>
        <dataType>DateTime</dataType>
        <expression>{!Holiday_Check_DateTime} + 48/24</expression>
    </formulas>
    <formulas>
        <name>AddDateTime</name>
        <dataType>DateTime</dataType>
        <expression>{!Flow_Trigger_DateTime} + 24/24</expression>
    </formulas>
    <formulas>
        <name>AddDay</name>
        <dataType>Date</dataType>
        <expression>{!Flow_Trigger_DateTime} + 24/24 - 8/24</expression>
    </formulas>
    <formulas>
        <name>CheckHolidayDate_Day</name>
        <dataType>Number</dataType>
        <expression>DAY({!Holiday_Check_Date})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>CheckHolidayDate_Month</name>
        <dataType>Number</dataType>
        <expression>MONTH({!Holiday_Check_Date})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Current_Date</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>HolidayCheckDT</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!Holiday_Check_Date})</expression>
    </formulas>
    <formulas>
        <name>HolidayDateValue</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!Holiday_Check_DateTime})</expression>
    </formulas>
    <formulas>
        <name>IsToday</name>
        <dataType>String</dataType>
        <expression>CASE( WEEKDAY( {!CNR_Reminder_Date}), 1, &quot;Sunday&quot;, 2, &quot;Monday&quot;, 3, &quot;Tuesday&quot;, 4, &quot;Wednesday&quot;, 5, &quot;Thursday&quot;, 6, &quot;Friday&quot;, 7, &quot;Saturday&quot;,&quot;Error&quot;)</expression>
    </formulas>
