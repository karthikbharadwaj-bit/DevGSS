            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsToday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Saturday</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>HolidayCheckDT</leftValueReference>
                <operator>IsNull</operator>
