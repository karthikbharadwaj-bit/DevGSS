    <formulas>
        <name>AssignSoftphonefeedbackCaseBrandRC</name>
        <dataType>Boolean</dataType>
        <expression>AND(
   NOT(
      OR(
         CONTAINS($Record.Brand_Account__c, &quot;AT&amp;T&quot;),
         CONTAINS($Record.Brand_Account__c, &quot;TELUS&quot;),
         CONTAINS($Record.Brand_Account__c, &quot;BT&quot;),
         CONTAINS($Record.Brand_Account__c, &quot;Avaya Cloud Office&quot;)
      )
   ),
   NOT(
      OR(
         CONTAINS($Record.Description, &quot;Brand: AT&amp;T&quot;),
