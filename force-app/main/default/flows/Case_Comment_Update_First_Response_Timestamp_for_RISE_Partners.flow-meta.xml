<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Case_comment_Length_and_Case_comment_Owner_check</name>
        <label>Case comment Length and Case comment Owner check</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_comment_Length_and_Case_comment_Owner_check1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CaseCommentLength</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>CharacterLimit</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CreatedById</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Parent.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_RISE_Record_Types</targetReference>
            </connector>
            <label>Case comment Length and Case comment Owner check</label>
        </rules>
    </decisions>
    <description>Added conditions Case owner and case comment owner are same, Case body length equal to or greater than 150, Published equal to True</description>
    <environments>Default</environments>
    <formulas>
        <name>CaseCommentLength</name>
        <dataType>Number</dataType>
        <expression>LEN({!$Record.CommentBody})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CharacterLimit</name>
        <dataType>Number</dataType>
        <expression>VALUE({!$Label.Partner_Case_Milestone_Character_Limit})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Case Comment : Update First Response Timestamp for RISE Partners {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Comment : Update First Response Timestamp for RISE Partners</label>
    <loops>
        <name>Check_each_record_Type_from_metadata</name>
        <label>Check each record Type from metadata</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <collectionReference>Get_RISE_Record_Types</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_First_Response_Time</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_RISE_Record_Types</name>
        <label>Get Partner Record Types</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_each_record_Type_from_metadata</targetReference>
        </connector>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>RISE_Partner_Support_RecordTypes__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_First_Response_Time</name>
        <label>Update First Response Time</label>
        <locationX>138</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>Check_each_record_Type_from_metadata</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeName__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Check_each_record_Type_from_metadata.RecordType__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Duplicate</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Invalid</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>First_Response_Timestamp_TELUS__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Case_comment_Length_and_Case_comment_Owner_check</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsPublished</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>CaseComment</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
