    <decisions>
        <description>Define if the update is on &quot;Status&quot; or &quot;Estimated Contract Value&quot;(TCV) fields</description>
        <name>Status_TCV_Update</name>
        <label>Status/TCV Update</label>
        <locationX>881</locationX>
        <locationY>1201</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Status_AND_TCV_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Estimated_Total_Contract_Value__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EmailLoop_Status_TCV</targetReference>
            </connector>
            <label>Status AND TCV Update</label>
        </rules>
        <rules>
            <name>Status_update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EmailLoop_Status</targetReference>
            </connector>
            <label>Status update</label>
        </rules>
        <rules>
            <name>TCV_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Estimated_Total_Contract_Value__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>EmailLoop_TCV</targetReference>
            </connector>
            <label>TCV Update</label>
        </rules>
    </decisions>
    <description>Send an email alert when Status or TCV fields are updated
