            <name>originalFormula</name>
            <value>
                <stringValue>AND(
AND(ISCHANGED([Deal_Support__c].OwnerId ) ,
[Deal_Support__c].OwnerId = &quot;00G2H0000044s1VUAQ&quot;),
[Deal_Support__c].Opportunity__r.Forecasted_Users__c &lt; 100,
ISPICKVAL([Deal_Support__c].Type__c , &quot;Initial Order&quot;),
ISPICKVAL([Deal_Support__c].Brand_Name__c , &quot;Avaya Cloud Office&quot;),
ISPICKVAL([Deal_Support__c].Status__c  , &quot;Signature Complete&quot;))</stringValue>
            </value>
        </processMetadataValues>
