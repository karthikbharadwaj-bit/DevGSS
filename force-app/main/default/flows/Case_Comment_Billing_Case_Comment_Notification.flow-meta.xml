    <description>LTR-2871: Sends email notifications to Case Owner when customer responds, and to Customer when agent posts a public comment, on Billing cases for in-scope brands and record types.</description>
    <environments>Default</environments>
    <formulas>
        <name>fml_Is_Owner_Queue</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!Get_Parent_Case.OwnerId}, &apos;00G&apos;)</expression>
    </formulas>
