    <description>Consolidated Flow migrating all Case Workflow Rules to Flow. This includes: CNR Status Updates, Integration Escalation, Number Porting Escalation, Glip Specialist Escalation, TAM/CSM Notifications, Auto-Close Emails, and InContact Status Updates.</description>
    <environments>Default</environments>
    <formulas>
        <name>Brand_Account_Check</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(CONTAINS(LOWER({!$Record.Brand_Account__c}), &quot;telus&quot;)),
    NOT(CONTAINS(LOWER({!$Record.Brand_Account__c}), &quot;bt&quot;))
)</expression>
    </formulas>
    <formulas>
        <name>Profile_Recordtype_Check</name>
        <dataType>Boolean</dataType>
        <expression>AND(
OR(
{!$Record.LastModifiedBy.Profile.Name} &lt;&gt; &apos;System Administrator&apos;,
{!$Record.LastModifiedBy.Profile.Name} &lt;&gt; &apos;CRM Support Engineer&apos;,
{!$Record.LastModifiedBy.Profile.Name} &lt;&gt; &apos;CRM Developer&apos;,
{!$Record.LastModifiedBy.Profile.Name} &lt;&gt; &apos;CRM QA Engineer&apos;,
{!$Record.LastModifiedBy.Profile.Name} &lt;&gt; &apos;CRM QA Engineer - EU Restricted&apos;,
{!$Record.LastModifiedBy.Profile.Name} &lt;&gt; &apos;CRM Support Engineer - EU Restricted&apos;,
{!$Record.LastModifiedById} &lt;&gt; &apos;00580000003d9rBAAQ&apos;
),
{!$Record.RecordType.DeveloperName} &lt;&gt; &apos;Support_Telus&apos;
)</expression>
    </formulas>
