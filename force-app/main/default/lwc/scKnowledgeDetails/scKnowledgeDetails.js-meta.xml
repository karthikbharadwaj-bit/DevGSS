<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>45.0</apiVersion>
    <description>SC Knowledge Details</description>
    <isExposed>true</isExposed>
    <masterLabel>SC Knowledge Details</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="detailsTitle" type="String" label="Details Title"/>
            <property name="displayDetailsTitle" type="Boolean" label="Show Details title"/>
            <property name="detailsDisplay" type="Boolean" label="Show Details block"/>
            <property name="issueTitle" type="String" label="Issue Title"/>
            <property name="issueDisplay" type="Boolean" label="Show Issue block"/>
            <property name="questionTitle" type="String" label="Question Title"/>
            <property name="questionDisplay" type="Boolean" label="Show Question block"/>
            <property name="STRTitle" type="String" label="STR Title"/>
            <property name="STRDisplay" type="Boolean" label="Show STR block"/>
            <property name="causeTitle" type="String" label="Cause Title"/>
            <property name="causeDisplay" type="Boolean" label="Show Cause block"/>
            <property name="symptomTitle" type="String" label="Symptom Title"/>
            <property name="symptomDisplay" type="Boolean" label="Show Symptom block"/>
            <property name="affectedEnvTitle" type="String" label="AffectedEnv Title"/>
            <property name="affectedEnvDisplay" type="Boolean" label="Show AffectedEnv block"/>
            <property name="statusTitle" type="String" label="Status Title"/>
            <property name="statusDisplay" type="Boolean" label="Show Status block"/>
            <property name="resolutionTitle" type="String" label="Resolution Title"/>
            <property name="resolutionDisplay" type="Boolean" label="Show Resolution block"/>
            <property name="hideEmptyAdditionalBlocks" type="Boolean" label="Hide empty additional blocks"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>