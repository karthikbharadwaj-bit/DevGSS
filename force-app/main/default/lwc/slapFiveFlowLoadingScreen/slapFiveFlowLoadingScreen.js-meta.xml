<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>SlapFive Flow Loading Spinner</masterLabel>
    <description>
        Spinner-only Screen Flow component that polls SlapFive Queueable job
        and outputs Success when completed
    </description>

    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="jobId" type="String" label="Job ID" role="inputOnly"/>
            <property name="flowResult" type="String" label="Flow Result" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>